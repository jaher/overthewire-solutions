{"version":3,"term":{"cols":100,"rows":32},"timestamp":1793541088,"idle_time_limit":2.0,"command":"bash /home/claude/solves/utumno/L4_run.sh","title":"Utumno L4: the length guard truncates to 16 bits","env":{"SHELL":"/bin/bash"}}
[0.002, "o", "$ ssh utumno4@utumno.labs.overthewire.org -p 2227   # password 06nx2CS7rS\r\n$ utumno4 checks only the low 16 bits of the copy length; 65599 passes the\r\n$   guard and still copies 65599 bytes, overwriting the return address.\r\n"]
