[60.757, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;83H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport ctypes, os, struct, sys, time\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# utumno4's main(), after a huge stack-probe prologue (it reserves 0xf000\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# bytes and touches each page -- a stack-clash guard):\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l#\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l#     int len = atoi(argv[1]);\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l#     unsigned short small = len;\u001b[8C/* only the LOW 16 BITS are kept */\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l#     if (small > 0x3f) exit(1);\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l#     memcpy(buf, argv[2], len);\u001b[9C/* buf is at ebp-0xff02 */\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l#\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l# The guard checks `(unsigned short)len <= 63`, so any len whose low 16 bits\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l# are 0..63 passes -- 65599 does.  But memcpy still copies the FULL 32-bit\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l# len, and the destination is 0xff02 bytes below ebp: the return address at\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l# ebp+4 is at offset 0xff06 = 65286 in the copy.  So a 65599-byte argv[2]\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l# overwrites the saved return address with byte