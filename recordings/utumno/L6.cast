;83H\u001b[K\u001b[32;83H70,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H70,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"sc.asm\" [New] 70L, 1599B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=425735b9-a500-444a-9b72-fff600233bc8;exit=success\u001b\\\u001b]3008;start=0e967b0e-806d-4615-9cc5-dcd2a9961f2e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu6\u001b\\\u001b[?2004h\u001b]0;utumno6@utumno: /tmp/uu6\u0007utumno6@utumno:/tmp/uu6$ "]
