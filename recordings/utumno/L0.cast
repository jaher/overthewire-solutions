[0.424, "o", "echo 'The binary is 32-bit (ELFCLASS32), so the .so must be built with gcc -m32 or ld.so rejects it.'\r\r\n\u001b[?2004l\r\u001b]3008;start=d2a4e089-8d5e-4cf4-993f-03ad5cc0085f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/utumno0\u001b\\The binary is 32-bit (ELFCLASS32), so the .so must be built with gcc -m32 or ld.so rejects it.\r\r\n"]
