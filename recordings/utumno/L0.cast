[1.572, "o", "vim -u NONE -N dump.c\r\r\n\u001b[?2004l\r\u001b]3008;start=b9c3dedd-6be6-4996-a848-463943c06d7a;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/u0\u001b\\\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;32r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[32;1HE325: ATTENTION\r\r\r\nFound a swap file by the name \".dump.c.swp\"\r\r\r\n\u001b[10Cowned by: utumno0   dated: Sun Nov 01 11:56:33 2026\r\r\r\n\u001b[9Cfile name: /tmp/u0/dump.c\r\r\r\n\u001b[10Cmodified: YES\r\r\r\n\u001b[9Cuser name: utumno0   host name: gibson-0\r\r\r\n\u001b[8Cprocess ID: 122 (STILL RUNNING)\r\r\r\nWhile opening file \"dump.c\"\r\r\r\n\u001b[13Cdated: Sun Nov 01 12:01:26 2026\r\r\r\n      NEWER than swap file!\r\r\r\n\r\r\n(1) Another program may be editing the same file.  If this is the case,\r\r\r\n    be careful not to end up with two different instances of the same\r\r\r\n    file when making changes.  Quit, or continue with caution.\r\r\r\n(2) An edit session for this file crashed.\r\r\r\n    If this is the case, use \":recover\" or \"vim -r dump.c\"\r\r\r\n    to recover the changes (see \":help recovery\").\r\r\r\n    If you did this already, delete the swap file \".dump.c.swp\"\r\r\r\n    to avoid this message.\r\r\r\n\r\r\nSwap file \".dump.c.swp\" already exists!\r\r\r\n[O]pen Read-Only, (E)dit anyway, (R)ecover, (Q)uit, (A)bort:\u001b[?25h"]
[45.069, "o", "\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;1H\"dump.c\" 106L, 3784B\r\r\r\nUsing swap file \".dump.c.swp\"\r\r\r\nOriginal file \"/tmp/u0/dump.c\"\r\r\r\nE308: Warning: Original file may have been changed\r\r\r\nRecovery completed. You should check if everything is OK.\r\r\r\n(You might want to write out this file under another name\r\r\r\nand run diff with the original file to check for changes)\r\r\r\nYou may want to delete the .swp file now.\r\r\r\nNote: process STILL RUNNING: 122\r\r\r\n\r\r\n\r\r\n\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[32;1HPress ENTER or type command to continue\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H/ltrace all fail with \"Permission denied\", and ptrace\rPress ENTER or type command to continu\u001b[32;40H\u001b[K\u001b[?25h\u001b[1;1H\u001b[11L\u001b[?25l\u001b[1;1H/* dump.c -- read a process's own memory from inside that process.\r\r\n *\r\r\n * utumno0 is execute-only (---x--x---): we may run it but not open it, so\r\r\n * strings/objdump/nm/ltrace all fail with \"Permission denied\", and ptrace\r\r\n * cannot read it either.  But the *pages* the kernel maps for the running\r\r\n * process are readable by the process itself -- the missing permission is on\r\r\n * the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\r\r\n * inside that process, so a constructor can copy the mapped segments out.\r\r\n *\r\r\n * The binary is 32-bit, so this must be compiled with -m32; a 64-bit .so is\r\r\n * rejected by the loader (\"wrong ELF class: ELFCLASS64\").\r\r\n */\u001b[12;4H\u001b[K\u001b[13;1H#define _GNU_SOURCE\u001b[13;20H\u001b[K\u001b[14;1H#include <stdio.h>\u001b[14;19H\u001b[K\u001b[15;1H#include <string.h>\u001b[15;21H\u001b[K\u001b[16;1H@line\u001b[16;10H\u001b[K\u001b[17;1H__attribute__((constructor)) static void dump(void)\r\r\n{\u001b[18;2H\u001b[K\u001b[19;5HFILE *m   = fopen(\"/proc/self/maps\", \"r\");\r\r\n    FILE *img = fopen(\"image.bin\", \"wb\");\r\r\n    FILE *txt = fopen(\"maps.txt\", \"w\");\r\r\n    char line[512];\u001b[22;21H\u001b[K\u001b[23;1H@line\u001b[23;6H\u001b[K\u001b[24;1H/* dump.c -- read a process's own memory from inside that process.\r\r\n *\u001b[25;3H\u001b[K\u001b[26;2H* utumno0 is execute-only (---x--x---): we may run it but not open it, so\r\r\n * strings/objdump/nm/ltrace all fail with \"Permission denied\", and ptrace\r\r\n * cannot read it either.  But the *pages* the kernel maps for the running\r\r\n * process are readable by the process itself -- the missing permission is on\r\r\n * the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\r\r\n * inside that process, so a constructor can copy the mapped segments out.\u001b[32;1H\u001b[K\u001b[32;83H4,23\u001b[10CTop\u001b[4;23H\u001b[?25h\u001b[?25l\u001b[32;1H/\\<ltrace\\>\u001b[32;83H\u001b[K\u001b[32;1H\u001b[82C27,23\u001b[9CTop\u001b[27;23H\u001b[?25h\u001b[?25l\u001b[32;87H4\u001b[27;24H\u001b[?25h\u0007\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H\u001b[31msearch hit BOTTOM, continuing at TOP\u001b[m\u001b[46C4,23\u001b[10CTop\u001b[32;83H\u001b[K\u001b[32;83H4,23\u001b[10CTop\u001b[4;23H\u001b[?25h\u001b[?25l\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H5,1\u001b[11CTop\u001b[5;31r\u001b[5;1H\u001b[2L\u001b[1;32r\u001b[5;1Ht read it either.  But the *pages* the kernel maps for the running\u001b[32;83H\u001b[K\u001b[32;83H6,1\u001b[11CTop\u001b[6;1H\u001b[?4m\u001b[?25h\u001b[?25l\u001b[7;31r\u001b[7;1H\u001b[L\u001b[1;32r\u001b[6;2H* process are readable by the process itself -- the missing permission is on\u001b[32;83H\u001b[K\u001b[32;83H7,1\u001b[11CTop\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[8;31r\u001b[8;1H\u001b[L\u001b[1;32r\u001b[7;2H* the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\u001b[32;83H\u001b[K\u001b[32;83H8,1\u001b[11CTop\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[9;31r\u001b[9;1H\u001b[L\u001b[1;32r\u001b[8;2H* inside that process, so a constructor can copy the mapped segments out.\u001b[32;83H\u001b[K\u001b[32;83H9,1\u001b[11CTop\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[10;31r\u001b[10;1H\u001b[2L\u001b[1;32r\u001b[9;2H*\r\r\n * The binary is 32-bit, so this must be compiled with -m32; a 64-bit .so is\u001b[32;83H\u001b[K\u001b[32;83H11,1\u001b[10CTop\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[12;31r\u001b[12;1H\u001b[L\u001b[1;32r\u001b[11;2H* rejected by the loader (\"wrong ELF class: ELFCLASS64\").\u001b[32;83H\u001b[K\u001b[32;83H12,1\u001b[10CTop\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[13;31r\u001b[13;1H\u001b[L\u001b[1;32r\u001b[12;2H*/\u001b[32;83H\u001b[K\u001b[32;83H13,1\u001b[10CTop\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[14;31r\u001b[14;1H\u001b[L\u001b[1;32r\u001b[13;1H#define _GNU_SOURCE\u001b[32;83H\u001b[K\u001b[32;83H14,1\u001b[10CTop\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[15;31r\u001b[15;1H\u001b[2L\u001b[1;32r\u001b[14;1H#include <stdio.h>\r\r\n#include <string.h>\u001b[32;83H\u001b[K\u001b[32;83H16,1\u001b[10CTop\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[17;31r\u001b[17;1H\u001b[L\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H17,1\u001b[10CTop\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[18;31r\u001b[18;1H\u001b[L\u001b[1;32r\u001b[17;1H__attribute__((constructor)) static void dump("]
[0.000, "o", "void)\u001b[32;83H\u001b[K\u001b[32;83H18,1\u001b[10CTop\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[19;31r\u001b[19;1H\u001b[L\u001b[1;32r\u001b[18;1H{\u001b[32;83H\u001b[K\u001b[32;83H19,1\u001b[10CTop\u001b[19;1H\u001b[?25h\u001b[?25l\u001b[20;31r\u001b[20;1H\u001b[L\u001b[1;32r\u001b[19;5HFILE *m   = fopen(\"/proc/self/maps\", \"r\");\u001b[32;83H\u001b[K\u001b[32;83H20,1\u001b[10CTop\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[21;31r\u001b[21;1H\u001b[L\u001b[1;32r\u001b[20;5HFILE *img = fopen(\"image.bin\", \"wb\");\u001b[32;83H\u001b[K\u001b[32;83H21,1\u001b[10CTop\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[22;31r\u001b[22;1H\u001b[L\u001b[1;32r\u001b[21;5HFILE *txt = fopen(\"maps.txt\", \"w\");\u001b[32;83H\u001b[K\u001b[32;83H22,1\u001b[10CTop\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[23;31r\u001b[23;1H\u001b[L\u001b[1;32r\u001b[22;5Hchar line[512];\u001b[32;83H\u001b[K\u001b[32;83H23,1\u001b[10CTop\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[24;31r\u001b[24;1H\u001b[L\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H24,1\u001b[10CTop\u001b[24;1H\u001b[?25h\u001b[?25l\u001b[25;31r\u001b[25;1H\u001b[L\u001b[1;32r\u001b[24;5Hif (!m || !img || !txt) return;\u001b[32;83H\u001b[K\u001b[32;83H25,1\u001b[10CTop\u001b[25;1H\u001b[?25h\u001b[?25l\u001b[26;31r\u001b[26;1H\u001b[L\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H26,1\u001b[10CTop\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[27;31r\u001b[27;1H\u001b[L\u001b[1;32r\u001b[26;5Hwhile (fgets(line, sizeof line, m)) {\u001b[32;83H\u001b[K\u001b[32;83H27,1\u001b[10CTop\u001b[27;1H\u001b[?25h\u001b[?25l\u001b[28;31r\u001b[28;1H\u001b[L\u001b[1;32r\u001b[27;9Hunsigned long lo, hi, off;\u001b[32;83H\u001b[K\u001b[32;83H28,1\u001b[10CTop\u001b[28;1H\u001b[?25h\u001b[?25l\u001b[29;31r\u001b[29;1H\u001b[L\u001b[1;32r\u001b[28;9Hchar perms[8], path[256] = \"\";\u001b[32;83H\u001b[K\u001b[32;83H29,1\u001b[10CTop\u001b[29;1H\u001b[?25h\u001b[?25l\u001b[30;2H\u001b[K\u001b[31;4Hcannot read it either.  But the *pages* the kernel maps for the running\u001b[31;76H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[29;9Hint n = sscanf(line, \"%lx-%lx %7s %lx %*s %*s %255s\",\r\r\n                       &lo, &hi, perms, &off, path);\u001b[30;53H\u001b[K\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[11C1%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hif (n < 4) continue;\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[11C3%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;9Hif (!strstr(path, \"/utumno/utumno0\")) continue;\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[11C6%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hfputs(line, txt);\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[11C7%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hif (!strchr(perms, 'r')) continue;   /* only segments we can read */\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[11C8%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hfwrite((void *)lo, 1, hi - lo, img);\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10C10%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H}\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10C11%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[30;5Hfclose(m);\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10C13%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfclose(img);\u001b[32;83H\u001b[K\u001b[32;83H42,1\u001b[10C15%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;5Hfclose(txt);\r\r\n}\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10C17%\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H44,0-1\u001b[8C17%\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"dump.c\" 106L, 3707B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=b9c3dedd-6be6-4996-a848-463943c06d7a;exit=success\u001b\\\u001b]3008;start=ffc7bea9-2d10-4da7-8d49-638bbce52199;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/u0\u001b\\\u001b[?2004h\u001b]0;utumno0@utumno: /tmp/u0\u0007utumno0@utumno:/tmp/u0$ "]
