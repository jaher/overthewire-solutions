[0.035, "o", "/* dump.c -- read a process's own memory from inside that process.\r\r\n *\r\r\n * utumno0 is execute-only (---x--x---): we may run it but not open it, so\r\r\n * strings/objdump/nm/ltrace all fail with \"Permission denied\", and ptrace\r\r\nt read it either.  But the *pages* the kernel maps for the running\r\r\n * process are readable by the process itself -- the missing permission is on\r\r\n * the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\r\r\n * inside that process, so a constructor can copy the mapped segments out.\r\r\n *\r\r\n * The binary is 32-bit, so this must be compiled with -m32; a 64-bit .so is\r\r\n * rejected by the loader (\"wrong ELF class: ELFCLASS64\").\r\r\n */\r\r\n#define _GNU_SOURCE\r\r\n#include <stdio.h>\r\r\n#include <string.h>\r\r\n\r\r\n__attribute__((constructor)) static void dump(void)\r\r\n{\r\r\n    FILE *m   = fopen(\"/proc/self/maps\", \"r\");\r\r\n    FILE *img = fopen(\"image.bin\", \"wb\");\r\r\n    FILE *txt = fopen(\"maps.txt\", \"w\");\r\r\n    char line[512];\r\r\n\r\r\n    if (!m || !img || !txt) return;\r\r\n\r\r\n    while (fgets(line, sizeof line, m)) {\r\r\n        unsigned long lo, hi, off;\r\r\n        char perms[8], path[256] = \"\";\r\r\n\r\r\n        int n = sscanf(line, \"%lx-%lx %7s %lx %*s %*s %255s\",\r\r\n                       &lo, &hi, perms, &off, path);\r\r\n        if (n < 4) continue;\r\r\n        if (!strstr(path, \"/utumno/utumno0\")) continue;\r\r\n\r\r\n        fputs(line, txt);\r\r\n        if (!strchr(perms, 'r')) continue;   /* only segments we can read */\r\r\n        fwrite((void *)lo, 1, hi - lo, img);\r\r\n    }\r\r\n\r\r\n    fclose(m);\r\r\n    fclose(img);\r\r\n    fclose(txt);\r\r\n}\r\r\n\r\r\n * cannot read it either.  But the *pages* the kernel maps for the running\r\r\n * process are readable by the process itself -- the missing permission is on\r\r\n * the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\r\r\n * inside that process, so a constructor can copy the mapped segments out.\r\r\n *\r\r\n * The binary is 32-bit, so this must be compiled with -m32; a 64-bit .so is\r\r\n * rejected by the loader (\"wrong ELF class: ELFCLASS64\").\r\r\n */\r\r\n#define _GNU_SOURCE\r\r\n#include <stdio.h>\r\r\n#include <string.h>\r\r\n@line\r\r\n__attribute__((constructor)) static void dump(void)\r\r\n{\r\r\n    FILE *m   = fopen(\"/proc/self/maps\", \"r\");\r\r\n    FILE *img = fopen(\"image.bin\", \"wb\");\r\r\n    FILE *txt = fopen(\"maps.txt\", \"w\");\r\r\n    char line[512];\r\r\n@line\r\r\n/* dump.c -- read a process's own memory from inside that process.\r\r\n *\r\r\n * utumno0 is execute-only (---x--x---): we may run it but not open it, so\r\r\n * strings/objdump/nm/ltrace all fail with \"Permission denied\", and ptrace\r\r\n * cannot read it either.  But the *pages* the kernel maps for the running\r\r\n * process are readable by the process itself -- the missing permission is on\r\r\n * the file, not on the mapping.  A shared library loaded with LD_PRELOAD runs\r\r\n * inside that process, so a constructor can copy the mapped segments out.\r\r\n *\r\r\n * The binary is 32-bit, so this must be compiled with -m32; a 64-bit .so is\r\r\n * rejected by the loader (\"wrong ELF class: ELFCLASS64\").\r\r\n */\r\r\n#define _GNU_SOURCE\r\r\n#include <stdio.h>\r\r\n#include <string.h>\r\r\n\r\r\n__attribute__((constructor)) static void dump(void)\r\r\n{\r\r\n    FILE *m   = fopen(\"/proc/self/maps\", \"r\");\r\r\n    FILE *img = fopen(\"image.bin\", \"wb\");\r\r\n    FILE *txt = fopen(\"maps.txt\", \"w\");\r\r\n    char line[512];\r\r\n\r\r\n    if (!m || !img || !txt) return;\r\r\n\r\r\n"]
[0.002, "o", "    while (fgets(line, sizeof line, m)) {\r\r\n        unsigned long lo, hi, off;\r\r\n        char perms[8], path[256] = \"\";\r\r\n\r\r\n        int n = sscanf(line, \"%lx-%lx %7s %lx %*s %*s %255s\",\r\r\n                       &lo, &hi, perms, &off, path);\r\r\n        if (n < 4) continue;\r\r\n        if (!strstr(path, \"/utumno/utumno0\")) continue;\r\r\n\r\r\n        fputs(line, txt);\r\r\n        if (!strchr(perms, 'r')) continue;   /* only segments we can read */\r\r\n        fwrite((void *)lo, 1, hi - lo, img);\r\r\n    }\r\r\n\r\r\n    fclose(m);\r\r\n    fclose(img);\r\r\n    fclose(txt);\r\r\n}\r\r\n\u001b]3008;end=9c262220-7471-45c1-a2cf-20198e833eac;exit=success\u001b\\\u001b]3008;start=ffc7bea9-2d10-4da7-8d49-638bbce52199;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/u0\u001b\\\u001b[?2004h\u001b]0;utumno0@utumno: /tmp/u0\u0007utumno0@utumno:/tmp/u0$ echo '=== step 7: compile it 32-bit and load it into the target ==='\r\r\n\u001b[?2004l\r"]
