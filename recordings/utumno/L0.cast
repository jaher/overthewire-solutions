[0.748, "o", "echo 'But once the kernel maps the program, the pages belong to the process, and a process may read its own pages.'\r\r\n"]
[0.001, "o", "\u001b[?2004l\r\u001b]3008;start=682113a1-9e89-47ba-886d-aabaf2e12659;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/utumno0\u001b\\But once the kernel maps the program, the pages belong to the process, and a process may read its own pages.\r\r\n\u001b]3008;end=682113a1-9e89-47ba-886d-aabaf2e12659;exit=success\u001b\\\u001b]3008;start=ffc7bea9-2d10-4da7-8d49-638bbce52199;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/utumno0\u001b\\\u001b[?2004h\u001b]0;utumno0@utumno: ~\u0007utumno0@utumno:~$ "]
[0.401, "o", "echo 'A shared library pulled in with LD_PRELOAD runs inside that process, so a constructor can copy them out.'\r\r\n\u001b[?2004l\r"]
