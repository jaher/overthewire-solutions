[0.830, "o", "strace -f -e trace=openat,read,write /utumno/utumno0 < /dev/null 2>&1 | tail -12\r\r\n\u001b[?2004l\r\u001b]3008;start=bbbd481b-392f-4a92-a72e-5be17168488f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/utumno0\u001b\\[ Process PID=96 runs in 32 bit mode. ]\r\r\nopenat(AT_FDCWD, 0xf7fee5e7, O_RDONLY|O_LARGEFILE|O_CLOEXEC) = 3\r\r\nopenat(AT_FDCWD, 0xf7fbb3e0, O_RDONLY|O_LARGEFILE|O_CLOEXEC) = 3\r\r\nread(3, 0xffffc8a0, 512)                = 512\r\r\nwrite(1, 0x804c010, 12Read me! :P\r\r\n)                 = 12\r\r\n+++ exited with 0 +++\r\r\n\u001b]3008;end=bbbd481b-392f-4a92-a72e-5be17168488f;exit=success\u001b\\\u001b]3008;start=ffc7bea9-2d10-4da7-8d49-638bbce52199;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/utumno0\u001b\\\u001b[?2004h\u001b]0;utumno0@utumno: ~\u0007utumno0@utumno:~$ "]
