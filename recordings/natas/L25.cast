[3.352196, "o", "function safeinclude($filename){        // check for directory traversal        if(strstr($filename,\"../\")){            logRequest(\"Directory traversal attempt! fixing request.\");            $filename=str_replace(\"../\",\"\",$filename);        }        // dont let ppl steal our passwords        if(strstr($filename,\"natas_webpass\")){            logRequest(\"Illegal file access detected! Aborting!\");            exit(-1);        }        // add more checks...        if (file_exists($filename)) {             include($filename);            return 1;        }        return 0;\r\r\n"]
