[0.002, "o", "$ curl -s -u natas27:<pw> http://natas27.natas.labs.overthewire.org/index-source.html\r\n$   users(username varchar(64), password varchar(64))\r\n$   createUser(): rejects $usr != trim($usr); inserts substr($usr,0,64)\r\n$   validUser(): exact SELECT on the whole string\r\n$   dumpData(): SELECT ... WHERE username=trim($usr) -> print_r($row)\r\n"]
[0.639, "o", "<html><head><!-- This stuff in the header has nothing to do with the level --><link rel=\"stylesheet\" type=\"text/css\" href=\"http://natas.labs.overthewire.org/css/level.css\"><link rel=\"stylesheet\" href=\"http://natas.labs.overthewire.org/css/jquery-ui.css\" /><link rel=\"stylesheet\" href=\"http://natas.labs.overthewire.org/css/wechall.css\" /><script src=\"http://natas.labs.overthewire.org/js/jquery-1.9.1.js\"></script><script src=\"http://natas.labs.overthewire.org/js/jquery-ui.js\"></script><script src=http://natas.labs.overthewire.org/js/wechall-data.js></script><script src=\"http://natas.labs.overthewire.org/js/wechall.js\"></script><script>var wechallinfo = { \"level\": \"natas27\", \"pass\": \"<censored>\" };</script></head><body><h1>natas27</h1><div id=\"content\"><?php// morla / 10111// database gets cleared every 5 min/*CREATE TABLE `users` (  `username` varchar(64) DEFAULT NULL,  `password` varchar(64) DEFAULT NULL);*/function checkCredentials($link,$usr,$pass){\r\n$query = \"SELECT username from users where username='$user' and password='$password' \";\r\n$query = \"SELECT * from users where username='$user'\";\r\n$user=mysqli_real_escape_string($link, trim($usr));\r\n$query = \"SELECT * from users where username='$user'\";\r\nif($usr != trim($usr)) {\r\n$user=mysqli_real_escape_string($link, substr($usr, 0, 64));\r\n$password=mysqli_real_escape_string($link, substr($pass, 0, 64));\r\n$query = \"INSERT INTO users (username,password) values ('$user','$password')\";\r\n"]
[0.000, "o", "$ idea: the trim() check only guards createUser(), and substr() cuts at 64 bytes.\r\n$   Register \"natas28\" + 57 spaces + \"x\" (65 chars, trim() leaves it intact):\r\n$     substr(...,0,64) stores username \"natas28\" + 57 spaces, password \"\" (ours).\r\n$   Then log in with \"natas28\" + 57 spaces:\r\n"]
[0.000, "o", "$     validUser()  matches the row (MySQL ignores trailing spaces in =)\r\n$     checkCredentials() passes (our password)\r\n"]
[0.000, "o", "$     dumpData(trim($usr)) = \"natas28\" -> selects the natas28 row and prints it\r\n"]
