[15.907, "o", "\u001b[?25l\u001b[24;53Hg\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;53H \u001b[1;1H\u001b[24;53Hgg\u001b[1;1H\u001b[24;53H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;53Hd\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;54HG\u001b[1;1H\u001b[24;53H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;53H:\u001b[1;1H\u001b[24;1H\u001b[K\u001b[24;1H:\u001b[?25hset paste noai nosi nocindent\r\u001b[?25l\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;70Hg\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;70H \u001b[1;1H\u001b[24;70Hgg\u001b[1;1H\u001b[24;70H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;70Hd\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;71HG\u001b[1;1H\u001b[24;70H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;70Hi\u001b[1;1H\u001b[24;70H \u001b[1;1H\u001b[24;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[24;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l#\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25lc\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25ld\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25l \u001b[?25h\u001b[?25l\r\u001b[35m#include <\u001b[?25h\u001b[?25l\u001b[mu\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25ls\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25ld\u001b[?25h\u001b[?25l.\u001b[?25h\u001b[?25lh\u001b[?25h\u001b[?25l\u001b[1;10H\u001b[31m<unistd.h>\u001b[?25h\u001b[?25l\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l#\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25lc\u001b[?25h\u001b[?25ll\u001b[?25h\u001b[?25lu\u001b[?25h\u001b[?25ld\u001b[?25h\u001b[?25le\u001b[?25h\u001b[?25l \u001b[?25h\u001b[?25l\r\u001b[35m#include <\u001b[?25h\u001b[?25l\u001b[ms\u001b[?25h\u001b[?25lt\u001b[?25h\u001b[?25l\b\b\b\u001b[31m<stdio.h>\u001b[m\r\r\n\u001b[32mint\u001b[m main\u001b[3;9H\u001b[K\u001b[3;9H\u001b[?25h\u001b[?25l(\u001b[?25h\u001b[?25li\u001b[?25h\u001b[?25ln\u001b[?25h\u001b[?25l\b\b\u001b[32mint\u001b[?25h\u001b[?25l\u001b[m \u001b[?25h\u001b[?25lc\u001b[?25h\u001b[?25l,\u0