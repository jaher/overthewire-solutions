[0.021, "o", "111   execve(\"./probe13\", [\"./probe13\", \"in.txt\", \"out\"], 0x7fffffffe328 /* 29 vars */) = 0\r\r\n112   execve(\"/vortex/vortex13\", [], 0x7fffffffe1e0 /* 0 vars */) = 0\r\r\n112   exit_group(1)                     = ?\r\r\n111   exit_group(0)                     = ?\r\r\n\u001b]3008;end=a997b7b3-ad52-47e7-b1b1-0ef91d4e646f;exit=success\u001b\\\u001b]3008;start=6bd44159-b088-4557-8a2f-1d9dd68f242a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\\u001b[?2004h\u001b]0;vortex13@vortex: /tmp/tmp.vefOqdtqlB\u0007vortex13@vortex:/tmp/tmp.vefOqdtqlB$ "]
