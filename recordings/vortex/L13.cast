[21.775, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/ptrace.h>\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<errno.h>\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<signal.h>\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[34m/* race13b: the decisive post-exec attach test.  The child sleeps 2s\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[34m   PRE-exec (so the parent's attach cannot land pre-exec), then execs\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m   the L13 level.  The parent attaches after the exec (a 3s sleep > 2s)\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m   and records the errno.  The level may have already exited at the\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m   argc gate - the attach then reports ESRCH (process gone), which is\u001b[m\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[34m   itself the datum: no attach can land between exec and exit. */\u001b[m\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mvoid\u001b[m) {\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l    pid_t pid = fork();\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (pid == \u001b[31m0\u001b[m) {\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[8Csleep(\u001b[31m2\u001b[m);\u001b[20C\u001b[34m/* pre-exec window: the parent\u001b[m\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l\u001b[34m                                        attaches AFTER this */\u001b[m\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[32mchar\u001b[m *av[\u001b[31m2\u001b[m] = { \u001b[31mNULL\u001b[m, \u001b[31mNULL\u001b[m };\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[32mchar\u001b[m *ev[\u001b[31m1\u001b[m] = { \u001b[31mNULL\u001b[m };\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[8Cexecv(\u001b[31m\"/vortex/vortex13\"\u001b[m, av);\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[8C_exit(\u001b[31m127\u001b[m);\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25l    }\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l    sleep(\u001b[31m3\u001b[m);\u001b[24C\u001b[34m/* > the child's 2s: post-exec */\u001b[m\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5Herrno = \u001b[31m0\u001b[m;\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[32mint\u001b[m r = ptrace(PTRACE_ATTACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5Hprintf(\u001b[31m\"post-exec attach: rc=\u001b[m\u001b[35m%d\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m, r, strerror(errno));\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[33mif\u001b[m (r == \u001b[31m0\u001b[m) { ptrace(PTRACE_DETACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m); kill(pid, \u001b[31m9\u001b[m); }\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[33melse\u001b[m kill(pid, \u001b[31m9\u001b[m);\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[32mint\u001b[m st;\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5Hwaitpid(pid, &st, \u001b[31m0\u001b[m);\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[33mreturn\u001b[m \u001b[31m0\u001b[m;\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[m}\u001b[27;1H\u001b[K\u001b[27;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[27;1H\u001b[?25l\u001b[32;90H^[\u001b[27;1H\u001b[32;90H  \u001b[27;1H\u001b[?25h\u001b[?25l\u001b[32;1H:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b[?2004l\u001b[>4;m\"race13b.c\" [New] 35L, 1254B written\r\u001b"]
