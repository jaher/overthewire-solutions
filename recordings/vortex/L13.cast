[26.558, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#define _GNU_SOURCE\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/uio.h>\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<fcntl.h>\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<errno.h>\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<signal.h>\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m/* rw13: measure whether process_vm_writev can land between the L13\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m   level's exec and its exit at the argc gate.  Spawns the level with\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m   argv={NULL}, writes \u001b[m\u001b[31m4\u001b[m\u001b[34m bytes to the .bss scratch (\u001b[m\u001b[31m0x804c028\u001b[m\u001b[34m) in a\u001b[m\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[34m   tight loop per spawn, counts the successes.  A success means the\u001b[m\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[34m   post-exec window is writable: the argc-slot rewrite becomes\u001b[m\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[34m   possible. */\u001b[m\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mvoid\u001b[m) {\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m tries = \u001b[31m0\u001b[m, ok = \u001b[31m0\u001b[m, eperm = \u001b[31m0\u001b[m, esrch = \u001b[31m0\u001b[m;\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l    \u001b[33mfor\u001b[m (\u001b[32mint\u001b[m run = \u001b[31m0\u001b[m; run < \u001b[31m20\u001b[m; run++) {\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[8Cpid_t pid = fork();\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[33mif\u001b[m (pid == \u001b[31m0\u001b[m) {\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[12C\u001b[32mchar\u001b[m *av[\u001b[31m2\u001b[m] = { \u001b[31mNULL\u001b[m, \u001b[31mNULL\u001b[m };\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[12C\u001b[32mchar\u001b[m *ev[\u001b[31m1\u001b[m] = { \u001b[31mNULL\u001b[m };\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25l\u001b[12Cexecv(\u001b[31m\"/vortex/vortex13\"\u001b[m, av);\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l\u001b[12C_exit(\u001b[31m127\u001b[m);\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H}\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9Htries++;\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[32mchar\u001b[m wbuf[\u001b[31m4\u001b[m] = { \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m };\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[32mstruct\u001b[m iovec l = { wbuf, \u001b[31m4\u001b[m };\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[32mstruct\u001b[m iovec r = { (\u001b[32mvoid\u001b[m *)\u001b[31m0x0804c028\u001b[m, \u001b[31m4\u001b[m };\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[34m/* tight write loop while the level lives */\u001b[m\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[33mfor\u001b[m (;;) {\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;13Herrno = \u001b[31m0\u001b[m;\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;13H\u001b[32mssize_t\u001b[m w = process_vm_writev(pid, &l, \u001b[31m1\u001b[m, &r, \u001b[31m1\u001b[m, \u001b[31m0\u001b[m);\u001b[26;1H\u001b[K\u001b[31;1