[30.178, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/ptrace.h>\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<errno.h>\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<fcntl.h>\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[34m/* race13: measure whether PTRACE_ATTACH can land between the L13\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[34m   level's exec and its exit at the argc gate.  Spawns the level with\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m   argv={NULL} (an empty-argv exec), attaches in a tight loop, records\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m   whether any attach succeeds (it should NEVER: dumpable=\u001b[m\u001b[31m0\u001b[m\u001b[34m blocks the\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m   parent too) and how many runs exit. */\u001b[m\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mint\u001b[m argc, \u001b[32mchar\u001b[m **argv) {\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (argc < \u001b[31m2\u001b[m) { fprintf(\u001b[31mstderr\u001b[m, \u001b[31m\"usage: race13 <stdin-file>\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m); \u001b[33mreturn\u001b[m \u001b[31m2\u001b[m; }\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m in = open(argv[\u001b[31m1\u001b[m], O_RDONLY);\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l    \u001b[32mchar\u001b[m tmp[\u001b[31m128\u001b[m];\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l    snprintf(tmp, \u001b[33msizeof\u001b[m tmp, \u001b[31m\"/tmp/vx13p/stdin.\u001b[m\u001b[35m%d\u001b[m\u001b[31m\"\u001b[m, getpid());\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m out = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, \u001b[31m0644\u001b[m);\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l    \u001b[32mchar\u001b[m b[\u001b[31m256\u001b[m];\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l    \u001b[32mssize_t\u001b[m n = read(in, b, \u001b[33msizeof\u001b[m b);\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l    write(out, b, n);\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l    close(out);\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25l    close(in);\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m tries = \u001b[31m0\u001b[m, attached = \u001b[31m0\u001b[m, exits = \u001b[31m0\u001b[m, eperm = \u001b[31m0\u001b[m;\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[33mfor\u001b[m (\u001b[32mint\u001b[m run = \u001b[31m0\u001b[m; run < \u001b[31m20\u001b[m; run++) {\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9Hpid_t pid = fork();\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                