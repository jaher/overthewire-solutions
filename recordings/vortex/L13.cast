[17.331, "o", "#include <stdio.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/wait.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> /* probe13: re-exec /vortex/vortex13 with argv={NULL}, envp={NULL} and a\r\r\n\u001b[?2004l\r\u001b[?2004h>    stdin payload, so the kernel places the exec path at the bottom of the\r\r\n\u001b[?2004l\r\u001b[?2004h>    stack and main's zeroing loops see no strings.  The argv/envp holes make\r\r\n\u001b[?2004l\r\u001b[?2004h>    argc=0; the stdin payload is read by fgets.  A second invocation with a\r\r\n\u001b[?2004l\r\u001b[?2004h>    flag runs the real probe: this stub execve's the level with the holes\r\r\n\u001b[?2004l\r\u001b[?2004h>    and passes the stdin through a pipe. */\r\r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char **argv, char **envp) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (argc < 3) {\r\r\n\u001b[?2004l\r\u001b[?2004h>         fprintf(stderr, \"usage: probe13 <stdin-file> <out>\\n\");\r\r\n\u001b[?2004l\r\u001b[?2004h>         return 2;\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>     /* read the stdin payload */\r\r\n\u001b[?2004l\r\u001b[?2004h>     static unsigned char in[256];\r\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *f = fopen(argv[1], \"rb\");\r\r\n\u001b[?2004l\r\u001b[?2004h>     size_t n = fread(in, 1, sizeof in, f);\r\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(f);\r\r\n\u001b[?2004l\r\u001b[?2004h>     /* pipe + fork: child = the level with holes, stdin = the payload */\r\r\n\u001b[?2004l\r\u001b[?2004h>     int pfd[2];\r\r\n\u001b[?2004l\r\u001b[?2004h>     pipe(pfd);\r\r\n\u001b[?2004l\r\u001b[?2004h>     write(pfd[1], in, n);   /* payload before the fork: no race */\r\r\n\u001b[?2004l\r\u001b[?2004h>     pid_t pid = fork();\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (pid == 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>         close(pfd[1]);\r\r\n\u001b[?2004l\r\u001b[?2004h>         dup2(pfd[0], 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>         close(pfd[0]);\r\r\n\u001b[?2004l\r\u001b[?2004h>         char *av[2] = { NULL, NULL };\r\r\n\u001b[?2004l\r\u001b[?2004h>         char *ev[1] = { NULL };\r\r\n\u001b[?2004l\r\u001b[?2004h>         execve(\"/vortex/vortex13\", av, ev);\r\r\n\u001b[?2004l\r\u001b[?2004h>         _exit(127);\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>     close(pfd[0]);\r\r\n\u001b[?2004l\r\u001b[?2004h>     close(pfd[1]);\r\r\n\u001b[?2004l\r\u001b[?2004h>     int st = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>     waitpid(pid, &st, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(stderr, \"child exit=%d sig=%d\\n\", WEXITSTATUS(st), WTERMSIG(st));\r\r\n\u001b[?2004l\r\u001b[?2004h>     (void)envp;\r\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\r\n\u001b[?2004l\r\u001b]3008;start=c6e3ea69-76f3-4565-a474-5eae46988d27;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\\u001b]3008;end=c6e3ea69-76f3-4565-a474-5eae46988d27;exit=success\u001b\\\u001b]3008;start=6bd44159-b088-4557-8a2f-1d9dd68f242a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\\u001b[?2004h\u001b]0;vortex13@vortex: /tmp/tmp.vefOqdtqlB\u0007vortex13@vortex:/tmp/tmp.vefOqdtqlB$ "]
[0.181, "o", "gcc -o probe13 probe13.c\r\r\n\u001b[?2004l\r\u001b]3008;start=2359081d-6538-4f2f-a8d5-5a5a23af6886;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\"]
[0.059, "o", "\u001b]3008;end=2359081d-6538-4f2f-a8d5-5a5a23af6886;exit=success\u001b\\\u001b]3008;start=6bd44159-b088-4557-8a2f-1d9dd68f242a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\"]
