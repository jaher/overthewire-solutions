[19.651, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34m#!/usr/bin/env python3\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[34m# xref13 - scan every e8/e9 branch in .text of /vortex/vortex13 and\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[34m# compute its target: find every path to vuln (0x80491d6).\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35mfrom\u001b[m elftools.elf.elffile \u001b[35mimport\u001b[m ELFFile\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35mimport\u001b[m struct\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25lf = \u001b[36mopen\u001b[m(\u001b[31m'/vortex/vortex13'\u001b[m, \u001b[31m'rb'\u001b[m)\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25lelf = ELFFile(f)\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25ltext = elf.get_section_by_name(\u001b[31m'.text'\u001b[m)\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25lcode = text.data()\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25lbase = text[\u001b[31m'sh_addr'\u001b[m]\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25lhits = []\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[33mfor\u001b[m i \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[36mlen\u001b[m(code) - \u001b[31m5\u001b[m):\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m code[i] \u001b[33min\u001b[m (\u001b[31m0xe8\u001b[m, \u001b[31m0xe9\u001b[m):\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[8Crel = struct.unpack(\u001b[31m'<i'\u001b[m, code[i+\u001b[31m1\u001b[m:i+\u001b[31m5\u001b[m])[\u001b[31m0\u001b[m]\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[8Ctgt = base + i + \u001b[31m5\u001b[m + rel\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[8Ckind = \u001b[31m'call'\u001b[m \u001b[33mif\u001b[m code[i] == \u001b[31m0xe8\u001b[m \u001b[33melse\u001b[m \u001b[31m'jmp'\u001b[m\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[33mif\u001b[m tgt == \u001b[31m0x80491d6\u001b[m:\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[12Chits.append((base + i, kind))\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l\u001b[36mprint\u001b[m(\u001b[31m\"branches to vuln (0x80491d6):\"\u001b[m)\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[33mfor\u001b[m a, k \u001b[33min\u001b[m hits:\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l    \u001b[36mprint\u001b[m(\u001b[31m\"  0x%08x %s\"\u001b[m % (a, k))\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[34m# the init_array entry\u001b[m\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25lia = elf.get_section_by_name(\u001b[31m'.init_array'\u001b[m)\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25lval = struct.unpack(\u001b[31m'<I'\u001b[m, ia.data())[\u001b[31m0\u001b[m]\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l\u001b[36mprint\u001b[m(\u001b[31m\".init_array entry: 0x%08x\"\u001b[m % val)\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;1H\u001b[33mfor\u001b[m sym \u001b[33min\u001b[m elf.get_section_by_name(\u001b[31m'.symtab'\u001b[m).iter_symbols():\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;5H\u001b[33mif\u001b[m sym[\u001b[31m'st_value'\u001b[m] == val:\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H\u001b[36mprint\u001b[m(\u001b[31m\"  = %s\"\u001b[m % sym.name)\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[m\u001b[32;1H\u001b[K\u001b[26;1H\u001b[?25l\u001b[32;90H^[\u001b[26;1H\u001b[32;90H  \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[32;1H:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b[?2004l\u001b[>4;m\"xref13.py\" [New] 29L, 988B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=9658b68d-18f3-4e0d-97bb-8dfb1ffea79b;exit=success\u001b\\\u001b]3008;start=b2652a6b-5d1f-4498-987b-0cce482c1b2a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.WOSjIYvWyA\u001b\\\u001b[?2004h\u001b]0;vortex13@vortex: /tmp/tmp.WOSjIYvWyA\u0007vortex13@vortex:/tmp/tmp.WOSjIYvWyA$ "]
