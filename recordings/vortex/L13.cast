[26.691, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/ptrace.h>\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/prctl.h>\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<errno.h>\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[34m/* ptrace13: test whether a dumpable=\u001b[m\u001b[31m0\u001b[m\u001b[34m process can be ptraced without\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[34m   CAP_SYS_PTRACE - even by the same uid.  The child sets PR_SET_DUMPABLE(\u001b[m\u001b[31m0\u001b[m\u001b[34m)\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m   and loops; the parent PTRACE_ATTACHes and reports the errno.  Then the\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m   child resets dumpable to \u001b[m\u001b[31m1\u001b[m\u001b[34m and the parent attaches again: the control. */\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mvoid\u001b[m) {\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l    pid_t pid = fork();\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (pid == \u001b[31m0\u001b[m) {\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[8Cprctl(PR_SET_DUMPABLE, \u001b[31m0\u001b[m);\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[33mfor\u001b[m (;;) pause();\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l    }\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l    sleep(\u001b[31m1\u001b[m);\u001b[24C\u001b[34m/* let the child start */\u001b[m\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m r = ptrace(PTRACE_ATTACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l    printf(\u001b[31m\"attach to dumpable=0 (same uid): rc=\u001b[m\u001b[35m%d\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m,\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[11Cr, strerror(errno));\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (r == \u001b[31m0\u001b[m) ptrace(PTRACE_DETACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25l    kill(pid, \u001b[31m9\u001b[m);\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l    waitpid(pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[27;1H\u001b[K\u001b[27;1H\u001b[?25h\u001b[?25l    \u001b[34m/* control: the same child shape with dumpable=\u001b[m\u001b[31m1\u001b[m\u001b[34m */\u001b[m\u001b[28;1H\u001b[K\u001b[28;1H\u001b[?25h\u001b[?25l    pid = fork();\u001b[29;1H\u001b[K\u001b[29;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (pid == \u001b[31m0\u001b[m) {\u001b[30;1H\u001b[K\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[8Cprctl(PR_SET_DUMPABLE, \u001b[31m1\u001b[m);\u001b[31;1H\u001b[K\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9H\u001b[33mfor\u001b[m (;;) pause();\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H}\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsleep(\u001b[31m1\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Herrno = \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hr = ptrace(PTRACE_ATTACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\u001b[31m\"attach to dumpable=1 (same uid): rc=\u001b[m\u001b[35m%d\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m,\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;12Hr, strerror(errno));\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[33mif\u001b[m (r == \u001b[31m0\u001b[m) ptrace(PTRACE_DETACH, pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hkill(pid, \u001b[31m9\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hwaitpid(pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[34m/* cross-uid control: a dumpable=\u001b[m\u001b[31m1\u001b[m\u001b[34m process owned by a different\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H\u001b[34m       uid cannot be ptraced (the uid rule) - attach from the parent\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H\u001b[34m       to a child that setuid(\u001b[m\u001b[31m0\u001b[m\u001b[34m)-style dropped... the parent cannot\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H\u001b[34m       create a different-uid child without setuid; skip: the uid\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H\u001b[34m       rule is known. */\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[33mreturn\u001b[m \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H}\r\r\n\u001b[?25h\u001b[32;1H\u001b[K\u001b[31;1H\u001b[?25l\u001b[32;90H^[\u001b[31;1H\u001b[32;90H  \u001b[31;1H\u001b[?25h\u001b[?25l\r\r\n:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b[?2004l\u001b[>4;m\""]
[0.000, "o", "ptrace13.c\" [New] 49L, 1625B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=cb31efca-5e75-4864-b5b2-837c0d903053;exit=success\u001b\\\u001b]3008;start=92ad331b-8a79-4170-9a3c-8e158a987600;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.tyotCwyvfm\u001b\\\u001b[?2004h\u001b]0;vortex13@vortex: /tmp/tmp.tyotCwyvfm\u0007vortex13@vortex:/tmp/tmp.tyotCwyvfm$ "]
