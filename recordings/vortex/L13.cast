[0.002, "o", "\u001b]3008;start=55e48b82-98c0-4630-849f-dec7b350811d;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\"]
