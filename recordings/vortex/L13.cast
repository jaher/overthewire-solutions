[0.160, "o", "strace -f -e trace=execve,read,exit_group -o st3.txt ./probe13 in.txt out\r\r\n\u001b[?2004l\r\u001b]3008;start=0b4e45e8-1a9c-41e1-b947-2dc6a433373c;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.vefOqdtqlB\u001b\\"]
