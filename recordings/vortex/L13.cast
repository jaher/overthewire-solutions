[30.504, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#define _GNU_SOURCE\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/uio.h>\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<fcntl.h>\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<errno.h>\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<signal.h>\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m/* pvm13: test process_vm_readv/writev and /proc/<pid>/mem against a\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m   parked setuid child (the L12 level parked in safecode's loop).\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m   Same posture as the ptrace test: the child is setuid (fsuid \u001b[m\u001b[31m5012\u001b[m\u001b[34m),\u001b[m\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[34m   the parent (vortex13) attempts the access. */\u001b[m\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mint\u001b[m argc, \u001b[32mchar\u001b[m **argv) {\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l    \u001b[32mstatic\u001b[m \u001b[32mchar\u001b[m buf[\u001b[31m16384\u001b[m];\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l    \u001b[32mFILE\u001b[m *f = fopen(argv[\u001b[31m1\u001b[m], \u001b[31m\"r\"\u001b[m);\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (!f) \u001b[33mreturn\u001b[m \u001b[31m2\u001b[m;\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l    \u001b[32msize_t\u001b[m n = fread(buf, \u001b[31m1\u001b[m, \u001b[33msizeof\u001b[m buf - \u001b[31m1\u001b[m, f);\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l    fclose(f);\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l    buf[n] = \u001b[31m0\u001b[m;\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l    pid_t pid = fork();\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (pid == \u001b[31m0\u001b[m) {\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[?25l\u001b[8Csleep(\u001b[31m1\u001b[m);\u001b[25;1H\u001b[K\u001b[25;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[32mchar\u001b[m *av[] = { \u001b[31m\"/vortex/vortex12\"\u001b[m, buf, \u001b[31m0\u001b[m };\u001b[26;1H\u001b[K\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9Hexecv(\u001b[31m\"/vortex/vortex12\"\u001b[m, av);\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[25;9H_exit(\u001b[31m127\u001b[m);\u001b[26;1H\u001b[K\u001b[31;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[26;1H\u001b[?25h\u001b[?25l\u001b[m    }\u001b[27;1H\u001b[K\u001b[27;1H\u001b[?25h\u001b[?25l    sleep(\u001b[31m3\u001b[m);\u001b[24C\u001b[34m/* the level parks */\u001b[m\u001b[28;1H\u001b[K\u001b[28;1H\u001b[?25h\u001b[?25l    \u001b[34m/* process_vm_readv: read the parking loop's code area */\u001b[m\u001b[29;1H\u001b[K\u001b[29;1H\u001b[?25h\u001b[?25l    \u001b[32mchar\u001b[m rbuf[\u001b[31m16\u001b[m];\u001b[30;1H\u001b[K\u001b[30;1H\u001b[?25h\u001b[?25l    \u001b[32mstruct\u001b[m iovec local = { rbuf, \u001b[33msizeof\u001b[m rbuf };\u001b[31;1H\u001b[K\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mstruct\u001b[m iovec remote = { (\u001b[32mvoid\u001b[m *)\u001b[31m0x08049260\u001b[m, \u001b[33msizeof\u001b[m rbuf };\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Herrno = \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mssize_t\u001b[m r = process_vm_readv(pid, &local, \u001b[31m1\u001b[m, &remote, \u001b[31m1\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\u001b[31m\"process_vm_readv: \u001b[m\u001b[35m%zd\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m, r, strerror(errno));\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[34m/* process_vm_writev: write \u001b[m\u001b[31m4\u001b[m\u001b[34m bytes to the .bss scratch */\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mchar\u001b[m wbuf[\u001b[31m4\u001b[m] = { \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m, \u001b[31m0x41\u001b[m };\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mstruct\u001b[m iovec l2 = { wbuf, \u001b[31m4\u001b[m };\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mstruct\u001b[m iovec r2 = { (\u001b[32mvoid\u001b[m *)\u001b[31m0x0804c028\u001b[m, \u001b[31m4\u001b[m };\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Herrno = \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hr = process_vm_writev(pid, &l2, \u001b[31m1\u001b[m, &r2, \u001b[31m1\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\u001b[31m\"process_vm_writev: \u001b[m\u001b[35m%zd\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m, r, strerror(errno));\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;"]
[0.001, "o", "32r\u001b[30;5H\u001b[34m/* /proc/<pid>/mem write */\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[m\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mchar\u001b[m mpath[\u001b[31m64\u001b[m];\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsnprintf(mpath, \u001b[33msizeof\u001b[m mpath, \u001b[31m\"/proc/\u001b[m\u001b[35m%d\u001b[m\u001b[31m/mem\"\u001b[m, pid);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Herrno = \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[32mint\u001b[m fd = open(mpath, O_RDWR);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\u001b[31m\"/proc/\u001b[m\u001b[35m%d\u001b[m\u001b[31m/mem open O_RDWR: \u001b[m\u001b[35m%d\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m, pid, fd, strerror(errno));\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[33mif\u001b[m (fd >= \u001b[31m0\u001b[m) {\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Herrno = \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9H\u001b[32mssize_t\u001b[m w = pwrite(fd, wbuf, \u001b[31m4\u001b[m, (\u001b[32moff_t\u001b[m)\u001b[31m0x0804c028\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hprintf(\u001b[31m\"  pwrite: \u001b[m\u001b[35m%zd\u001b[m\u001b[31m errno=\u001b[m\u001b[35m%s\\n\u001b[m\u001b[31m\"\u001b[m, w, strerror(errno));\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hclose(fd);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H}\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hkill(pid, \u001b[31m9\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hwaitpid(pid, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m);\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\u001b[33mreturn\u001b[m \u001b[31m0\u001b[m;\r\r\n\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H}\r\r\n\u001b[?25h\u001b[32;1H\u001b[K\u001b[31;1H\u001b[?25l\u001b[32;90H^[\u001b[31;1H\u001b[32;90H  \u001b[31;1H\u001b[?25h\u001b[?25l\r\r\n:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b[?2004l\u001b[>4;m\"pvm13.c\" [New] 60L, 2045B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=2d56dc9d-4a52-4b0c-b9a3-6024289883a5;exit=success\u001b\\\u001b]3008;start=3c4348fa-c0a0-4e6f-bf92-aa3d5662089e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex13;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.YEo1LviWDZ\u001b\\\u001b[?2004h\u001b]0;vortex13@vortex: /tmp/tmp.YEo1LviWDZ\u0007vortex13@vortex:/tmp/tmp.YEo1LviWDZ$ "]
