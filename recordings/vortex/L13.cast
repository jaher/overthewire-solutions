[38.153, "o", "\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdio.h>\u001b[m\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<stdlib.h>\u001b[m\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<string.h>\u001b[m\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<unistd.h>\u001b[m\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<fcntl.h>\u001b[m\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[35m#ifndef AT_EMPTY_PATH\u001b[m\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[35m#define AT_EMPTY_PATH \u001b[m\u001b[31m0x1000\u001b[m\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[35m#endif\u001b[m\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/syscall.h>\u001b[m\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<spawn.h>\u001b[m\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[35m#include \u001b[m\u001b[31m<sys/wait.h>\u001b[m\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[32mextern\u001b[m \u001b[32mchar\u001b[m **environ;\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m/* exec13: try every exec path against /vortex/vortex13 and report whether\r\r\n * \u001b[m\u001b[14;4H\u001b[K\u001b[32;84H4,4\u001b[14;4H\u001b[?25h\u001b[?25l\u001b[34m   the child reads stdin (i.e. vuln() runs past the argc gate).\r\r\n *    \u001b[m\u001b[15;7H\u001b[K\u001b[32;84H5,7\u001b[15;7H\u001b[?25h\u001b[?25l\u001b[34m   usage: exec13 <mode> <stdin-file>\r\r\n *       \u001b[m\u001b[16;10H\u001b[K\u001b[32;84H6,10\u001b[16;10H\u001b[?25h\u001b[?25l\u001b[34m   modes: execve (argv=NULL), execven (argv={NULL}), execveat (dirfd+empty),\r\r\n *          \u001b[m\u001b[17;13H\u001b[K\u001b[32;84H7,13\u001b[17;13H\u001b[?25h\u001b[?25l\u001b[34m          fexecve (memfd of the binary), posix_spawn (argv={NULL}). */\u001b[m\u001b[18;1H\u001b[K\u001b[32;84H8,1 \u001b[18;1H\u001b[?25h\u001b[?25l\u001b[32mint\u001b[m main(\u001b[32mint\u001b[m argc, \u001b[32mchar\u001b[m **argv) {\r\r\n        \u001b[19;9H\u001b[K\u001b[32;84H9,2-9\u001b[19;9H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (argc < \u001b[31m3\u001b[m) { fprintf(\u001b[31mstderr\u001b[m, \u001b[31m\"usage: exec13 <mode> <stdin-file>\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m); \u001b[33mreturn\u001b[m \u001b[31m2\u001b[m; }\r\r\n            \u001b[20;13H\u001b[K\u001b[32;83H20,6-13\u001b[20;13H\u001b[?25h\u001b[?25l    \u001b[32mconst\u001b[m \u001b[32mchar\u001b[m *mode = argv[\u001b[31m1\u001b[m];\r\r\n                \u001b[21;17H\u001b[K\u001b[32;84H1,3-17\u001b[21;17H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m st = \u001b[31m0\u001b[m;\r\r\n                    \u001b[22;21H\u001b[K\u001b[32;84H2,7-21\u001b[22;21H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m in = open(argv[\u001b[31m2\u001b[m], O_RDONLY);\r\r\n                        \u001b[23;25H\u001b[K\u001b[32;84H3,4-25\u001b[23;25H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (in < \u001b[31m0\u001b[m) { perror(\u001b[31m\"open stdin\"\u001b[m); \u001b[33mreturn\u001b[m \u001b[31m2\u001b[m; }\r\r\n                            \u001b[24;29H\u001b[K\u001b[32;84H4,8-29\u001b[24;29H\u001b[?25h\u001b[?25l    \u001b[32mint\u001b[m pfd[\u001b[31m2\u001b[m];\r\r\n                                \u001b[25;33H\u001b[K\u001b[32;84H5,5-33\u001b[25;33H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m (pipe(pfd) < \u001b[31m0\u001b[m) { perror(\u001b[31m\"pipe\"\u001b[m); \u001b[33mreturn\u001b