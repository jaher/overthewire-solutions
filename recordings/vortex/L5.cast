[7.403, "o", "wc -l crack5.py\r\r\n\u001b[?2004l\r\u001b]3008;start=d8c86e6f-d29b-42ba-9c88-17aeae578ec3;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l5rec\u001b\\29 crack5.py\r\r\n\u001b]3008;end=d8c86e6f-d29b-42ba-9c88-17aeae578ec3;exit=success\u001b\\\u001b]3008;start=854c4456-d8d4-441e-bb85-c088b69b955f;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l5rec\u001b\\\u001b[?2004h\u001b]0;vortex5@vortex: /tmp/l5rec\u0007vortex5@vortex:/tmp/l5rec$ cat -n crack5.py\r\r\n\u001b[?2004l\r\u001b]3008;start=0a62367a-b5f0-4155-bac6-bcda59843289;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l5rec\u001b\\     1\timport hashlib, itertools, string, multiprocessing as mp\r\r\n     2\t\r\r\n     3\tTARGET = bytes.fromhex('155fb95d04287b757c996d77b5ea51f7')\r\r\n     4\tALNUM = string.ascii_letters + string.digits\r\r\n     5\t\r\r\n     6\tdef worker(first):\r\r\n     7\t    # check short lengths for this first letter\r\r\n     8\t    for L in range(1, 5):\r\r\n     9\t        for t in itertools.product(ALNUM, repeat=L-1):\r\r\n    10\t            s = first + ''.join(t)\r\r\n    11\t            if hashlib.md5(s.encode()).digest() == TARGET:\r\r\n    12\t                return s\r\r\n    13\t    # the 5-char space: this first letter + 4 more\r\r\n    14\t    for t in itertools.product(ALNUM, repeat=4):\r\r\n    15\t        s = first + ''.join(t)\r\r\n    16\t        if hashlib.md5(s.encode()).digest() == TARGET:\r\r\n    17\t            return s\r\r\n    18\t    return None\r\r\n    19\t\r\r\n    20\tif __name__ == '__main__':\r\r\n    21\t    with mp.Pool(20) as pool:\r\r\n    22\t        for r in pool.imap_unordered(worker, list(ALNUM)):\r\r\n    23\t            if r:\r\r\n    24\t                print('FOUND:', r)\r\r\n    25\t                pool.terminate()\r\r\n    26\t                break\r\r\n    27\t        else:\r\r\n    28\t            print('not found')\r\r\n    29\t\r\r\n\u001b]3008;end=0a62367a-b5f0-4155-bac6-bcda59843289;exit=success\u001b\\\u001b]3008;start=854c4456-d8d4-441e-bb85-c088b69b955f;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l5rec\u001b\\\u001b[?2004h\u001b]0;vortex5@vortex: /tmp/l5rec\u0007vortex5@vortex:/tmp/l5rec$ exit\r\r\n\u001b[?2004l\r\u001b]3008;start=68cd6200-165d-4481-8fd9-449236649d61;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=vortex5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l5rec\u001b\\logout\r\r\nConnection to vortex.labs.overthewire.org closed.\r\r\r\n\u001b[?2004hclient$ mkdir -p /tmp/l5local && cd /tmp/l5local && rm -f crack5.py\r\r\n\u001b[?2004l\r\u001b[?2004hclient$ vim crack5.py\r\r\n\u001b[?2004l\r"]
