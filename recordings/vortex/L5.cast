[63.473268, "o", "mkdir -p /tmp/l5local && cd /tmp/l5local && rm -f crack5.py\r\r\n\u001b[?2004l\r\u001b[?2004huser@localhost$ "]
[64.772988, "o", "cat > crack5.py <<'CRACKEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.292264, "o", "import hashlib, itertools, string, multiprocessing as mp\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> TARGET = bytes.fromhex('155fb95d04287b757c996d77b5ea51f7')\r\r\n\u001b[?2004l\r\u001b[?2004h> ALNUM = string.ascii_letters + string.digits\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> def worker(first):\r\r\n\u001b[?2004l\r\u001b[?2004h>     # check short lengths for this first letter\r\r\n\u001b[?2004l\r\u001b[?2004h>     for L in range(1, 5):\r\r\n\u001b[?2004l\r\u001b[?2004h>         for t in itertools.product(ALNUM, repeat=L-1):\r\r\n\u001b[?2004l\r\u001b[?2004h>             s = first + ''.join(t)\r\r\n\u001b[?2004l\r\u001b[?2004h>             if hashlib.md5(s.encode()).digest() == TARGET:\r\r\n\u001b[?2004l\r\u001b[?2004h>                 return s\r\r\n\u001b[?2004l\r\u001b[?2004h>     # the 5-char space: this first letter + 4 more\r\r\n\u001b[?2004l\r\u001b[?2004h>     for t in itertools.product(ALNUM, repeat=4):\r\r\n\u001b[?2004l\r\u001b[?2004h>         s = first + ''.join(t)\r\r\n\u001b[?2004l\r\u001b[?2004h>         if hashlib.md5(s.encode()).digest() == TARGET:\r\r\n\u001b[?2004l\r\u001b[?2004h>             return s\r\r\n\u001b[?2004l\r\u001b[?2004h>     return None\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\r\n\u001b[?2004l\r\u001b[?2004h>     with mp.Pool(20) as pool:\r\r\n\u001b[?2004l\r\u001b[?2004h>         for r in pool.imap_unordered(worker, list(ALNUM)):\r\r\n\u001b[?2004l\r\u001b[?2004h>             if r:\r\r\n\u001b[?2004l\r\u001b[?2004h>                 print('FOUND:', r)\r\r\n\u001b[?2004l\r\u001b[?2004h>                 pool.terminate()\r\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\r\n\u001b[?2004l\r\u001b[?2004h>             print('not found')\r\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.111666, "o", "CRACKEOF\r\r\n\u001b[?2004l\r\u001b[?2004huser@localhost$ wc -l crack5.py\r\r\n\u001b[?2004l\r28 crack5.py\r\r\n\u001b[?2004huser@localhost$ "]
[76.684105, "o", "python3 crack5.py\r\r\n\u001b[?2004l\r"]
[77.683398, "o", "FOUND: rlTf6\r\r\n"]
[77.690208, "o", "\u001b[?2004huser@localhost$ "]
[78.163261, "o", "echo -n rlTf6 | md5sum\r\r\n\u001b[?2004l\r155fb95d04287b757c996d77b5ea51f7  -\r\r\n\u001b[?2004huser@localhost$ "]
