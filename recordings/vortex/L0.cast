[0.002, "o", "     1\t#include <stdio.h>\r\n     2\t#include <string.h>\r\n     3\t#include <unistd.h>\r\n     4\t#include <sys/socket.h>\r\n     5\t#include <netinet/in.h>\r\n     6\t#include <arpa/inet.h>\r\n     7\t#include <netdb.h>\r\n     8\t\r\n     9\t/* vortex L0: sum the four uint32s the service sends, send it back */\r\n    10\tint main(void) {\r\n    11\t    int fd, i;\r\n    12\t    struct sockaddr_in sa;\r\n    13\t    unsigned char buf[16];\r\n    14\t    char reply[256];\r\n    15\t    unsigned int v[4], sum = 0;\r\n    16\t    ssize_t n;\r\n    17\t\r\n    18\t    fd = socket(AF_INET, SOCK_STREAM, 0);\r\n    19\t    if (fd < 0) { perror(\"socket\"); return 1; }\r\n    20\t\r\n    21\t    memset(&sa, 0, sizeof(sa));\r\n    22\t    sa.sin_family = AF_INET;\r\n    23\t    sa.sin_port = htons(5842);\r\n    24\t    /* resolve the host name first; inet_pton only takes a literal IP */\r\n    25\t    {\r\n    26\t        struct hostent *he = gethostbyname(\"vortex.labs.overthewire.org\");\r\n    27\t        if (!he) { perror(\"gethostbyname\"); return 1; }\r\n    28\t        memcpy(&sa.sin_addr, he->h_addr_list[0], he->h_length);\r\n    29\t    }\r\n    30\t\r\n    31\t    if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {\r\n    32\t        perror(\"connect\");\r\n    33\t        return 1;\r\n    34\t    }\r\n    35\t\r\n    36\t    n = 0;\r\n    37\t    while (n < 16) {\r\n    38\t        ssize_t r = read(fd, buf + n, 16 - n);\r\n    39\t        if (r <= 0) { perror(\"read\"); return 1; }\r\n    40\t        n += r;\r\n    41\t    }\r\n    42\t\r\n    43\t    for (i = 0; i < 4; i++) {\r\n    44\t        memcpy(&v[i], buf + 4 * i, 4);\r\n    45\t        sum += v[i];\r\n    46\t    }\r\n    47\t\r\n    48\t    printf(\"received: %u %u %u %u\\n\", v[0], v[1], v[2], v[3]);\r\n    49\t    printf(\"sum:      %u (0x%08x)\\n\", sum, sum);\r\n    50\t\r\n    51\t    if (write(fd, &sum, 4) != 4) { perror(\"write\"); return 1; }\r\n    52\t\r\n    53\t    /* the reply can arrive in several chunks: read until the peer closes */\r\n    54\t    memset(reply, 0, sizeof(reply));\r\n    55\t    n = 0;\r\n    56\t    while (n < (ssize_t)sizeof(reply) - 1) {\r\n    57\t        ssize_t r = read(fd, reply + n, sizeof(reply) - 1 - n);\r\n    58\t        if (r <= 0) break;\r\n    59\t        n += r;\r\n    60\t    }\r\n    61\t    reply[n] = 0;\r\n    62\t    printf(\"%s\\n\", reply);\r\n    63\t\r\n    64\t    close(fd);\r\n    65\t    return 0;\r\n    66\t}\r\n    67\t\r\n\r\n$ gcc -Wall -O2 -o v0 v0.c\r\n"]
