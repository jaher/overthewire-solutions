[5.348243, "o", "#include <stdio.h>\r\r\n#include <sys/socket.h>\r\r\n#include <arpa/inet.h>\r\r\n#include <netdb.h>\r\r\n#include <string.h>\r\r\n#include <unistd.h>\r\r\n#include <stdlib.h>\r\r\n#include <signal.h>\r\r\n\r\r\n#define PORT 4091\r\r\n\r\r\nint createsocket(int portno)\r\r\n{\r\r\n  int yes = 1;\r\r\n\tstruct sockaddr_in addr;\r\r\n\tbzero(&addr, sizeof(addr));\r\r\n\taddr.sin_family = AF_INET;\r\r\n\taddr.sin_addr.s_addr = INADDR_ANY;\r\r\n\taddr.sin_port = htons(portno);\r\r\n\t\r\r\n"]
[5.350468, "o", "\u001b]3008;end=84b62bb0-d9a0-44e3-a2f9-8220437836fb;exit=success\u001b\\"]
