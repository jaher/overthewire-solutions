[5.246351, "o", "cat /formulaone/formulaone1.c\r\r\n\u001b[?2004l\r\u001b]3008;start=a4e57026-9d99-4042-b435-99bf335ddfc7;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\"]
[5.248843, "o", "#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <unistd.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n#include <fcntl.h>\r\r\n#include <string.h>\r\r\n\r\r\nint main(int argc, char **argv) {\r\r\n  if (access(argv[1], R_OK) < 0) return 1;\r\r\n  printf(\"Contents:\\n\");\r\r\n  int f = open(argv[1], O_RDONLY);\r\r\n  if(f < 0) return 1;\r\r\n  char c;\r\r\n  while (read(f,&c,1)) write(1,&c,1);\r\r\n  return 0;\r\r\n}\r\r\n"]
[5.264944, "o", "\u001b]3008;end=a4e57026-9d99-4042-b435-99bf335ddfc7;exit=success\u001b\\\u001b]3008;start=a7cbf9e1-515e-4b9a-aa39-d7395f975120;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\\u001b[?2004h\u001b]0;formulaone1@formulaone: ~\u0007formulaone1@formulaone:~$ "]
