[7.364951, "o", "echo '# Writing the racer (heredoc, code visible):'\r\r\n\u001b[?2004l\r"]
[7.366406, "o", "\u001b]3008;start=b56c73e3-5b6d-4718-8b3b-ba6017245a70;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\# Writing the racer (heredoc, code visible):\r\r\n"]
