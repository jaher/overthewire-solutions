[6.394568, "o", "\u001b]3008;start=369e48c7-b49f-4d57-b6f9-53dd371e0dc1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\"]
[6.398727, "o", "#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <unistd.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n#include <fcntl.h>\r\r\n#include <string.h>\r\r\n\r\r\nint main(int argc, char **argv) {\r\r\n  if (access(argv[1], R_OK) < 0) return 1;\r\r\n  printf(\"Contents:\\n\");\r\r\n  int f = open(argv[1], O_RDONLY);\r\r\n  if(f < 0) return 1;\r\r\n  char c;\r\r\n  while (read(f,&c,1)) write(1,&c,1);\r\r\n  return 0;\r\r\n}\r\r\n"]
[6.402529, "o", "\u001b]3008;end=369e48c7-b49f-4d57-b6f9-53dd371e0dc1;exit=success\u001b\\\u001b]3008;start=1103e9f1-e467-408a-b4a1-cc8c9697847e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone1\u001b\\"]
