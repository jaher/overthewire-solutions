[3.00826, "o", "             __                            _                        \r\r\n            / _| ___  _ __ _ __ ___  _   _| | __ _  ___  _ __   ___ \r\r\n           | |_ / _ \\| '__| '_ ` _ \\| | | | |/ _` |/ _ \\| '_ \\ / _ \\\r\r\n           |  _| (_) | |  | | | | | | |_| | | (_| | (_) | | | |  __/\r\r\n           |_|  \\___/|_|  |_| |_| |_|\\__,_|_|\\__,_|\\___/|_| |_|\\___|\r\r\n                                                                    \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rformulaone1@drifter.labs.overthewire.org's password: "]
