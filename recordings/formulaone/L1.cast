[6.222723, "o", "#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <unistd.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n#include <fcntl.h>\r\r\n#include <string.h>\r\r\n\r\r\nint main(int argc, char **argv) {\r\r\n  if (access(argv[1], R_OK) < 0) return 1;\r\r\n  printf(\"Contents:\\n\");\r\r\n  int f = open(argv[1], O_RDONLY);\r\r\n  if(f < 0) return 1;\r\r\n  char c;\r\r\n  while (read(f,&c,1)) write(1,&c,1);\r\r\n  return 0;\r\r\n}\r\r\n"]
