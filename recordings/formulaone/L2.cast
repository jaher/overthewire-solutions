[6.946842, "o", "cat /formulaone/formulaone2_src/formulaone2.c\r\r\n\u001b[?2004l\r\u001b]3008;start=ddf569cc-c08c-439d-867d-92e833147db3;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\"]
[6.956877, "o", "#include <stdio.h>\r\r\n\r\r\nchar *mytmpnam(char *s);\r\r\n\r\r\nint main(int argc, char *argv[]){\r\r\n  char buf[256];\r\r\n  FILE *f = fopen(mytmpnam(NULL),\"r\");\r\r\n  fgets(buf, sizeof(buf), f);\r\r\n  fwrite(buf, sizeof(buf), 1, stdout);\r\r\n  return 0;\r\r\n}\r\r\n\u001b]3008;end=ddf569cc-c08c-439d-867d-92e833147db3;exit=success\u001b\\\u001b]3008;start=8a9af750-0b24-4ff6-b58a-1462bd9feb9d;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\"]
[6.958832, "o", "\u001b[?2004h\u001b]0;formulaone2@formulaone: ~\u0007formulaone2@formulaone:~$ "]
[7.13801, "o", "cat /formulaone/formulaone2_src/tmpnam.c\r\r\n"]
[7.138913, "o", "\u001b[?2004l\r\u001b]3008;start=c6f349a2-c6b2-41b8-8f97-3b18de56d2f4;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\"]
[7.145082, "o", "#include <stdio.h>\r\r\n#include <string.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n#include <unistd.h>\r\r\n#include <stdlib.h>\r\r\n\r\r\n#define PREFIX \"/tmp/tmp_\"\r\r\n#define RNDLEN 4\r\r\n\r\r\nchar mytmpnam_buffer[100];\r\r\n\r\r\nchar *mytmpnam(char *s) {\r\r\n    int i, seed, result, prefixlen = strlen(PREFIX);\r\r\n    FILE *in;\r\r\n    struct stat st;\r\r\n\r\r\n    if(!(in = fopen(\"/dev/urandom\", \"r\"))) return NULL;\r\r\n    fread(&seed, sizeof(seed), 1, in);\r\r\n    fclose(in);\r\r\n    srand(seed);\r\r\n\r\r\n    while(1) {\r\r\n\tstrcpy(mytmpnam_buffer, PREFIX);\r\r\n        for(i = prefixlen; i < prefixlen + RNDLEN; i++) {\r\r\n            mytmpnam_buffer[i] = 'a' + (rand() % 26);\r\r\n\t}\r\r\n\tmytmpnam_buffer[i] = 0;\r\r\n\r\r\n\tif(stat(mytmpnam_buffer, &st) != 0) return mytmpnam_buffer;\r\r\n    }\r\r\n\r\r\n    return NULL;\r\r\n}\r\r\n\r\r\n#ifdef MAIN\r\r\nvoid main() {\r\r\n   printf(\"%s\\n\", mytmpnam(NULL));\r\r\n}\r\r\n#endif\r\r\n"]
[7.152513, "o", "\u001b]3008;end=c6f349a2-c6b2-41b8-8f97-3b18de56d2f4;exit=success\u001b\\"]
[7.153578, "o", "\u001b]3008;start=8a9af750-0b24-4ff6-b58a-1462bd9feb9d;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\"]
