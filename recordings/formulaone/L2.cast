[6.760621, "o", "echo '# Formula One L2: /formulaone/formulaone2 (setuid formulaone2), source group-readable:'\r\r\n\u001b[?2004l\r\u001b]3008;start=0bd2871b-0c60-4c1c-8d65-35a085ede8d1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\# Formula One L2: /formulaone/formulaone2 (setuid formulaone2), source group-readable:\r\r\n\u001b]3008;end=0bd2871b-0c60-4c1c-8d65-35a085ede8d1;exit=success\u001b\\\u001b]3008;start=8a9af750-0b24-4ff6-b58a-1462bd9feb9d;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone2\u001b\\"]
