[6.470538, "o", "/*'09 codegate chal\r\r\nPROVE YOUR MIGHT\r\r\n*/\r\r\n#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <string.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/shm.h>\r\r\n#include <time.h>\r\r\n\r\r\nunsigned int keys[] = {0xADCADC00, 0xADC00ADC, 0x00ADCADC, 0x0ADCADC0};\r\r\nunsigned int SHMKEY;\r\r\n\r\r\nstruct msg {\r\r\n  int sz;\r\r\n  char ptr[1024];\r\r\n} msg;\r\r\n\r\r\nstruct msg *echo;\r\r\n\r\r\nvoid doecho(){\r\r\n  int shmid;\r\r\n  char buf[256];\r\r\n  shmid = shmget(SHMKEY, 8192, IPC_CREAT | 0777);\r\r\n  echo = shmat(shmid, NULL, SHM_EXEC);\r\r\n\r\r\n  if( echo->sz ) {\r\r\n    if( echo->sz < sizeof(buf)) {\r\r\n      printf(\"The msg is...\\n\");\r\r\n      memcpy(buf, echo->ptr, echo->sz);\r\r\n      printf(\"%s\\n\",buf);\r\r\n    }\r\r\n  }\r\r\n\r\r\n}\r\r\n\r\r\nint main(int argc, char *argv[]){\r\r\n  if(!argv[1])return 0;\r\r\n  SHMKEY= keys[argv[1][0]&3];\r\r\n  doecho();\r\r\n}\r\r\n"]
[6.476544, "o", "\u001b]3008;end=697d462c-2289-4994-afe2-f8d254b7bd66;exit=success\u001b\\"]
