[5.954185, "o", "echo '--- The shm is mapped SHM_EXEC (RWX) at a fixed address (ASLR off): the ret slot'\r\r\n\u001b[?2004l\r\u001b]3008;start=cdc30dc8-6e5a-430a-b725-04040c6a8fcb;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\"]
