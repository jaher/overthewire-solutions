[5.194703, "o", "cat /formulaone/formulaone3.c\r\r\n\u001b[?2004l\r\u001b]3008;start=a06d6f17-ad47-483f-ab8a-427348d30f80;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\"]
[5.197158, "o", "/*'09 codegate chal\r\r\nPROVE YOUR MIGHT\r\r\n*/\r\r\n#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <string.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/shm.h>\r\r\n#include <time.h>\r\r\n\r\r\nunsigned int keys[] = {0xADCADC00, 0xADC00ADC, 0x00ADCADC, 0x0ADCADC0};\r\r\nunsigned int SHMKEY;\r\r\n\r\r\nstruct msg {\r\r\n  int sz;\r\r\n  char ptr[1024];\r\r\n} msg;\r\r\n\r\r\nstruct msg *echo;\r\r\n\r\r\nvoid doecho(){\r\r\n  int shmid;\r\r\n  char buf[256];\r\r\n  shmid = shmget(SHMKEY, 8192, IPC_CREAT | 0777);\r\r\n  echo = shmat(shmid, NULL, SHM_EXEC);\r\r\n\r\r\n  if( echo->sz ) {\r\r\n    if( echo->sz < sizeof(buf)) {\r\r\n      printf(\"The msg is...\\n\");\r\r\n      memcpy(buf, echo->ptr, echo->sz);\r\r\n      printf(\"%s\\n\",buf);\r\r\n    }\r\r\n  }\r\r\n\r\r\n}\r\r\n\r\r\nint main(int argc, char *argv[]){\r\r\n  if(!argv[1])return 0;\r\r\n  SHMKEY= keys[argv[1][0]&3];\r\r\n  doecho();\r\r\n}\r\r\n"]
[5.204112, "o", "\u001b]3008;end=a06d6f17-ad47-483f-ab8a-427348d30f80;exit=success\u001b\\\u001b]3008;start=d5dfa2da-6841-4633-8fe5-de04e6e6fc06;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\"]
[5.206827, "o", "\u001b[?2004h\u001b]0;formulaone3@formulaone: ~\u0007formulaone3@formulaone:~$ "]
[5.382516, "o", "echo '--- doecho reads echo->sz TWICE: once for the check (cmp 0xff) and once for'\r\r\n\u001b[?2004l\r"]
[5.38605, "o", "\u001b]3008;start=6eb82022-665a-4cb8-840a-1b7437e61af5;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\--- doecho reads echo->sz TWICE: once for the check (cmp 0xff) and once for\r\r\n"]
[5.387509, "o", "\u001b]3008;end=6eb82022-665a-4cb8-840a-1b7437e61af5;exit=success\u001b\\\u001b]3008;start=d5dfa2da-6841-4633-8fe5-de04e6e6fc06;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\"]
[5.392773, "o", "\u001b[?2004h\u001b]0;formulaone3@formulaone: ~\u0007formulaone3@formulaone:~$ "]
[5.577517, "o", "echo '--- memcpy. A toggler flips sz between 10 and 0x400 in our 0777 shm segment;'\r\r\n\u001b[?2004l\r\u001b]3008;start=eafc198a-e921-4af8-803f-e012684ebea1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\--- memcpy. A toggler flips sz between 10 and 0x400 in our 0777 shm segment;\r\r\n"]
[5.57964, "o", "\u001b]3008;end=eafc198a-e921-4af8-803f-e012684ebea1;exit=success\u001b\\\u001b]3008;start=d5dfa2da-6841-4633-8fe5-de04e6e6fc06;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\"]
[5.584218, "o", "\u001b[?2004h\u001b]0;formulaone3@formulaone: ~\u0007formulaone3@formulaone:~$ "]
[5.761891, "o", "echo '--- when the check sees 10 but memcpy sees 0x400, 1KB of our shm smears the stack.'\r\r\n\u001b[?2004l\r"]
[5.766513, "o", "\u001b]3008;start=77599a0b-d8ab-4592-a8ab-038a8f479ef9;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=formulaone3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/formulaone3\u001b\\--- when the check sees 10 but memcpy sees 0x400, 1KB of our shm smears the stack.\r\r\n\u001b]3008;end=77599a0b-d8ab-4592-a8ab-038a8f479ef9;exit=success\u001b\\"]
