[0.000, "o", "\r\r\n 8049279:\tmov    %eax,-0x304(%ebp)\r\r\n 804927f:\tpush   $0x804a008\r\r\n 8049284:\tpush   $0x804a00a\r\r\n 8049289:\tcall   80490e0 <fopen@plt>\r\r\n 804928e:\tadd    $0x8,%esp\r\r\n 8049291:\tmov    %eax,0x804c18c\r\r\n 8049296:\tpush   $0x804a014\r\r\n 804929b:\tcall   80490b0 <puts@plt>\r\r\n 80492a0:\tadd    $0x4,%esp\r\r\n 80492a3:\tmov    0x804c180,%eax\r\r\n 80492a8:\tpush   %eax\r\r\n 80492a9:\tpush   $0x100\r\r\n 80492ae:\tlea    -0x100(%ebp),%eax\r\r\n 80492b4:\tpush   %eax\r\r\n 80492b5:\tcall   8049070 <fgets@plt>\r\r\n 80492ba:\tadd    $0xc,%esp\r\r\n 80492bd:\ttest   %eax,%eax\r\r\n 80492bf:\tjne    80492c8 <log_winner+0x62>\r\r\n 80492c1:\tpush   $0x1\r\r\n 80492c3:\tcall   80490c0 <exit@plt>\r\r\n 80492c8:\tlea    -0x300(%ebp),%eax\r\r\n 80492ce:\tpush   %eax\r\r\n 80492cf:\tlea    -0x200(%ebp),%eax\r\r\n 80492d5:\tpush   %eax\r\r\n 80492d6:\tpush   $0x804a02c\r\r\n 80492db:\tlea    -0x100(%ebp),%eax\r\r\n 80492e1:\tpush   %eax\r\r\n 80492e2:\tcall   8049060 <__isoc23_sscanf@plt>\r\r\n 80492e7:\tadd    $0x10,%esp\r\r\n 80492ea:\tlea    -0x304(%ebp),%eax\r\r\n 80492f0:\tpush   %eax\r\r\n 80492f1:\tcall   80490a0 <ctime@plt>\r\r\n 80492f6:\tadd    $0x4,%esp\r\r\n 80492f9:\tlea    -0x300(%ebp),%edx\r\r\n 80492ff:\tpush   %edx\r\r\n 8049300:\tlea    -0x200(%ebp),%edx\r\r\n 8049306:\tpush   %edx\r\r\n 8049307:\tpush   %eax\r\r\n 8049308:\tpush   $0x804a038\r\r\n 804930d:\tlea    -0x100(%ebp),%eax\r\r\n 8049313:\tpush   %eax\r\r\n 8049314:\tcall   8049120 <sprintf@plt>\r\r\n 8049319:\tadd    $0x14,%esp\r\r\n 804931c:\tmov    0x804c18c,%eax\r\r\n 8049321:\tpush   %eax\r\r\n 8049322:\tlea    -0x100(%ebp),%eax\r\r\n 8049328:\tpush   %eax\r\r\n 8049329:\tcall   8049140 <fputs@plt>\r\r\n 804932e:\tadd    $0x8,%esp\r\r\n 8049331:\tmov    0x804c18c,%eax\r\r\n 8049336:\tpush   %eax\r\r\n 8049337:\tcall   8049080 <fclose@plt>\r\r\n 804933c:\tadd    $0x4,%esp\r\r\n 804933f:\tnop\r\r\n 8049340:\tleave\r\r\n 8049341:\tret\r\r\n\r\r\n\u001b]3008;end=b5a8f6b3-8366-4726-8fb6-ed811d1e27bc;exit=success\u001b\\\u001b]3008;start=9b5ceb78-44cf-4353-b563-700385db1030;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage4\u001b\\\u001b[?2004h\u001b]0;manpage4@manpage: ~\u0007manpage4@manpage:~$ ln -sf /etc/manpage_pass/manpage5 /tmp/x && ls -la /tmp/x\r\r\n\u001b[?2004l\r\u001b]3008;start=b141c781-98e2-4faf-957e-dfcab06e7b1f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage4\u001b\\lrwxrwxrwx 1 manpage4 manpage4 26 Nov 27 23:24 \u001b[0m\u001b[01;36m/tmp/x\u001b[0m -> /etc/manpage_pass/manpage5\r\r\n\u001b]3008;end=b141c781-98e2-4faf-957e-dfcab06e7b1f;exit=success\u001b\\\u001b]3008;start=9b5ceb78-44cf-4353-b563-700385db1030;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage4\u001b\\\u001b[?2004h\u001b]0;manpage4@manpage: ~\u0007manpage4@manpage:~$ "]
