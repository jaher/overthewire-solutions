[6.275906, "o", "id\r\r\n\u001b[?2004l\r\u001b]3008;start=61737ccd-4daf-41f6-bf9a-9890c4553a9f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage2\u001b\\uid=17002(manpage2) gid=17002(manpage2) groups=17002(manpage2)\r\r\n\u001b]3008;end=61737ccd-4daf-41f6-bf9a-9890c4553a9f;exit=success\u001b\\\u001b]3008;start=6686f1ad-60a2-41f8-9b40-1401474b9192;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage2\u001b\\\u001b[?2004h\u001b]0;manpage2@manpage: ~\u0007manpage2@manpage:~$ cat /manpage/manpage2.c\r\r\n\u001b[?2004l\r\u001b]3008;start=8da583e2-6053-4698-9a50-18f74ce3c0e6;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage2\u001b\\#include <stdio.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n#include <fcntl.h>\r\r\n#include <unistd.h>\r\r\n#include <string.h>\r\r\n#include <stdlib.h>\r\r\n\r\r\n#define PWFILE \"/etc/manpage_pass/manpage3\"\r\r\n\r\r\nint main(int argc, char *argv[])\r\r\n{\r\r\n    FILE *f;\r\r\n    char *p;\r\r\n    char pass[32];\r\r\n    char buf[2];\r\r\n\r\r\n    f = fopen(PWFILE, \"r\");\r\r\n    fgets(pass, sizeof pass, f);\r\r\n    pass[strlen(pass)-1] = '\\0';\r\r\n\r\r\n    p = getpass(\"password: \");\r\r\n\r\r\n    if(!strcmp(p, pass))\r\r\n    {\r\r\n        system(\"sh\");\r\r\n        exit(0);\r\r\n    }\r\r\n\r\r\n    setuid(getuid()); /* dont need privs anymore */\r\r\n\r\r\n    if(!argv[1])\r\r\n    {\r\r\n        argv[1] = buf;\r\r\n        buf[0] = '\\0';\r\r\n    }\r\r\n\r\r\n    if( argv[1][0]++ >= 2) exit(0);\r\r\n\r\r\n    argv[1][1] = '\\0';\r\r\n    execl(argv[0], argv[0], argv[1], 0); /* restart */\r\r\n    return 0;\r\r\n}\r\r\n\u001b]3008;end=8da583e2-6053-4698-9a50-18f74ce3c0e6;exit=success\u001b\\\u001b]3008;start=6686f1ad-60a2-41f8-9b40-1401474b9192;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage2\u001b\\\u001b[?2004h\u001b]0;manpage2@manpage: ~\u0007manpage2@manpage:~$ mkdir -p /tmp/mp2b && cd /tmp/mp2b\r\r\n\u001b[?2004l\r\u001b]3008;start=bc9fc5c3-65d9-46c5-8a0a-883d9c28c5e9;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage2\u001b\\\u001b]3008;end=bc9fc5c3-65d9-46c5-8a0a-883d9c28c5e9;exit=success\u001b\\\u001b]3008;start=6686f1ad-60a2-41f8-9b40-1401474b9192;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/mp2b\u001b\\\u001b[?2004h\u001b]0;manpage2@manpage: /tmp/mp2b\u0007manpage2@manpage:/tmp/mp2b$ "]
