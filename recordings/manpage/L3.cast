[7.089446, "o", "id\r\r\n\u001b[?2004l\r\u001b]3008;start=d878cfdc-e278-43d6-baaa-ab93e896981f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\uid=17003(manpage3) gid=17003(manpage3) groups=17003(manpage3)\r\r\n\u001b]3008;end=d878cfdc-e278-43d6-baaa-ab93e896981f;exit=success\u001b\\\u001b]3008;start=7fbcf728-0c66-4404-92df-587b51807905;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\\u001b[?2004h\u001b]0;manpage3@manpage: ~\u0007manpage3@manpage:~$ cat /manpage/manpage3.c\r\r\n\u001b[?2004l\r\u001b]3008;start=f4e085c4-0d29-40b5-8a12-6e99dfdf5811;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <fcntl.h>\r\r\n#include <unistd.h>\r\r\n#include <sys/types.h>\r\r\n#include <string.h>\r\r\n\r\r\n#define PASS_PATH \"/manpage/manpage3-pw/password\"\r\r\n\r\r\nint main()\r\r\n{\r\r\n    int rfd = open(PASS_PATH, O_RDONLY);\r\r\n    char buf[256];\r\r\n    char buf2[256];\r\r\n    memset(buf, '\\0', sizeof buf);\r\r\n    memset(buf2, '\\0', sizeof buf2);\r\r\n    read(rfd, buf2, sizeof buf);\r\r\n    fgets(buf, sizeof buf, stdin);\r\r\n\r\r\n    if (!strcmp(buf, buf2))\r\r\n    {\r\r\n        printf(\"Wow, you should play the lottery!\\n\");\r\r\n        setreuid(geteuid(), geteuid());\r\r\n        system(\"/bin/sh\");\r\r\n    }\r\r\n    return 0;\r\r\n}\r\r\n\u001b]3008;end=f4e085c4-0d29-40b5-8a12-6e99dfdf5811;exit=success\u001b\\\u001b]3008;start=7fbcf728-0c66-4404-92df-587b51807905;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\\u001b[?2004h\u001b]0;manpage3@manpage: ~\u0007manpage3@manpage:~$ cat /manpage/manpage3-reset.c\r\r\n\u001b[?2004l\r\u001b]3008;start=ce12c47a-d8bc-4cce-af52-443dc26d1eaa;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\/* reset-password */\r\r\n#include <stdio.h>\r\r\n#include <unistd.h>\r\r\n#include <fcntl.h>\r\r\n#include <sys/types.h>\r\r\n#include <sys/stat.h>\r\r\n\r\r\n#define PASS_PATH \"/manpage/manpage3-pw/password\"\r\r\n\r\r\nint main()\r\r\n{\r\r\n    FILE *wf;\r\r\n    FILE *rf;\r\r\n    wf = fopen(PASS_PATH, \"w\");\r\r\n    rf = fopen(\"/dev/urandom\", \"r\");\r\r\n    char buf[256];\r\r\n\r\r\n\tsetreuid(geteuid(), geteuid());\r\r\n\r\r\n    fread(buf, 1, sizeof buf, rf);\r\r\n    fwrite(buf, 1, sizeof buf, wf);\r\r\n    return 0;\r\r\n}\r\r\n\u001b]3008;end=ce12c47a-d8bc-4cce-af52-443dc26d1eaa;exit=success\u001b\\\u001b]3008;start=7fbcf728-0c66-4404-92df-587b51807905;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\\u001b[?2004h\u001b]0;manpage3@manpage: ~\u0007manpage3@manpage:~$ "]
