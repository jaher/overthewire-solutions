[2.974429, "o", "                   _            _       _   _                 \r\r\n                  | | _____   _(_) __ _| |_| |__   __ _ _ __  \r\r\n                  | |/ _ \\ \\ / / |/ _` | __| '_ \\ / _` | '_ \\ \r\r\n                  | |  __/\\ V /| | (_| | |_| | | | (_| | | | |\r\r\n                  |_|\\___| \\_/ |_|\\__,_|\\__|_| |_|\\__,_|_| |_|\r\r\n                                                              \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rleviathan5@leviathan.labs.overthewire.org's password: "]
