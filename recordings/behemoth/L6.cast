[0.000, "o", "\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hcontinue\u001b[32;83H\u001b[K\u001b[32;83H52,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Htry:\u001b[32;83H\u001b[K\u001b[32;83H53,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hdata = os.read(master, 4096)\u001b[32;83H\u001b[K\u001b[32;83H54,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hexcept OSError:\u001b[32;83H\u001b[K\u001b[32;83H55,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H56,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif not data:\u001b[32;83H\u001b[K\u001b[32;83H57,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H58,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hout += data\u001b[32;83H\u001b[K\u001b[32;83H59,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.write(1, out)\u001b[32;83H\u001b[K\u001b[32;83H60,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Htry:\u001b[32;83H\u001b[K\u001b[32;83H61,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.waitpid(pid, 0)\u001b[32;83H\u001b[K\u001b[32;83H62,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hexcept ChildProcessError:\u001b[32;83H\u001b[K\u001b[32;83H63,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpass\u001b[32;83H\u001b[K\u001b[32;83H64,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"\\nB6\" + \"DONE\", flush=True)\u001b[32;83H\u001b[K\u001b[32;83H65,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H65,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_behemoth6.py\" [New] 65L, 2059B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=c6635be8-5c09-4309-8ab7-a6bdba2fd34f;exit=success\u001b\\\u001b]3008;start=a3c9587c-cac4-421b-ac6a-cd2c9ba3654a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth6\u001b\\\u001b[?2004h\u001b]0;behemoth6@behemoth: ~\u0007behemoth6@behemoth:~$ $ python3 /tmp/e_behemoth6.py\r\n"]
