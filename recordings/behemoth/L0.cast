[0.005, "o", "$ memfrob XORs each byte with 42 (0x2A). Decode \"OK^GSYBEX^Y\":\r\n$ ssh behemoth0@behemoth.labs.overthewire.org -p 2221 python3 -c \"print(bytes(c^42 for c in bytes.fromhex(\\\"4f4b5e4753594245585e59\\\")))\"\r\n"]
