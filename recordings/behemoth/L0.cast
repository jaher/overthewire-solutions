[0.000, "o", "$ objdump: the secret is built from three movl immediates at -0x55(%ebp):\r\n$   0x475e4b4f 0x45425953 0x00595e58  ->  \"OK^GSYBEX^Y\"\r\n$   then memfrob(secret, strlen) and strcmp(secret, input)\r\n$ ssh behemoth0@behemoth.labs.overthewire.org -p 2221 objdump -d --no-show-raw-insn /behemoth/behemoth0 | sed -n \"/<main>:/,/strcmp/p\" | head -25\r\n"]
