[0.003, "o", "$ ssh behemoth4@behemoth.labs.overthewire.org -p 2221   # password ABTmcqez7l\r\n$ objdump: sprintf(buf,\"/tmp/%d\",getpid()); fopen(buf,\"r\"); sleep(1);\r\n$   then putchar() every byte of the file\r\n$ write /tmp/e_behemoth4.py in vim: fork first so we know the child pid,\r\n$   symlink /tmp/<child pid> -> /etc/behemoth_pass/behemoth5, child execs it\r\n"]
