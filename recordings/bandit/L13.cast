[2.974438, "o", "                         _                     _ _ _   \r\r\n                        | |__   __ _ _ __   __| (_) |_ \r\r\n                        | '_ \\ / _` | '_ \\ / _` | | __|\r\r\n                        | |_) | (_| | | | | (_| | | |_ \r\r\n                        |_.__/ \\__,_|_| |_|\\__,_|_|\\__|\r\r\n                                                       \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rbandit13@bandit.labs.overthewire.org's password: "]
