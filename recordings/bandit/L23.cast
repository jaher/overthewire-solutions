[0.003, "o", "@reboot bandit24 /usr/bin/cronjob_bandit24.sh &> /dev/null\r\r\n* * * * * bandit24 /usr/bin/cronjob_bandit24.sh &> /dev/null\r\r\n\u001b]3008;end=f5e40989-40ce-4bb4-b88d-f95d02c7f35e;exit=success\u001b\\"]
