[9.045496, "o", "cat /usr/bin/cronjob_bandit24.sh\r\r\n\u001b[?2004l\r\u001b]3008;start=006a18c4-d7b4-41ce-bdb2-1a3733c26a9a;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=bandit23;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/bandit23\u001b\\"]
[9.050575, "o", "#!/bin/bash\r\r\n\r\r\nshopt -s nullglob\r\r\n\r\r\nmyname=$(whoami)\r\r\n\r\r\ncd /var/spool/\"$myname\"/foo || exit \r\r\necho \"Executing and deleting all scripts in /var/spool/$myname/foo:\"\r\r\nfor i in * .*;\r\r\ndo\r\r\n    if [ \"$i\" != \".\" ] && [ \"$i\" != \"..\" ];\r\r\n    then\r\r\n        echo \"Handling $i\"\r\r\n        owner=\"$(stat --format \"%U\" \"./$i\")\"\r\r\n        if [ \"${owner}\" = \"bandit23\" ] && [ -f \"$i\" ]; then\r\r\n            timeout -s 9 60 \"./$i\"\r\r\n        fi\r\r\n        rm -rf \"./$i\"\r\r\n    fi\r\r\ndone"]
[9.054908, "o", "\u001b]3008;end=006a18c4-d7b4-41ce-bdb2-1a3733c26a9a;exit=success\u001b\\\u001b]3008;start=32828722-0031-4018-97d5-e3728d901f9d;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=bandit23;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/bandit23\u001b\\"]
[9.058078, "o", "\u001b[?2004h\u001b]0;bandit23@bandit: ~\u0007bandit23@bandit:~$ "]
[9.231221, "o", "ls -ld /var/spool/bandit24/foo\r\r\n"]
