[15.565063, "o", "\u001b[>c\u001b[1;1H\u001b[34m#!/usr/bin/python\r\r\n# level2_alt is Caesar-shifted; print all 25 non-trivial shifts\u001b[m\r\r\nct = \"\u001b[31mBPMXIAAEWZLGWCIZMTWWSQVONWZQAXQHQXUESMK\u001b[m\"\r\r\n\u001b[33mfor\u001b[m k \u001b[33min\u001b[m range(1, 26):\r\r\n    pt = \"\"\r\r\n    \u001b[33mfor\u001b[m c \u001b[33min\u001b[m ct:\u001b[7;9H\u001b[33mif\u001b[m c.isalpha():\u001b[8;13Hbase = 65\u001b[9;13H\u001b[33mif\u001b[m \u001b[33mnot\u001b[m c.isupper():\u001b[10;17Hbase = 97\u001b[11;13Hpt = pt + chr((ord(c) - base - k) % 26 + base)\u001b[12;9H\u001b[33melse\u001b[m:\u001b[13;13Hpt = pt + c\r\r\n    \u001b[33mprint\u001b[m k, pt\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[34;1H~                                                                                                   \u001b[35;1H~                                                                                                   \u001b[36;1H~                                                                                                   \u001b[37;1H~                                                                                                   \u001b[38;1H~                                                                                                   \u001b[39;1H~                                                                                                   \u001b[m\u001b[40;83H15,0-1\u001b[8CAll\u001b[15;1H\u001b[?12l\u001b[?25h"]
[27.276782, "o", "\u0007\u001b[?25l\u001b[40;1H\u001b[K\u001b[40;1H:set noai nocin nosi indentexpr=\r\u001b[82C15,0-1\u001b[8CAll\u001b[15;1H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[40;84H,1   \u001b[1;1H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[m\u001b[40;1H--No lines in buffer--\u001b[40;23H\u001b[K\u001b[40;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[40;1H\u001b[1m-- INSER