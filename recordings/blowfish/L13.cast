[210.988841, "o", "#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n\r\r\nint main(int argc, char *argv[]) {\r\r\n\r\r\n  char  *data1 = malloc(250);\r\r\n  char  *data2 = malloc(250);\r\r\n  int   i;\r\r\n\r\r\n  if(argc)\r\r\n    return -1;\r\r\n\r\r\n  if(strlen(argv[1]) > 48)\r\r\n    if(\r\r\n      ((unsigned char) argv[1][48] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][49] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][50] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][51] == 0x90)  &&\r\r\n      ((unsigned char) argv[2][38] == 0xde)  &&\r\r\n      ((unsigned char) argv[2][39] == 0xad)  &&\r\r\n      ((unsigned char) argv[2][40] == 0xbe)  &&\r\r\n      ((unsigned char) argv[2][41] == 0xef)  &&\r\r\n      ((unsigned char) argv[2][48] == 0xba)  &&\r\r\n      ((unsigned char) argv[2][49] == 0xdc)  &&\r\r\n      ((unsigned char) argv[2][50] == 0x0d)  &&\r\r\n      ((unsigned char) argv[2][51] == 0xed)  &&\r\r\n      ((unsigned char) argv[1][58] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][59] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][60] == 0x90)  &&\r\r\n      ((unsigned char) argv[1][61] == 0x90)\r\r\n    ) {\r\r\n      strcpy(data1, argv[1]);\r\r\n\r\r\n      printf(\"Dumping data buffer 1:\\n\\n\");\r\r\n\r\r\n      for(i = 0; i < strlen(data1); i++) {\r\r\n        printf(\"[%02x]\", data1[i]);\r\r\n      }\r\r\n\r\r\n      printf(\"\\n\\n\");\r\r\n\r\r\n      printf(\"Dumping data buffer 2:\\n\\n\");\r\r\n\r\r\n      for(i = 0; i < strlen(data1); i++) {\r\r\n        printf(\"[%02x]\", data1[i]);\r\r\n      }\r\r\n\r\r\n      printf(\"\\n\\n\");\r\r\n\r\r\n      free(data1);\r\r\n\r\r\n    }\r\r\n}\r\r\n\u001b[01;31mlevel13\u001b[01;32m@\u001b[01;36mblowfish \u001b[01;32m~ \u001b[01;35m$ \u001b[00m"]
