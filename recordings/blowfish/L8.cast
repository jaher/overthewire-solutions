[9.586394, "o", "cat /levels/level8.c\r\r\n #include <stdio.h>\r\r\n#include <string.h>\r\r\n\r\r\nint main(int argc, char *argv[]) {\r\r\n\r\r\n  char  buffer[64];\r\r\n  char  *pointer = \"changeme\";\r\r\n\r\r\n  if(argc < 3)\r\r\n    return -1;\r\r\n\r\r\n  strncpy(buffer, argv[3], sizeof(buffer)-1);\r\r\n\r\r\n  printf(\"\\n\\tpointer: \");\r\r\n  printf(pointer);\r\r\n\r\r\n  printf(\"\\n\\tinput: \");\r\r\n  printf(buffer);\r\r\n  printf(\"\\n\\n\");\r\r\n\r\r\n  return 0;\r\r\n}\r\r\nlevel8@blowfish:~$ "]
[9.75047, "o", "objdump -d --no-show-raw-insn /levels/level8 | sed -n '/<main>:/,/ret/p'\r\r\n"]
