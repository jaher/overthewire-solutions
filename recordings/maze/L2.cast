[17.557, "o", "\u001b[?25l\u001b[32;1H\u001b[K\u001b[32;1H:set paste noai nosi nocindent\r\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[32;90Hi\u001b[1;1H\u001b[32;90H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT (paste) --\u001b[m\u001b[32;22H\u001b[K\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[35mimport\u001b[m os, struct, subprocess\u001b[2;1H\u001b[K\u001b[2;1H\u001b[?25h\u001b[?25lSC = \u001b[36mopen\u001b[m(\u001b[31m'sc.bin'\u001b[m,\u001b[31m'rb'\u001b[m).read()\u001b[3;1H\u001b[K\u001b[3;1H\u001b[?25h\u001b[?25lbase_env = {k.encode(): v.encode() \u001b[33mfor\u001b[m k, v \u001b[33min\u001b[m os.environ.items()}\u001b[4;1H\u001b[K\u001b[4;1H\u001b[?25h\u001b[?25lenv = \u001b[36mdict\u001b[m(base_env)\u001b[5;1H\u001b[K\u001b[5;1H\u001b[?25h\u001b[?25lenv[\u001b[31mb'P'\u001b[m] = \u001b[31mb'A'\u001b[m * \u001b[31m2000\u001b[m + SC\u001b[6;1H\u001b[K\u001b[6;1H\u001b[?25h\u001b[?25lt = \u001b[31m0xffffc000\u001b[m\u001b[7;1H\u001b[K\u001b[7;1H\u001b[?25h\u001b[?25lfound = \u001b[36mNone\u001b[m\u001b[8;1H\u001b[K\u001b[8;1H\u001b[?25h\u001b[?25l\u001b[33mwhile\u001b[m t <= \u001b[31m0xfffff000\u001b[m:\u001b[9;1H\u001b[K\u001b[9;1H\u001b[?25h\u001b[?25l    ib = struct.pack(\u001b[31m'<I'\u001b[m, t)\u001b[10;1H\u001b[K\u001b[10;1H\u001b[?25h\u001b[?25l    \u001b[33mif\u001b[m \u001b[31m0\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m ib:\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h\u001b[?25l\u001b[8Carg = \u001b[31mb'\u001b[m\u001b[35m\\x68\u001b[m\u001b[31m'\u001b[m + ib + \u001b[31mb'\u001b[m\u001b[35m\\xc3\u001b[m\u001b[31m'\u001b[m + \u001b[31mb'AA'\u001b[m\u001b[12;1H\u001b[K\u001b[12;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[33mtry\u001b[m:\u001b[13;1H\u001b[K\u001b[13;1H\u001b[?25h\u001b[?25l\u001b[12Cp = subprocess.run([\u001b[31m'/maze/maze2'\u001b[m, arg], \u001b[36minput\u001b[m=\u001b[31mb''\u001b[m, env=env, capture_output=\u001b[36mTrue\u001b[m, timeouu\u001b[14;1Ht=\u001b[31m5\u001b[m)\u001b[14;5H\u001b[K\u001b[15;1H\u001b[K\u001b[15;1H\u001b[?25h\u001b[?25l\u001b[12C\u001b[33mif\u001b[m p.stdout \u001b[33mor\u001b[m p.stderr:\u001b[16;1H\u001b[K\u001b[16;1H\u001b[?25h\u001b[?25l\u001b[16Cfound = t\u001b[17;1H\u001b[K\u001b[17;1H\u001b[?25h\u001b[?25l\u001b[16C\u001b[36mprint\u001b[m(\u001b[31m'HIT at 0x%08x'\u001b[m % t, flush=\u001b[36mTrue\u001b[m)\u001b[18;1H\u001b[K\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[16C\u001b[36mprint\u001b[m((p.stdout + p.stderr)[:\u001b[31m60\u001b[m], flush=\u001b[36mTrue\u001b[m)\u001b[19;1H\u001b[K\u001b[19;1H\u001b[?25h\u001b[?25l\u001b[16C\u001b[33mbreak\u001b[m\u001b[20;1H\u001b[K\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[8C\u001b[33mexcept\u001b[m \u001b[32mException\u001b[m:\u001b[21;1H\u001b[K\u001b[21;1H\u001b[?25h\u001b[?25l\u001b[12C\u001b[33mpass\u001b[m\u001b[22;1H\u001b[K\u001b[22;1H\u001b[?25h\u001b[?25l    t += \u001b[31m0x4\u001b[m\u001b[23;1H\u001b[K\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[36mprint\u001b[m(\u001b[31m'done'\u001b[m, found, flush=\u001b[36mTrue\u001b[m)\u001b[24;1H\u001b[K\u001b[24;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[24;1H\u001b[?25l\u001b[32;90H^[\u001b[24;1H\u001b[32;90H  \u001b[24;1H\u001b[?25h\u001b[?25l\u001b[32;1H:wq\r\u001b[?1006;1000l\u001b[?1002l\u001b[?2004l\u001b[>4;m\"drv.py\" [New] 23L, 735B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=925f12c9-d52b-4f9a-8d55-cac4a4d4191c;exit=success\u001b\\\u001b]3008;start=b65013f0-f98b-4a85-86fe-620a38e35930;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/tmp.UFcfawY9PI\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/tmp.UFcfawY9PI\u0007maze2@maze:/tmp/tmp.UFcfawY9PI$ "]
