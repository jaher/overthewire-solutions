[8.615, "o", "readelf -l /maze/maze2 | grep -A1 GNU_STACK\r\n\u001b[?2004l\r\u001b]3008;start=ec0690f4-114c-4a55-914e-162efccd3c1e;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze2\u001b\\  \u001b[01;31m\u001b[KGNU_STACK\u001b[m\u001b[K      0x000000 0x00000000 0x00000000 0x00000 0x00000 RWE 0x10\r\n\r\n\u001b]3008;end=ec0690f4-114c-4a55-914e-162efccd3c1e;exit=success\u001b\\\u001b]3008;start=efd481d7-8672-4589-a403-a7b0fd76a73e;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze2\u001b\\\u001b[?2004h\u001b]0;maze2@maze: ~\u0007maze2@maze:~$ "]
