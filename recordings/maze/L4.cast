[7.231869, "o", "echo '# An ELF passes for free: bytes 7,8 = EI_OSABI/EI_ABIVERSION = 0*0 = 0,'\r\r\n\u001b[?2004l\r\u001b]3008;start=cdbfce02-c92d-40da-9bca-5f5c9e963853;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\# An ELF passes for free: bytes 7,8 = EI_OSABI/EI_ABIVERSION = 0*0 = 0,\r\r\n"]
[7.236307, "o", "\u001b]3008;end=cdbfce02-c92d-40da-9bca-5f5c9e963853;exit=success\u001b\\\u001b]3008;start=9284f040-deb9-4973-ae57-0362f964d9cb;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\"]
