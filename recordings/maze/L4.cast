[3.101, "o", "id\r\r\n\u001b[?2004l\r\u001b]3008;start=8ae9ed94-f8fe-431a-9fe9-745c5b2c4ff4;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\uid=15004(maze4) gid=15004(maze4) groups=15004(maze4)\r\r\n\u001b]3008;end=8ae9ed94-f8fe-431a-9fe9-745c5b2c4ff4;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: ~\u0007maze4@maze:~$ ls -la /maze/maze4\r\r\n\u001b[?2004l\r\u001b]3008;start=952c26d1-095e-4e19-9811-1ede99385af2;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\-r-sr-x--- 1 maze5 maze4 16392 Oct 25 13:39 \u001b[0m\u001b[37;41m/maze/maze4\u001b[0m\r\r\n\u001b]3008;end=952c26d1-095e-4e19-9811-1ede99385af2;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: ~\u0007maze4@maze:~$ objdump -d -M intel /maze/maze4 --section=.text | grep -B3 -A2 \"imul\\|0f b6\" | head -14\r\r\n\u001b[?2004l\r\u001b]3008;start=4fa3f641-fe5f-461e-b8f9-6bab644cddc3;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\ 80492f9:\te8 42 fd ff ff       \tcall   8049040 <read@plt>\r\r\n 80492fe:\t83 c4 0c             \tadd    esp,0xc\r\r\n 8049301:\t8b 8d 5c ff ff ff    \tmov    ecx,DWORD PTR [ebp-0xa4]\r\r\n 8049307:\t0f b6 45 cf          \tmovzx  eax,BYTE PTR [ebp-0x31]\r\r\n 804930b:\t0f b6 d0             \tmovzx  edx,al\r\r\n 804930e:\t0f b6 45 d0          \tmovzx  eax,BYTE PTR [ebp-0x30]\r\r\n 8049312:\t0f b6 c0             \tmovzx  eax,al\r\r\n 8049315:\t0f af c2             \timul   eax,edx\r\r\n 8049318:\t39 c1                \tcmp    ecx,eax\r\r\n 804931a:\t75 2b                \tjne    8049347 <main+0x131>\r\r\n\u001b]3008;end=4fa3f641-fe5f-461e-b8f9-6bab644cddc3;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: ~\u0007maze4@maze:~$ mkdir -p /run/screen/l4 && cd /run/screen/l4\r\r\n\u001b[?2004l\r\u001b]3008;start=91088660-b40a-4720-929b-26ddb6e94eed;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze4\u001b\\\u001b]3008;end=91088660-b40a-4720-929b-26ddb6e94eed;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ cp /bin/sh ./sh\r\r\n\u001b[?2004l\r\u001b]3008;start=9398b442-181b-4073-9549-10252d1bc6cc;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b]3008;end=9398b442-181b-4073-9549-10252d1bc6cc;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ chmod 755 ./sh\r\r\n\u001b[?2004l\r\u001b]3008;start=fdc44e5c-9551-422d-a119-ed5a40d7f3e8;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b]3008;end=fdc44e5c-9551-422d-a119-ed5a40d7f3e8;exit=success\u001b\\\u001b]3008;start=464935e2-9283-4d81-82b7-e0ab33bd4021;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
