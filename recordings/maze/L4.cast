[0.358, "o", "printf '%s' 'ID0gYnl0ZXMoZWhkcikgKyBieXRlcyhwaGRyKSArIGNvZGUKZGF0YSArPSBiIlx4MDAiICogKDEyMyAtIGxlbihkYXRhKSkgICAgICMgcGFkIHRvIGV4YWN0bHkgMTIzIChzaXplIGdhdGU6IDw9IDB4N2IpCmFzc2VydCBsZW4oZGF0YSkgPT0gMTIzCm9wZW4oc3lzLmFyZ3ZbMV0sICJ3YiIpLndyaXRlKGRhdGEpCnByaW50KCJ3cm90ZSIsIGxlbihkYXRhKSwgImJ5dGVzIikK' >> tinel.b64\r\r\n\u001b[?2004l\r\u001b]3008;start=1068934e-4741-416d-8a77-c8474dff8cc1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b]3008;end=1068934e-4741-416d-8a77-c8474dff8cc1;exit=success\u001b\\\u001b]3008;start=be5066c5-cd88-447a-b473-cc78d2839f66;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze4;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l4\u001b\\\u001b[?2004h\u001b]0;maze4@maze: /run/screen/l4\u0007maze4@maze:/run/screen/l4$ "]
