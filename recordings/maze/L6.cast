[18.854106, "o", "ls -la /maze/maze6\r\r\n\u001b[?2004l\r\u001b]3008;start=0bc8d2ac-8446-4c3d-a9a5-cf2020d5268e;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\-r-sr-x--- 1 maze7 maze6 14352 Oct 25 13:39 \u001b[0m\u001b[37;41m/maze/maze6\u001b[0m\r\r\n\u001b]3008;end=0bc8d2ac-8446-4c3d-a9a5-cf2020d5268e;exit=success\u001b\\\u001b]3008;start=f9ce88b0-7272-482e-8cc3-10d7e5b290f4;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ file /maze/maze6\r\r\n\u001b[?2004l\r\u001b]3008;start=21a010ad-ab0e-4bf6-9140-c200d3b3c02e;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\/maze/maze6: setuid ELF 32-bit LSB executable, Intel i386, version 1 (SYSV), dynamically linked, interpreter /lib/ld-linux.so.2, BuildID[sha1]=fabe8d66cb9e8e6f34463a3146de56794ec4c017, for GNU/Linux 3.2.0, with debug_info, not stripped\r\r\n\u001b]3008;end=21a010ad-ab0e-4bf6-9140-c200d3b3c02e;exit=success\u001b\\\u001b]3008;start=f9ce88b0-7272-482e-8cc3-10d7e5b290f4;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ md5sum /maze/maze6\r\r\n\u001b[?2004l\r\u001b]3008;start=c0b585eb-0abd-4529-abcc-4f078c83b772;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\a3dde0a162510d0c142a6d33f66084d0  /maze/maze6\r\r\n\u001b]3008;end=c0b585eb-0abd-4529-abcc-4f078c83b772;exit=success\u001b\\\u001b]3008;start=f9ce88b0-7272-482e-8cc3-10d7e5b290f4;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ mkdir -p /run/screen/l6 && cd /run/screen/l6\r\r\n\u001b[?2004l\r\u001b]3008;start=556212e5-0d57-4f6b-a99c-7ef0235984e6;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b]3008;end=556212e5-0d57-4f6b-a99c-7ef0235984e6;exit=success\u001b\\\u001b]3008;start=f9ce88b0-7272-482e-8cc3-10d7e5b290f4;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: /run/screen/l6\u0007maze6@maze:/run/screen/l6$ "]
