[7.682579, "o", "echo '# fprintf memcpy the line into exit@GOT landing leave;ret, pivot to shellcode.'\r\r\n\u001b[?2004l\r\u001b]3008;start=5566cde7-53ad-4080-8f52-78f455143399;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\# fprintf memcpy the line into exit@GOT landing leave;ret, pivot to shellcode.\r\r\n\u001b]3008;end=5566cde7-53ad-4080-8f52-78f455143399;exit=success\u001b\\\u001b]3008;start=3a687c62-dfce-4130-80b1-eac70b32b1b8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ "]
