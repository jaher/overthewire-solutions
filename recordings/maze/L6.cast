[7.07228, "o", "\u001b]3008;start=bdfef12e-a8b8-43c2-bdd9-9f28f8224350;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\080491d6 <main>:\r\r\n 80491d6:\t55                   \tpush   ebp\r\r\n 80491d7:\t89 e5                \tmov    ebp,esp\r\r\n 80491d9:\t81 ec 04 01 00 00    \tsub    esp,0x104\r\r\n 80491df:\t83 7d 08 03          \tcmp    DWORD PTR [ebp+0x8],0x3\r\r\n 80491e3:\t74 1a                \tje     80491ff <main+0x29>\r\r\n 80491e5:\t8b 45 0c             \tmov    eax,DWORD PTR [ebp+0xc]\r\r\n"]
