[27.661313, "o", "echo '# Verify by logging in as maze9 from the CLIENT (localhost logins are blocked):'\r\r\n\u001b[?2004l\r\u001b]3008;start=83149c0c-e9ca-424c-b214-585337552942;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze8;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze8\u001b\\# Verify by logging in as maze9 from the CLIENT (localhost logins are blocked):\r\r\n\u001b]3008;end=83149c0c-e9ca-424c-b214-585337552942;exit=success\u001b\\\u001b]3008;start=5226ee0b-5968-480c-833c-1e642c782207;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=maze8;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/maze8\u001b\\\u001b[?2004h\u001b]0;maze8@maze: ~\u0007maze8@maze:~$ "]
