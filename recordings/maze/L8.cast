[31.145254, "o", "                                                    \r\r\n                            _ __ ___   __ _ _______ \r\r\n                           | '_ ` _ \\ / _` |_  / _ \\\r\r\n                           | | | | | | (_| |/ /  __/\r\r\n                           |_| |_| |_|\\__,_/___\\___|\r\r\n                                                    \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rmaze9@maze.labs.overthewire.org's password: "]
