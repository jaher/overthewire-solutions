[0.003, "o", "$ ssh krypton3@krypton.labs.overthewire.org -p 2231   # password CAESARISEASY\r\n$ cat /krypton/krypton3/README   # same key for all 4 files: one fixed substitution\r\n$ ssh krypton3@krypton.labs.overthewire.org -p 2231 cat /krypton/krypton3/README\r\n"]
[2.585, "o", "Well done.  You've moved past an easy substitution cipher.\r\n\r\nHopefully you just encrypted the alphabet a plaintext \r\nto fully expose the key in one swoop.\r\n\r\nThe main weakness of a simple substitution cipher is \r\nrepeated use of a simple key.  In the previous exercise\r\nyou were able to introduce arbitrary plaintext to expose\r\nthe key.  In this example, the cipher mechanism is not \r\navailable to you, the attacker.\r\n\r\nHowever, you have been lucky.  You have intercepted more\r\nthan one message.  The password to the next level is found\r\nin the file 'krypton4'.  You have also found 3 other files.\r\n(found1, found2, found3)\r\n\r\nYou know the following important details:\r\n\r\n- The message plaintexts are in English (*** very important)\r\n- They were produced from the same key (*** even better!)\r\n\r\n\r\nEnjoy.\r\n\r\n\r\n"]
[0.004, "o", "$ frequency analysis on the four files: one fixed key, not a stepping one\r\n"]
[2.531, "o", "S:13.0% Q:9.6% J:8.5% U:7.3% B:7.0% N:6.8% C:6.4% G:6.4% D:5.9% V:3.8%\r\n"]
[0.002, "o", "$ decode krypton4: the key is the keyboard-walk QAZWSX..OLP -> A-Z\r\n$ ssh krypton3@krypton.labs.overthewire.org -p 2231 cat /krypton/krypton3/krypton4 | tr -d \" \" | tr QAZWSXEDCRFVTGBYHNUJMIKOLP A-Z; echo; cat /krypton/krypton3/krypton4\r\n"]
[2.470, "o", "WELLDONETHELEVELFOURPASSWORDISBRUTE\r\nKSVVW BGSJD SVSIS VXBMN YQUUK BNWCU ANMJS "]
[0.001, "o", "$ ssh krypton4@krypton.labs.overthewire.org -p 2231   # verify BRUTE\r\n$ ssh krypton4@krypton.labs.overthewire.org -p 2231 whoami; cat /etc/krypton_pass/krypton5\r\n"]
[2.840, "o", "krypton4\r\n"]
[0.002, "o", "cat: /etc/krypton_pass/krypton5: Permission denied\r\n"]
[0.003, "x", "1"]
