[0.002, "o", "$ chosen plaintext: encrypt ABCDEFGHIJKLMNOPQRSTUVWXYZ to learn the shift\r\r\n$ ssh krypton2@krypton.labs.overthewire.org -p 2231 D=$(mktemp -d); cd \"$D\"; ln -s /krypton/krypton2/keyfile.dat; chmod 777 .; printf \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n\" > p.txt; /krypton/krypton2/encrypt p.txt; cat ciphertext\r\r\n"]
