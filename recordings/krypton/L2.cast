[0.001, "o", "$ mapping is A->M (+12); decrypt by shifting -12, i.e. tr A-Z O-ZA-N\r\r\n$ ssh krypton2@krypton.labs.overthewire.org -p 2231 cat /krypton/krypton2/krypton3 | tr 'A-Z' 'O-ZA-N'\r\r\n"]
