[27.514693, "o", "\u001b[1;1H\u001b[35mimport\u001b[m collections\r\r\n\u001b[34m# krypton4: Vigenere, KNOWN key length 6. Split the two found* texts into 6 columns and\u001b[m\u001b[2;88H\u001b[K\u001b[3;1H\u001b[34m# break each with chi-squared against English frequencies. Chi-squared pins each column\u001b[m\u001b[3;88H\u001b[K\u001b[4;1H\u001b[34m# only up to ROT13 (an artifact of the samples), so the raw key needs one ROT13 pass -\r\r\n# verified by the decode reading as English.\u001b[m\r\r\nENG = [\u001b[31m8.167\u001b[m,\u001b[31m1.492\u001b[m,\u001b[31m2.782\u001b[m,\u001b[31m4.253\u001b[m,\u001b[31m12.702\u001b[m,\u001b[31m2.228\u001b[m,\u001b[31m2.015\u001b[m,\u001b[31m6.094\u001b[m,\u001b[31m6.966\u001b[m,\u001b[31m0.153\u001b[m,\u001b[31m0.772\u001b[m,\u001b[31m4.025\u001b[m,\u001b[7;8H\u001b[31m2.406\u001b[m,\u001b[31m6.749\u001b[m,\u001b[31m7.507\u001b[m,\u001b[31m1.929\u001b[m,\u001b[31m0.095\u001b[m,\u001b[31m5.987\u001b[m,\u001b[31m6.327\u001b[m,\u001b[31m9.056\u001b[m,\u001b[31m2.758\u001b[m,\u001b[31m0.978\u001b[m,\u001b[31m2.360\u001b[m,\u001b[31m0.150\u001b[m,\u001b[8;8H\u001b[31m1.974\u001b[m,\u001b[31m0.074\u001b[m]\r\r\n\u001b[33mdef\u001b[m \u001b[36mread\u001b[m(fn):\r\r\n    \u001b[33mreturn\u001b[m \u001b[31m\"\"\u001b[m.join(c \u001b[33mfor\u001b[m c \u001b[33min\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"/krypton/krypton4/\"\u001b[m + fn).read() \u001b[33mif\u001b[m c.isalpha())\r\r\nct = read(\u001b[31m\"found1\"\u001b[m) + read(\u001b[31m\"found2\"\u001b[m)\r\r\nraw = \u001b[31m\"\"\u001b[m\r\r\n\u001b[33mfor\u001b[m col \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m6\u001b[m):\r\r\n    letters = ct[col::\u001b[31m6\u001b[m]\r\r\n    best, bestshift = \u001b[36mNone\u001b[m, \u001b[31m0\u001b[m\r\r\n    \u001b[33mfor\u001b[m s \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m26\u001b[m):\u001b[17;9Hchi = \u001b[31m0.0\u001b[m\u001b[18;9Hn = \u001b[36mlen\u001b[m(letters)\u001b[19;9Hcnt = collections.Counter(letters)\u001b[20;9H\u001b[33mfor\u001b[m i \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m26\u001b[m):\u001b[21;13Hobs = cnt.get(\u001b[36mchr\u001b[m(\u001b[36mord\u001b[m(\u001b[31m'A'\u001b[m) + (i + s) % \u001b[31m26\u001b[m), \u001b[31m0\u001b[m) / n * \u001b[31m100\u001b[m\u001b[22;13Hchi += (obs - ENG[i]) ** \u001b[31m2\u001b[m / ENG[i]\u001b[23;9H\u001b[33mif\u001b[m best \u001b[33mis\u001b[m \u001b[36mNone\u001b[m \u001b[33mor\u001b[m chi < best:\u001b[24;13Hbest, bestshift = chi, s\r\r\n    raw += \u001b[36mchr\u001b[m(\u001b[36mord\u001b[m(\u001b[31m'A'\u001b[m) + bestshift)\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"chi-squared key =\"\u001b[m, raw, flush=\u001b[36mTrue\u001b[m)\r\r\n\u001b[33mdef\u001b[m \u001b[36mvig_dec\u001b[m(t, key):\r\r\n    out, ki = [], \u001b[31m0\u001b[m\r\r\n    \u001b[33mfor\u001b[m c \u001b[33min\u001b[m t:\u001b[30;9H\u001b[33mif\u001b[m c.isalpha():\u001b[31;13Hs = \u001b[36mord\u001b[m(key[ki % \u001b[36mlen\u001b[m(key)]) - \u001b[36mord\u001b[m(\u001b[31m'A'\u001b[m)\u001b[32;13Hout.append(\u001b[36mchr\u001b[m((\u001b[36mord\u001b[m(c) - \u001b[36mord\u001b[m(\u001b[31m'A'\u001b[m) - s) % \u001b[31m26\u001b[m + \u001b[36mord\u001b[m(\u001b[31m'A'\u001b[m)))\u001b[33;13Hki += \u001b[31m1\u001b[m\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
[49.598319, "o", "\u001b[?25l\u001b[34;73H^[\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[34;73H^[\u001b[1;1H\u0007\u001b[34;73H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr=\r\u001b[82C1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;73HdG\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                   