[3.214946, "o", "                      _                     _              \r\r\n                     | | ___ __ _   _ _ __ | |_ ___  _ __  \r\r\n                     | |/ / '__| | | | '_ \\| __/ _ \\| '_ \\ \r\r\n                     |   <| |  | |_| | |_) | || (_) | | | |\r\r\n                     |_|\\_\\_|   \\__, | .__/ \\__\\___/|_| |_|\r\r\n                                |___/|_|                   \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rkrypton7@krypton.labs.overthewire.org's password: "]
