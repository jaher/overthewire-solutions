[17.982, "o", "$ cat /tmp/l2_harness.c\r\nvim -u NONE -N /tmp/l2_harness.c\r\r\n\u001b[?2004l\r\u001b]3008;start=6746c25e-60a5-4c5d-bdd7-4775482bbfec;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;32r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[32;1H\"/tmp/l2_harness.c\" [New]\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[m\u001b[32;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?25h\u001b[?4m\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25l/* l2_harness.c -- run raw shellcode bytes taken from an assembled file.\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l *\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l * We assembled /tmp/l2.asm with nasm and extracted the text section to\u001b[4;1H\u001b[K\u001b[32;83"]
[0.001, "o", "H4\u001b[4;1H\u001b[?25h\u001b[?25l * /tmp/l2.bin. This harness mmaps a page, copies the bytes in, makes it\r\r\n * executable and calls it -- exactly what the overflow will do, but here\u001b[5;74H\u001b[K\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l * under our control so we can debug the shellcode on its own before putting\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l * it in argv[1].\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l *\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l * Compile:  gcc -m32 -o l2_harness l2_harness.c\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l * Run:      ./l2_harness /tmp/l2.bin\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l *\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l * It prints the bytes it loaded and then jumps into them.\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l */\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l#include <stdio.h>\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l#include <stdlib.h>\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l#include <string.h>\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l#include <sys/mman.h>\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25lint main(int argc, char **argv)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l{\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l    if (argc != 2) { fprintf(stderr, \"usage: %s shellcode.bin\\n\", argv[0]); return 1; }\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l    FILE *f = fopen(argv[1], \"rb\");\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25l    if (!f) { perror(argv[1]); return 1; }\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l    fseek(f, 0, SEEK_END);\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l    long n = ftell(f);\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l    rewind(f);\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l\r\r\n    unsigned char *buf = malloc(n);\u001b[29;36H\u001b[K\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l    if (fread(buf, 1, n, f) != (size_t)n) { perror(\"fread\"); return 1; }\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfclose(f);\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\"loaded %ld bytes:\", n);\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfor (long i = 0; i < n; i++) printf(\" %02x\", buf[i]);\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\"\\n\");\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;5H/* executable page: the overflow will run this from the stack, which is RWE */\r\r\n    void *code = mmap(NULL, 4096, PROT_READ | PROT_WRITE | PROT_EXEC,\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;23HMAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif (code == MAP_FAILED) { perror(\"mmap\"); return 1; }\u001b[32;83H\u001b[K\u001b[32;83H41,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hmemcpy(code, buf, n);\u001b[32;83H\u001b[K\u001b[32;83H42,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\"jumping into the shellcode at %p\\n\", code);\u001b[32;83H\u001b[K\u001b[32;83H43,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hfflush(stdout);\u001b[32;83H\u001b[K\u001b[32;83H44,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H45,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5H((void (*)(void))code)();\u001b[32;83H\u001b[K\u001b[32;83H46,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hreturn 0;\u001b[32;83H\u001b[K\u001b[32;83H47,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H}\u001b[32;83H\u001b[K\u001b[32;83H48,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H48,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/l2_harness.c\" [New] 48L, 1554B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=6746c25e-60a5-4c5d-bdd7-4775482bbfec;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ $ gcc -m32 -"]
[0.000, "o", "o /tmp/l2_harness /tmp/l2_harness.c\r\n"]
[0.339, "o", "cat /tmp/l2_harness.c\r\r\n\u001b[?2004l\r\u001b]3008;start=b67e0a4e-533a-4293-bda7-15e204bc1c8e;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\/* l2_harness.c -- run raw shellcode bytes taken from an assembled file.\r\r\n *\r\r\n * We assembled /tmp/l2.asm with nasm and extracted the text section to\r\r\n * /tmp/l2.bin. This harness mmaps a page, copies the bytes in, makes it\r\r\n * executable and calls it -- exactly what the overflow will do, but here\r\r\n * under our control so we can debug the shellcode on its own before putting\r\r\n * it in argv[1].\r\r\n *\r\r\n * Compile:  gcc -m32 -o l2_harness l2_harness.c\r\r\n * Run:      ./l2_harness /tmp/l2.bin\r\r\n *\r\r\n * It prints the bytes it loaded and then jumps into them.\r\r\n */\r\r\n#include <stdio.h>\r\r\n#include <stdlib.h>\r\r\n#include <string.h>\r\r\n#include <sys/mman.h>\r\r\n\r\r\nint main(int argc, char **argv)\r\r\n{\r\r\n    if (argc != 2) { fprintf(stderr, \"usage: %s shellcode.bin\\n\", argv[0]); return 1; }\r\r\n\r\r\n    FILE *f = fopen(argv[1], \"rb\");\r\r\n    if (!f) { perror(argv[1]); return 1; }\r\r\n    fseek(f, 0, SEEK_END);\r\r\n    long n = ftell(f);\r\r\n    rewind(f);\r\r\n\r\r\n    unsigned char *buf = malloc(n);\r\r\n    if (fread(buf, 1, n, f) != (size_t)n) { perror(\"fread\"); return 1; }\r\r\n    fclose(f);\r\r\n\r\r\n    printf(\"loaded %ld bytes:\", n);\r\r\n    for (long i = 0; i < n; i++) printf(\" %02x\", buf[i]);\r\r\n    printf(\"\\n\");\r\r\n\r\r\n    /* executable page: the overflow will run this from the stack, which is RWE */\r\r\n    void *code = mmap(NULL, 4096, PROT_READ | PROT_WRITE | PROT_EXEC,\r\r\n                      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\r\r\n    if (code == MAP_FAILED) { perror(\"mmap\"); return 1; }\r\r\n    memcpy(code, buf, n);\r\r\n    printf(\"jumping into the shellcode at %p\\n\", code);\r\r\n    fflush(stdout);\r\r\n\r\r\n    ((void (*)(void))code)();\r\r\n    return 0;\r\r\n}\r\r\n\r\r\n\u001b]3008;end=b67e0a4e-533a-4293-bda7-15e204bc1c8e;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ gcc -m32 -o /tmp/l2_harness /tmp/l2_harness.c\r\r\n\u001b[?2004l\r\u001b]3008;start=fc013696-2e1e-4c85-a636-3a558148ae3f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\Cannot create temporary file in ./: Permission denied\r\r\nAborted                    gcc -m32 -o /tmp/l2_harness /tmp/l2_harness.c\r\r\n\u001b]3008;end=fc013696-2e1e-4c85-a636-3a558148ae3f;exit=failure;status=134;signal=SIGABRT\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ $ file /tmp/l2_harness\r\n"]
