[9.069623, "o", "\u001b[1;1H\u001b[36mBITS\u001b[m \u001b[31m32\u001b[m\r\r\n\u001b[36mglobal\u001b[m \u001b[36m_start\u001b[m\u001b[2;14H\u001b[K\u001b[3;1H\u001b[33m_start\u001b[m:\u001b[3;8H\u001b[K\u001b[4;5H\u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mpush\u001b[m \u001b[36meax\r\r\n\u001b[m    \u001b[36mpush\u001b[m \u001b[31m0x214e5750\u001b[m\r\r\n    \u001b[36mmov\u001b[m \u001b[36mecx\u001b[m, \u001b[36mesp\r\r\n\u001b[m    \u001b[36mxor\u001b[m \u001b[36mebx\u001b[m, \u001b[36mebx\r\r\n\u001b[m    \u001b[36minc\u001b[m \u001b[36mebx\r\r\n\u001b[m    \u001b[36mxor\u001b[m \u001b[36medx\u001b[m, \u001b[36medx\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mdl\u001b[m, \u001b[31m4\u001b[m\r\r\n    \u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mal\u001b[m, \u001b[31m4\u001b[m\r\r\n    \u001b[36mint\u001b[m \u001b[31m0x80\u001b[m\r\r\n    \u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mal\u001b[m, \u001b[31m201\u001b[m\r\r\n    \u001b[36mint\u001b[m \u001b[31m0x80\u001b[m\r\r\n    \u001b[36mmov\u001b[m \u001b[36mebx\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mecx\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mal\u001b[m, \u001b[31m70\u001b[m\r\r\n    \u001b[36mint\u001b[m \u001b[31m0x80\u001b[m\r\r\n    \u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mal\u001b[m, \u001b[31m201\u001b[m\r\r\n    \u001b[36mint\u001b[m \u001b[31m0x80\u001b[m\r\r\n    \u001b[36mmov\u001b[m \u001b[36mebx\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mxor\u001b[m \u001b[36meax\u001b[m, \u001b[36meax\r\r\n\u001b[m    \u001b[36mmov\u001b[m \u001b[36mal\u001b[m, \u001b[31m23\u001b[m\r\r\n    \u001b[36mint\u001b[m \u001b[31m0x80\u001b[m\r"]
