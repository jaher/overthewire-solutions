?25h\u001b[?25l\b\b\u001b[32mint\u001b[m\u001b[34;86H3\u001b[2;13H\u001b[?25h\u001b[?25l\u001b[34;86H4\u001b[2;14H\u001b[?25h\u001b[?25lar\u001b[34;86H6\u001b[2;16H\u001b[?25h\u001b[?25lg\u001b[34;86H7\u001b[2;17H\u001b[?25h\u001b[?25lc\u001b[34;86H8\u001b[2;18H\u001b[?25h\u001b[?25l,\u001b[34;86H9\u001b[2;19H\u001b[?25h\u001b[?25l\u001b[34;85H20\u001b[2;20H\u001b[?25h\u001b[?25lc\u001b[34;86H1\u001b[2;21H\u001b[?25h\u001b[?25l\b\u001b[32mchar\u001b[m **argv){ printf(\u001b[31m\"\u001b[m\u001b[34;85H42\u001b[2;42H\u001b[?25h\u001b[?25l\u001b[31ma\u001b[m\u001b[34;86H3\u001b[2;43H\u001b[?25h\u001b[?25l\u001b[31mr\u001b[m\u001b[34;86H4\u001b[2;44H\u001b[?25h\u001b[?25l\u001b[31mg\u001b[m\u001b[34;86H5\u001b[2;45H\u001b[?25h\u001b[?25l\u001b[31mv\u001b[m\u001b[34;86H6\u001b[2;46H\u001b[?25h\u001b[?25l\u001b[31m1\u001b[m\u001b[34;86H7\u001b[2;47H\u001b[?25h\u001b[?25l\u001b[31m=\u001b[m\u001b[34;86H8\u001b[2;48H\u001b[?25h\u001b[?25l\u001b[31m%\u001b[m\u001b[34;86H9\u001b[2;49H\u001b[?25h\u001b[?25l\b\u001b[35m%p\u001b[m\u001b[34;85H50\u001b[2;50H\u001b[?25h\u001b[?25l\u001b[35m\\\u001b[m\u001b[34;86H1\u001b[2;51H\u001b[?25h\u001b[?25l\u001b[35mn\u001b[m\u001b[34;86H2\u001b[2;52H\u001b[?25h\u001b[?25l\u001b[31m\"\u001b[m\u001b[34;86H3\u001b[2;53H\u001b[?25h\u001b[?25l,\u001b[34;86H4\u001b[2;54H\u001b[?25h\u001b[?25l\u001b[34;86H5\u001b[2;55H\u001b[?25h\u001b[?25l(\u001b[34;86H6\u001b[2;56H\u001b[?25h\u001b[?25lv\u001b[34;86H7\u001b[2;57H\u001b[?25h\u001b[?25lo\u001b[34;86H8\u001b[2;58H\u001b[?25h\u001b[?25li\u001b[34;86H9\u001b[2;59H\u001b[?25h\u001b[?25l\b\b\b\u001b[32mvoid\u001b[m\u001b[34;85H60\u001b[2;60H\u001b[?25h\u001b[?25l*\u001b[34;86H1\u001b[2;61H\u001b[?25h\u001b[?25l)\u001b[2;55H\u001b[46m(\u001b[5C)\u001b[m\u001b[34;86H2\u001b[2;62H\u001b[?25h\u001b[?25larg\u001b[2;55H(\u001b[5C)\u001b[34;86H5\u001b[2;65H\u001b[?25h\u001b[?25lv\u001b[34;86H6\u001b[2;66H\u001b[?25h\u001b[?25l[\u001b[34;86H7\u001b[2;67H\u001b[?25h\u001b[?25l\u001b[31m1\u001b[m\u001b[34;86H8\u