[9.547617, "o", "/narnia/narnia5 'AAAA.%08x.%08x.%08x.%08x.%08x.%08x'\r\r\n\u001b[?2004l\r\u001b]3008;start=915b3d06-e9f7-4f2b-babe-40d3316f42cc;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia5\u001b\\Change i's value from 1 -> 500. No way...let me give you a hint!\r\r\nbuffer : [AAAA.41414141.3431342e.34313431.34332e31.34333133.332e6532] (58)\r\r\ni = 1 (0xffffd3a0)\r\r\n\u001b]3008;end=915b3d06-e9f7-4f2b-babe-40d3316f42cc;exit=success\u001b\\\u001b]3008;start=bde6022d-70da-42c3-89c9-306ec7c699f7;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=narnia5;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/narnia5\u001b\\\u001b[?2004h\u001b]0;narnia5@narnia: ~\u0007narnia5@narnia:~$ "]
