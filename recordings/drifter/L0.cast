\u001b[31m\"<i\"\u001b[m, dec)[\u001b[31m0\u001b[m]\r\r\ns = socket.create_connection((HOST, PORT), timeout=\u001b[31m10\u001b[m)\r\r\nme = s.getsockname()\u001b[10C\u001b[34m# what the SERVER sees as the peer\u001b[m\r\r\nkeymat = socket.inet_aton(me[\u001b[31m0\u001b[m]) + struct.pack(\u001b[31m\">H\"\u001b[m, me[\u001b[31m1\u001b[m])\r\r\n\u001b[36mprint\u001b[m(\u001b[31m\"keymat:\"\u001b[m, keymat.hex())\u001b[34;93H1,1\u001b[11CTop\u001b[1;1H\u001b[?25h\u001b[?4m"]
