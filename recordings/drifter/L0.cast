[2.996975, "o", "                             _      _  __ _            \r\r\n                          __| |_ __(_)/ _| |_ ___ _ __ \r\r\n                         / _` | '__| | |_| __/ _ \\ '__|\r\r\n                        | (_| | |  | |  _| ||  __/ |   \r\r\n                         \\__,_|_|  |_|_|  \\__\\___|_|   \r\r\n                                                       \r\r\n\r\r\n                      This is an OverTheWire game server. \r\r\n            More information on http://www.overthewire.org/wargames\r\r\n\r\r\nbackend: gibson-0\r\r\n\rdrifter0@drifter.labs.overthewire.org's password: "]
