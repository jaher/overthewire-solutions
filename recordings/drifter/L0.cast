[44.742747, "o", "EXFIL raw: b'yttCfzKiorcOz5V0Nr9AVk6SZ13IonYV\\n'\r\r\nwrite -> 33\r\r\n"]
[44.848693, "o", "\u001b]3008;end=b2053882-d56d-4a4f-9301-205d1e63318f;exit=success\u001b\\\u001b]3008;start=b0a9e1e7-39b8-461f-ae8d-6aaebf93b5dc;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=drifter0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/drifter0\u001b\\\u001b[?2004h\u001b]0;drifter0@drifter: ~\u0007drifter0@drifter:~$ echo rc=$?\r\r\n\u001b[?2004l\r\u001b]3008;start=a40fb114-8e76-49f3-b566-4bc37194f9fc;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=drifter0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/drifter0\u001b\\rc=0\r\r\n\u001b]3008;end=a40fb114-8e76-49f3-b566-4bc37194f9fc;exit=success\u001b\\\u001b]3008;start=b0a9e1e7-39b8-461f-ae8d-6aaebf93b5dc;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=drifter0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/drifter0\u001b\\\u001b[?2004h\u001b]0;drifter0@drifter: ~\u0007drifter0@drifter:~$ "]
