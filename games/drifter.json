      "def prepare_key(keymat):",
      "    s = list(range(256)); j = 0",
      "    for i in range(256):",
      "        j = (keymat[i % len(keymat)] + s[i] + j) % 256",
      "        s[i], s[j] = s[j], s[i]",
      "    return s, 0, 0",
      "def call(sock, K, nr, *a):",
      "    a = a + (0,) * (8 - len(a))",
      "    sti, xi, yi, sto, xo, yo = K",
