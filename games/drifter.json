      "import socket, struct, sys, time",
      "HOST = \"127.0.0.1\"",
      "PORT = 1111",
      "def rc4(state, x, y, data):",
      "    buf = bytearray(data)",
      "    for i in range(len(buf)):",
      "        x = (x + 1) % 256",
      "        y = (state[x] + y) % 256",
      "        state[x], state[y] = state[y], state[x]",
      "        buf[i] ^= state[(state[x] + state[y]) % 256]",
