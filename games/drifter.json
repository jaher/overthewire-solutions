      "",
      "\tint ret;",
      "\tstruct sockaddr_in sin;",
      "",
      "\tret = socket(AF_INET, SOCK_STREAM, 0);",
      "\tif(ret == -1) exit(6);",
      "",
      "\tmemset(&sin, 0, sizeof(struct sockaddr_in));",
      "\tsin.sin_family = AF_INET,",
