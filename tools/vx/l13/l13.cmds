@sleep 3
@wait 12 D=$(mktemp -d); cd $D; pwd
@wait 8 ls -l /vortex/vortex13 /etc/vortex_pass/vortex14
@wait 8 file /vortex/vortex13
@wait 8 md5sum /vortex/vortex13
@wait 8 readelf -l /vortex/vortex13 | grep -E 'GNU_STACK|RELRO' -A1
@wait 10 objdump -d /vortex/vortex13 -M intel | sed -n '/<main>:/,/^$/p'
@wait 10 objdump -d /vortex/vortex13 -M intel | sed -n '/<vuln>:/,/^$/p'
@wait 10 objdump -R /vortex/vortex13 | grep -E 'printf|free|fgets|strchr|malloc'
@wait 8 echo "--- the argc printer (typed in vim) ---"
@wait 6 vi printargc.c
@literal i
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <unistd.h>
@line /* printargc: the exec target of an empty-argv execve; prints argc. */
@line int main(int argc, char **argv) {
@line     printf("argc=%d\n", argc);
@line     return 0;
@line }
@literal \x1b
@literal :wq\r
@wait 10 gcc -o printargc printargc.c
@wait 8 echo "--- probe argc under an empty-argv execve ---"
@wait 2 cat > probe13.c << 'EOF'
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <string.h>
@line #include <unistd.h>
@line #include <sys/wait.h>
@line /* probe13: re-exec /vortex/vortex13 with argv={NULL}, envp={NULL} and a
@line    stdin payload, so the kernel places the exec path at the bottom of the
@line    stack and main's zeroing loops see no strings.  The argv/envp holes make
@line    argc=0; the stdin payload is read by fgets.  A second invocation with a
@line    flag runs the real probe: this stub execve's the level with the holes
@line    and passes the stdin through a pipe. */
@line int main(int argc, char **argv, char **envp) {
@line     if (argc < 3) {
@line         fprintf(stderr, "usage: probe13 <stdin-file> <out>\n");
@line         return 2;
@line     }
@line     /* read the stdin payload */
@line     static unsigned char in[256];
@line     FILE *f = fopen(argv[1], "rb");
@line     size_t n = fread(in, 1, sizeof in, f);
@line     fclose(f);
@line     /* pipe + fork: child = the level with holes, stdin = the payload */
@line     int pfd[2];
@line     pipe(pfd);
@line     write(pfd[1], in, n);   /* payload before the fork: no race */
@line     pid_t pid = fork();
@line     if (pid == 0) {
@line         close(pfd[1]);
@line         dup2(pfd[0], 0);
@line         close(pfd[0]);
@line         char *av[2] = { NULL, NULL };
@line         char *ev[1] = { NULL };
@line         execve("/vortex/vortex13", av, ev);
@line         _exit(127);
@line     }
@line     close(pfd[0]);
@line     close(pfd[1]);
@line     int st = 0;
@line     waitpid(pid, &st, 0);
@line     fprintf(stderr, "child exit=%d sig=%d\n", WEXITSTATUS(st), WTERMSIG(st));
@line     (void)envp;
@line     return 0;
@line }
@line EOF
@wait 12 gcc -o probe13 probe13.c
@wait 8 python3 -c "open('in.txt','w').write('A'*19)"
@wait 8 ./probe13 in.txt out
@wait 8 echo "--- strace: the level exits before vuln ---"
@wait 12 strace -f -e trace=execve,read,exit_group -o st3.txt ./probe13 in.txt out
@wait 8 grep -E "execve|exit_group|read.0" st3.txt | tail -6
@wait 8 exit
