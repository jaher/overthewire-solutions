@sleep 3
@wait 12 D=$(mktemp -d); cd $D; pwd
@wait 8 echo "--- step 1: static or dynamic ---"
@wait 6 file /vortex/vortex13
@wait 6 readelf -d /vortex/vortex13 | grep -E "NEEDED"
@wait 8 echo "--- step 2: the empirical ptrace permission test (typed in vim) ---"
@wait 6 vi ptrace13.c
@sleep 3
@literal :set paste noai nosi nocindent\r
@literal i
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <string.h>
@line #include <unistd.h>
@line #include <sys/ptrace.h>
@line #include <sys/prctl.h>
@line #include <sys/wait.h>
@line #include <errno.h>
@line /* ptrace13: test whether a dumpable=0 process can be ptraced without
@line    CAP_SYS_PTRACE - even by the same uid.  The child sets PR_SET_DUMPABLE(0)
@line    and loops; the parent PTRACE_ATTACHes and reports the errno.  Then the
@line    child resets dumpable to 1 and the parent attaches again: the control. */
@line int main(void) {
@line     pid_t pid = fork();
@line     if (pid == 0) {
@line         prctl(PR_SET_DUMPABLE, 0);
@line         for (;;) pause();
@line     }
@line     sleep(1);                        /* let the child start */
@line     int r = ptrace(PTRACE_ATTACH, pid, 0, 0);
@line     printf("attach to dumpable=0 (same uid): rc=%d errno=%s\n",
@line            r, strerror(errno));
@line     if (r == 0) ptrace(PTRACE_DETACH, pid, 0, 0);
@line     kill(pid, 9);
@line     waitpid(pid, 0, 0);
@line 
@line     /* control: the same child shape with dumpable=1 */
@line     pid = fork();
@line     if (pid == 0) {
@line         prctl(PR_SET_DUMPABLE, 1);
@line         for (;;) pause();
@line     }
@line     sleep(1);
@line     errno = 0;
@line     r = ptrace(PTRACE_ATTACH, pid, 0, 0);
@line     printf("attach to dumpable=1 (same uid): rc=%d errno=%s\n",
@line            r, strerror(errno));
@line     if (r == 0) ptrace(PTRACE_DETACH, pid, 0, 0);
@line     kill(pid, 9);
@line     waitpid(pid, 0, 0);
@line 
@line     /* cross-uid control: a dumpable=1 process owned by a different
@line        uid cannot be ptraced (the uid rule) - attach from the parent
@line        to a child that setuid(0)-style dropped... the parent cannot
@line        create a different-uid child without setuid; skip: the uid
@line        rule is known. */
@line     return 0;
@line }
@literal \x1b
@literal :wq\r
@wait 12 gcc -o ptrace13 ptrace13.c
@wait 8 ./ptrace13
@wait 8 cat /proc/sys/kernel/yama/ptrace_scope 2>&1
@wait 8 echo "--- the L12 control: the parked setuid process after setresuid ---"
@wait 6 file /vortex/vortex12
@wait 8 echo "--- step 3: the attach race, measured ---"
@wait 6 vi race13.c
@sleep 3
@literal :set paste noai nosi nocindent\r
@literal i
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <string.h>
@line #include <unistd.h>
@line #include <sys/ptrace.h>
@line #include <sys/wait.h>
@line #include <errno.h>
@line #include <fcntl.h>
@line /* race13: measure whether PTRACE_ATTACH can land between the L13
@line    level's exec and its exit at the argc gate.  Spawns the level with
@line    argv={NULL} (an empty-argv exec), attaches in a tight loop, records
@line    whether any attach succeeds (it should NEVER: dumpable=0 blocks the
@line    parent too) and how many runs exit. */
@line int main(int argc, char **argv) {
@line     if (argc < 2) { fprintf(stderr, "usage: race13 <stdin-file>\n"); return 2; }
@line     int in = open(argv[1], O_RDONLY);
@line     char tmp[128];
@line     snprintf(tmp, sizeof tmp, "/tmp/vx13p/stdin.%d", getpid());
@line     int out = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0644);
@line     char b[256];
@line     ssize_t n = read(in, b, sizeof b);
@line     write(out, b, n);
@line     close(out);
@line     close(in);
@line     int tries = 0, attached = 0, exits = 0, eperm = 0;
@line     for (int run = 0; run < 20; run++) {
@line         pid_t pid = fork();
@line         if (pid == 0) {
@line             int i2 = open(tmp, O_RDONLY);
@line             dup2(i2, 0);
@line             close(i2);
@line             char *av[2] = { NULL, NULL };
@line             char *ev[1] = { NULL };
@line             execv("/vortex/vortex13", av);
@line             _exit(127);
@line         }
@line         tries++;
@line         /* tight attach loop while the level lives */
@line         for (;;) {
@line             errno = 0;
@line             int r = ptrace(PTRACE_ATTACH, pid, 0, 0);
@line             if (r == 0) {
@line                 attached++;
@line                 ptrace(PTRACE_DETACH, pid, 0, 0);
@line                 break;
@line             }
@line             if (errno == EPERM) eperm++;
@line             int st;
@line             pid_t w = waitpid(pid, &st, WNOHANG);
@line             if (w == pid) { exits++; break; }
@line             if (w < 0) break;
@line         }
@line     }
@line     unlink(tmp);
@line     printf("spawns=%d attached=%d exits=%d eperm=%d\n",
@line            tries, attached, exits, eperm);
@line     return 0;
@line }
@literal \x1b
@literal :wq\r
@wait 12 gcc -o race13 race13.c
@wait 8 printf "AAAAAAAAAAAAAAAAA" > in.txt
@wait 12 nohup ./race13 in.txt > race13out.txt 2>&1 < /dev/null & sleep 8; cat race13out.txt
@wait 6 vi race13b.c
@sleep 3
@literal :set paste noai nosi nocindent\r
@literal i
@line #include <stdio.h>
@line #include <stdlib.h>
@line #include <string.h>
@line #include <unistd.h>
@line #include <sys/ptrace.h>
@line #include <sys/wait.h>
@line #include <errno.h>
@line #include <signal.h>
@line /* race13b: the decisive post-exec attach test.  The child sleeps 2s
@line    PRE-exec (so the parent's attach cannot land pre-exec), then execs
@line    the L13 level.  The parent attaches after the exec (a 3s sleep > 2s)
@line    and records the errno.  The level may have already exited at the
@line    argc gate - the attach then reports ESRCH (process gone), which is
@line    itself the datum: no attach can land between exec and exit. */
@line int main(void) {
@line     pid_t pid = fork();
@line     if (pid == 0) {
@line         sleep(2);                    /* pre-exec window: the parent
@line                                         attaches AFTER this */
@line         char *av[2] = { NULL, NULL };
@line         char *ev[1] = { NULL };
@line         execv("/vortex/vortex13", av);
@line         _exit(127);
@line     }
@line     sleep(3);                        /* > the child's 2s: post-exec */
@line     errno = 0;
@line     int r = ptrace(PTRACE_ATTACH, pid, 0, 0);
@line     printf("post-exec attach: rc=%d errno=%s\n", r, strerror(errno));
@line     if (r == 0) { ptrace(PTRACE_DETACH, pid, 0, 0); kill(pid, 9); }
@line     else kill(pid, 9);
@line     int st;
@line     waitpid(pid, &st, 0);
@line     return 0;
@line }
@literal \x1b
@literal :wq\r
@wait 12 gcc -o race13b race13b.c
@wait 10 ./race13b
@wait 8 exit
