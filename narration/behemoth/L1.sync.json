     "role": "out",
     "from": 0,
     "to": 0
    }
   ]
  },
  {
   "id": 12,
   "start": 67.92,
   "end": 74.33,
   "text": "The payload is seventy-one NOP bytes, then the candidate return address, then the shellcode, then a newline.",
   "lines": [
    {
     "step": 19,
     "role": "cmd"
    },
    {
     "step": 19,
     "role": "out",
     "from": 0,
     "to": 0
    }
   ]
  },
  {
   "id": 13,
   "start": 74.33,
   "end": 80.38,
   "text": "The exploit forks once per candidate address, feeds the payload on standard input, and watches for the marker.",
   "lines": [
    {
     "step": 19,
