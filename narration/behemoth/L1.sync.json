     "from": 0,
     "to": 0
    }
   ]
  },
  {
   "id": 3,
   "start": 11.81,
   "end": 19.08,
   "text": "We disassemble main with objdump: it loads the address of a buffer sixty-seven bytes below the frame pointer and calls gets on it.",
   "lines": [
    {
     "step": 4,
     "role": "cmd"
    },
    {
     "step": 4,
     "role": "out",
     "from": 7,
     "to": 7
    },
    {
     "step": 4,
     "role": "out",
     "from": 9,
     "to": 9
    }
   ]
  },
  {
   "id": 4,
   "start": 19.08,
   "end": 29.47,
   "text": "gets reads until a newline with no bound, so this is a classic stack overflow: the saved frame pointer sits at offset sixty-seven and the return address at offset seventy-one.",
   "lines": [
    {
     "step": 4,
     "role": "out",
     "from": 7,
     "to": 7
    }
   ]
  },
  {
   "id": 5,
   "start": 29.47,
   "end": 35.9,
   "text": "We inspect the protections: readelf shows the stack is marked executable, and address randomisation is off.",
   "lines": [
    {
     "step": 5,
     "role": "cmd"
    },
    {
     "step": 5,
     "role": "out",
     "from": 0,
     "to": 0
    },
    {
     "step": 6,
     "role": "cmd"
    },
    {
     "step": 6,
     "role": "out",
     "from": 0,
     "to": 0
    }
   ]
  },
  {
   "id": 6,
   "start": 35.9,
   "end": 42.7,
   "text": "That combination means we do not need a return-to-libc chain; we can simply place shellcode on the stack and jump to it.",
   "lines": [
    {
     "step": 5,
     "role": "out",
     "from": 0,
     "to": 0
    },
    {
     "step": 6,
     "role": "out",
     "from": 0,
     "to": 0
    }
   ]
  },
  {
   "id": 7,
   "start": 42.7,
   "end": 44.69,
   "text": "Then we write the shellcode in vim.",
   "lines": [
    {
     "step": 7,
     "role": "vimcmd"
    },
    {
     "step": 7,
     "role": "vim"
    }
   ]
  },
  {
   "id": 8,
   "start": 44.69,
   "end": 48.05,
   "text": "It writes a marker so our sweep can detect a successful jump.",
   "lines": [
    {
     "step": 14,
     "role": "out",
     "from": 3,
     "to": 14
    }
   ]
  },
  {
   "id": 9,
   "start": 48.05,
   "end": 57.0,
   "text": "Then it calls geteuid, setreuid with that id twice, and setuid with the same id so the privilege survives the exec.",
   "lines": [
    {
     "step": 14,
     "role": "out",
     "from": 15,
     "to": 32
    }
   ]
  },
  {
   "id": 10,
   "start": 57.0,
   "end": 60.67,
   "text": "And finally execve on slash bin slash sh.",
   "lines": [
    {
     "step": 14,
     "role": "out",
     "from": 33,
     "to": 44
    }
   ]
  },
  {
   "id": 11,
   "start": 60.67,
   "end": 67.92,
   "text": "We assemble it with nasm, extract the raw bytes with objcopy, and print them with xxd: seventy-eight bytes.",
   "lines": [
    {
     "step": 15,
     "role": "cmd"
    },
    {
     "step": 15,
     "role": "out",
     "from": 0,
     "to": 0
    },
