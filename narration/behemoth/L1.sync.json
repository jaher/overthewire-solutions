    }
   ]
  },
  {
   "id": 2,
   "start": 4.61,
   "end": 11.81,
   "text": "ls shows it is setuid to behemoth two, and file says it is a thirty-two bit Intel executable, not stripped.",
   "lines": [
    {
     "step": 2,
     "role": "cmd"
    },
    {
     "step": 2,
     "role": "out",
     "from": 0,
     "to": 0
    },
